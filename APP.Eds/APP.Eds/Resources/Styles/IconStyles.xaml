<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:helpers="clr-namespace:APP.Eds.Helpers">

    <!-- Icon Styles -->
    <Style x:Key="IconLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{OnPlatform Android='monospace', iOS='Menlo', MacCatalyst='Menlo', WinUI='Segoe UI Symbol', Default='Courier New'}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Header Icon Style -->
    <Style x:Key="HeaderIconStyle" TargetType="Label" BasedOn="{StaticResource IconLabelStyle}">
        <Setter Property="FontSize" Value="32" />
    </Style>

    <!-- Card Icon Style -->
    <Style x:Key="CardIconStyle" TargetType="Label" BasedOn="{StaticResource IconLabelStyle}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- Button Icon Style -->
    <Style x:Key="ButtonIconStyle" TargetType="Label" BasedOn="{StaticResource IconLabelStyle}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Small Icon Style -->
    <Style x:Key="SmallIconStyle" TargetType="Label" BasedOn="{StaticResource IconLabelStyle}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Icon Colors -->
    <Color x:Key="PrimaryIconColor">#1565C0</Color>
    <Color x:Key="SecondaryIconColor">#F57C00</Color>
    <Color x:Key="SuccessIconColor">#2E7D32</Color>
    <Color x:Key="ErrorIconColor">#D32F2F</Color>
    <Color x:Key="WarningIconColor">#F57C00</Color>
    <Color x:Key="InfoIconColor">#1565C0</Color>

    <!-- Icon Backgrounds -->
    <Color x:Key="PrimaryIconBackground">#E3F2FD</Color>
    <Color x:Key="SecondaryIconBackground">#FFF3E0</Color>
    <Color x:Key="SuccessIconBackground">#E8F5E8</Color>
    <Color x:Key="ErrorIconBackground">#FFEBEE</Color>
    <Color x:Key="WarningIconBackground">#FFF8E1</Color>
    <Color x:Key="InfoIconBackground">#E1F5FE</Color>

    <!-- Fallback Text Icons (for platforms with poor Unicode support) -->
    <x:String x:Key="FallbackFuelIcon">EDS</x:String>
    <x:String x:Key="FallbackTankIcon">TNK</x:String>
    <x:String x:Key="FallbackSuccessIcon">OK</x:String>
    <x:String x:Key="FallbackErrorIcon">ERR</x:String>
    <x:String x:Key="FallbackWarningIcon">!</x:String>
    <x:String x:Key="FallbackInfoIcon">i</x:String>

</ResourceDictionary>