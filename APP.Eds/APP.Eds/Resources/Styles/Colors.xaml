<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>
    
    <!-- Premium Gradient Colors for Modern Popups -->
    <Color x:Key="GradientStart">#6366F1</Color>
    <Color x:Key="GradientMid">#8B5CF6</Color>
    <Color x:Key="GradientEnd">#D946EF</Color>
    
    <!-- Custom Green Colors for Login Button -->
    <Color x:Key="LoginGreen">#4CAF50</Color>
    <Color x:Key="LoginGreenDark">#388E3C</Color>
    
    <!-- Semantic Colors -->
    <Color x:Key="Success">#4CAF50</Color>
    <Color x:Key="Warning">#FF9800</Color>
    <Color x:Key="Error">#F44336</Color>
    <Color x:Key="Info">#2196F3</Color>

    <!-- Point of Sale Colors -->
    <Color x:Key="POSProductGreen">#10B981</Color>
    <Color x:Key="POSProductGreenDark">#059669</Color>
    <Color x:Key="POSBlue">#3B82F6</Color>
    <Color x:Key="POSBlueDark">#2563EB</Color>
    <Color x:Key="POSOrange">#F97316</Color>
    <Color x:Key="POSOrangeDark">#EA580C</Color>
    <Color x:Key="POSRed">#EF4444</Color>
    <Color x:Key="POSRedDark">#DC2626</Color>
    <Color x:Key="POSBackground">#F8FAFC</Color>
    <Color x:Key="POSCardBackground">#F1F5F9</Color>
    <Color x:Key="POSBorder">#E2E8F0</Color>
    <Color x:Key="POSTextPrimary">#1E293B</Color>
    <Color x:Key="POSTextSecondary">#374151</Color>
    <Color x:Key="POSTextMuted">#9CA3AF</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray50">#F9FAFB</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1F2937</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <!-- Dark Mode Specific Colors for Better Contrast -->
    <!-- Card backgrounds for dark mode - using darker grays with good separation from page background -->
    <Color x:Key="DarkCardBackground">#2D2D2D</Color>
    <Color x:Key="DarkInputBackground">#3A3A3A</Color>
    
    <!-- Border colors for dark mode - lighter to create contrast -->
    <Color x:Key="DarkBorderColor">#4A4A4A</Color>
    <Color x:Key="DarkBorderAccent">#5A5A5A</Color>
    
    <!-- Text colors for dark mode - high contrast white/light gray -->
    <Color x:Key="DarkPrimaryText">#FFFFFF</Color>
    <Color x:Key="DarkSecondaryText">#B0B0B0</Color>
    <Color x:Key="DarkMutedText">#909090</Color>
    
    <!-- Section header backgrounds for dark mode with color tints -->
    <Color x:Key="DarkGreenSection">#1E4D2B</Color>
    <Color x:Key="DarkBlueSection">#1A3A5C</Color>
    <Color x:Key="DarkOrangeSection">#5C3A1A</Color>
    <Color x:Key="DarkRedSection">#5C1A1A</Color>
    <Color x:Key="DarkPurpleSection">#3A1A5C</Color>
    <Color x:Key="DarkYellowSection">#5C5C1A</Color>
    
    <!-- Colored backgrounds for metrics in dark mode -->
    <Color x:Key="DarkSuccessBackground">#1B3D1F</Color>
    <Color x:Key="DarkInfoBackground">#1A2F4D</Color>
    <Color x:Key="DarkWarningBackground">#4D3A1A</Color>
    <Color x:Key="DarkErrorBackground">#4D1A1A</Color>
    
    <!-- Disabled state colors -->
    <Color x:Key="LightDisabledBackground">#D3D3D3</Color>
    <Color x:Key="DarkDisabledBackground">#3A3A3A</Color>
    <Color x:Key="LightDisabledText">#9E9E9E</Color>
    <Color x:Key="DarkDisabledText">#6B6B6B</Color>
    
    <!-- Border colors for colored sections in dark mode -->
    <Color x:Key="DarkYellowBorder">#8B7200</Color>
    <Color x:Key="DarkGreenBorder">#2E7D32</Color>
    <Color x:Key="DarkRedBorder">#D32F2F</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="LoginGreenBrush" Color="{StaticResource LoginGreen}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <!-- Point of Sale Brushes -->
    <SolidColorBrush x:Key="POSProductGreenBrush" Color="{StaticResource POSProductGreen}"/>
    <SolidColorBrush x:Key="POSBlueBrush" Color="{StaticResource POSBlue}"/>
    <SolidColorBrush x:Key="POSOrangeBrush" Color="{StaticResource POSOrange}"/>
    <SolidColorBrush x:Key="POSRedBrush" Color="{StaticResource POSRed}"/>
    <SolidColorBrush x:Key="POSBackgroundBrush" Color="{StaticResource POSBackground}"/>

    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>