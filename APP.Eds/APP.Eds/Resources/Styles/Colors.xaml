<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#006EAA</Color>
    <Color x:Key="PrimaryDark">#006EAA</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#E8F3FA</Color>
    <Color x:Key="SecondaryDarkText">#133B55</Color>
    <Color x:Key="Tertiary">#133B55</Color>

    <!-- Premium Gradient Colors for Modern Popups -->
    <Color x:Key="GradientStart">#006EAA</Color>
    <Color x:Key="GradientMid">#006EAA</Color>
    <Color x:Key="GradientEnd">#006EAA</Color>

    <!-- Custom Green Colors for Login Button -->
    <Color x:Key="LoginGreen">#006EAA</Color>
    <Color x:Key="LoginGreenDark">#133B55</Color>

    <!-- Semantic Colors -->
    <Color x:Key="Success">#187246</Color>
    <Color x:Key="Warning">#8F570A</Color>
    <Color x:Key="Error">#B42318</Color>
    <Color x:Key="Info">#006EAA</Color>

    <!-- Point of Sale Colors -->
    <Color x:Key="POSProductGreen">#006EAA</Color>
    <Color x:Key="POSProductGreenDark">#133B55</Color>
    <Color x:Key="POSBlue">#006EAA</Color>
    <Color x:Key="POSBlueDark">#133B55</Color>
    <Color x:Key="POSOrange">#133B55</Color>
    <Color x:Key="POSOrangeDark">#133B55</Color>
    <Color x:Key="POSRed">#B42318</Color>
    <Color x:Key="POSRedDark">#B42318</Color>
    <Color x:Key="POSBackground">#F4F7FA</Color>
    <Color x:Key="POSCardBackground">#FFFFFF</Color>
    <Color x:Key="POSBorder">#DFE7EF</Color>
    <Color x:Key="POSTextPrimary">#132D40</Color>
    <Color x:Key="POSTextSecondary">#546779</Color>
    <Color x:Key="POSTextMuted">#546779</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray50">#F9FAFB</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1F2937</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <!-- Dark Mode Specific Colors for Better Contrast (WCAG AA Compliant) -->
    <Color x:Key="DarkBackground">#0F1C27</Color>
    <Color x:Key="DarkSurface">#182B3A</Color>
    <Color x:Key="DarkCardBackground">#182B3A</Color>
    <Color x:Key="DarkBorder">#354E60</Color>
    <Color x:Key="DarkTextPrimary">#EDF5FC</Color>
    <Color x:Key="DarkTextSecondary">#B8CAD7</Color>
    <Color x:Key="DarkDisabledText">#707070</Color>
    <Color x:Key="DarkInputBackground">#182B3A</Color>
    <Color x:Key="DarkDivider">#354E60</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="LoginGreenBrush" Color="{StaticResource LoginGreen}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <!-- Point of Sale Brushes -->
    <SolidColorBrush x:Key="POSProductGreenBrush" Color="{StaticResource POSProductGreen}"/>
    <SolidColorBrush x:Key="POSBlueBrush" Color="{StaticResource POSBlue}"/>
    <SolidColorBrush x:Key="POSOrangeBrush" Color="{StaticResource POSOrange}"/>
    <SolidColorBrush x:Key="POSRedBrush" Color="{StaticResource POSRed}"/>
    <SolidColorBrush x:Key="POSBackgroundBrush" Color="{StaticResource POSBackground}"/>

    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Dark Mode Brushes for Better Accessibility -->
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}"/>
    <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource DarkSurface}"/>
    <SolidColorBrush x:Key="DarkCardBackgroundBrush" Color="{StaticResource DarkCardBackground}"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource DarkBorder}"/>
    <SolidColorBrush x:Key="DarkTextPrimaryBrush" Color="{StaticResource DarkTextPrimary}"/>
    <SolidColorBrush x:Key="DarkTextSecondaryBrush" Color="{StaticResource DarkTextSecondary}"/>
    <SolidColorBrush x:Key="DarkInputBackgroundBrush" Color="{StaticResource DarkInputBackground}"/>

    <!-- Poliedro EDS: approved light tokens and explicit dark equivalents. -->
    <Color x:Key="BrandPrimary">#006EAA</Color>
    <Color x:Key="BrandPrimaryDark">#234D65</Color>
    <Color x:Key="BrandDeep">#133B55</Color>
    <Color x:Key="BrandDeepDark">#234D65</Color>
    <Color x:Key="PageBackground">#F4F7FA</Color>
    <Color x:Key="PageBackgroundDark">#0F1C27</Color>
    <Color x:Key="CardSurface">#FFFFFF</Color>
    <Color x:Key="CardSurfaceDark">#182B3A</Color>
    <Color x:Key="BrandSoft">#E8F3FA</Color>
    <Color x:Key="BrandSoftDark">#203F54</Color>
    <Color x:Key="TextPrimary">#132D40</Color>
    <Color x:Key="TextPrimaryDark">#EDF5FC</Color>
    <Color x:Key="TextSecondary">#546779</Color>
    <Color x:Key="TextSecondaryDark">#B8CAD7</Color>
    <Color x:Key="SubtleBorder">#DFE7EF</Color>
    <Color x:Key="SubtleBorderDark">#354E60</Color>
    <Color x:Key="InputBorder">#8295A5</Color>
    <Color x:Key="InputBorderDark">#8295A5</Color>
    <Color x:Key="SuccessDark">#7BD5A2</Color>
    <Color x:Key="SuccessSurface">#EAF6EF</Color>
    <Color x:Key="SuccessSurfaceDark">#143526</Color>
    <Color x:Key="WarningDark">#FFD086</Color>
    <Color x:Key="WarningSurface">#FFF5DF</Color>
    <Color x:Key="WarningSurfaceDark">#382A14</Color>
    <Color x:Key="ErrorDark">#FFB4AC</Color>
    <Color x:Key="ErrorSurface">#FFF0EF</Color>
    <Color x:Key="ErrorSurfaceDark">#421E1B</Color>
    <Color x:Key="OnBrand">#FFFFFF</Color>
    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpacePage">20</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="SpaceXxl">32</x:Double>
    <x:Double x:Key="TypeCaption">12</x:Double>
    <x:Double x:Key="TypeLabel">14</x:Double>
    <x:Double x:Key="TypeBody">16</x:Double>
    <x:Double x:Key="TypeSection">18</x:Double>
    <x:Double x:Key="TypePageTitle">24</x:Double>
    <x:Double x:Key="TypeHeroTitle">28</x:Double>
    <x:Double x:Key="TypeMetric">34</x:Double>
    <Color x:Key="BrandText">#006EAA</Color>
    <Color x:Key="BrandTextDark">#70C5F5</Color>
    <Color x:Key="ErrorFill">#B42318</Color>
    <Color x:Key="ErrorFillDark">#B42318</Color>
    <Color x:Key="SuccessFill">#187246</Color>
    <Color x:Key="SuccessFillDark">#187246</Color>
    <Color x:Key="WarningFill">#8F570A</Color>
    <Color x:Key="WarningFillDark">#8F570A</Color>
    <!-- Dark proposal: white primary actions over navy surfaces. -->
    <Color x:Key="PrimaryActionFill">#006EAA</Color>
    <Color x:Key="PrimaryActionFillDark">#FFFFFF</Color>
    <Color x:Key="PrimaryActionText">#FFFFFF</Color>
    <Color x:Key="PrimaryActionTextDark">#006EAA</Color>
</ResourceDictionary>