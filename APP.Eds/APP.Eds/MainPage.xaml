<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:APP.Eds.Controls"
             xmlns:custom="clr-namespace:APP.Eds.Resources.Custom"
             x:Class="APP.Eds.MainPage"
             Title="Inicio de Sesión"
             BackgroundColor="{StaticResource White}">
    
    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="30,30">
            
            <!-- Header Section - Only title with dark text for white background -->
            <StackLayout Grid.Row="0" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                <!-- App Title -->
                <Label Text="POLIEDRO EDS"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#2196F3"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                       
                <Label Text="Sistema de Gestión de Estaciones de Servicio"
                       FontSize="13"
                       TextColor="{StaticResource Gray600}"
                       FontAttributes="None"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,10"/>
            </StackLayout>
            
            <!-- Login Card with Logo -->
            <Border Grid.Row="1" 
                    Style="{StaticResource LoginCardStyle}"
                    Margin="0,10,0,20"
                    VerticalOptions="Center">
                
                <StackLayout Spacing="25">
                    
                    <!-- Logo Section - Moved to white area -->
                    <StackLayout Spacing="15" HorizontalOptions="Center" Margin="0,5,0,0">
                        <!-- Poliedro Logo -->
                        <Border BackgroundColor="{StaticResource White}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                HeightRequest="70"
                                WidthRequest="140"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="#2196F3" 
                                        Offset="0,4" 
                                        Radius="15" 
                                        Opacity="0.2"/>
                            </Border.Shadow>
                            <Image Source="poliedro.jpeg" 
                                   Aspect="AspectFit"
                                   HeightRequest="50"
                                   WidthRequest="200"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   BackgroundColor="Transparent"/>
                        </Border>
                    </StackLayout>
                    
                    <!-- Welcome Text -->
                    <StackLayout Spacing="8">
                        <Label Text="¡Bienvenido de vuelta!"
                               Style="{StaticResource LoginTitleStyle}"/>
                        <Label Text="Ingresa tus credenciales para continuar"
                               Style="{StaticResource LoginSubtitleStyle}"/>
                    </StackLayout>
                    
                    <!-- Username Field -->
                    <StackLayout Spacing="8">
                        <Label Text="Nombre de Usuario"
                               Style="{StaticResource InputLabelStyle}"/>
                        <Border Style="{StaticResource LoginInputStyle}">
                            <Grid ColumnDefinitions="Auto,*" Padding="15,12">
                                <Label Grid.Column="0" 
                                       Text="👤" 
                                       Style="{StaticResource IconLabelStyle}"/>
                                <Entry x:Name="UsernameEntry"
                                       Grid.Column="1"
                                       Placeholder="Ingresa tu usuario"
                                       Keyboard="Text"
                                       Completed="UsernameEntry_Completed"
                                       BackgroundColor="Transparent"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       AutomationId="EntryUsername"/>
                            </Grid>
                        </Border>
                    </StackLayout>
                    
                    <!-- Password Field -->
                    <StackLayout Spacing="8">
                        <Label Text="Contraseña"
                               Style="{StaticResource InputLabelStyle}"/>
                        <Border Style="{StaticResource LoginInputStyle}">
                            <Grid ColumnDefinitions="Auto,*" Padding="15,12">
                                <Label Grid.Column="0" 
                                       Text="🔒" 
                                       Style="{StaticResource IconLabelStyle}"/>
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="1"
                                       Placeholder="Ingresa tu contraseña"
                                       IsPassword="True" 
                                       Completed="OnLoginClicked"
                                       BackgroundColor="Transparent"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       AutomationId="EntryPassword"/>
                            </Grid>
                        </Border>
                    </StackLayout>
                    
                    <!-- Remember Me Option -->
                    <StackLayout Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                        <CheckBox x:Name="RememberMeCheckBox" 
                                  Color="#2196F3"
                                  VerticalOptions="Center"/>
                        <Label Text="Recordar mis credenciales"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRememberMeTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>
                    
                    <!-- Login Button -->
                    <controls:HoverButton x:Name="LoginButton"
                                          Text="Iniciar Sesión"
                                          Clicked="OnLoginClicked"
                                          FontSize="16"
                                          FontAttributes="Bold"
                                          HeightRequest="50"
                                          CornerRadius="8"
                                          NormalColor="{StaticResource White}"
                                          HoverColor="#F5F5F5"
                                          PressedColor="#E0E0E0"
                                          TextColor="#2196F3"
                                          BorderColor="#2196F3"
                                          BorderWidth="2"
                                          Margin="0,10,0,0"
                                          AutomationId="ButtonLogin">
                        <controls:HoverButton.Shadow>
                            <Shadow Brush="#E0E0E0" 
                                    Offset="0,4" 
                                    Radius="12" 
                                    Opacity="0.3"/>
                        </controls:HoverButton.Shadow>
                    </controls:HoverButton>
                    
                    <!-- Loading Indicator -->
                    <StackLayout x:Name="LoadingSection" 
                                 IsVisible="False"
                                 Spacing="12"
                                 Margin="0,10,0,0">
                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsVisible="False"
                                           IsRunning="False"
                                           Color="#2196F3"
                                           HorizontalOptions="Center"
                                           AutomationId="ActivityIndicatorLoading"/>
                        <Label Text="Validando credenciales..."
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                    
                    <!-- Error display -->
                    <Border x:Name="ErrorSection"
                            IsVisible="False"
                            BackgroundColor="#FFEBEE"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="#FFCDD2"
                            Padding="15,12">
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Label Text="⚠️" 
                                   FontSize="16"
                                   VerticalOptions="Center"/>
                            <Label x:Name="ErrorLabel"
                                   TextColor="#C62828"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   AutomationId="LabelError"/>
                        </StackLayout>
                    </Border>
                    
                </StackLayout>
            </Border>
            
            <!-- Footer with dark text for white background -->
            <StackLayout Grid.Row="2" Spacing="12" HorizontalOptions="Center">
                <Label Text="¿Necesitas ayuda?"
                       FontSize="14"
                       TextColor="{StaticResource Gray600}"
                       HorizontalOptions="Center"/>
                <Label Text="Contacta al administrador del sistema"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center"/>
            </StackLayout>
            
        </Grid>
    </ScrollView>
</ContentPage>