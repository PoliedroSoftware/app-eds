<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:APP.Eds.Controls"
             xmlns:custom="clr-namespace:APP.Eds.Resources.Custom"
             x:Class="APP.Eds.MainPage"
             Title="Inicio de Sesión"
             BackgroundColor="{StaticResource Gray50}">
    
    <!-- Modern gradient background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
            <GradientStop Color="{StaticResource Secondary}" Offset="0.3" />
            <GradientStop Color="{StaticResource Gray50}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    
    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="30,40">
            
            <!-- Logo/Branding Section -->
            <StackLayout Grid.Row="0" Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">
                <!-- Logo placeholder - using icon font -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 30"
                        StrokeThickness="0"
                        HeightRequest="80"
                        WidthRequest="80"
                        HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" 
                                Offset="0,4" 
                                Radius="8" 
                                Opacity="0.3"/>
                    </Border.Shadow>
                    <Label Text="🏢" 
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{StaticResource Primary}"/>
                </Border>
                
                <!-- App Title -->
                <Label Text="EDS Manager"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       HorizontalOptions="Center"/>
                       
                <Label Text="Sistema de Gestión de Estaciones de Servicio"
                       FontSize="14"
                       TextColor="{StaticResource White}"
                       Opacity="0.8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </StackLayout>
            
            <!-- Login Card -->
            <Border Grid.Row="1" 
                    BackgroundColor="{StaticResource White}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="30"
                    Margin="0,40,0,20"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}" 
                            Offset="0,8" 
                            Radius="24" 
                            Opacity="0.1"/>
                </Border.Shadow>
                
                <StackLayout Spacing="25">
                    <!-- Welcome Text -->
                    <StackLayout Spacing="8">
                        <Label Text="¡Bienvenido de vuelta!"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}"
                               HorizontalOptions="Center"/>
                        <Label Text="Ingresa tus credenciales para continuar"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                    
                    <!-- Username Field -->
                    <StackLayout Spacing="8">
                        <Label Text="Nombre de Usuario"
                               FontSize="14"
                               FontAttributes="Medium"
                               TextColor="{StaticResource Gray700}"/>
                        <Border BackgroundColor="{StaticResource Gray50}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                Stroke="{StaticResource Gray200}">
                            <Grid ColumnDefinitions="Auto,*" Padding="15,12">
                                <Label Grid.Column="0" 
                                       Text="👤" 
                                       FontSize="18"
                                       TextColor="{StaticResource Gray400}"
                                       VerticalOptions="Center"
                                       Margin="0,0,12,0"/>
                                <Entry x:Name="UsernameEntry"
                                       Grid.Column="1"
                                       Placeholder="Ingresa tu usuario"
                                       Keyboard="Text"
                                       Completed="UsernameEntry_Completed"
                                       BackgroundColor="Transparent"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       AutomationId="EntryUsername"/>
                            </Grid>
                        </Border>
                    </StackLayout>
                    
                    <!-- Password Field -->
                    <StackLayout Spacing="8">
                        <Label Text="Contraseña"
                               FontSize="14"
                               FontAttributes="Medium"
                               TextColor="{StaticResource Gray700}"/>
                        <Border BackgroundColor="{StaticResource Gray50}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                Stroke="{StaticResource Gray200}">
                            <Grid ColumnDefinitions="Auto,*" Padding="15,12">
                                <Label Grid.Column="0" 
                                       Text="🔒" 
                                       FontSize="18"
                                       TextColor="{StaticResource Gray400}"
                                       VerticalOptions="Center"
                                       Margin="0,0,12,0"/>
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="1"
                                       Placeholder="Ingresa tu contraseña"
                                       IsPassword="True" 
                                       Completed="OnLoginClicked"
                                       BackgroundColor="Transparent"
                                       FontSize="16"
                                       TextColor="{StaticResource Gray900}"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       AutomationId="EntryPassword"/>
                            </Grid>
                        </Border>
                    </StackLayout>
                    
                    <!-- Login Button -->
                    <controls:HoverButton x:Name="LoginButton"
                                          Text="Iniciar Sesión"
                                          Clicked="OnLoginClicked"
                                          FontSize="16"
                                          FontAttributes="Medium"
                                          HeightRequest="50"
                                          CornerRadius="8"
                                          NormalColor="{StaticResource Primary}"
                                          HoverColor="{StaticResource Tertiary}"
                                          PressedColor="{StaticResource PrimaryDark}"
                                          Margin="0,10,0,0"
                                          AutomationId="ButtonLogin">
                        <controls:HoverButton.Shadow>
                            <Shadow Brush="{StaticResource Primary}" 
                                    Offset="0,4" 
                                    Radius="12" 
                                    Opacity="0.3"/>
                        </controls:HoverButton.Shadow>
                    </controls:HoverButton>
                    
                    <!-- Loading Indicator -->
                    <StackLayout x:Name="LoadingSection" 
                                 IsVisible="False"
                                 Spacing="12"
                                 Margin="0,10,0,0">
                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsVisible="False"
                                           IsRunning="False"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           AutomationId="ActivityIndicatorLoading"/>
                        <Label Text="Validando credenciales..."
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                    
                    <!-- Error display -->
                    <Border x:Name="ErrorSection"
                            IsVisible="False"
                            BackgroundColor="#FFEBEE"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="#FFCDD2"
                            Padding="15,12">
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Label Text="⚠️" 
                                   FontSize="16"
                                   VerticalOptions="Center"/>
                            <Label x:Name="ErrorLabel"
                                   TextColor="#C62828"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   AutomationId="LabelError"/>
                        </StackLayout>
                    </Border>
                    
                </StackLayout>
            </Border>
            
            <!-- Footer -->
            <StackLayout Grid.Row="2" Spacing="12" HorizontalOptions="Center">
                <Label Text="¿Necesitas ayuda?"
                       FontSize="14"
                       TextColor="{StaticResource White}"
                       Opacity="0.7"
                       HorizontalOptions="Center"/>
                <Label Text="Contacta al administrador del sistema"
                       FontSize="12"
                       TextColor="{StaticResource White}"
                       Opacity="0.6"
                       HorizontalOptions="Center"/>
            </StackLayout>
            
        </Grid>
    </ScrollView>
</ContentPage>