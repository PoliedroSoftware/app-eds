<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:brand="clr-namespace:APP.Eds.Controls" x:Class="APP.Eds.MainPage" Title="Acceso" NavigationPage.HasNavigationBar="False" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid SafeAreaEdges="SoftInput">
    <ScrollView>
        <VerticalStackLayout Padding="24,24" Spacing="24" MaximumWidthRequest="440" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <Image Source="{AppThemeBinding Light=poliedro_logo.png, Dark=poliedro_logo_dark.png}" Aspect="AspectFit" HeightRequest="78" WidthRequest="216" HorizontalOptions="Start" SemanticProperties.Description="Poliedro Software" />
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="10,5" VerticalOptions="Center">
                        <Label Text="EDS" FontSize="12" FontFamily="OpenSansSemibold" CharacterSpacing="1" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" />
                    </Border>
                </Grid>
            </VerticalStackLayout>
            <Border Style="{StaticResource PoliedroCard}">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Acceso" Style="{StaticResource PoliedroSectionTitle}" />
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Usuario" Style="{StaticResource InputLabelStyle}" />
                        <Border Style="{StaticResource PoliedroField}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <brand:PoliedroIcon Text="👤" VerticalOptions="Center" />
                                <Entry x:Name="UsernameEntry" Grid.Column="1" Keyboard="Text" ReturnType="Next" Completed="UsernameEntry_Completed" AutomationId="EntryUsername" SemanticProperties.Description="Usuario" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Contraseña" Style="{StaticResource InputLabelStyle}" />
                        <Border Style="{StaticResource PoliedroField}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <brand:PoliedroIcon Text="🔒" VerticalOptions="Center" />
                                <Entry x:Name="PasswordEntry" Grid.Column="1" IsPassword="True" ReturnType="Go" Completed="OnLoginClicked" AutomationId="EntryPassword" SemanticProperties.Description="Contraseña" />
                            </Grid>
                        </Border>
                        <Button Text="Mostrar contraseña" Clicked="OnShowPasswordClicked" Style="{StaticResource PoliedroSecondaryButton}" AutomationId="ButtonShowPassword" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <CheckBox x:Name="RememberMeCheckBox" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Recordarme" FontSize="14" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnRememberMeTapped" /></Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Button x:Name="LoginButton" Text="Iniciar sesión" Clicked="OnLoginClicked" Style="{StaticResource PoliedroPrimaryButton}" AutomationId="ButtonLogin" />
                    <VerticalStackLayout x:Name="LoadingSection" IsVisible="False" Spacing="8">
                        <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" AutomationId="ActivityIndicatorLoading" />
                        <Label Text="Validando credenciales…" Style="{StaticResource PoliedroBodySecondary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border x:Name="ErrorSection" IsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}" Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" StrokeShape="RoundRectangle 10" Padding="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <brand:PoliedroIcon x:Name="ErrorIcon" Text="⚠️" VerticalOptions="Start" />
                            <Label x:Name="ErrorLabel" Grid.Column="1" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" FontSize="14" AutomationId="LabelError" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>
            <Button Text="Soporte por WhatsApp" Clicked="OnHelpButtonTapped" Style="{StaticResource PoliedroSecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
