<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Business.BusinessListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestion de Negocios"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="140,*,Auto">

        <!-- Professional Header Section -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Padding="20,40,20,20">
            <Border.Background>
                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
            </Border.Background>


            <Grid RowDefinitions="Auto,Auto,Auto">
                <!-- Title and Icon -->
                <StackLayout Grid.Row="0" Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                    <Border BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="2"
                            Stroke="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            WidthRequest="40" HeightRequest="40"
                            VerticalOptions="Center">
                        <Label Text="??" FontSize="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <Label Text="Gestion de Negocios"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnBrand}"
                           VerticalOptions="Center"/>
                </StackLayout>

                <!-- Subtitle -->
                <Label Grid.Row="1"
                       Text="Administre sus unidades de negocio"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"/>

                <!-- Business count indicator -->
                <Border Grid.Row="2"
                        BackgroundColor="Transparent"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        Opacity="0.8"
                        Padding="16,8"
                        HorizontalOptions="Center"
                        Margin="0,12,0,0">
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label Text="??" FontSize="14" TextColor="{StaticResource OnBrand}" VerticalOptions="Center"/>
                        <Label Text="{Binding BusinessList.Count, StringFormat='Total: {0} negocios'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnBrand}"
                               VerticalOptions="Center"/>
                    </StackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding BusinessList}"
                            SelectionChanged="OnBusinessSelected"
                            BackgroundColor="Transparent">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Enhanced Business Card -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                StrokeShape="RoundRectangle 20"
                                Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                StrokeThickness="1"
                                Padding="0"
                                Margin="20,10,20,10">


                            <!-- Left Color Bar for Visual Separation -->
                            <Grid ColumnDefinitions="6,*">

                                <!-- Color-coded Left Border -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                        StrokeShape="RoundRectangle 20,0,0,20"/>

                                <!-- Main Content -->
                                <Grid Grid.Column="1" RowDefinitions="*,Auto">

                                    <!-- Content Section -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="24,20">

                                        <!-- Business Icon -->
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 25"
                                                WidthRequest="50" HeightRequest="50"
                                                VerticalOptions="Center"
                                                Margin="0,0,16,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                                            </Border.Background>
                                            <Label Text="??"
                                                   FontSize="24"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Business Info -->
                                        <StackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="8">
                                            <Label Text="{Binding Name}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                   LineBreakMode="TailTruncation"/>

                                            <StackLayout Orientation="Horizontal" Spacing="12">
                                                <!-- ID Badge -->
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 12"
                                                        Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                        StrokeThickness="1"
                                                        Padding="8,4">
                                                    <StackLayout Orientation="Horizontal" Spacing="4">
                                                        <Label Text="#" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" FontAttributes="Bold" VerticalOptions="Center"/>
                                                        <Label Text="{Binding IdBusiness}"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                               VerticalOptions="Center"/>
                                                    </StackLayout>
                                                </Border>

                                                <!-- Status Badge -->
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 12"
                                                        Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                        StrokeThickness="1"
                                                        Padding="8,4">
                                                    <StackLayout Orientation="Horizontal" Spacing="4">
                                                        <Label Text="?" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" VerticalOptions="Center"/>
                                                        <Label Text="Activo"
                                                               FontSize="12"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                               VerticalOptions="Center"/>
                                                    </StackLayout>
                                                </Border>
                                            </StackLayout>
                                        </StackLayout>

                                        <!-- Action Button -->
                                        <Border Grid.Column="2"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                WidthRequest="40" MinimumHeightRequest="52"
                                                VerticalOptions="Center">


                                            <Button Text=">"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewBusinessDetailCommand}"
                                                    CommandParameter="{Binding}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="White"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="12"/>
                                        </Border>
                                    </Grid>

                                    <!-- Action Footer -->
                                    <Border Grid.Row="1"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 0,0,0,20"
                                            Padding="24,12">

                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <!-- Info -->
                                            <StackLayout Grid.Column="0"
                                                         Orientation="Horizontal"
                                                         Spacing="8"
                                                         VerticalOptions="Center">
                                                <Label Text="??" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="Toque para ver detalles y gestionar"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>

                                            <!-- Edit Button -->
                                            <Button Grid.Column="1"
                                                    Text="Edit"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditBusinessCommand}"
                                                    CommandParameter="{Binding}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                    FontSize="12"
                                                    WidthRequest="36" HeightRequest="36"
                                                    CornerRadius="18"
                                                    Margin="0,0,8,0"/>

                                            <!-- Options Button -->
                                            <Button Grid.Column="2"
                                                    Text="Opt"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.BusinessOptionsCommand}"
                                                    CommandParameter="{Binding}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                    FontSize="12"
                                                    WidthRequest="36" HeightRequest="36"
                                                    CornerRadius="18"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Enhanced Empty State -->
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20" Padding="32">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                StrokeShape="RoundRectangle 24"
                                Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                StrokeThickness="1"
                                Padding="48,40">


                            <StackLayout Spacing="20" HorizontalOptions="Center">
                                <Border StrokeShape="RoundRectangle 50"
                                        WidthRequest="100" HeightRequest="100">
                                    <Border.Background>
                                        <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                                    </Border.Background>
                                    <Label Text="??" FontSize="48"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           Opacity="0.6"/>
                                </Border>

                                <StackLayout Spacing="12">
                                    <Label Text="No hay negocios registrados"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Comience creando su primer negocio para administrar sus estaciones de servicio"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           MaximumWidthRequest="300"
                                           LineHeight="1.4"/>
                                </StackLayout>

                                <Button Text="+ Crear Primer Negocio"
                                        Command="{Binding CreateBusinessCommand}"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        TextColor="{StaticResource OnBrand}"
                                        CornerRadius="20"
                                        WidthRequest="220"
                                        MinimumHeightRequest="52"
                                        Margin="0,12,0,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                                    </Button.Background>

                                </Button>
                            </StackLayout>
                        </Border>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Floating Action Button -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                StrokeShape="RoundRectangle 28"
                WidthRequest="56" HeightRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20,0,20,20">


            <Button Text="+"
                    Command="{Binding CreateBusinessCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource OnBrand}"
                    FontSize="28"
                    FontAttributes="Bold"
                    WidthRequest="56" MinimumHeightRequest="52"
                    CornerRadius="28"
                    AutomationId="ButtonAddBusiness"/>
        </Border>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              Grid.RowSpan="3"
                              AutomationId="LoadingOverlay"/>
    </Grid>
</ContentPage>