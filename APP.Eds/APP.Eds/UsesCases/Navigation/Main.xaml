<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Navigation.Main"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="POLIEDRO EDS"
    BackgroundColor="{StaticResource Gray50}">
    
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
            <GradientStop Color="{StaticResource Secondary}" Offset="0.4" />
            <GradientStop Color="{StaticResource Gray50}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    
    <Grid>
        <ScrollView>
            <StackLayout Padding="25,40,25,25" Spacing="25">
                
                <!-- Header Section -->
                <Border BackgroundColor="{StaticResource White}" 
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0" 
                        Padding="25,20">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" 
                                Offset="0,4" 
                                Radius="15" 
                                Opacity="0.15"/>
                    </Border.Shadow>
                    <StackLayout Spacing="8">
                        <Label Text="¡Bienvenido!" 
                               FontSize="24" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"/>
                        <Label Text="Menú Principal" 
                               FontSize="16"
                               TextColor="{StaticResource Gray600}"
                               HorizontalOptions="Center"
                               AutomationId="LabelMenuPrincipal"/>
                    </StackLayout>
                </Border>

                <!-- Court Button for Islander -->
                <Border IsVisible="{Binding IsIslander}"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                            <GradientStop Color="{StaticResource Tertiary}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" 
                                Offset="0,6" 
                                Radius="12" 
                                Opacity="0.25"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToCourtCommand}" />
                    </Border.GestureRecognizers>
                    <Grid Padding="20,15" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="💼"
                               FontSize="24"
                               VerticalOptions="Center"
                               Margin="0,0,15,0"/>
                        <Label Grid.Column="1"
                               Text="Corte del Día"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2"
                               Text="▶"
                               FontSize="18"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>
                
                <!-- Menu Categories -->
                <CollectionView ItemsSource="{Binding Categories}" 
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,8" 
                                    BackgroundColor="{StaticResource White}"
                                    StrokeShape="RoundRectangle 15"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Gray200}"
                                    Padding="20,18"
                                    AutomationId="FrameCategory">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray300}" 
                                            Offset="0,2" 
                                            Radius="8" 
                                            Opacity="0.1"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowPopupCommand}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Icon Container -->
                                    <Border Grid.Column="0"
                                            BackgroundColor="{StaticResource Secondary}"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Margin="0,0,15,0">
                                        <Label Text="{Binding Icon}"
                                               FontSize="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    
                                    <!-- Title -->
                                    <Label Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray900}"
                                           VerticalOptions="Center"
                                           AutomationId="LabelCategoryTitle"/>
                                    
                                    <!-- Arrow -->
                                    <Label Grid.Column="2"
                                           Text="▶"
                                           FontSize="14"
                                           TextColor="{StaticResource Gray400}"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Logout Button -->
                <Border Margin="0,15,0,0"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF5252" Offset="0.0" />
                            <GradientStop Color="#D32F2F" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#FF5252" 
                                Offset="0,4" 
                                Radius="10" 
                                Opacity="0.3"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked" />
                    </Border.GestureRecognizers>
                    <Grid Padding="20,15" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="🚪"
                               FontSize="20"
                               VerticalOptions="Center"
                               Margin="0,0,12,0"/>
                        <Label Grid.Column="1"
                               Text="Cerrar Sesión"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               AutomationId="ButtonLogout"/>
                    </Grid>
                </Border>
            </StackLayout>
        </ScrollView>
        
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay"
              BackgroundColor="#80000000"
              IsVisible="False"
              VerticalOptions="Fill"
              HorizontalOptions="Fill"
              ZIndex="1"
              AutomationId="GridLoadingOverlay">
            <Border BackgroundColor="{StaticResource White}"
                    StrokeShape="RoundRectangle 20"
                    Padding="30,25"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" 
                            Offset="0,8" 
                            Radius="20" 
                            Opacity="0.3"/>
                </Border.Shadow>
                <StackLayout Spacing="15">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="40"
                                       HeightRequest="40"
                                       HorizontalOptions="Center"
                                       AutomationId="ActivityIndicatorLoading"/>
                    <Label Text="Cerrando sesión..."
                           FontSize="16"
                           TextColor="{StaticResource Gray700}"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
