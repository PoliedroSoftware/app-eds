<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="APP.Eds.UsesCases.Navigation.Main" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:brand="clr-namespace:APP.Eds.Controls" Title="Poliedro EDS" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
    <Grid>
        <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None" Margin="20,0">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="20" Padding="0,24,0,16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tu estación, en orden" Style="{StaticResource PoliedroPageTitle}" />
                            <Label Text="Menú Principal" AutomationId="LabelMenuPrincipal" Style="{StaticResource PoliedroBodySecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12,8" VerticalOptions="Start">
                            <HorizontalStackLayout Spacing="8">
                                <brand:PoliedroIcon Text="👤" VerticalOptions="Center" />
                                <Label x:Name="UserNameLabel" FontSize="14" MaximumWidthRequest="120" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Border IsVisible="{Binding IsIslander}" BackgroundColor="{AppThemeBinding Light={StaticResource BrandDeep}, Dark={StaticResource BrandDeepDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Cierre de turno" TextColor="{StaticResource OnBrand}" FontSize="24" FontFamily="OpenSansSemibold" />
                            <Label Text="Registra las ventas y revisa la información del turno." TextColor="{StaticResource OnBrand}" FontSize="14" />
                            <Button Text="Preparar cierre" Command="{Binding NavigateToCourtCommand}" Style="{StaticResource PoliedroPrimaryButton}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PoliedroCard}" Padding="16" Margin="0,0,0,12" AutomationId="FrameCategory">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowPopupCommand}" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" MinimumHeightRequest="48">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12" VerticalOptions="Center">
                                <brand:PoliedroIcon Text="{Binding Icon}" />
                            </Border>
                            <Label Grid.Column="1" Text="{Binding Title}" FontSize="16" FontFamily="OpenSansSemibold" VerticalOptions="Center" AutomationId="LabelCategoryTitle" />
                            <Image Grid.Column="2" Source="poliedro_arrow.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <VerticalStackLayout Spacing="12" Padding="0,8,0,24">
                    <Button Text="Cerrar sesión" Clicked="OnLogoutClicked" Style="{StaticResource PoliedroSecondaryButton}" AutomationId="ButtonLogout" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label x:Name="VersionLabel" Text="{Binding AppVersion}" Style="{StaticResource PoliedroBodySecondary}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Buscar actualizaciones" Clicked="OnUpdateClicked" Style="{StaticResource PoliedroSecondaryButton}" FontSize="14" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
        <Grid x:Name="LoadingOverlay" BackgroundColor="#80000000" IsVisible="False" AutomationId="GridLoadingOverlay">
            <Border Style="{StaticResource PoliedroCard}" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="16">
                    <ActivityIndicator IsRunning="True" AutomationId="ActivityIndicatorLoading" />
                    <Label Text="Cerrando sesión…" FontSize="16" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
