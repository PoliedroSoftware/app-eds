<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Navigation.Main"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="App EDS">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20">
                <Label  Margin="0,10,0,20" FontSize="20" HorizontalOptions="Center" Text="{Binding TranslatedMenuTitle}"
                        AutomationId="LabelMenuPrincipal" />

                <Button Text="Court"
                        Command="{Binding NavigateToCourtCommand}"
                        IsVisible="{Binding IsIslander}"
                        HeightRequest="50"
                        BackgroundColor="Purple"
                        TextColor="White"/>
                
                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="5" Padding="10"
                                   CornerRadius="10" AutomationId="FrameCategory">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowPopupCommand}" />
                                </Frame.GestureRecognizers>
                                <Label FontSize="18"
                                       HorizontalOptions="Center"
                                       Text="{Binding Title}"
                                       VerticalOptions="Center"
                                       AutomationId="LabelCategoryTitle"/>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="{Binding TranslatedLogoutButtonText}"
                        Clicked="OnLogoutClicked"
                        BackgroundColor="Red"
                        TextColor="White"
                        HeightRequest="50"
                        Margin="0,20,0,0"
                        AutomationId="ButtonLogout"/>
            </VerticalStackLayout>
        </ScrollView>
        <Grid x:Name="LoadingOverlay"
              BackgroundColor="#80000000"
              IsVisible="False"
              VerticalOptions="Fill"
              HorizontalOptions="Fill"
              ZIndex="1"
              AutomationId="GridLoadingOverlay">
            <ActivityIndicator IsRunning="True"
                               Color="Purple"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               WidthRequest="50"
                               HeightRequest="50"
                               AutomationId="ActivityIndicatorLoading"/>
        </Grid>
    </Grid>
</ContentPage>
