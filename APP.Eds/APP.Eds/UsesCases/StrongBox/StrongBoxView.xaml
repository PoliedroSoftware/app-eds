<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             x:Class="APP.Eds.UsesCases.StrongBox.StrongBoxView"
             Title="Caja Fuerte"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
            <VerticalStackLayout Spacing="0">

                <!-- Header moderno con gradiente purpura -->
                <Border StrokeShape="RoundRectangle 0,0,24,24"
                        StrokeThickness="0"
                        Padding="20,40,20,20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}">
                    <Border.Background>
                        <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                    </Border.Background>


                    <StackLayout Spacing="8">
                        <Label Text="Caja Fuerte"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnBrand}"
                               HorizontalOptions="Center"/>
                        <Label Text="Gestione el efectivo disponible de forma segura"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Contenido principal -->
                <VerticalStackLayout Padding="20,24,20,20" Spacing="20">

                    <!-- Tarjeta de saldo actual -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0"
                            Padding="24,20">


                        <VerticalStackLayout Spacing="16">
                            <!-- Header de saldo -->
                            <StackLayout Orientation="Horizontal" Spacing="12">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="40" HeightRequest="40"
                                        VerticalOptions="Center">
                                    <brand:PoliedroIcon Text="💵" FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Saldo actual:"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       VerticalOptions="Center"/>
                            </StackLayout>

                            <!-- Monto del saldo -->
                            <Label Text="{Binding CurrentBalance.Saldo, StringFormat='${0:N2}'}"
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                   HorizontalOptions="Center"
                                   Margin="0,8,0,16"/>

                            <!-- Campo de retiro -->
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Monto a retirar"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="1"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12">
                                        <Label Text="$"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center"/>
                                        <Entry Placeholder="0.00"
                                               Keyboard="Numeric"
                                               Text="{Binding WithdrawAmount, Mode=TwoWay}"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Botones de retiro -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <!-- Boton retiro normal -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="4"
                                        IsEnabled="{Binding CanWithdraw}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding CanWithdraw}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Border.Triggers>


                                    <Button Text="Retirar"
                                            Command="{Binding WithdrawCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource OnBrand}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            MinimumHeightRequest="52"/>
                                </Border>

                                <!-- Boton retirar todo -->
                                <Border Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="4"
                                        IsEnabled="{Binding CanWithdrawAll}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding CanWithdrawAll}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Border.Triggers>


                                    <Button Text="Retirar Todo"
                                            Command="{Binding WithdrawAllCommand}"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource OnBrand}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            MinimumHeightRequest="52"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Seccion de movimientos recientes -->
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <brand:PoliedroIcon Text="📋" FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Movimientos recientes"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Lista de movimientos -->
                        <CollectionView ItemsSource="{Binding Movements}"
                                        MaximumHeightRequest="400">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            StrokeThickness="1"
                                            Margin="0,0,0,12"
                                            Padding="16">


                                        <!-- Gesto tap para todos los movimientos -->
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewCourtDetailCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>

                                        <!-- Efecto visual para indicar que es clickeable -->
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="CORTE">
                                                <DataTrigger.Setters>
                                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"/>
                                                    <Setter Property="StrokeThickness" Value="2"/>
                                                </DataTrigger.Setters>
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="8" ColumnSpacing="12">

                                            <!-- Icono del tipo de movimiento -->
                                            <Border Grid.RowSpan="4" Grid.Column="0"
                                                    WidthRequest="48" HeightRequest="48"
                                                    StrokeShape="RoundRectangle 12"
                                                    VerticalOptions="Center">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="RETIRO">
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="CORTE">
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"/>
                                                    </DataTrigger>
                                                </Border.Triggers>

                                                <Label FontSize="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="RETIRO">
                                                            <Setter Property="Text" Value="💸"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="CORTE">
                                                            <Setter Property="Text" Value="💰"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>

                                            <!-- Tipo y monto -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                                <StackLayout Orientation="Horizontal" Spacing="8">
                                                    <Label Text="{Binding Type}"
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                                    <!-- Indicador visual para CORTE clickeable -->
                                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="4,2"
                                                            VerticalOptions="Center">
                                                        <Border.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="CORTE">
                                                                <Setter Property="IsVisible" Value="{Binding IdCorte, Converter={StaticResource IsNotNullConverter}}"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="RETIRO">
                                                                <Setter Property="IsVisible" Value="False"/>
                                                            </DataTrigger>
                                                        </Border.Triggers>
                                                        <Label Text="Ver detalles"
                                                               FontSize="9"
                                                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                               FontAttributes="Bold"/>
                                                    </Border>
                                                </StackLayout>

                                                <Label Text="{Binding Ammount, StringFormat='Monto: ${0:N2}'}"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                            </StackLayout>

                                            <!-- Saldo resultante -->
                                            <StackLayout Grid.Row="0" Grid.Column="2" VerticalOptions="Center">
                                                <Label Text="{Binding Saldo, StringFormat='${0:N2}'}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       HorizontalOptions="End"/>
                                            </StackLayout>

                                            <!-- Nota (si existe) -->
                                            <StackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                         IsVisible="{Binding Note, Converter={StaticResource StringNotEmptyConverter}}">
                                                <Label Text="{Binding Note, StringFormat='Nota: {0}'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       LineBreakMode="WordWrap"/>
                                            </StackLayout>

                                            <!-- ID del corte (si existe) -->
                                            <StackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                         IsVisible="{Binding IdCorte, Converter={StaticResource IsNotNullConverter}}"
                                                         Orientation="Horizontal"
                                                         Spacing="8">
                                                <brand:PoliedroIcon Text="🎯" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding IdCorte, StringFormat='ID Corte: #{0}'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>

                                            <!-- Fecha y usuario -->
                                            <StackLayout Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                         Orientation="Horizontal"
                                                         Spacing="16">
                                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                <Label Text="{Binding CreatedBy, StringFormat='Por: {0}'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <!-- Estado vacio -->
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                             Spacing="16" Padding="32">
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                            StrokeShape="RoundRectangle 16"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            Padding="32,24">
                                        <StackLayout Spacing="16" HorizontalOptions="Center">
                                            <brand:PoliedroIcon Text="📋" FontSize="48"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Label Text="No hay movimientos registrados"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Los movimientos de efectivo apareceran aqui"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </Border>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <!-- Boton cargar mas -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                Padding="4">
                            <Button Text="Cargar mas"
                                    Command="{Binding LoadMoreMovementsCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="52"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Espaciado inferior -->
                    <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              IsVisible="{Binding IsLoading}"/>
    </AbsoluteLayout>
</ContentPage>