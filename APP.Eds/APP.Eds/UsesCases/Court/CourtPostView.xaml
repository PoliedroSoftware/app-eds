<ContentPage
    x:Class="APP.Eds.UsesCases.Court.CourtPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="{Binding ShiftClosing}"
    BackgroundColor="#F8FAFC">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- Header Card with Professional Blue Gradient -->
                <Border BackgroundColor="#3B82F6" 
                        StrokeShape="RoundRectangle 16"
                        Padding="24"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#3B82F6" Offset="0,8" Radius="20" Opacity="0.15"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="🏪 Cierre De Turno" 
                               FontSize="26" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Complete la información del turno" 
                               FontSize="14" 
                               TextColor="#DBEAFE" 
                               HorizontalOptions="Center"
                               Margin="0,6,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Business Selection Card -->
                <Border x:Name="Business"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="20"
                        IsVisible="{Binding IsNotIslanderLogin}">
                    <Border.Shadow>
                        <Shadow Brush="#1E293B" Offset="0,2" Radius="12" Opacity="0.08"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="18">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#3B82F6" 
                                    StrokeShape="RoundRectangle 20" 
                                    WidthRequest="40" HeightRequest="40">
                                <Label Text="🏢" FontSize="18" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="{Binding Business}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#1E293B"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                        
                        <Grid ColumnDefinitions="100, *" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <!-- Business -->
                            <Label Text="Negocio" 
                                   FontAttributes="Bold" 
                                   TextColor="#64748B" 
                                   VerticalOptions="Center" 
                                   Grid.Row="0" Grid.Column="0"/>
                            <Border BackgroundColor="#F8FAFC" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#CBD5E1" 
                                    StrokeThickness="1"
                                    Grid.Row="0" Grid.Column="1">
                                <Picker Title="{Binding SelectaBusiness}"
                                        AutomationId="BusinessPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding BusinessList}"
                                        SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnBusinessSelected"
                                        BackgroundColor="Transparent"
                                        TextColor="#374151"
                                        Margin="12,8"/>
                            </Border>
                            
                            <!-- EDS -->
                            <Label Text="EDS" 
                                   FontAttributes="Bold" 
                                   TextColor="#64748B" 
                                   VerticalOptions="Center" 
                                   Grid.Row="1" Grid.Column="0"/>
                            <Border BackgroundColor="#F8FAFC" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#CBD5E1" 
                                    StrokeThickness="1"
                                    Grid.Row="1" Grid.Column="1">
                                <Picker Title="{Binding SelectaEds}"
                                        AutomationId="EdsPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding EdsSelectList}"
                                        SelectedItem="{Binding SelectedEds, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnEdsSelected" 
                                        IsEnabled="{Binding IsBusinessSelected}"
                                        BackgroundColor="Transparent"
                                        TextColor="#374151"
                                        Margin="12,8"/>
                            </Border>
                            
                            <!-- Islander -->
                            <Label Text="Islero" 
                                   FontAttributes="Bold" 
                                   TextColor="#64748B" 
                                   VerticalOptions="Center" 
                                   Grid.Row="2" Grid.Column="0"/>
                            <Border BackgroundColor="#F8FAFC" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#CBD5E1" 
                                    StrokeThickness="1"
                                    Grid.Row="2" Grid.Column="1">
                                <Picker Title="{Binding SelectAnIslander}"
                                        AutomationId="IslanderPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding IslanderSelectList}"
                                        SelectedItem="{Binding SelectedIslander, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnIslanderSelected"
                                        IsEnabled="{Binding IsEdsSelected}"
                                        BackgroundColor="Transparent"
                                        TextColor="#374151"
                                        Margin="12,8"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Time Card -->
                <Border x:Name="Time" 
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#1E293B" Offset="0,2" Radius="12" Opacity="0.08"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="18">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#06B6D4" 
                                    StrokeShape="RoundRectangle 20" 
                                    WidthRequest="40" HeightRequest="40">
                                <Label Text="⏰" FontSize="18" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="{Binding Time}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#1E293B"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                        
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="16" ColumnSpacing="12">
                            <!-- Date -->
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Fecha" 
                                       FontAttributes="Bold" 
                                       TextColor="#64748B" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="#F8FAFC" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#A78BFA" 
                                        StrokeThickness="1"
                                        Padding="8">
                                    <DatePicker x:Name="datePicker" 
                                                AutomationId="DatePicker" 
                                                Date="{Binding DateStarttime, Mode=TwoWay}" 
                                                MinimumDate="1900-01-01"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="#7C3AED"/>
                                </Border>
                            </StackLayout>

                            <!-- Start Time -->
                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Hora Inicio" 
                                       FontAttributes="Bold" 
                                       TextColor="#64748B" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="#F0FDF4" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#10B981" 
                                        StrokeThickness="1"
                                        Padding="8">
                                    <TimePicker AutomationId="StartTimePicker" 
                                                Time="{Binding Starttime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="#059669"/>
                                </Border>
                            </StackLayout>

                            <!-- End Time -->
                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <Label Text="Hora Fin" 
                                       FontAttributes="Bold" 
                                       TextColor="#64748B" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="#FEF2F2" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#EF4444" 
                                        StrokeThickness="1"
                                        Padding="8">
                                    <TimePicker AutomationId="EndTimePicker" 
                                                Time="{Binding Endtime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="#DC2626"/>
                                </Border>
                            </StackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Cash Count Card -->
                <Border x:Name="CashCount"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#1E293B" Offset="0,2" Radius="12" Opacity="0.08"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="18">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#10B981" 
                                    StrokeShape="RoundRectangle 20" 
                                    WidthRequest="40" HeightRequest="40">
                                <Label Text="💰" FontSize="18" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="{Binding CashCount}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#1E293B"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                        
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="16">
                            <!-- Sales in Money -->
                            <Border BackgroundColor="#F0FDF4" 
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#10B981"
                                    StrokeThickness="1"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInMoney}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#064E3B"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalAmount, StringFormat='$ {0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#10B981"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Sales in Gallons -->
                            <Border BackgroundColor="#EFF6FF" 
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#3B82F6"
                                    StrokeThickness="1"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInGallons}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#1E3A8A"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalGallons, StringFormat='{0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#3B82F6"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Expenses -->
                            <Border BackgroundColor="#FEF2F2" 
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#EF4444"
                                    StrokeThickness="1"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Expenses}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#7F1D1D"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalExpenditure, StringFormat='$ {0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#EF4444"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Collections -->
                            <Border BackgroundColor="#FEF3C7" 
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#F59E0B"
                                    StrokeThickness="1"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Collections}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#92400E"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTypeOfCollection, StringFormat='$ {0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#F59E0B"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Total and Distintic -->
                            <Border BackgroundColor="#F5F3FF" 
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#8B5CF6"
                                    StrokeThickness="1"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding TotalForTheDay}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#581C87"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalSales, StringFormat='$ {0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#8B5CF6"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="#F8FAFC" 
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#94A3B8"
                                    StrokeThickness="1"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding DistinticDescription}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#475569"
                                           HorizontalOptions="Center"/>
                                    <Border BackgroundColor="White"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            Padding="8">
                                        <Entry Keyboard="Numeric" 
                                               Placeholder="Ingrese distintivo" 
                                               Text="{Binding Distintic, Mode=TwoWay}"
                                               BackgroundColor="Transparent"
                                               TextColor="#374151"
                                               HorizontalTextAlignment="Center"/>
                                    </Border>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Sales by Hoses Section -->
                <StackLayout x:Name="AddedDispensers" IsVisible="{Binding VisibleDispenser}">
                    <Border BackgroundColor="#F0FDF4" 
                            StrokeShape="RoundRectangle 10"
                            Stroke="#10B981"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                            <Label Text="⛽" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Ventas por mangueras" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#059669"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDispensers}" x:Name="CourtDispensers">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" 
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="#1E293B" Offset="0,2" Radius="8" Opacity="0.06"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="🔧" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Manguera #" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center"/>
                                            <Label Text="{Binding NumberName}" FontAttributes="Bold" TextColor="#3B82F6" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Money Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Monto acumulado" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedAmount, StringFormat='$ {0:N3}'}" 
                                                       FontSize="14" TextColor="#10B981" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en dinero" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                                <Label Text="{Binding AmountDifferenceResult, StringFormat='$ {0:N3}'}" 
                                                       FontSize="14" TextColor="#3B82F6" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Gallons Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="2" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Galones acumulados" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedGallons, StringFormat='{0:N3}'}" 
                                                       FontSize="14" TextColor="#F59E0B" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en galones" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                                <Label Text="{Binding GallonsDifferenceResult, StringFormat='{0:N3}'}" 
                                                       FontSize="14" TextColor="#8B5CF6" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FEF2F2" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#EF4444"
                                                StrokeThickness="1"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="5"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteDispenserButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#EF4444"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCollectionCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Collections Section -->
                <StackLayout x:Name="TypesofAggregateCollections" IsVisible="{Binding VisibleReceipts}">
                    <Border BackgroundColor="#EFF6FF" 
                            StrokeShape="RoundRectangle 10"
                            Stroke="#3B82F6"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                            <Label Text="💳" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Formas de pago" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#1D4ED8"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtTypeOfCollections}" x:Name="CourtTypeOfCollections">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" 
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="#1E293B" Offset="0,2" Radius="8" Opacity="0.06"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="💰" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de cobro" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Método" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                                <Label Text="{Binding TypeOfCollectionName}" 
                                                       FontSize="14" TextColor="#3B82F6" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, StringFormat='$ {0:N3}'}" 
                                                       FontSize="14" TextColor="#10B981" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}" 
                                                   FontSize="13" TextColor="#94A3B8"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FEF2F2" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#EF4444"
                                                StrokeThickness="1"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteCollectionButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#EF4444"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCollectionCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Documents Section -->
                <StackLayout x:Name="AddedDocuments" IsVisible="{Binding VisibleDocuments}">
                    <Border BackgroundColor="#FEF3C7" 
                            StrokeShape="RoundRectangle 10"
                            Stroke="#F59E0B"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                            <Label Text="📄" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Comprobantes" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#D97706"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDocuments}" x:Name="CourtDocuments">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" 
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="#1E293B" Offset="0,2" Radius="8" Opacity="0.06"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="8">
                                        <!-- Document Info -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="📎" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Comprobante" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center"/>
                                            <Label Text="{Binding DocumentName}" 
                                                   FontSize="14" TextColor="#F59E0B" FontAttributes="Bold" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FEF2F2" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#EF4444"
                                                StrokeThickness="1"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.Row="0"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteDocumentButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#EF4444"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDocumentCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Expenses Section -->
                <StackLayout x:Name="AddedExpenses" IsVisible="{Binding VisibleExpenses}">
                    <Border BackgroundColor="#FEF2F2" 
                            StrokeShape="RoundRectangle 10"
                            Stroke="#EF4444"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                            <Label Text="💸" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Gastos" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#DC2626"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtExpenditures}" x:Name="CourtExpenditures">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" 
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="#1E293B" Offset="0,2" Radius="8" Opacity="0.06"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="🏪" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de gasto" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Tipo" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                                <Label Text="{Binding ExpenditureName}" 
                                                       FontSize="14" TextColor="#EF4444" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, StringFormat='$ {0:N3}'}" 
                                                       FontSize="14" TextColor="#DC2626" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}" 
                                                   FontSize="13" TextColor="#94A3B8"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FEF2F2" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#EF4444"
                                                StrokeThickness="1"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteExpenseButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#EF4444"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteExpenseCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Main Action Buttons Section -->
                <VerticalStackLayout Spacing="16" x:Name="Button" Margin="0,0,0,110">
                    
                    <!-- Required Actions Card -->
                    <Border BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Stroke="#FEE2E2"
                            StrokeThickness="1"
                            Padding="20"
                            Margin="0,8">
                        <Border.Shadow>
                            <Shadow Brush="#EF4444" Offset="0,4" Radius="12" Opacity="0.08"/>
                        </Border.Shadow>
                        
                        <VerticalStackLayout Spacing="16">
                            <!-- Header -->
                            <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                                <Border BackgroundColor="#EF4444" 
                                        StrokeShape="RoundRectangle 20" 
                                        WidthRequest="40" HeightRequest="40">
                                    <Label Text="⚠️" FontSize="18" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"
                                           TextColor="White"/>
                                </Border>
                                <Label Text="Acciones Obligatorias"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#DC2626"
                                       VerticalOptions="Center"/>
                            </StackLayout>
                            
                            <!-- Required Buttons Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        BackgroundColor="#10B981"
                                        StrokeShape="RoundRectangle 12"
                                        HeightRequest="48">
                                    <Border.Shadow>
                                        <Shadow Brush="#10B981" Offset="0,2" Radius="8" Opacity="0.2"/>
                                    </Border.Shadow>
                                    <Button Text="{Binding NewSale}"
                                            BackgroundColor="Transparent"
                                            TextColor="White"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            Clicked="OpenDispenserPopUp"
                                            Command="{Binding OpenDispenserCommand}"
                                            AutomationId="AddSaleButton"
                                            IsEnabled="{Binding NewSaleEnabled}"
                                            HeightRequest="48"/>
                                </Border>
                                
                                <Border Grid.Column="1"
                                        BackgroundColor="#3B82F6"
                                        StrokeShape="RoundRectangle 12"
                                        HeightRequest="48">
                                    <Border.Shadow>
                                        <Shadow Brush="#3B82F6" Offset="0,2" Radius="8" Opacity="0.2"/>
                                    </Border.Shadow>
                                    <Button Text="{Binding AddCollectionType}"
                                            BackgroundColor="Transparent"
                                            TextColor="White"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            Clicked="OpenTypeOfCollectionPopUp"
                                            AutomationId="AddCollectionTypeButton"
                                            IsEnabled="{Binding IsEdsSelected}"
                                            HeightRequest="48"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Primary Send Button -->
                    <Border BackgroundColor="#10B981"
                            StrokeShape="RoundRectangle 16"
                            Padding="4"
                            Margin="0,8">
                        <Border.Shadow>
                            <Shadow Brush="#10B981" Offset="0,6" Radius="16" Opacity="0.25"/>
                        </Border.Shadow>
                        
                        <Button x:Name="SendData" 
                                AutomationId="SendDataButton"
                                Text="{Binding SendData}"
                                TextColor="White" 
                                BackgroundColor="Transparent"
                                Clicked="Button_Clicked"
                                FontSize="20"
                                FontAttributes="Bold"
                                HeightRequest="60"
                                CornerRadius="12">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsTotalSalesValid}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="TextColor" Value="#9CA3AF" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Professional Bottom Navigation Menu -->
        <Border BackgroundColor="White"
                StrokeShape="RoundRectangle 20,20,0,0"
                Stroke="#F1F5F9"
                StrokeThickness="1"
                AbsoluteLayout.LayoutBounds="0,1,1,95"
                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">
            <Border.Shadow>
                <Shadow Brush="#1E293B" Offset="0,-4" Radius="20" Opacity="0.08"/>
            </Border.Shadow>
            
            <Grid ColumnDefinitions="*,*,*,*" Padding="12,16,12,24" RowDefinitions="Auto,Auto">
                
                <!-- Upload Document Button -->
                <Grid Grid.Column="0" x:Name="DocumentButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDocumentTapped"/>
                    </Grid.GestureRecognizers>
                    
                    <!-- Background Circle -->
                    <Border BackgroundColor="#FEF3C7" 
                            StrokeShape="RoundRectangle 26"
                            WidthRequest="52" HeightRequest="52"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            x:Name="DocumentCircle">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveNavItem}" Value="Document">
                                <Setter Property="BackgroundColor" Value="#F59E0B"/>
                                <Setter Property="Scale" Value="1.1"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                    
                    <!-- Content -->
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📄" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Docs" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#D97706"
                               x:Name="DocumentLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Document">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                </Grid>

                <!-- Add Expense Button -->
                <Grid Grid.Column="1" x:Name="ExpenseButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExpenseTapped"/>
                    </Grid.GestureRecognizers>
                    
                    <!-- Background Circle -->
                    <Border BackgroundColor="#FEF2F2" 
                            StrokeShape="RoundRectangle 26"
                            WidthRequest="52" HeightRequest="52"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            x:Name="ExpenseCircle">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveNavItem}" Value="Expense">
                                <Setter Property="BackgroundColor" Value="#EF4444"/>
                                <Setter Property="Scale" Value="1.1"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                    
                    <!-- Content -->
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="💸" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Gastos" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#DC2626"
                               x:Name="ExpenseLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Expense">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                </Grid>

                <!-- Additional Info Button -->
                <Grid Grid.Column="2" x:Name="InfoButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInfoTapped"/>
                    </Grid.GestureRecognizers>
                    
                    <!-- Background Circle -->
                    <Border BackgroundColor="#F5F3FF" 
                            StrokeShape="RoundRectangle 26"
                            WidthRequest="52" HeightRequest="52"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveNavItem}" Value="Info">
                                <Setter Property="BackgroundColor" Value="#8B5CF6"/>
                                <Setter Property="Scale" Value="1.1"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                    
                    <!-- Content -->
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="💬" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Info" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#7C3AED"
                               x:Name="InfoLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Info">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                </Grid>

                <!-- History/List Button -->
                <Grid Grid.Column="3" x:Name="HistoryButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                    </Grid.GestureRecognizers>
                    
                    <!-- Background Circle -->
                    <Border BackgroundColor="#F0FDF4" 
                            StrokeShape="RoundRectangle 26"
                            WidthRequest="52" HeightRequest="52"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveNavItem}" Value="History">
                                <Setter Property="BackgroundColor" Value="#10B981"/>
                                <Setter Property="Scale" Value="1.1"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                    
                    <!-- Content -->
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📜" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Lista" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#059669"
                               x:Name="HistoryLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="History">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                </Grid>
                
                <!-- Clean Sliding Indicator -->
                <Border x:Name="SlidingBackground"
                        BackgroundColor="#64748B"
                        StrokeShape="RoundRectangle 26"
                        WidthRequest="56"
                        HeightRequest="56"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Opacity="0.12"
                        Grid.RowSpan="2"/>
            </Grid>
        </Border>

        <!-- Additional Info Display -->
        <Border x:Name="AdditionalInfo"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 12"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                Padding="16"
                Margin="16"
                IsVisible="{Binding AdditionalInfoEnabled}"
                AbsoluteLayout.LayoutBounds="0,1,1,100"
                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">
            <Border.Shadow>
                <Shadow Brush="#3B82F6" Offset="0,2" Radius="8" Opacity="0.1"/>
            </Border.Shadow>
            <Label Text="{Binding AdditionalInfoDescription, Mode=TwoWay}" 
                   TextColor="#374151"
                   FontSize="14"/>
        </Border>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>