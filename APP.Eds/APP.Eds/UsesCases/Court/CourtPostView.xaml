<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Court.CourtPostView"
    x:Name="CortePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:services="clr-namespace:APP.Eds.Services.RegisterShift"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:converters="clr-namespace:APP.Eds.Converters"
    Title="{Binding ShiftClosing}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DecimalFormatConverter x:Key="DecimalFormat" />
            <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:NumberToWordsConverter x:Key="NumberToWordsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header Card with Purple Gradient -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">

                    <StackLayout>
                        <Label Text="Cierre De Turno"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Start"/>
                        <Label Text="Complete la información del turno"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalOptions="Start"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Business Selection Card -->
                <Border x:Name="Business"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                        StrokeThickness="1"
                        Padding="20"
                        IsVisible="{Binding IsNotIslanderLogin}">

                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="🏢" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding Business}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <brand:ResponsiveFormGrid ColumnDefinitions="100, *" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <!-- Business -->
                            <Label Text="Negocio"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center"
                                   Grid.Row="0" Grid.Column="0"/>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                    Grid.Row="0" Grid.Column="1">
                                <Picker Title="{Binding SelectaBusiness}"
                                        AutomationId="BusinessPicker"
                                        ItemDisplayBinding="{Binding Name}"
                                        ItemsSource="{Binding BusinessList}"
                                        SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}"
                                        SelectedIndexChanged="OnBusinessSelected"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>

                            <!-- EDS -->
                            <Label
                                   Text="EDS"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center"
                                   Grid.Row="1" Grid.Column="0"/>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                    Grid.Row="1" Grid.Column="1">
                                <Picker Title="{Binding SelectaEds}"
                                        AutomationId="EdsPicker"
                                        ItemDisplayBinding="{Binding Name}"
                                        ItemsSource="{Binding EdsSelectList}"
                                        SelectedItem="{Binding SelectedEds, Mode=TwoWay}"
                                        SelectedIndexChanged="OnEdsSelected"
                                        IsEnabled="{Binding IsBusinessSelected}"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>

                            <!-- Islander -->
                            <Label Text="Islero"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalOptions="Center"
                                   Grid.Row="2" Grid.Column="0"/>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                    Grid.Row="2" Grid.Column="1">
                                <Picker Title="{Binding SelectAnIslander}"
                                        AutomationId="IslanderPicker"
                                        ItemDisplayBinding="{Binding Name}"
                                        ItemsSource="{Binding IslanderSelectList}"
                                        SelectedItem="{Binding SelectedIslander, Mode=TwoWay}"
                                        SelectedIndexChanged="OnIslanderSelected"
                                        IsEnabled="{Binding IsEdsSelected}"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>
                        </brand:ResponsiveFormGrid>
                    </VerticalStackLayout>
                </Border>

                <!-- Time Card -->
                <Border x:Name="Time"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                        StrokeThickness="1"
                        Padding="20">

                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="⏰" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding Time}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                        <!-- Selector de EDS (solo User y si tiene >1) -->
                        <Border x:Name="EdsUser"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                Padding="12,0">
                            <VerticalStackLayout Spacing="6">
                                    <Label Text="Selecciona EDS"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                <Picker Title="Seleccione EDS"
                                            ItemDisplayBinding="{Binding Name}"
                                            AutomationId="EdsUserPicker"
                                            ItemsSource="{Binding Source={x:Static services:RegisterShiftUserService.Instance}, Path=UserEds}"
                                            SelectedItem="{Binding Source={x:Static services:RegisterShiftUserService.Instance}, Path=SelectedUserEds, Mode=TwoWay}"
                                            SelectedIndexChanged="OnEdsUserSelected"
                                            BackgroundColor="Transparent"
                                            Margin="12,8"/>
                                <!--IsEnabled="{Binding Source={x:Reference CortePage}, Path=IsRegisterShiftChecked}"/> -->
                            </VerticalStackLayout>
                        </Border>

                        <!--Texto informativo cuando solo hay 1 EDS
                        <StackLayout IsVisible="{Binding Source={x:Reference CortePage}, Path=BindingContext.ShowEdsPicker, Converter={StaticResource InverseBoolConverter}}">
                            <Label Text="{Binding Source={x:Reference CortePage}, Path=BindingContext.EdsName}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   FontAttributes="Italic"/>
                        </StackLayout>-->

                        <brand:ResponsiveFormGrid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="16" ColumnSpacing="12">
                            <!-- Date -->
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Fecha"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <DatePicker x:Name="datePicker"
                                                AutomationId="DatePicker"
                                                Date="{Binding DateStarttime, Mode=TwoWay}"
                                                MinimumDate="1900-01-01"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"/>
                                </Border>
                                <!-- Checkbox para registrar turno sin ventas -->
                                <StackLayout Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                    <CheckBox x:Name="RegisterShiftCheck"
                                              IsChecked="{Binding Source={x:Reference CortePage}, Path=IsRegisterShiftChecked, Mode=TwoWay}"
                                              Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                              CheckedChanged="OnRegisterShiftCheckChanged"/>
                                    <Label Text="Registrar turno sin ventas"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           VerticalTextAlignment="Center"/>
                                </StackLayout>

                            </StackLayout>

                            <!-- Start Time -->
                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Hora Inicio"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <TimePicker AutomationId="StartTimePicker"
                                                Time="{Binding Starttime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- End Time -->
                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <Label Text="Hora Fin"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <TimePicker AutomationId="EndTimePicker"
                                                Time="{Binding Endtime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"/>
                                </Border>
                            </StackLayout>
                        </brand:ResponsiveFormGrid>
                    </VerticalStackLayout>
                </Border>

                <!-- Cash Count Card -->
                <Border x:Name="CashCount"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                        StrokeThickness="1"
                        Padding="20"
                        IsVisible="{Binding ShouldShowCashCountSection}">

                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="💰" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding CashCount}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <brand:ResponsiveFormGrid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="16">
                            <!-- Sales in Money -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInMoney}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalAmount, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="34"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Sales in Gallons -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInGallons}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalGallons, Converter={StaticResource DecimalFormat}}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Expenses -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Expenses}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalExpenditure, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Collections -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Collections}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTypeOfCollection, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Total and Distintic -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding TotalForTheDay}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalSales, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding DistinticDescription}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"/>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                            Padding="12,0">
                                        <Entry Keyboard="Numeric"
                                               Placeholder="Ingrese distintivo"
                                               Text="{Binding Distintic, Mode=TwoWay}"
                                               BackgroundColor="Transparent"
                                               HorizontalTextAlignment="Center"/>
                                    </Border>
                                </StackLayout>
                            </Border>
                        </brand:ResponsiveFormGrid>
                    </VerticalStackLayout>
                </Border>

                <!-- Sales by Hoses Section -->
                <StackLayout x:Name="AddedDispensers"
                             IsVisible="{Binding ShouldShowDispensersSection}"
                             IsEnabled="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}">
                    <StackLayout.Triggers>
                        <!-- Ocultar después del envío -->
                        <DataTrigger TargetType="StackLayout"
                                     Binding="{Binding Source={x:Reference CortePage}, Path=SeccionesVisibles}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <brand:PoliedroIcon Text="⛽" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Ventas por mangueras"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDispensers}" x:Name="CourtDispensers">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                        Margin="0,4"
                                        Padding="16">

                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <brand:PoliedroIcon Text="🔧" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Manguera #" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center"/>
                                            <Label Text="{Binding NumberName}" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Money Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Monto acumulado" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedAmount, Converter={StaticResource CurrencyFormat}}"
                                                       FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en dinero" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding AmountDifferenceResult, Converter={StaticResource CurrencyFormat}}"
                                                       FontSize="14" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Gallons Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="2" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Galones acumulados" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedGallons, Converter={StaticResource DecimalFormat}}"
                                                       FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en galones" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding GallonsDifferenceResult, Converter={StaticResource DecimalFormat}}"
                                                       FontSize="14" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                WidthRequest="40" MinimumHeightRequest="52"
                                                Grid.Column="1" Grid.RowSpan="5"
                                                VerticalOptions="Center">
                                            <Button Text="✕"
                                                    AutomationId="DeleteDispenserButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" MinimumHeightRequest="52"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDispenserCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Collections Section (Formas de pago) -->
                <StackLayout x:Name="TypesofAggregateCollections"
                             IsVisible="{Binding ShouldShowPaymentMethodsSection}"
                             IsEnabled="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}">
                    <StackLayout.Triggers>
                        <DataTrigger TargetType="StackLayout"
                                     Binding="{Binding Source={x:Reference CortePage}, Path=SeccionesVisibles}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <brand:PoliedroIcon Text="💳" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Formas de pago"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtTypeOfCollections}" x:Name="CourtTypeOfCollections">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                        Margin="0,4"
                                        Padding="16">

                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <brand:PoliedroIcon Text="💰" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de cobro" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Método" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding TypeOfCollectionName}"
                                                       FontSize="14" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, Converter={StaticResource CurrencyFormat}}"
                                                       FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, Converter={StaticResource NumberToWordsConverter}}"
                                                       FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Italic"
                                                       LineBreakMode="WordWrap"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}"
                                                   FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                WidthRequest="40" MinimumHeightRequest="52"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕"
                                                    AutomationId="DeleteCollectionButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" MinimumHeightRequest="52"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCollectionCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Documents Section (no se oculta por la tarea) -->
                <StackLayout x:Name="AddedDocuments" IsVisible="{Binding VisibleDocuments}">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                            Padding="12"
                            Margin="0,0,0,8"
                            IsVisible="{Binding CourtDocuments, Converter={StaticResource CountToBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Start" Grid.Column="0">
                                <brand:PoliedroIcon Text="📄" FontSize="18" VerticalOptions="Center"/>
                                <Label Text="Comprobantes"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                       VerticalOptions="Center"/>
                            </StackLayout>

                            <Button Grid.Column="1"
                                    Text="Eliminar todos"
                                    Padding="10,6"
                                    CornerRadius="12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                    FontSize="12"
                                    Clicked="OnRemoveAllDocumentsClicked"
                                    IsVisible="{Binding CourtDocuments, Converter={StaticResource CountToBoolConverter}}"/>
                        </Grid>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDocuments}" x:Name="CourtDocuments">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                        Margin="0,4"
                                        Padding="16">

                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="8">
                                        <!-- Document Info -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <brand:PoliedroIcon Text="📎" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Comprobante" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center"/>
                                            <Label Text="{Binding DocumentName}"
                                                   FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" FontAttributes="Bold" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                WidthRequest="40" MinimumHeightRequest="52"
                                                Grid.Column="1" Grid.Row="0"
                                                VerticalOptions="Center">
                                            <Button Text="✕"
                                                    AutomationId="DeleteDocumentButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" MinimumHeightRequest="52"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDocumentCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Expenses Section -->
                <StackLayout x:Name="AddedExpenses"
                             IsVisible="{Binding VisibleExpenses}"
                             IsEnabled="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}">
                    <StackLayout.Triggers>
                        <!-- Ocultar después del envío -->
                        <DataTrigger TargetType="StackLayout"
                                     Binding="{Binding Source={x:Reference CortePage}, Path=SeccionesVisibles}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                            Padding="16"
                            Margin="0,0,0,8"
                            IsVisible="{Binding CourtExpenditures, Converter={StaticResource CountToBoolConverter}}">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <brand:PoliedroIcon Text="💸" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Gastos"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtExpenditures}" x:Name="CourtExpenditures">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                        Margin="0,4"
                                        Padding="16">

                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <brand:PoliedroIcon Text="🏪" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de gasto" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Tipo" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding ExpenditureName}"
                                                       FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, Converter={StaticResource CurrencyFormat}}"
                                                       FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}"
                                                   FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                WidthRequest="40" MinimumHeightRequest="52"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕"
                                                    AutomationId="DeleteExpenseButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" MinimumHeightRequest="52"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteExpenseCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Main Action Buttons Section -->
                <VerticalStackLayout Spacing="16" x:Name="Button" Margin="0,0,0,20">

                    <!-- Required Actions Card -->
                    <Border Style="{StaticResource RequiredActionsCardStyle}"
                            Margin="0,8">

                        <VerticalStackLayout Spacing="16">
                            <!-- Header -->
                            <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                                <brand:PoliedroIcon Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                                <Label Text="Acciones Obligatorias"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                       VerticalOptions="Center"/>
                            </StackLayout>

                            <!-- Required Buttons Grid -->

                            <!-- Required Buttons Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                                <!-- Botón NewSale -->
                                <Button Text="{Binding NewSale}"
                                    Clicked="OpenDispenserPopUp"
                                    AutomationId="AddSaleButton"
                                    Grid.Column="0"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Padding="16,12"
                                    CornerRadius="12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    TextColor="{StaticResource OnBrand}">
                                    <Button.Triggers>
                                        <!-- ✅ Trigger para cuando está deshabilitado -->
                                        <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference CortePage}, Path=CanAccessFunctionality}"
                                                 Value="False">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"/>
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                        <!-- Trigger para cuando se envió el corte -->
                                        <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference CortePage}, Path=AccionesHabilitadas}"
                                                 Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"/>
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                                <!-- Botón AddCollectionType -->
                                <Button Text="{Binding AddCollectionType}"
                                    Clicked="OpenTypeOfCollectionPopUp"
                                    AutomationId="AddCollectionTypeButton"
                                    Grid.Column="1"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Padding="16,12"
                                    CornerRadius="12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    TextColor="{StaticResource OnBrand}">
                                    <Button.Triggers>
                                        <!-- ✅ Trigger para cuando está deshabilitado -->
                                        <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference CortePage}, Path=CanAccessFunctionality}"
                                                 Value="False">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"/>
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                        <!-- Trigger para cuando se envió el corte -->
                                        <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference CortePage}, Path=AccionesHabilitadas}"
                                                 Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"/>
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                            </Grid>


                        </VerticalStackLayout>
                    </Border>

                    <!-- Primary Send Button - Destacado -->
                    <Border Style="{StaticResource PrimarySendButtonStyle}"
                            Margin="0,8">

                        <Button x:Name="SendData"
                                AutomationId="SendDataButton"
                                Text="{Binding SendData}"
                                TextColor="{StaticResource OnBrand}"
                                BackgroundColor="Transparent"
                                Clicked="Button_Clicked"
                                FontSize="22"
                                FontAttributes="Bold"
                                HeightRequest="64"
                                CornerRadius="16">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsTotalSalesValid}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}" />
                                </DataTrigger>
                                <!-- Deshabilitar tras enviar -->
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}"
                                             Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Enhanced Bottom Navigation Menu -->
        <Border x:Name="BottomNavContainer"
                Style="{StaticResource EnhancedBottomNavContainerStyle}"
                Grid.Row="1">

            <Grid ColumnDefinitions="*,*,*,*" Padding="8,12" RowDefinitions="Auto,Auto">
                <!-- (sin cambios, el bloqueo lo hace el code-behind) -->

                <!-- Upload Document Button -->
                <Grid Grid.Column="0" x:Name="DocumentButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDocumentTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                             Style="{StaticResource NavCircleIndicatorStyle}"
                             x:Name="DocumentCircle">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Document">
                                <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"/>
                                <Setter Property="Scale" Value="1"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <brand:PoliedroIcon Text="📄" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Comprobantes"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                               x:Name="DocumentLabel" HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Document">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                             Style="{StaticResource NavDotIndicatorStyle}"
                             x:Name="DocumentDot">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Document">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- Add Expense Button -->
                <Grid Grid.Column="1" x:Name="ExpenseButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExpenseTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                             Style="{StaticResource NavCircleIndicatorStyle}"
                             x:Name="ExpenseCircle">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Expense">
                                <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"/>
                                <Setter Property="Scale" Value="1"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <brand:PoliedroIcon Text="💸" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Gastos"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                               x:Name="ExpenseLabel" HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Expense">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Expense">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- Additional Info Button -->
                <Grid Grid.Column="2" x:Name="InfoButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInfoTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                             Style="{StaticResource NavCircleIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Info">
                                <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"/>
                                <Setter Property="Scale" Value="1"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <brand:PoliedroIcon Text="💬" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Observaciones"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                               x:Name="InfoLabel" HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Info">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Info">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- History/List Button -->
                <Grid Grid.Column="3" x:Name="HistoryButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                             Style="{StaticResource NavCircleIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="History">
                                <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"/>
                                <Setter Property="Scale" Value="1"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <brand:PoliedroIcon Text="📜" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Cierres"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                               x:Name="HistoryLabel" HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="History">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="History">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>


            </Grid>
        </Border>



        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              Grid.RowSpan="2"/>
    </Grid>
</ContentPage>
