<ContentPage
    x:Class="APP.Eds.UsesCases.Court.CourtPostView"
    x:Name="CortePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:converters="clr-namespace:APP.Eds.Converters"
    Title="{Binding ShiftClosing}"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DecimalFormatConverter x:Key="DecimalFormat" />
            <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:NumberToWordsConverter x:Key="NumberToWordsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Header Card with Purple Gradient -->
                <Border BackgroundColor="#6A1B9A" 
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#6A1B9A" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="🏪 Cierre De Turno" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Complete la información del turno" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Business Selection Card -->
                <Border x:Name="Business"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3D3D3D}"
                        StrokeThickness="1"
                        Padding="20"
                        IsVisible="{Binding IsNotIslanderLogin}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="🏢" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding Business}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <Grid ColumnDefinitions="100, *" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <!-- Business -->
                            <Label Text="Negocio" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                   VerticalOptions="Center" 
                                   Grid.Row="0" Grid.Column="0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}" 
                                    Grid.Row="0" Grid.Column="1">
                                <Picker Title="{Binding SelectaBusiness}"
                                        AutomationId="BusinessPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding BusinessList}"
                                        SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnBusinessSelected"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>

                            <!-- EDS -->
                            <Label Text="EDS" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                   VerticalOptions="Center" 
                                   Grid.Row="1" Grid.Column="0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}" 
                                    Grid.Row="1" Grid.Column="1">
                                <Picker Title="{Binding SelectaEds}"
                                        AutomationId="EdsPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding EdsSelectList}"
                                        SelectedItem="{Binding SelectedEds, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnEdsSelected" 
                                        IsEnabled="{Binding IsBusinessSelected}"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>

                            <!-- Islander -->
                            <Label Text="Islero" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                   VerticalOptions="Center" 
                                   Grid.Row="2" Grid.Column="0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}" 
                                    Grid.Row="2" Grid.Column="1">
                                <Picker Title="{Binding SelectAnIslander}"
                                        AutomationId="IslanderPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding IslanderSelectList}"
                                        SelectedItem="{Binding SelectedIslander, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnIslanderSelected"
                                        IsEnabled="{Binding IsEdsSelected}"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Time Card -->
                <Border x:Name="Time" 
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3D3D3D}"
                        StrokeThickness="1"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="⏰" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding Time}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="16" ColumnSpacing="12">
                            <!-- Date -->
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Fecha" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="#FFF3CD" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#F39C12" 
                                        Padding="8">
                                    <DatePicker x:Name="datePicker" 
                                                AutomationId="DatePicker" 
                                                Date="{Binding DateStarttime, Mode=TwoWay}" 
                                                MinimumDate="1900-01-01"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="#E67E22"/>
                                </Border>
                            </StackLayout>

                            <!-- Start Time -->
                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Hora Inicio" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="#D4EDDA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#27AE60" 
                                        Padding="8">
                                    <TimePicker AutomationId="StartTimePicker" 
                                                Time="{Binding Starttime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="#27AE60"/>
                                </Border>
                            </StackLayout>

                            <!-- End Time -->
                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <Label Text="Hora Fin" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="#F8D7DA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#E74C3C" 
                                        Padding="8">
                                    <TimePicker AutomationId="EndTimePicker" 
                                                Time="{Binding Endtime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="#E74C3C"/>
                                </Border>
                            </StackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Cash Count Card -->
                <Border x:Name="CashCount"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3D3D3D}"
                        StrokeThickness="1"
                        Padding="20"
                        IsVisible="{Binding ShouldShowCashCountSection}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="💰" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding CashCount}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="16">
                            <!-- Sales in Money -->
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#4CAF50"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInMoney}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#2E7D32"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalAmount, Converter={StaticResource CurrencyFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#1B5E20"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Sales in Gallons -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#2196F3"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInGallons}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#1976D2"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalGallons, Converter={StaticResource DecimalFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#0D47A1"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Expenses -->
                            <Border BackgroundColor="#FFEBEE" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#F44336"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Expenses}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#D32F2F"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalExpenditure, Converter={StaticResource CurrencyFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#B71C1C"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Collections -->
                            <Border BackgroundColor="#FFF3E0" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#FF9800"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Collections}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#F57C00"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTypeOfCollection, Converter={StaticResource CurrencyFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#E65100"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Total and Distintic -->
                            <Border BackgroundColor="#F3E5F5" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#9C27B0"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding TotalForTheDay}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#7B1FA2"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalSales, Converter={StaticResource CurrencyFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#4A148C"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#9E9E9E, Dark=#3D3D3D}"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding DistinticDescription}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#616161, Dark=#B8B8B8}"
                                           HorizontalOptions="Center"/>
                                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2C}"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="{AppThemeBinding Light=#BDBDBD, Dark=#3D3D3D}"
                                            Padding="8">
                                        <Entry Keyboard="Numeric" 
                                               Placeholder="Ingrese distintivo" 
                                               Text="{Binding Distintic, Mode=TwoWay}"
                                               BackgroundColor="Transparent"
                                               HorizontalTextAlignment="Center"/>
                                    </Border>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Sales by Hoses Section -->
                <StackLayout x:Name="AddedDispensers"
                             IsVisible="{Binding ShouldShowDispensersSection}"
                             IsEnabled="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}">
                    <StackLayout.Triggers>
                        <!-- Ocultar después del envío -->
                        <DataTrigger TargetType="StackLayout"
                                     Binding="{Binding Source={x:Reference CortePage}, Path=SeccionesVisibles}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <Border BackgroundColor="#E8F5E8" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="#4CAF50"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="⛽" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Ventas por mangueras" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#2E7D32"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDispensers}" x:Name="CourtDispensers">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="🔧" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Manguera #" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}" VerticalOptions="Center"/>
                                            <Label Text="{Binding NumberName}" FontAttributes="Bold" TextColor="#1976D2" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Money Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Monto acumulado" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedAmount, Converter={StaticResource CurrencyFormat}}" 
                                                       FontSize="14" TextColor="#4CAF50" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en dinero" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                <Label Text="{Binding AmountDifferenceResult, Converter={StaticResource CurrencyFormat}}" 
                                                       FontSize="14" TextColor="#2196F3" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Gallons Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="2" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Galones acumulados" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedGallons, Converter={StaticResource DecimalFormat}}" 
                                                       FontSize="14" TextColor="#FF9800" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en galones" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                <Label Text="{Binding GallonsDifferenceResult, Converter={StaticResource DecimalFormat}}" 
                                                       FontSize="14" TextColor="#9C27B0" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FFEBEE" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#F44336"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="5"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteDispenserButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#F44336"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDispenserCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Collections Section (Formas de pago) -->
                <StackLayout x:Name="TypesofAggregateCollections"
                             IsVisible="{Binding ShouldShowPaymentMethodsSection}"
                             IsEnabled="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}">
                    <StackLayout.Triggers>
                        <DataTrigger TargetType="StackLayout"
                                     Binding="{Binding Source={x:Reference CortePage}, Path=SeccionesVisibles}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <Border BackgroundColor="#E3F2FD" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="#2196F3"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="💳" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Formas de pago" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#1976D2"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtTypeOfCollections}" x:Name="CourtTypeOfCollections">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="💰" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de cobro" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Método" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                <Label Text="{Binding TypeOfCollectionName}" 
                                                       FontSize="14" TextColor="#2196F3" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, Converter={StaticResource CurrencyFormat}}" 
                                                       FontSize="14" TextColor="#4CAF50" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, Converter={StaticResource NumberToWordsConverter}}" 
                                                       FontSize="10" TextColor="{AppThemeBinding Light=#666666, Dark=#B8B8B8}" FontAttributes="Italic"
                                                       LineBreakMode="WordWrap"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}" 
                                                   FontSize="13" TextColor="{AppThemeBinding Light=#757575, Dark=#B8B8B8}"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FFEBEE" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#F44336"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteCollectionButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#F44336"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCollectionCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Documents Section (no se oculta por la tarea) -->
                <StackLayout x:Name="AddedDocuments" IsVisible="{Binding VisibleDocuments}">
                    <Border BackgroundColor="#FFF3E0" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="#FF9800"
                            Padding="12"
                            Margin="0,0,0,8"
                            IsVisible="{Binding CourtDocuments, Converter={StaticResource CountToBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Start" Grid.Column="0">
                                <Label Text="📄" FontSize="18" VerticalOptions="Center"/>
                                <Label Text="Comprobantes" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       TextColor="#F57C00"
                                       VerticalOptions="Center"/>
                            </StackLayout>

                            <Button Grid.Column="1"
                                    Text="Eliminar todos"
                                    Padding="10,6"
                                    CornerRadius="12"
                                    BackgroundColor="#FFEBEE"
                                    TextColor="#C62828"
                                    FontSize="12"
                                    Clicked="OnRemoveAllDocumentsClicked"
                                    IsVisible="{Binding CourtDocuments, Converter={StaticResource CountToBoolConverter}}"/>
                        </Grid>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDocuments}" x:Name="CourtDocuments">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="8">
                                        <!-- Document Info -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="📎" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Comprobante" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}" VerticalOptions="Center"/>
                                            <Label Text="{Binding DocumentName}" 
                                                   FontSize="14" TextColor="#FF9800" FontAttributes="Bold" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FFEBEE" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#F44336"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.Row="0"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteDocumentButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#F44336"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDocumentCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Expenses Section -->
                <StackLayout x:Name="AddedExpenses"
                             IsVisible="{Binding VisibleExpenses}"
                             IsEnabled="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}">
                    <StackLayout.Triggers>
                        <!-- Ocultar después del envío -->
                        <DataTrigger TargetType="StackLayout"
                                     Binding="{Binding Source={x:Reference CortePage}, Path=SeccionesVisibles}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <Border BackgroundColor="#FFEBEE" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="#F44336"
                            Padding="16"
                            Margin="0,0,0,8"
                            IsVisible="{Binding CourtExpenditures, Converter={StaticResource CountToBoolConverter}}">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="💸" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Gastos" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#D32F2F"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtExpenditures}" x:Name="CourtExpenditures">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="🏪" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de gasto" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Tipo" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                <Label Text="{Binding ExpenditureName}" 
                                                       FontSize="14" TextColor="#F44336" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, Converter={StaticResource CurrencyFormat}}" 
                                                       FontSize="14" TextColor="#D32F2F" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}" 
                                                   FontSize="13" TextColor="{AppThemeBinding Light=#757575, Dark=#B8B8B8}"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FFEBEE" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#F44336"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteExpenseButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#F44336"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteExpenseCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Main Action Buttons Section -->
                <VerticalStackLayout Spacing="16" x:Name="Button" Margin="0,0,0,110">

                    <!-- Required Actions Card -->
                    <Border Style="{StaticResource RequiredActionsCardStyle}"
                            Margin="0,8">

                        <VerticalStackLayout Spacing="16">
                            <!-- Header -->
                            <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                                <Label Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                                <Label Text="Acciones Obligatorias"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#D32F2F"
                                       VerticalOptions="Center"/>
                            </StackLayout>

                            <!-- Required Buttons Grid -->

                            <!-- Required Buttons Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                                <!-- Botón NewSale -->
                                <Button Text="{Binding NewSale}"
                                    Clicked="OpenDispenserPopUp"
                                    AutomationId="AddSaleButton"
                                    Grid.Column="0"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Padding="16,12"
                                    CornerRadius="12"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White">
                                    <Button.Triggers>
                                        <!-- ✅ Trigger para cuando está deshabilitado -->
                                        <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference CortePage}, Path=CanAccessFunctionality}"
                                                 Value="False">
                                            <Setter Property="BackgroundColor" Value="#E0E0E0"/>
                                            <Setter Property="TextColor" Value="#9E9E9E"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                        <!-- Trigger para cuando se envió el corte -->
                                        <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference CortePage}, Path=AccionesHabilitadas}"
                                                 Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="BackgroundColor" Value="#E0E0E0"/>
                                            <Setter Property="TextColor" Value="#9E9E9E"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                                <!-- Botón AddCollectionType -->
                                <Button Text="{Binding AddCollectionType}"
                                    Clicked="OpenTypeOfCollectionPopUp"
                                    AutomationId="AddCollectionTypeButton"
                                    Grid.Column="1"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    Padding="16,12"
                                    CornerRadius="12"
                                    BackgroundColor="#2196F3"
                                    TextColor="White">
                                    <Button.Triggers>
                                        <!-- ✅ Trigger para cuando está deshabilitado -->
                                        <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference CortePage}, Path=CanAccessFunctionality}"
                                                 Value="False">
                                            <Setter Property="BackgroundColor" Value="#E0E0E0"/>
                                            <Setter Property="TextColor" Value="#9E9E9E"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                        <!-- Trigger para cuando se envió el corte -->
                                        <DataTrigger TargetType="Button"
                                                 Binding="{Binding Source={x:Reference CortePage}, Path=AccionesHabilitadas}"
                                                 Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="BackgroundColor" Value="#E0E0E0"/>
                                            <Setter Property="TextColor" Value="#9E9E9E"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                            </Grid>


                        </VerticalStackLayout>
                    </Border>

                    <!-- Primary Send Button - Destacado -->
                    <Border Style="{StaticResource PrimarySendButtonStyle}"
                            Margin="0,8">

                        <Button x:Name="SendData" 
                                AutomationId="SendDataButton"
                                Text="{Binding SendData}"
                                TextColor="White" 
                                BackgroundColor="Transparent"
                                Clicked="Button_Clicked"
                                FontSize="22"
                                FontAttributes="Bold"
                                HeightRequest="64"
                                CornerRadius="16">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsTotalSalesValid}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="TextColor" Value="#BDBDBD" />
                                </DataTrigger>
                                <!-- Deshabilitar tras enviar -->
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}"
                                             Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Enhanced Bottom Navigation Menu -->
        <Border x:Name="BottomNavContainer"
                Style="{StaticResource EnhancedBottomNavContainerStyle}"
                AbsoluteLayout.LayoutBounds="0,1,1,95"
                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">

            <Grid ColumnDefinitions="*,*,*,*" Padding="12,16,12,24" RowDefinitions="Auto,Auto">
                <!-- (sin cambios, el bloqueo lo hace el code-behind) -->

                <!-- Upload Document Button -->
                <Grid Grid.Column="0" x:Name="DocumentButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDocumentTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="#FFF3E0" 
                             Style="{StaticResource NavCircleIndicatorStyle}"
                             x:Name="DocumentCircle">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Document">
                                <Setter Property="Fill" Value="#FF9800"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📄" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Docs" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#F57C00"
                               x:Name="DocumentLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Document">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="#FF9800"
                             Style="{StaticResource NavDotIndicatorStyle}"
                             x:Name="DocumentDot">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Document">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- Add Expense Button -->
                <Grid Grid.Column="1" x:Name="ExpenseButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExpenseTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="#F3E5F5" 
                             Style="{StaticResource NavCircleIndicatorStyle}"
                             x:Name="ExpenseCircle">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Expense">
                                <Setter Property="Fill" Value="#9C27B0"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="💸" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Gastos" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#9C27B0"
                               x:Name="ExpenseLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Expense">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="#9C27B0"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Expense">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- Additional Info Button -->
                <Grid Grid.Column="2" x:Name="InfoButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInfoTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="#E8EAF6" 
                             Style="{StaticResource NavCircleIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Info">
                                <Setter Property="Fill" Value="#3F51B5"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="💬" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Info" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#3F51B5"
                               x:Name="InfoLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Info">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="#3F51B5"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Info">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- History/List Button -->
                <Grid Grid.Column="3" x:Name="HistoryButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="#E8F5E8" 
                             Style="{StaticResource NavCircleIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="History">
                                <Setter Property="Fill" Value="#4CAF50"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📜" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Lista" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#4CAF50"
                               x:Name="HistoryLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="History">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="#4CAF50"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="History">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>


            </Grid>
        </Border>



        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>
