<ContentPage
    x:Class="APP.Eds.UsesCases.Court.CourtPostView"
    x:Name="CortePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:converters="clr-namespace:APP.Eds.Converters"
    Title="{Binding ShiftClosing}"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark={StaticResource OffBlack}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DecimalFormatConverter x:Key="DecimalFormat" />
            <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:NumberToWordsConverter x:Key="NumberToWordsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Header Card with Purple Gradient -->
                <Border BackgroundColor="#6A1B9A" 
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#6A1B9A" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="🏪 Cierre De Turno" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Complete la información del turno" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Business Selection Card -->
                <Border x:Name="Business"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkCardBackground}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20"
                        IsVisible="{Binding IsNotIslanderLogin}">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=Black, Dark={StaticResource Gray950}}" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="🏢" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding Business}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark={StaticResource DarkPrimaryText}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <Grid ColumnDefinitions="100, *" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <!-- Business -->
                            <Label Text="Negocio" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#636E72, Dark={StaticResource DarkSecondaryText}}" 
                                   VerticalOptions="Center" 
                                   Grid.Row="0" Grid.Column="0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark={StaticResource DarkInputBackground}}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#DDD6FE, Dark={StaticResource DarkBorderColor}}" 
                                    Grid.Row="0" Grid.Column="1">
                                <Picker Title="{Binding SelectaBusiness}"
                                        AutomationId="BusinessPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding BusinessList}"
                                        SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnBusinessSelected"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>

                            <!-- EDS -->
                            <Label Text="EDS" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#636E72, Dark={StaticResource DarkSecondaryText}}" 
                                   VerticalOptions="Center" 
                                   Grid.Row="1" Grid.Column="0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark={StaticResource DarkInputBackground}}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#DDD6FE, Dark={StaticResource DarkBorderColor}}" 
                                    Grid.Row="1" Grid.Column="1">
                                <Picker Title="{Binding SelectaEds}"
                                        AutomationId="EdsPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding EdsSelectList}"
                                        SelectedItem="{Binding SelectedEds, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnEdsSelected" 
                                        IsEnabled="{Binding IsBusinessSelected}"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>

                            <!-- Islander -->
                            <Label Text="Islero" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#636E72, Dark={StaticResource DarkSecondaryText}}" 
                                   VerticalOptions="Center" 
                                   Grid.Row="2" Grid.Column="0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark={StaticResource DarkInputBackground}}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#DDD6FE, Dark={StaticResource DarkBorderColor}}" 
                                    Grid.Row="2" Grid.Column="1">
                                <Picker Title="{Binding SelectAnIslander}"
                                        AutomationId="IslanderPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding IslanderSelectList}"
                                        SelectedItem="{Binding SelectedIslander, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnIslanderSelected"
                                        IsEnabled="{Binding IsEdsSelected}"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Time Card -->
                <Border x:Name="Time" 
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkCardBackground}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=Black, Dark={StaticResource Gray950}}" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="⏰" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding Time}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark={StaticResource DarkPrimaryText}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="16" ColumnSpacing="12">
                            <!-- Date -->
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Fecha" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark={StaticResource DarkSecondaryText}}" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#FFF3CD, Dark={StaticResource DarkYellowSection}}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#F39C12, Dark={StaticResource DarkYellowBorder}}" 
                                        Padding="8">
                                    <DatePicker x:Name="datePicker" 
                                                AutomationId="DatePicker" 
                                                Date="{Binding DateStarttime, Mode=TwoWay}" 
                                                MinimumDate="1900-01-01"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="{AppThemeBinding Light=#E67E22, Dark=#FFA500}"/>
                                </Border>
                            </StackLayout>

                            <!-- Start Time -->
                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Hora Inicio" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark={StaticResource DarkSecondaryText}}" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#D4EDDA, Dark={StaticResource DarkSuccessBackground}}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#27AE60, Dark={StaticResource DarkGreenBorder}}" 
                                        Padding="8">
                                    <TimePicker AutomationId="StartTimePicker" 
                                                Time="{Binding Starttime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="{AppThemeBinding Light=#27AE60, Dark=#66BB6A}"/>
                                </Border>
                            </StackLayout>

                            <!-- End Time -->
                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <Label Text="Hora Fin" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark={StaticResource DarkSecondaryText}}" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#F8D7DA, Dark={StaticResource DarkErrorBackground}}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#E74C3C, Dark={StaticResource DarkRedBorder}}" 
                                        Padding="8">
                                    <TimePicker AutomationId="EndTimePicker" 
                                                Time="{Binding Endtime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="{AppThemeBinding Light=#E74C3C, Dark=#EF5350}"/>
                                </Border>
                            </StackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Cash Count Card -->
                <Border x:Name="CashCount"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkCardBackground}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20"
                        IsVisible="{Binding ShouldShowCashCountSection}">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=Black, Dark={StaticResource Gray950}}" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="💰" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding CashCount}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark={StaticResource DarkPrimaryText}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="16">
                            <!-- Sales in Money -->
                            <Border BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark={StaticResource DarkSuccessBackground}}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#4CAF50, Dark=#2E7D32}"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInMoney}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalAmount, Converter={StaticResource CurrencyFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1B5E20, Dark=#A5D6A7}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Sales in Gallons -->
                            <Border BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark={StaticResource DarkInfoBackground}}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInGallons}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalGallons, Converter={StaticResource DecimalFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0D47A1, Dark=#90CAF9}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Expenses -->
                            <Border BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark={StaticResource DarkErrorBackground}}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#F44336, Dark=#D32F2F}"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Expenses}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#D32F2F, Dark=#E57373}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalExpenditure, Converter={StaticResource CurrencyFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#B71C1C, Dark=#EF5350}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Collections -->
                            <Border BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark={StaticResource DarkWarningBackground}}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#FF9800, Dark=#F57C00}"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Collections}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTypeOfCollection, Converter={StaticResource CurrencyFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#E65100, Dark=#FFA726}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Total and Distintic -->
                            <Border BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark={StaticResource DarkPurpleSection}}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#9C27B0, Dark=#7B1FA2}"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding TotalForTheDay}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#7B1FA2, Dark=#BA68C8}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalSales, Converter={StaticResource CurrencyFormat}}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#4A148C, Dark=#CE93D8}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark={StaticResource DarkInputBackground}}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#9E9E9E, Dark={StaticResource DarkBorderColor}}"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding DistinticDescription}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#616161, Dark={StaticResource DarkSecondaryText}}"
                                           HorizontalOptions="Center"/>
                                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="{AppThemeBinding Light=#BDBDBD, Dark={StaticResource DarkBorderAccent}}"
                                            Padding="8">
                                        <Entry Keyboard="Numeric" 
                                               Placeholder="Ingrese distintivo" 
                                               Text="{Binding Distintic, Mode=TwoWay}"
                                               BackgroundColor="Transparent"
                                               HorizontalTextAlignment="Center"/>
                                    </Border>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Sales by Hoses Section -->
                <StackLayout x:Name="AddedDispensers"
                             IsVisible="{Binding ShouldShowDispensersSection}"
                             IsEnabled="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}">
                    <StackLayout.Triggers>
                        <!-- Ocultar después del envío -->
                        <DataTrigger TargetType="StackLayout"
                                     Binding="{Binding Source={x:Reference CortePage}, Path=SeccionesVisibles}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <Border BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark={StaticResource DarkGreenSection}}" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#4CAF50, Dark=#2E7D32}"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="⛽" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Ventas por mangueras" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDispensers}" x:Name="CourtDispensers">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkCardBackground}}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark={StaticResource DarkBorderColor}}"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=Black, Dark={StaticResource Gray950}}" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="🔧" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Manguera #" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark={StaticResource DarkPrimaryText}}" VerticalOptions="Center"/>
                                            <Label Text="{Binding NumberName}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Money Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Monto acumulado" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedAmount, Converter={StaticResource CurrencyFormat}}" 
                                                       FontSize="14" TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en dinero" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding AmountDifferenceResult, Converter={StaticResource CurrencyFormat}}" 
                                                       FontSize="14" TextColor="{AppThemeBinding Light=#2196F3, Dark=#64B5F6}" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Gallons Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="2" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Galones acumulados" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedGallons, Converter={StaticResource DecimalFormat}}" 
                                                       FontSize="14" TextColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en galones" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding GallonsDifferenceResult, Converter={StaticResource DecimalFormat}}" 
                                                       FontSize="14" TextColor="{AppThemeBinding Light=#9C27B0, Dark=#BA68C8}" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark={StaticResource DarkErrorBackground}}" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="{AppThemeBinding Light=#F44336, Dark=#D32F2F}"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="5"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteDispenserButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light=#F44336, Dark=#EF5350}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDispenserCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Collections Section (Formas de pago) -->
                <StackLayout x:Name="TypesofAggregateCollections"
                             IsVisible="{Binding ShouldShowPaymentMethodsSection}"
                             IsEnabled="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}">
                    <StackLayout.Triggers>
                        <DataTrigger TargetType="StackLayout"
                                     Binding="{Binding Source={x:Reference CortePage}, Path=SeccionesVisibles}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <Border BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark={StaticResource DarkBlueSection}}" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="💳" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Formas de pago" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtTypeOfCollections}" x:Name="CourtTypeOfCollections">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkCardBackground}}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark={StaticResource DarkBorderColor}}"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=Black, Dark={StaticResource Gray950}}" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="💰" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de cobro" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark={StaticResource DarkPrimaryText}}" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Método" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding TypeOfCollectionName}" 
                                                       FontSize="14" TextColor="{AppThemeBinding Light=#2196F3, Dark=#64B5F6}" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, Converter={StaticResource CurrencyFormat}}" 
                                                       FontSize="14" TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, Converter={StaticResource NumberToWordsConverter}}" 
                                                       FontSize="10" TextColor="{AppThemeBinding Light=#666666, Dark={StaticResource DarkMutedText}}" FontAttributes="Italic"
                                                       LineBreakMode="WordWrap"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}" 
                                                   FontSize="13" TextColor="{AppThemeBinding Light=#757575, Dark={StaticResource DarkMutedText}}"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark={StaticResource DarkErrorBackground}}" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="{AppThemeBinding Light=#F44336, Dark=#D32F2F}"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteCollectionButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light=#F44336, Dark=#EF5350}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCollectionCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Documents Section (no se oculta por la tarea) -->
                <StackLayout x:Name="AddedDocuments" IsVisible="{Binding VisibleDocuments}">
                    <Border BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark={StaticResource DarkOrangeSection}}" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#FF9800, Dark=#F57C00}"
                            Padding="16"
                            Margin="0,0,0,8"
                            IsVisible="{Binding CourtDocuments, Converter={StaticResource CountToBoolConverter}}">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="📄" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Comprobantes" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDocuments}" x:Name="CourtDocuments">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkCardBackground}}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark={StaticResource DarkBorderColor}}"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=Black, Dark={StaticResource Gray950}}" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="8">
                                        <!-- Document Info -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="📎" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Comprobante" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark={StaticResource DarkPrimaryText}}" VerticalOptions="Center"/>
                                            <Label Text="{Binding DocumentName}" 
                                                   FontSize="14" TextColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}" FontAttributes="Bold" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark={StaticResource DarkErrorBackground}}" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="{AppThemeBinding Light=#F44336, Dark=#D32F2F}"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.Row="0"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteDocumentButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light=#F44336, Dark=#EF5350}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDocumentCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Expenses Section -->
                <StackLayout x:Name="AddedExpenses"
                             IsVisible="{Binding VisibleExpenses}"
                             IsEnabled="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}">
                    <StackLayout.Triggers>
                        <!-- Ocultar después del envío -->
                        <DataTrigger TargetType="StackLayout"
                                     Binding="{Binding Source={x:Reference CortePage}, Path=SeccionesVisibles}"
                                     Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </StackLayout.Triggers>

                    <Border BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark={StaticResource DarkRedSection}}" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#F44336, Dark=#D32F2F}"
                            Padding="16"
                            Margin="0,0,0,8"
                            IsVisible="{Binding CourtExpenditures, Converter={StaticResource CountToBoolConverter}}">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="💸" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Gastos" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="{AppThemeBinding Light=#D32F2F, Dark=#E57373}"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtExpenditures}" x:Name="CourtExpenditures">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkCardBackground}}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark={StaticResource DarkBorderColor}}"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=Black, Dark={StaticResource Gray950}}" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="🏪" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de gasto" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#424242, Dark={StaticResource DarkPrimaryText}}" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Tipo" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding ExpenditureName}" 
                                                       FontSize="14" TextColor="{AppThemeBinding Light=#F44336, Dark=#EF5350}" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, Converter={StaticResource CurrencyFormat}}" 
                                                       FontSize="14" TextColor="{AppThemeBinding Light=#D32F2F, Dark=#E57373}" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark={StaticResource DarkSecondaryText}}" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}" 
                                                   FontSize="13" TextColor="{AppThemeBinding Light=#757575, Dark={StaticResource DarkMutedText}}"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark={StaticResource DarkErrorBackground}}" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="{AppThemeBinding Light=#F44336, Dark=#D32F2F}"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteExpenseButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light=#F44336, Dark=#EF5350}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteExpenseCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Main Action Buttons Section -->
                <VerticalStackLayout Spacing="16" x:Name="Button" Margin="0,0,0,110">

                    <!-- Required Actions Card -->
                    <Border Style="{StaticResource RequiredActionsCardStyle}"
                            Margin="0,8">

                        <VerticalStackLayout Spacing="16">
                            <!-- Header -->
                            <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                                <Label Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                                <Label Text="Acciones Obligatorias"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                                       VerticalOptions="Center"/>
                            </StackLayout>

                            <!-- Required Buttons Grid -->

                            <!-- Required Buttons Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                                <!-- Botón NewSale -->
                                <Button Text="{Binding NewSale}"
            Style="{StaticResource CompactActionButtonStyle}"
            Clicked="OpenDispenserPopUp"
            Command="{Binding OpenDispenserCommand}"
            AutomationId="AddSaleButton"
            IsEnabled="{Binding Source={x:Reference CortePage}, Path=CanAccessFunctionality}"
            Grid.Column="0">
                                    <Button.Triggers>
                                        <!-- Bloquear si el corte ya fue enviado -->
                                        <DataTrigger TargetType="Button"
                         Binding="{Binding Source={x:Reference CortePage}, Path=AccionesHabilitadas}"
                         Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Button.Triggers>

                                    <!-- Estados visuales -->
                                    <!-- Estados visuales -->
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#4CAF50"/>
                                                    <Setter Property="TextColor" Value="White"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightDisabledBackground}, Dark={StaticResource DarkDisabledBackground}}"/>
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightDisabledText}, Dark={StaticResource DarkDisabledText}}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Button>

                                <!-- Botón AddCollectionType -->
                                <Button Text="{Binding AddCollectionType}"
            Style="{StaticResource CompactActionButtonStyle}"
            Clicked="OpenTypeOfCollectionPopUp"
            AutomationId="AddCollectionTypeButton"
            IsEnabled="{Binding Source={x:Reference CortePage}, Path=CanAccessFunctionality}"
            Grid.Column="1">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button"
                         Binding="{Binding Source={x:Reference CortePage}, Path=AccionesHabilitadas}"
                         Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Button.Triggers>

                                    <!-- Estados visuales -->
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#2196F3"/>
                                                    <!-- Azul -->
                                                    <Setter Property="TextColor" Value="White"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightDisabledBackground}, Dark={StaticResource DarkDisabledBackground}}"/>
                                                    <!-- Apagado -->
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightDisabledText}, Dark={StaticResource DarkDisabledText}}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Button>

                            </Grid>


                        </VerticalStackLayout>
                    </Border>

                    <!-- Primary Send Button - Destacado -->
                    <Border Style="{StaticResource PrimarySendButtonStyle}"
                            Margin="0,8">

                        <Button x:Name="SendData" 
                                AutomationId="SendDataButton"
                                Text="{Binding SendData}"
                                TextColor="White" 
                                BackgroundColor="Transparent"
                                Clicked="Button_Clicked"
                                FontSize="22"
                                FontAttributes="Bold"
                                HeightRequest="64"
                                CornerRadius="16">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsTotalSalesValid}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightDisabledText}, Dark={StaticResource DarkDisabledText}}" />
                                </DataTrigger>
                                <!-- Deshabilitar tras enviar -->
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding Source={x:Reference CortePage}, Path=PuedeEditar}"
                                             Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Enhanced Bottom Navigation Menu -->
        <Border x:Name="BottomNavContainer"
                Style="{StaticResource EnhancedBottomNavContainerStyle}"
                AbsoluteLayout.LayoutBounds="0,1,1,95"
                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">

            <Grid ColumnDefinitions="*,*,*,*" Padding="12,16,12,24" RowDefinitions="Auto,Auto">
                <!-- (sin cambios, el bloqueo lo hace el code-behind) -->

                <!-- Upload Document Button -->
                <Grid Grid.Column="0" x:Name="DocumentButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDocumentTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="#FFF3E0" 
                             Style="{StaticResource NavCircleIndicatorStyle}"
                             x:Name="DocumentCircle">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Document">
                                <Setter Property="Fill" Value="#FF9800"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📄" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Docs" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#F57C00"
                               x:Name="DocumentLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Document">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="#FF9800"
                             Style="{StaticResource NavDotIndicatorStyle}"
                             x:Name="DocumentDot">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Document">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- Add Expense Button -->
                <Grid Grid.Column="1" x:Name="ExpenseButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExpenseTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="#F3E5F5" 
                             Style="{StaticResource NavCircleIndicatorStyle}"
                             x:Name="ExpenseCircle">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Expense">
                                <Setter Property="Fill" Value="#9C27B0"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="💸" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Gastos" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#9C27B0"
                               x:Name="ExpenseLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Expense">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="#9C27B0"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Expense">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- Additional Info Button -->
                <Grid Grid.Column="2" x:Name="InfoButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInfoTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="#E8EAF6" 
                             Style="{StaticResource NavCircleIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Info">
                                <Setter Property="Fill" Value="#3F51B5"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="💬" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Info" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#3F51B5"
                               x:Name="InfoLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Info">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="#3F51B5"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Info">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- History/List Button -->
                <Grid Grid.Column="3" x:Name="HistoryButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                    </Grid.GestureRecognizers>
                    <Ellipse Fill="#E8F5E8" 
                             Style="{StaticResource NavCircleIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="History">
                                <Setter Property="Fill" Value="#4CAF50"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📜" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Lista" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#4CAF50"
                               x:Name="HistoryLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="History">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    <Ellipse Fill="#4CAF50"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="History">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>


            </Grid>
        </Border>



        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>
