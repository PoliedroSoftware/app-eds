<ContentPage
    x:Class="APP.Eds.UsesCases.Court.CourtPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="{Binding ShiftClosing}"
    BackgroundColor="#F8F9FA">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- Header Card with Purple Gradient -->
                <Border BackgroundColor="#6A1B9A" 
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#6A1B9A" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="🏪 Cierre De Turno" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Complete la información del turno" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Business Selection Card -->
                <Border x:Name="Business"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20"
                        IsVisible="{Binding IsNotIslanderLogin}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="🏢" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding Business}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#2D3436"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                        
                        <Grid ColumnDefinitions="100, *" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <!-- Business -->
                            <Label Text="Negocio" 
                                   FontAttributes="Bold" 
                                   TextColor="#636E72" 
                                   VerticalOptions="Center" 
                                   Grid.Row="0" Grid.Column="0"/>
                            <Border BackgroundColor="#F8F9FA" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#DDD6FE" 
                                    Grid.Row="0" Grid.Column="1">
                                <Picker Title="{Binding SelectaBusiness}"
                                        AutomationId="BusinessPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding BusinessList}"
                                        SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnBusinessSelected"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>
                            
                            <!-- EDS -->
                            <Label Text="EDS" 
                                   FontAttributes="Bold" 
                                   TextColor="#636E72" 
                                   VerticalOptions="Center" 
                                   Grid.Row="1" Grid.Column="0"/>
                            <Border BackgroundColor="#F8F9FA" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#DDD6FE" 
                                    Grid.Row="1" Grid.Column="1">
                                <Picker Title="{Binding SelectaEds}"
                                        AutomationId="EdsPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding EdsSelectList}"
                                        SelectedItem="{Binding SelectedEds, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnEdsSelected" 
                                        IsEnabled="{Binding IsBusinessSelected}"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>
                            
                            <!-- Islander -->
                            <Label Text="Islero" 
                                   FontAttributes="Bold" 
                                   TextColor="#636E72" 
                                   VerticalOptions="Center" 
                                   Grid.Row="2" Grid.Column="0"/>
                            <Border BackgroundColor="#F8F9FA" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#DDD6FE" 
                                    Grid.Row="2" Grid.Column="1">
                                <Picker Title="{Binding SelectAnIslander}"
                                        AutomationId="IslanderPicker"
                                        ItemDisplayBinding="{Binding Name}" 
                                        ItemsSource="{Binding IslanderSelectList}"
                                        SelectedItem="{Binding SelectedIslander, Mode=TwoWay}" 
                                        SelectedIndexChanged="OnIslanderSelected"
                                        IsEnabled="{Binding IsEdsSelected}"
                                        BackgroundColor="Transparent"
                                        Margin="12,8"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Time Card -->
                <Border x:Name="Time" 
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="⏰" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding Time}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#2D3436"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                        
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="16" ColumnSpacing="12">
                            <!-- Date -->
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Fecha" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="#FFF3CD" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#F39C12" 
                                        Padding="8">
                                    <DatePicker x:Name="datePicker" 
                                                AutomationId="DatePicker" 
                                                Date="{Binding DateStarttime, Mode=TwoWay}" 
                                                MinimumDate="1900-01-01"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="#E67E22"/>
                                </Border>
                            </StackLayout>

                            <!-- Start Time -->
                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Hora Inicio" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="#D4EDDA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#27AE60" 
                                        Padding="8">
                                    <TimePicker AutomationId="StartTimePicker" 
                                                Time="{Binding Starttime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="#27AE60"/>
                                </Border>
                            </StackLayout>

                            <!-- End Time -->
                            <StackLayout Grid.Row="0" Grid.Column="2">
                                <Label Text="Hora Fin" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       HorizontalOptions="Center"/>
                                <Border BackgroundColor="#F8D7DA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#E74C3C" 
                                        Padding="8">
                                    <TimePicker AutomationId="EndTimePicker" 
                                                Time="{Binding Endtime, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                HorizontalOptions="Center"
                                                TextColor="#E74C3C"/>
                                </Border>
                            </StackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Cash Count Card -->
                <Border x:Name="CashCount"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="💰" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="{Binding CashCount}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#2D3436"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                        
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="16">
                            <!-- Sales in Money -->
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#4CAF50"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInMoney}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#2E7D32"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalAmount, StringFormat='$ {0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#1B5E20"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Sales in Gallons -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#2196F3"
                                    Padding="16"
                                    Grid.Row="0" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding SalesInGallons}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#1976D2"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalGallons, StringFormat='{0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#0D47A1"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Expenses -->
                            <Border BackgroundColor="#FFEBEE" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#F44336"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Expenses}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#D32F2F"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalExpenditure, StringFormat='$ {0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#B71C1C"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Collections -->
                            <Border BackgroundColor="#FFF3E0" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#FF9800"
                                    Padding="16"
                                    Grid.Row="1" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Collections}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#F57C00"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalTypeOfCollection, StringFormat='$ {0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#E65100"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Total and Distintic -->
                            <Border BackgroundColor="#F3E5F5" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#9C27B0"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding TotalForTheDay}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#7B1FA2"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalSales, StringFormat='$ {0:N3}'}" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#4A148C"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="#F5F5F5" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#9E9E9E"
                                    Padding="16"
                                    Grid.Row="2" Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding DistinticDescription}" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#616161"
                                           HorizontalOptions="Center"/>
                                    <Border BackgroundColor="White"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="#BDBDBD"
                                            Padding="8">
                                        <Entry Keyboard="Numeric" 
                                               Placeholder="Ingrese distintivo" 
                                               Text="{Binding Distintic, Mode=TwoWay}"
                                               BackgroundColor="Transparent"
                                               HorizontalTextAlignment="Center"/>
                                    </Border>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Sales by Hoses Section -->
                <StackLayout x:Name="AddedDispensers" IsVisible="{Binding VisibleDispenser}">
                    <Border BackgroundColor="#E8F5E8" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="#4CAF50"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="⛽" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Ventas por mangueras" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#2E7D32"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDispensers}" x:Name="CourtDispensers">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#E0E0E0"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="🔧" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Manguera #" FontAttributes="Bold" TextColor="#424242" VerticalOptions="Center"/>
                                            <Label Text="{Binding NumberName}" FontAttributes="Bold" TextColor="#1976D2" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Money Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Monto acumulado" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedAmount, StringFormat='$ {0:N3}'}" 
                                                       FontSize="14" TextColor="#4CAF50" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en dinero" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                                <Label Text="{Binding AmountDifferenceResult, StringFormat='$ {0:N3}'}" 
                                                       FontSize="14" TextColor="#2196F3" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Gallons Section -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="2" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Galones acumulados" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                                <Label Text="{Binding AccumulatedGallons, StringFormat='{0:N3}'}" 
                                                       FontSize="14" TextColor="#FF9800" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Venta en galones" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                                <Label Text="{Binding GallonsDifferenceResult, StringFormat='{0:N3}'}" 
                                                       FontSize="14" TextColor="#9C27B0" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FFEBEE" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#F44336"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="5"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteDispenserButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#F44336"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCollectionCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Collections Section -->
                <StackLayout x:Name="TypesofAggregateCollections" IsVisible="{Binding VisibleReceipts}">
                    <Border BackgroundColor="#E3F2FD" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="#2196F3"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="💳" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Formas de pago" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#1976D2"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtTypeOfCollections}" x:Name="CourtTypeOfCollections">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#E0E0E0"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="💰" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de cobro" FontAttributes="Bold" TextColor="#424242" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Método" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                                <Label Text="{Binding TypeOfCollectionName}" 
                                                       FontSize="14" TextColor="#2196F3" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, StringFormat='$ {0:N3}'}" 
                                                       FontSize="14" TextColor="#4CAF50" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}" 
                                                   FontSize="13" TextColor="#757575"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FFEBEE" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#F44336"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteCollectionButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#F44336"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCollectionCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Documents Section -->
                <StackLayout x:Name="AddedDocuments" IsVisible="{Binding VisibleDocuments}">
                    <Border BackgroundColor="#FFF3E0" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="#FF9800"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="📄" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Comprobantes" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#F57C00"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtDocuments}" x:Name="CourtDocuments">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#E0E0E0"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="8">
                                        <!-- Document Info -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="📎" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Comprobante" FontAttributes="Bold" TextColor="#424242" VerticalOptions="Center"/>
                                            <Label Text="{Binding DocumentName}" 
                                                   FontSize="14" TextColor="#FF9800" FontAttributes="Bold" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FFEBEE" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#F44336"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.Row="0"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteDocumentButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#F44336"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDocumentCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Expenses Section -->
                <StackLayout x:Name="AddedExpenses" IsVisible="{Binding VisibleExpenses}">
                    <Border BackgroundColor="#FFEBEE" 
                            StrokeShape="RoundRectangle 8"
                            Stroke="#F44336"
                            Padding="16"
                            Margin="0,0,0,8">
                        <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                            <Label Text="💸" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Gastos" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="#D32F2F"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <CollectionView ItemsSource="{Binding CourtExpenditures}" x:Name="CourtExpenditures">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#E0E0E0"
                                        Margin="0,4"
                                        Padding="16">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.1"/>
                                    </Border.Shadow>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8" Grid.Row="0" Grid.Column="0">
                                            <Label Text="🏪" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="Tipo de gasto" FontAttributes="Bold" TextColor="#424242" VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Type and Amount -->
                                        <Grid ColumnDefinitions="*,*" Grid.Row="1" Grid.Column="0" ColumnSpacing="16">
                                            <StackLayout Grid.Column="0">
                                                <Label Text="Tipo" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                                <Label Text="{Binding ExpenditureName}" 
                                                       FontSize="14" TextColor="#F44336" FontAttributes="Bold"/>
                                            </StackLayout>
                                            <StackLayout Grid.Column="1">
                                                <Label Text="Monto" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                                <Label Text="{Binding Amount, StringFormat='$ {0:N3}'}" 
                                                       FontSize="14" TextColor="#D32F2F" FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                            <Label Text="Descripción" FontSize="12" TextColor="#666" FontAttributes="Bold"/>
                                            <Label Text="{Binding Description}" 
                                                   FontSize="13" TextColor="#757575"/>
                                        </StackLayout>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="#FFEBEE" 
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#F44336"
                                                WidthRequest="40" HeightRequest="40"
                                                Grid.Column="1" Grid.RowSpan="3"
                                                VerticalOptions="Center">
                                            <Button Text="✕" 
                                                    AutomationId="DeleteExpenseButton"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#F44336"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40" HeightRequest="40"
                                                    CornerRadius="20"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteExpenseCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Main Action Buttons Section -->
                <VerticalStackLayout Spacing="16" x:Name="Button" Margin="0,0,0,110">
                    
                    <!-- Required Actions Card -->
                    <Border Style="{StaticResource RequiredActionsCardStyle}"
                            Margin="0,8">
                        
                        <VerticalStackLayout Spacing="16">
                            <!-- Header -->
                            <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                                <Label Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                                <Label Text="Acciones Obligatorias"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#D32F2F"
                                       VerticalOptions="Center"/>
                            </StackLayout>
                            
                            <!-- Required Buttons Grid -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Text="{Binding NewSale}"
                                        Style="{StaticResource CompactActionButtonStyle}"
                                        BackgroundColor="#4CAF50"
                                        Clicked="OpenDispenserPopUp"
                                        Command="{Binding OpenDispenserCommand}"
                                        AutomationId="AddSaleButton"
                                        IsEnabled="{Binding NewSaleEnabled}"
                                        Grid.Column="0"/>
                                
                                <Button Text="{Binding AddCollectionType}"
                                        Style="{StaticResource CompactActionButtonStyle}"
                                        BackgroundColor="#2196F3"
                                        Clicked="OpenTypeOfCollectionPopUp"
                                        AutomationId="AddCollectionTypeButton"
                                        IsEnabled="{Binding IsEdsSelected}"
                                        Grid.Column="1"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Primary Send Button - Destacado -->
                    <Border Style="{StaticResource PrimarySendButtonStyle}"
                            Margin="0,8">
                        
                        <Button x:Name="SendData" 
                                AutomationId="SendDataButton"
                                Text="{Binding SendData}"
                                TextColor="White" 
                                BackgroundColor="Transparent"
                                Clicked="Button_Clicked"
                                FontSize="22"
                                FontAttributes="Bold"
                                HeightRequest="64"
                                CornerRadius="16">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsTotalSalesValid}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="TextColor" Value="#BDBDBD" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>


        <!-- Enhanced Bottom Navigation Menu -->
        <Border Style="{StaticResource EnhancedBottomNavContainerStyle}"
                AbsoluteLayout.LayoutBounds="0,1,1,95"
                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">
            
            <Grid ColumnDefinitions="*,*,*,*" Padding="12,16,12,24" RowDefinitions="Auto,Auto">
                
                <!-- Upload Document Button -->
                <Grid Grid.Column="0" x:Name="DocumentButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomNavTapped" CommandParameter="Document"/>
                    </Grid.GestureRecognizers>
                    
                    <!-- Background Circle -->
                    <Ellipse Fill="#FFF3E0" 
                             Style="{StaticResource NavCircleIndicatorStyle}"
                             x:Name="DocumentCircle">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Document">
                                <Setter Property="Fill" Value="#FF9800"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    
                    <!-- Content -->
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📄" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Docs" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#F57C00"
                               x:Name="DocumentLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Document">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    
                    <!-- Active Dot Indicator -->
                    <Ellipse Fill="#FF9800"
                             Style="{StaticResource NavDotIndicatorStyle}"
                             x:Name="DocumentDot">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Document">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>


                <!-- Add Expense Button -->
                <Grid Grid.Column="1" x:Name="ExpenseButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomNavTapped" CommandParameter="Expense"/>
                    </Grid.GestureRecognizers>
                    
                    <!-- Background Circle -->
                    <Ellipse Fill="#F3E5F5" 
                             Style="{StaticResource NavCircleIndicatorStyle}"
                             x:Name="ExpenseCircle">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Expense">
                                <Setter Property="Fill" Value="#9C27B0"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    
                    <!-- Content -->
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="💸" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Gastos" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#9C27B0"
                               x:Name="ExpenseLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Expense">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    
                    <!-- Active Dot Indicator -->
                    <Ellipse Fill="#9C27B0"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Expense">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- Additional Info Button -->
                <Grid Grid.Column="2" x:Name="InfoButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomNavTapped" CommandParameter="Info"/>
                    </Grid.GestureRecognizers>
                    
                    <!-- Background Circle -->
                    <Ellipse Fill="#E8EAF6" 
                             Style="{StaticResource NavCircleIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Info">
                                <Setter Property="Fill" Value="#3F51B5"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    
                    <!-- Content -->
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="💬" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Info" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#3F51B5"
                               x:Name="InfoLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="Info">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    
                    <!-- Active Dot Indicator -->
                    <Ellipse Fill="#3F51B5"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="Info">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>

                <!-- History/List Button -->
                <Grid Grid.Column="3" x:Name="HistoryButton">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBottomNavTapped" CommandParameter="History"/>
                    </Grid.GestureRecognizers>
                    
                    <!-- Background Circle -->
                    <Ellipse Fill="#E8F5E8" 
                             Style="{StaticResource NavCircleIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="History">
                                <Setter Property="Fill" Value="#4CAF50"/>
                                <Setter Property="Scale" Value="1.15"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    
                    <!-- Content -->
                    <StackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="📜" FontSize="22" HorizontalOptions="Center"/>
                        <Label Text="Lista" 
                               FontSize="10" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="#4CAF50"
                               x:Name="HistoryLabel">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveNavItem}" Value="History">
                                    <Setter Property="TextColor" Value="White"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </StackLayout>
                    
                    <!-- Active Dot Indicator -->
                    <Ellipse Fill="#4CAF50"
                             Style="{StaticResource NavDotIndicatorStyle}">
                        <Ellipse.Triggers>
                            <DataTrigger TargetType="Ellipse" Binding="{Binding ActiveNavItem}" Value="History">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                
                <!-- Dynamic Sliding Indicator Background -->
                <Border x:Name="SlidingBackground"
                        BackgroundColor="#6A1B9A"
                        StrokeShape="RoundRectangle 26"
                        WidthRequest="56"
                        HeightRequest="56"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Opacity="0.15"
                        Grid.RowSpan="2"/>
        <!-- Additional Info Display -->
        <Border x:Name="AdditionalInfo"
                BackgroundColor="#F0F8FF"
                StrokeShape="RoundRectangle 12"
                Stroke="#87CEEB"
                Padding="16"
                Margin="16"
                IsVisible="{Binding AdditionalInfoEnabled}"
                AbsoluteLayout.LayoutBounds="0,1,1,100"
                AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional">
            <Border.Shadow>
                <Shadow Brush="#87CEEB" Offset="0,2" Radius="8" Opacity="0.2"/>
            </Border.Shadow>
            <Label Text="{Binding AdditionalInfoDescription, Mode=TwoWay}"
                   TextColor="#2F4F4F"
                   FontSize="14"/>
        </Border>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>