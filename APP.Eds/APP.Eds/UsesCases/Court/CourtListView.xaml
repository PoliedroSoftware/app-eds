<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Court.CourtListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:converters="clr-namespace:APP.Eds.Converters"
    Title="Cortes"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <!-- Recursos necesarios (faltaba el convertidor de hora) -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TimeSpanTo12HourConverter x:Key="TimeSpanTo12HourConverter" />
            <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />
            <converters:NumberToWordsConverter x:Key="NumberToWordsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="120,*">

        <!-- Professional Header Section -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                StrokeShape="RoundRectangle 0,0,20,20"
                Padding="20,40,20,20"
                StrokeThickness="0">


            <StackLayout>
                <Label Text="Historial de Cortes"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnBrand}"
                       HorizontalOptions="Center"/>
                <Label Text="Consulte el historial de cierres de turno registrados"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                       HorizontalOptions="Center"
                       Margin="0,5,0,0"/>
            </StackLayout>
        </Border>

        <!-- Main Content Area with Enhanced Spacing -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CourtList}"
                        SelectionChanged="OnCourtSelected"
                        SelectionMode="None"
                        BackgroundColor="Transparent">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Enhanced Court Card with Better Differentiation -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                            StrokeThickness="1"
                            Padding="0"
                            Margin="16,10,16,10">


                        <!-- Left Color Bar for Visual Separation -->
                        <Grid ColumnDefinitions="6,*">

                            <!-- Color-coded Left Border -->
                            <Border Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                    StrokeShape="RoundRectangle 16,0,0,16"/>

                            <!-- Main Content -->
                            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

                                <!-- Header Section with Islander Name -->
                                <Border Grid.Row="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 0,16,0,0"
                                        Padding="24,20">

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                StrokeShape="RoundRectangle 22"
                                                WidthRequest="44" HeightRequest="44"
                                                VerticalOptions="Center">
                                            <brand:PoliedroIcon Text="👤"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                        </Border>

                                        <StackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Margin="16,0,0,0">
                                            <Label Text="{Binding Islander}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                            <Label Text="Islero Responsable"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <StackLayout Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                <brand:PoliedroIcon Text="🏭"
                                                       FontSize="14"
                                                       VerticalOptions="Center"/>
                                                <Label Text="EDS:"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       VerticalOptions="Center"/>
                                                <Label Text="{Binding Eds, FallbackValue='Sin asignar', TargetNullValue='Sin asignar'}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                        </StackLayout>

                                        <!-- Enhanced Status Indicator -->
                                        <Border Grid.Column="2"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                StrokeThickness="1"
                                                Padding="12,8"
                                                VerticalOptions="Center">
                                            <StackLayout Orientation="Horizontal" Spacing="6">
                                                <brand:PoliedroIcon Text="✓"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                       VerticalOptions="Center"/>
                                                <Label Text="Completado"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Content Section with Enhanced Layout -->
                                <StackLayout Grid.Row="1" Padding="24,20" Spacing="16">

                                    <!-- Date and Time Row with Better Contrast -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                                        <!-- Date Section -->
                                        <Border Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                StrokeThickness="1"
                                                Padding="16,12">
                                            <StackLayout Spacing="6">
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <brand:PoliedroIcon Text="📅" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Fecha"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <Label Text="{Binding DateStarttime, StringFormat='{0:yyyy-MM-dd}'}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                        </Border>

                                        <!-- Time Section -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                StrokeThickness="1"
                                                Padding="16,12">
                                            <StackLayout Spacing="6">
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <brand:PoliedroIcon Text="⏰" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Horario"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <Label Text="{Binding Starttime, Converter={StaticResource TimeSpanTo12HourConverter}}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                                    <Label Text="–"
                                                           FontSize="14"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                           FontAttributes="Bold"/>
                                                    <Label Text="{Binding Endtime, Converter={StaticResource TimeSpanTo12HourConverter}}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                                </StackLayout>
                                            </StackLayout>
                                        </Border>
                                    </Grid>

                                    <!-- Financial Summary Row with Professional Design -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                                        <!-- Total Money -->
                                        <Border Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                StrokeThickness="1"
                                                Padding="16,12">
                                            <StackLayout Spacing="6">
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <brand:PoliedroIcon Text="💰" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Total Dinero"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <Label Text="{Binding TotalAccumulatedAmount, Converter={StaticResource CurrencyFormat}}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="{Binding TotalAccumulatedAmount, Converter={StaticResource NumberToWordsConverter}}"
                                                       FontSize="9"
                                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                       FontAttributes="Italic"
                                                       LineBreakMode="WordWrap"
                                                       MaxLines="2"
                                                       HorizontalOptions="Center"
                                                       HorizontalTextAlignment="Center"/>
                                            </StackLayout>
                                        </Border>

                                        <!-- Total Gallons -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                StrokeThickness="1"
                                                Padding="16,12">
                                            <StackLayout Spacing="6">
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <brand:PoliedroIcon Text="⛽" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Galones"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <Label Text="{Binding TotalAccumulatedGallons, StringFormat='{0:N1}'}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                        </Border>
                                    </Grid>
                                </StackLayout>

                                <!-- Action Section with Professional Footer -->
                                <Border Grid.Row="2"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 0,0,0,16"
                                        Padding="24,16">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- Performance Indicator -->
                                        <StackLayout Grid.Column="0"
                                                     Orientation="Horizontal"
                                                     Spacing="12"
                                                     VerticalOptions="Center">
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                                    StrokeShape="RoundRectangle 8"
                                                    Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                    StrokeThickness="1"
                                                    Padding="8,4">
                                                <StackLayout Orientation="Horizontal" Spacing="6">
                                                    <brand:PoliedroIcon Text="📊" FontSize="12" VerticalOptions="Center"/>
                                                    <Label Text="Rendimiento: Excelente"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                            </Border>
                                        </StackLayout>

                                        <!-- Detail Button with Enhanced Design -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                StrokeShape="RoundRectangle 24"
                                                WidthRequest="56" MinimumHeightRequest="52"
                                                VerticalOptions="Center">


                                            <Button Text="📋"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourtDetailCommand}"
                                                    CommandParameter="{Binding}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource OnBrand}"
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    WidthRequest="56" MinimumHeightRequest="52"
                                                    CornerRadius="24"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    AutomationId="ButtonCourtInfo"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Enhanced Empty State -->
            <CollectionView.EmptyView>
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20" Padding="32">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 20"
                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                            StrokeThickness="1"
                            Padding="40,32">


                        <StackLayout Spacing="16" HorizontalOptions="Center">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 40"
                                    WidthRequest="80" HeightRequest="80">
                                <brand:PoliedroIcon Text="📋" FontSize="40"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </Border>
                            <Label Text="No hay cortes registrados"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Los cierres de turno aparecerán aquí una vez que sean registrados en el sistema"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   MaximumWidthRequest="280"/>
                        </StackLayout>
                    </Border>
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              Grid.RowSpan="2"
                              AutomationId="LoadingOverlay"/>
    </Grid>
</ContentPage>
