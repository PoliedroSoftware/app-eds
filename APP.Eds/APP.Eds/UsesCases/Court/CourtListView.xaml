<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Court.CourtListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:converters="clr-namespace:APP.Eds.Converters"
    Title="Cortes"
    BackgroundColor="#F1F5F9">

    <!-- Recursos necesarios (faltaba el convertidor de hora) -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TimeSpanTo12HourConverter x:Key="TimeSpanTo12HourConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="120,*">

        <!-- Professional Header Section -->
        <Border Grid.Row="0"
                BackgroundColor="#3B82F6" 
                StrokeShape="RoundRectangle 0,0,20,20"
                Padding="20,40,20,20"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="#3B82F6" Offset="0,6" Radius="20" Opacity="0.15"/>
            </Border.Shadow>

            <StackLayout>
                <Label Text="📋 Historial de Cortes" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalOptions="Center"/>
                <Label Text="Consulte el historial de cierres de turno registrados" 
                       FontSize="14" 
                       TextColor="#DBEAFE" 
                       HorizontalOptions="Center"
                       Margin="0,5,0,0"/>
            </StackLayout>
        </Border>

        <!-- Main Content Area with Enhanced Spacing -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CourtList}" 
                        SelectionChanged="OnCourtSelected"
                        SelectionMode="None"
                        BackgroundColor="Transparent">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Enhanced Court Card with Better Differentiation -->
                    <Border BackgroundColor="White"
                            StrokeShape="RoundRectangle 16"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="0"
                            Margin="16,10,16,10">
                        <Border.Shadow>
                            <Shadow Brush="#1E293B" Offset="0,4" Radius="16" Opacity="0.08"/>
                        </Border.Shadow>

                        <!-- Left Color Bar for Visual Separation -->
                        <Grid ColumnDefinitions="6,*">

                            <!-- Color-coded Left Border -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#10B981"
                                    StrokeShape="RoundRectangle 16,0,0,16"/>

                            <!-- Main Content -->
                            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

                                <!-- Header Section with Islander Name -->
                                <Border Grid.Row="0"
                                        BackgroundColor="#F8FAFC"
                                        StrokeShape="RoundRectangle 0,16,0,0"
                                        Padding="24,20">

                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#3B82F6"
                                                StrokeShape="RoundRectangle 22"
                                                WidthRequest="44" HeightRequest="44"
                                                VerticalOptions="Center">
                                            <Label Text="👤" 
                                                   FontSize="20" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"
                                                   TextColor="White"/>
                                        </Border>

                                        <StackLayout Grid.Column="1" 
                                                     VerticalOptions="Center" 
                                                     Margin="16,0,0,0">
                                            <Label Text="{Binding Islander}" 
                                                   FontSize="18" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#1E293B"/>
                                            <Label Text="Islero Responsable" 
                                                   FontSize="13" 
                                                   TextColor="#64748B"/>
                                            <StackLayout Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                <Label Text="🏭" 
                                                       FontSize="13" 
                                                       VerticalOptions="Center"/>
                                                <Label Text="EDS:" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       TextColor="#64748B"
                                                       VerticalOptions="Center"/>
                                                <Label Text="{Binding Eds, FallbackValue='Sin asignar', TargetNullValue='Sin asignar'}" 
                                                       FontSize="12" 
                                                       TextColor="#475569"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                        </StackLayout>

                                        <!-- Enhanced Status Indicator -->
                                        <Border Grid.Column="2"
                                                BackgroundColor="#F0FDF4"
                                                StrokeShape="RoundRectangle 20"
                                                Stroke="#10B981"
                                                StrokeThickness="1"
                                                Padding="12,8"
                                                VerticalOptions="Center">
                                            <StackLayout Orientation="Horizontal" Spacing="6">
                                                <Label Text="✓" 
                                                       FontSize="12" 
                                                       TextColor="#059669"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                                <Label Text="Completado" 
                                                       FontSize="12" 
                                                       TextColor="#059669"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Content Section with Enhanced Layout -->
                                <StackLayout Grid.Row="1" Padding="24,20" Spacing="16">

                                    <!-- Date and Time Row with Better Contrast -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                                        <!-- Date Section -->
                                        <Border Grid.Column="0"
                                                BackgroundColor="#FEF3C7"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="#F59E0B"
                                                StrokeThickness="1"
                                                Padding="16,12">
                                            <StackLayout Spacing="6">
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <Label Text="📅" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Fecha" 
                                                           FontSize="12" 
                                                           FontAttributes="Bold"
                                                           TextColor="#92400E"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <Label Text="{Binding DateStarttime, StringFormat='{0:yyyy-MM-dd}'}" 
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#D97706"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                        </Border>

                                        <!-- Time Section -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="#EFF6FF"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="#3B82F6"
                                                StrokeThickness="1"
                                                Padding="16,12">
                                            <StackLayout Spacing="6">
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <Label Text="⏰" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Horario" 
                                                           FontSize="12" 
                                                           FontAttributes="Bold"
                                                           TextColor="#1E40AF"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <Label Text="{Binding Starttime, Converter={StaticResource TimeSpanTo12HourConverter}}" 
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="#1D4ED8"/>
                                                    <Label Text="–" 
                                                           FontSize="13"
                                                           TextColor="#3B82F6"
                                                           FontAttributes="Bold"/>
                                                    <Label Text="{Binding Endtime, Converter={StaticResource TimeSpanTo12HourConverter}}" 
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="#1D4ED8"/>
                                                </StackLayout>
                                            </StackLayout>
                                        </Border>
                                    </Grid>

                                    <!-- Financial Summary Row with Professional Design -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                                        <!-- Total Money -->
                                        <Border Grid.Column="0"
                                                BackgroundColor="#F0FDF4"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="#10B981"
                                                StrokeThickness="1"
                                                Padding="16,12">
                                            <StackLayout Spacing="6">
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <Label Text="💰" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Total Dinero" 
                                                           FontSize="12" 
                                                           FontAttributes="Bold"
                                                           TextColor="#064E3B"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <Label Text="{Binding TotalAccumulatedAmount, StringFormat='$ {0:N0}'}" 
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#059669"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                        </Border>

                                        <!-- Total Gallons -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="#F5F3FF"
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="#8B5CF6"
                                                StrokeThickness="1"
                                                Padding="16,12">
                                            <StackLayout Spacing="6">
                                                <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                                    <Label Text="⛽" FontSize="14" VerticalOptions="Center"/>
                                                    <Label Text="Galones" 
                                                           FontSize="12" 
                                                           FontAttributes="Bold"
                                                           TextColor="#581C87"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                                <Label Text="{Binding TotalAccumulatedGallons, StringFormat='{0:N1}'}" 
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#7C3AED"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                        </Border>
                                    </Grid>
                                </StackLayout>

                                <!-- Action Section with Professional Footer -->
                                <Border Grid.Row="2"
                                        BackgroundColor="#F8FAFC"
                                        StrokeShape="RoundRectangle 0,0,0,16"
                                        Padding="24,16">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- Performance Indicator -->
                                        <StackLayout Grid.Column="0" 
                                                     Orientation="Horizontal" 
                                                     Spacing="12"
                                                     VerticalOptions="Center">
                                            <Border BackgroundColor="#FEF3C7"
                                                    StrokeShape="RoundRectangle 8"
                                                    Stroke="#F59E0B"
                                                    StrokeThickness="1"
                                                    Padding="8,4">
                                                <StackLayout Orientation="Horizontal" Spacing="6">
                                                    <Label Text="📊" FontSize="12" VerticalOptions="Center"/>
                                                    <Label Text="Rendimiento: Excelente" 
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="#92400E"
                                                           VerticalOptions="Center"/>
                                                </StackLayout>
                                            </Border>
                                        </StackLayout>

                                        <!-- Detail Button with Enhanced Design -->
                                        <Border Grid.Column="1"
                                                BackgroundColor="#3B82F6"
                                                StrokeShape="RoundRectangle 24"
                                                WidthRequest="56" HeightRequest="48"
                                                VerticalOptions="Center">
                                            <Border.Shadow>
                                                <Shadow Brush="#3B82F6" Offset="0,2" Radius="8" Opacity="0.2"/>
                                            </Border.Shadow>

                                            <Button Text="📋"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCourtDetailCommand}"
                                                    CommandParameter="{Binding}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="White"
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    WidthRequest="56" HeightRequest="48"
                                                    CornerRadius="24"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    AutomationId="ButtonCourtInfo"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Enhanced Empty State -->
            <CollectionView.EmptyView>
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20" Padding="32">
                    <Border BackgroundColor="White"
                            StrokeShape="RoundRectangle 20"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="40,32">
                        <Border.Shadow>
                            <Shadow Brush="#1E293B" Offset="0,4" Radius="16" Opacity="0.08"/>
                        </Border.Shadow>

                        <StackLayout Spacing="16" HorizontalOptions="Center">
                            <Border BackgroundColor="#F8FAFC"
                                    StrokeShape="RoundRectangle 40"
                                    WidthRequest="80" HeightRequest="80">
                                <Label Text="📋" FontSize="40" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"
                                       TextColor="#94A3B8"/>
                            </Border>
                            <Label Text="No hay cortes registrados" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="#475569" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Los cierres de turno aparecerán aquí una vez que sean registrados en el sistema" 
                                   FontSize="14" 
                                   TextColor="#64748B" 
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   MaximumWidthRequest="280"/>
                        </StackLayout>
                    </Border>
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              Grid.RowSpan="2"
                              AutomationId="LoadingOverlay"/>
    </Grid>
</ContentPage>
