<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Court.CourtDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:APP.Eds.Converters"
    Title="Detalle Del Corte"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TimeSpanTo12HourConverter x:Key="TimeSpanTo12HourConverter" />
            <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />
            <converters:NumberToWordsConverter x:Key="NumberToWordsConverter" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="120,*">

        <!-- Header Section with Modern Design -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                StrokeShape="RoundRectangle 0,0,20,20"
                Padding="20,40,20,20"
                StrokeThickness="0">


            <StackLayout>
                <Label Text="Detalle Del Corte"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnBrand}"
                       HorizontalOptions="Center"/>
                <Label Text="Informacion detallada del cierre de turno"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                       HorizontalOptions="Center"
                       Margin="0,5,0,0"/>
            </StackLayout>
        </Border>

        <!-- Main Content with ScrollView -->
        <ScrollView Grid.Row="1" x:Name="MainScroll" Padding="16,12" AutomationId="ScrollViewCourtDetails">
            <VerticalStackLayout Spacing="16">

                <!-- Court Information Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                        Padding="16,12">
                    <StackLayout Spacing="14">
                        <Label Text="Informacion del Cierre"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>

                        <!-- Simplified layout without consecutive -->
                        <StackLayout Spacing="12">
                            <!-- Date Section -->
                            <StackLayout Spacing="6">
                                <Label Text="Fecha del Cierre"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                        Padding="12,8">
                                    <Label Text="{Binding DateStarttime, StringFormat='{0:dddd, dd/MM/yyyy}'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           HorizontalOptions="Center"
                                           AutomationId="LabelDateValue"/>
                                </Border>
                            </StackLayout>

                            <!-- Islander Section -->
                            <StackLayout Spacing="6">
                                <Label Text="Islero Responsable"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                        Padding="12,8">
                                    <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                        <brand:PoliedroIcon Text="👤" FontSize="16" VerticalOptions="Center"/>
                                        <Label Text="{Binding Islander}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                               VerticalOptions="Center"
                                               AutomationId="LabelIslanderValue"/>
                                    </StackLayout>
                                </Border>
                            </StackLayout>

                            <!-- EDS Section -->
                            <StackLayout Spacing="6">
                                <Label Text="EDS"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                        Padding="12,8">
                                    <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                        <brand:PoliedroIcon Text="🏭" FontSize="16" VerticalOptions="Center"/>
                                        <Label Text="{Binding Eds, FallbackValue='Sin asignar', TargetNullValue='Sin asignar'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                               VerticalOptions="Center"
                                               AutomationId="LabelEdsValue"/>
                                    </StackLayout>
                                </Border>
                            </StackLayout>

                            <!-- Schedule Section -->
                            <StackLayout Spacing="6">
                                <Label Text="Horario de Trabajo"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                        Padding="12,8">
                                    <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Center">
                                        <Label Text="{Binding Starttime, Converter={StaticResource TimeSpanTo12HourConverter}}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                               AutomationId="LabelStarttime"/>
                                        <Label Text="→"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                               VerticalOptions="Center"/>
                                        <Label Text="{Binding Endtime, Converter={StaticResource TimeSpanTo12HourConverter}}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                               AutomationId="LabelEndtime"/>
                                    </StackLayout>
                                </Border>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Financial Summary Cards -->
                <StackLayout Spacing="12">
                    <Label Text="Totales Financieros"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <!-- Total Amount -->
                        <Border Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                Padding="10,8">
                            <StackLayout Spacing="3">
                                <Label Text="Total Dinero"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding TotalAccumulatedAmount, Converter={StaticResource CurrencyFormat}}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       HorizontalOptions="Center"
                                       AutomationId="LabelTotalAccumulatedAmount"/>
                                <Label Text="{Binding TotalAccumulatedAmount, Converter={StaticResource NumberToWordsConverter}}"
                                       FontSize="8"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       FontAttributes="Italic"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </Border>

                        <!-- Total Gallons -->
                        <Border Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                Padding="10,8">
                            <StackLayout Spacing="3">
                                <Label Text="Total Galones"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding TotalAccumulatedGallons, StringFormat='{0:N1}'}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       HorizontalOptions="Center"
                                       AutomationId="LabelTotalAccumulatedGallons"/>
                            </StackLayout>
                        </Border>

                        <!-- Distintivo -->
                        <Border Grid.Column="2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                Padding="10,8">
                            <StackLayout Spacing="3">
                                <Label Text="Distinta"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding Distinc, Converter={StaticResource CurrencyFormat}}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       HorizontalOptions="Center"
                                       AutomationId="LabelDistincValue"/>
                                <Label Text="{Binding Distinc, Converter={StaticResource NumberToWordsConverter}}"
                                       FontSize="8"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       FontAttributes="Italic"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </Border>
                    </Grid>
                </StackLayout>

                <!-- Collections Section - Enhanced with better visibility logic -->
                <StackLayout Spacing="10">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                            StrokeShape="RoundRectangle 6"
                            Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                            Padding="10,6">
                        <Label Text="Formas de Pago"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                               HorizontalOptions="Center"/>
                    </Border>

                    <!-- Show message when no collections -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                            StrokeShape="RoundRectangle 6"
                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                            Padding="16,12"
                            IsVisible="{Binding Collections.Count, Converter={StaticResource CountToBoolConverter}, ConverterParameter=inverse}">
                        <StackLayout Spacing="8" HorizontalOptions="Center">
                            <brand:PoliedroIcon Text="💳" FontSize="28" HorizontalOptions="Center" Opacity="0.6"/>
                            <Label Text="No hay medios de pago registrados"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   HorizontalOptions="Center"/>
                            <Label Text="Los métodos de pago se mostrarán aquí cuando estén disponibles"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <!-- Collections list -->
                    <CollectionView ItemsSource="{Binding Collections}"
                                    AutomationId="CollectionViewCollections"
                                    IsVisible="{Binding Collections.Count, Converter={StaticResource CountToBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                        Margin="0,2"
                                        Padding="12,8">


                                    <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                                        <!-- Icon -->
                                        <StackLayout Grid.Row="0" Grid.Column="0" VerticalOptions="Center">
                                            <brand:PoliedroIcon Text="💰" FontSize="16" HorizontalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Collection Type -->
                                        <StackLayout Grid.Row="0" Grid.Column="1" Spacing="1">
                                            <Label Text="Método de Pago"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Label Text="{Binding Collection}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                   AutomationId="LabelCollectionValue"/>
                                        </StackLayout>

                                        <!-- Amount -->
                                        <StackLayout Grid.Row="0" Grid.Column="2" Spacing="1">
                                            <Label Text="Monto"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Label Text="{Binding Amount, Converter={StaticResource CurrencyFormat}}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                   AutomationId="LabelAmountValue"/>
                                        </StackLayout>

                                        <!-- Description -->
                                        <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" IsVisible="{Binding Description, Converter={StaticResource StringNotEmptyConverter}}" Spacing="1">
                                            <Label Text="Descripción"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Label Text="{Binding Description}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   AutomationId="LabelDescriptionValue"/>
                                        </StackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Dispensers Section -->
                <StackLayout Spacing="10" IsVisible="{Binding Dispensers.Count, Converter={StaticResource CountToBoolConverter}}">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                            StrokeShape="RoundRectangle 6"
                            Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                            Padding="10,6">
                        <Label Text="Dispensadores"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                               HorizontalOptions="Center"/>
                    </Border>

                    <CollectionView ItemsSource="{Binding Dispensers}" AutomationId="CollectionViewDispensers">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                        Margin="0,2"
                                        Padding="12,8">


                                    <StackLayout Spacing="8">
                                        <!-- Header with Dispenser Info -->
                                        <Grid ColumnDefinitions="Auto,*,*" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                    StrokeShape="RoundRectangle 4"
                                                    Padding="4">
                                                <brand:PoliedroIcon Text="⛽" FontSize="14" HorizontalOptions="Center"/>
                                            </Border>

                                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                <Label Text="Dispensador"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                <Label Text="{Binding Dispenser}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                            </StackLayout>

                                            <StackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                                                <Label Text="Num. Manguera"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                <Label Text="{Binding NumberHose}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Dispenser Details in Vertical Layout -->
                                        <StackLayout Spacing="6">
                                            <!-- Current Values Row -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <StackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="Monto Actual"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                    <Label Text="{Binding AccumulatedAmount, Converter={StaticResource CurrencyFormat}}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                                </StackLayout>

                                                <StackLayout Grid.Column="1" Spacing="1">
                                                    <Label Text="Galones Actuales"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                    <Label Text="{Binding AccumulatedGallons, StringFormat='{0:N1}'}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Previous Values Row -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <StackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="Monto Anterior"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                    <Label Text="{Binding LastAccumulatedAmount, Converter={StaticResource CurrencyFormat}}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                </StackLayout>

                                                <StackLayout Grid.Column="1" Spacing="1">
                                                    <Label Text="Galones Anteriores"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                    <Label Text="{Binding LastAccumulatedGallons, StringFormat='{0:N1}'}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                </StackLayout>
                                            </Grid>
                                        </StackLayout>
                                    </StackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Expenditures Section -->
                <StackLayout Spacing="10" IsVisible="{Binding Expenditures.Count, Converter={StaticResource CountToBoolConverter}}">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                            StrokeShape="RoundRectangle 6"
                            Stroke="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                            Padding="10,6">
                        <Label Text="Gastos"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                               HorizontalOptions="Center"/>
                    </Border>

                    <CollectionView ItemsSource="{Binding Expenditures}" AutomationId="CollectionViewExpenditures">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                        Margin="0,2"
                                        Padding="10,6">


                                    <Grid ColumnDefinitions="*,*" RowSpacing="4" ColumnSpacing="12">
                                        <!-- Expenditure Type -->
                                        <StackLayout Grid.Row="0" Grid.Column="0" Spacing="1">
                                            <Label Text="Descripcion"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Label Text="{Binding Expenditure}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                   AutomationId="LabelExpenditureValue"/>
                                        </StackLayout>

                                        <!-- Amount -->
                                        <StackLayout Grid.Row="0" Grid.Column="1" Spacing="1">
                                            <Label Text="Monto"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            <Label Text="{Binding Amount, Converter={StaticResource CurrencyFormat}}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                   AutomationId="LabelExpenditureAmountValue"/>
                                        </StackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

                <!-- Observations Section -->
                <StackLayout Spacing="10" IsVisible="{Binding Descripcion, Converter={StaticResource StringNotEmptyConverter}}">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                            StrokeShape="RoundRectangle 6"
                            Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                            Padding="10,6">
                        <Label Text="Observaciones"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                               HorizontalOptions="Center"/>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 6"
                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                            Padding="12,10">


                        <StackLayout Spacing="6">
                            <brand:PoliedroIcon Text="📝"
                                   FontSize="20"
                                   HorizontalOptions="Start"/>
                            <Label Text="{Binding Descripcion}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   LineBreakMode="WordWrap"
                                   AutomationId="LabelObservationsValue"/>
                        </StackLayout>
                    </Border>
                </StackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>