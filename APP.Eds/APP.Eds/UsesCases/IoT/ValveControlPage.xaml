<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:iot="clr-namespace:APP.Eds.Services.IoT"
             xmlns:converters="clr-namespace:APP.Eds.Converters"
             x:Class="APP.Eds.UsesCases.IoT.ValveControlPage"
             x:Name="ValveControlPageRoot"
             Title="Control de Valvula IoT"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.BindingContext>
        <iot:IoTService x:Name="IoTService"/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToOutputConverter x:Key="BoolToOutputConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:BoolToInput2Converter x:Key="BoolToInput2Converter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeThickness="0"
                    Padding="20"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="12">
                    <Label Text="Control de Valvula IoT"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           HorizontalOptions="Start"/>

                    <Label Text="Control remoto de valvulas mediante AWS IoT"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeThickness="0"
                    Padding="20"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="15">
                    <Label Text="Estado Actual"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                    <Border BackgroundColor="{Binding ValveStatusColor}"
                            StrokeThickness="0"
                            Padding="20"
                            HeightRequest="100">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           Spacing="8">
                            <Label Text="{Binding ValveStatusText}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource OnBrand}"
                                   HorizontalOptions="Center"/>

                            <Grid WidthRequest="60" HeightRequest="60"
                                  HorizontalOptions="Center">
                                <Ellipse Fill="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        Opacity="0.3"
                                        WidthRequest="60"
                                        HeightRequest="60"/>
                                <Ellipse Fill="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Border Grid.Column="0" Grid.Row="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Output 1"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding ValveIsOpen, Converter={StaticResource BoolToOutputConverter}}"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Output 2"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       FontAttributes="Bold"/>
                                <!-- Output 2: "0" cuando esta abierto, "1" cuando esta cerrado -->
                                <Label Text="{Binding ValveIsOpen, Converter={StaticResource BoolToInput2Converter}}"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Input 1"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                       FontAttributes="Bold"/>
                                <Label Text="0"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Input 2"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       FontAttributes="Bold"/>
                                <!-- Input 2 siempre es "0" -->
                                <Label Text="0"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeThickness="0"
                    Padding="20"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>


                <VerticalStackLayout Spacing="20">
                    <Label Text="Control de Valvula"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0"
                                           VerticalOptions="Center"
                                           Spacing="4">
                            <Label Text="Estado de la Valvula"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Label Text="Toque para cambiar el estado"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                        </VerticalStackLayout>

                        <Switch Grid.Column="1"
                                IsToggled="{Binding ValveIsOpen}"
                                OnColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                ThumbColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                Toggled="OnValveToggled"
                                VerticalOptions="Center"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Abrir"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                TextColor="{StaticResource OnBrand}"
                                CornerRadius="12"
                                MinimumHeightRequest="52"
                                FontSize="16"
                                FontAttributes="Bold"
                                Clicked="OnOpenValveClicked"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                        <Button Grid.Column="1"
                                Text="Cerrar"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ErrorFill}, Dark={StaticResource ErrorFillDark}}"
                                TextColor="{StaticResource OnBrand}"
                                CornerRadius="12"
                                MinimumHeightRequest="52"
                                FontSize="16"
                                FontAttributes="Bold"
                                Clicked="OnCloseValveClicked"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                             HeightRequest="50"
                             WidthRequest="50"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
