<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:iot="clr-namespace:APP.Eds.Services.IoT"
             xmlns:converters="clr-namespace:APP.Eds.Converters"
             x:Class="APP.Eds.UsesCases.IoT.ValveControlPage"
             x:Name="ValveControlPageRoot"
             Title="Control de Valvula IoT"
             BackgroundColor="#F5F5F5">

    <ContentPage.BindingContext>
        <iot:IoTService x:Name="IoTService"/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToOutputConverter x:Key="BoolToOutputConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:BoolToInput2Converter x:Key="BoolToInput2Converter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Radius="8" Offset="0,2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Control de Valvula IoT"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#1E88E5"
                           HorizontalOptions="Center"/>
                    
                    <Label Text="Control remoto de valvulas mediante AWS IoT"
                           FontSize="14"
                           TextColor="#757575"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Radius="8" Offset="0,2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Estado Actual"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#333333"/>

                    <Border BackgroundColor="{Binding ValveStatusColor}"
                            StrokeThickness="0"
                            Padding="20"
                            HeightRequest="100">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           Spacing="8">
                            <Label Text="{Binding ValveStatusText}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"/>

                            <Grid WidthRequest="60" HeightRequest="60"
                                  HorizontalOptions="Center">
                                <Ellipse Fill="White"
                                        Opacity="0.3"
                                        WidthRequest="60"
                                        HeightRequest="60"/>
                                <Ellipse Fill="White"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Border Grid.Column="0" Grid.Row="0"
                                BackgroundColor="#E3F2FD"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Output 1"
                                       FontSize="12"
                                       TextColor="#1976D2"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding ValveIsOpen, Converter={StaticResource BoolToOutputConverter}}"
                                       FontSize="16"
                                       TextColor="#1565C0"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="0"
                                BackgroundColor="#E8F5E9"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Output 2"
                                       FontSize="12"
                                       TextColor="#388E3C"
                                       FontAttributes="Bold"/>
                                <!-- Output 2: "0" cuando esta abierto, "1" cuando esta cerrado -->
                                <Label Text="{Binding ValveIsOpen, Converter={StaticResource BoolToInput2Converter}}"
                                       FontSize="16"
                                       TextColor="#2E7D32"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="0" Grid.Row="1"
                                BackgroundColor="#FFF3E0"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Input 1"
                                       FontSize="12"
                                       TextColor="#F57C00"
                                       FontAttributes="Bold"/>
                                <Label Text="0"
                                       FontSize="16"
                                       TextColor="#EF6C00"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="1"
                                BackgroundColor="#FCE4EC"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Input 2"
                                       FontSize="12"
                                       TextColor="#C2185B"
                                       FontAttributes="Bold"/>
                                <!-- Input 2 siempre es "0" -->
                                <Label Text="0"
                                       FontSize="16"
                                       TextColor="#AD1457"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20"
                    Margin="0,10,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Radius="8" Offset="0,2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    <Label Text="Control de Valvula"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#333333"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0"
                                           VerticalOptions="Center"
                                           Spacing="4">
                            <Label Text="Estado de la Valvula"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#333333"/>
                            <Label Text="Toque para cambiar el estado"
                                   FontSize="12"
                                   TextColor="#757575"/>
                        </VerticalStackLayout>

                        <Switch Grid.Column="1"
                                IsToggled="{Binding ValveIsOpen}"
                                OnColor="#4CAF50"
                                ThumbColor="White"
                                Toggled="OnValveToggled"
                                VerticalOptions="Center"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Abrir"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                FontSize="16"
                                FontAttributes="Bold"
                                Clicked="OnOpenValveClicked"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                        <Button Grid.Column="1"
                                Text="Cerrar"
                                BackgroundColor="#F44336"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                FontSize="16"
                                FontAttributes="Bold"
                                Clicked="OnCloseValveClicked"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                             IsVisible="{Binding IsLoading}"
                             Color="#1E88E5"
                             HeightRequest="50"
                             WidthRequest="50"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
