<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Hose.HosePostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:button="clr-namespace:APP.Eds.Controls"
    Title="Gestión de Mangueras"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="20">
                
                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="🔧 Gestión de Mangueras" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Configure las mangueras de los dispensadores" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Hose Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="🔧" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nueva Manguera" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>
                                <Label Text="Configure una nueva manguera para dispensador" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Number Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Número de Manguera" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🔢" 
                                               FontSize="18" 
                                               TextColor="#6A1B9A" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Numeric"
                                               Placeholder="Ingrese número de manguera"
                                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                               Text="{Binding Number, Mode=TwoWay}"
                                               AutomationId="EntryNumber"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Grid for Amount and Gallons -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                
                                <!-- Accumulated Amount Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="0">
                                    <Label Text="Monto Acumulado" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                           Margin="4,0,0,0"/>
                                           
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                            StrokeThickness="2"
                                            Padding="0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <Label Text="💰" 
                                                   FontSize="16" 
                                                   TextColor="#4CAF50" 
                                                   VerticalOptions="Center"/>
                                            
                                            <Entry Keyboard="Numeric"
                                                   Placeholder="0.00"
                                                   PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                                   Text="{Binding AccumulatedAmount, Mode=TwoWay}"
                                                   AutomationId="EntryAccumulatedAmount"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Accumulated Gallons Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="1">
                                    <Label Text="Galones Acumulados" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                           Margin="4,0,0,0"/>
                                           
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                            StrokeThickness="2"
                                            Padding="0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <Label Text="⛽" 
                                                   FontSize="16" 
                                                   TextColor="#2196F3" 
                                                   VerticalOptions="Center"/>
                                            
                                            <Entry Keyboard="Numeric"
                                                   Placeholder="0.000"
                                                   PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                                   Text="{Binding AccumulatedGallons, Mode=TwoWay}"
                                                   AutomationId="EntryAccumulatedGallons"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Dispenser Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Dispensador" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🔧" 
                                               FontSize="18" 
                                               TextColor="#FF9800" 
                                               VerticalOptions="Center"/>
                                        
                                        <Picker Title="Seleccione un Dispensador"
                                                ItemsSource="{Binding DispensersList}"
                                                ItemDisplayBinding="{Binding DisplayName}"
                                                SelectedItem="{Binding SelectedDispensers, Mode=TwoWay}"
                                                AutomationId="PickerDispensers"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Product Type Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Tipo de Producto" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🛢️" 
                                               FontSize="18" 
                                               TextColor="#9C27B0" 
                                               VerticalOptions="Center"/>
                                        
                                        <Picker Title="Seleccione un Tipo de Producto"
                                                ItemsSource="{Binding ProductTypeList}"
                                                ItemDisplayBinding="{Binding Description}"
                                                SelectedItem="{Binding SelectProductType, Mode=TwoWay}"
                                                AutomationId="PickerProductType"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>
                            <!-- Compartiment Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Compartimiento" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🔧" 
                                               FontSize="18" 
                                               TextColor="#FF9800" 
                                               VerticalOptions="Center"/>

                                        <Picker Title="Seleccione un Compartimiento"
                                                ItemsSource="{Binding CompartimentsList}"
                                                ItemDisplayBinding="{Binding DisplayCompartiment}"
                                                SelectedItem="{Binding SelectCompartiment, Mode=TwoWay}"
                                                AutomationId="PickerCompartiments"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Action Buttons Section -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                            
                            <!-- Info Card -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2196F3"
                                    Padding="16"
                                    Opacity="0.9">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="ℹ️" 
                                           FontSize="16" 
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="Las mangueras son los puntos finales de dispensación de combustible. Cada manguera debe estar asociada a un dispensador específico y a un tipo de producto."
                                           FontSize="12"
                                           TextColor="#1565C0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                                <Button
                                    Text="🚀 Enviar Datos"
                                    TextColor="White"
                                    BackgroundColor="#43B02A"
                                    Clicked="Button_Clicked_1"
                                    AutomationId="ButtonSendData"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    CornerRadius="16"
                                    Grid.Column="0"/>
                                <Button
                                    Text="📦 Compartimento"
                                    TextColor="White"
                                    BackgroundColor="#FF9800"
                                    Clicked="OnCompartimentButtonClicked"
                                    AutomationId="ButtonCompartiment"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    CornerRadius="16"
                                    Grid.Column="1"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Hoses List Section -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="📋" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Lista de Mangueras" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>
                                <Label Text="Mangueras registradas en el sistema" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Hoses List -->
                        <CollectionView ItemsSource="{Binding HoseList}" HeightRequest="400">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#FAFAFA" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                            Margin="0,4"
                                            Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1"/>
                                        </Border.Shadow>
                                        
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                                            <!-- Hose Icon -->
                                            <Border BackgroundColor="#E3F2FD" 
                                                    StrokeShape="RoundRectangle 16"
                                                    WidthRequest="40" HeightRequest="40"
                                                    Grid.RowSpan="5" Grid.Column="0"
                                                    VerticalOptions="Start">
                                                <Label Text="🔧" 
                                                       FontSize="18" 
                                                       HorizontalOptions="Center" 
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Hose Info -->
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="0" Grid.Column="1">
                                                <Label Text="N° Manguera:" FontSize="13" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Number}" FontSize="13" TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                            
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="1" Grid.Column="1">
                                                <Label Text="Dispensador:" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding DispenserName}" FontSize="12" TextColor="#FF9800" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                            
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="2" Grid.Column="1">
                                                <Label Text="Producto:" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding ProductTypeName}" FontSize="12" TextColor="#9C27B0" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                            
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="3" Grid.Column="1">
                                                <Label Text="Dinero:" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding AccumulatedAmount, StringFormat='$ {0:N2}'}" FontSize="12" TextColor="#4CAF50" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                            
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="4" Grid.Column="1">
                                                <Label Text="Galones:" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding AccumulatedGallons, StringFormat='{0:N3}'}" FontSize="12" TextColor="#2196F3" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <StackLayout Grid.Column="2" Grid.RowSpan="4" VerticalOptions="Center" Spacing="8">
                                                <!-- Edit Button -->
                                                <Border BackgroundColor="#FFF3E0" 
                                                        StrokeShape="RoundRectangle 15"
                                                        Stroke="#FF9800"
                                                        WidthRequest="30" HeightRequest="30">
                                                    <Button Text="✏️" 
                                                            BackgroundColor="Transparent"
                                                            TextColor="#FF9800"
                                                            FontSize="12"
                                                            WidthRequest="30" HeightRequest="30"
                                                            CornerRadius="15"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditHoseDataCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Border>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>
