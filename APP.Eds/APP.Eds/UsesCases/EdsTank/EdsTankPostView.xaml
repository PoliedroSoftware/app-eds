<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.EdsTank.EdsTankPostView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             xmlns:converters="clr-namespace:APP.Eds.Converters"
             Title="Gestion de Tanques - EDS"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />

            <!-- Local Icon Styles -->
            <Style x:Key="IconLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="{OnPlatform Android='monospace', iOS='Menlo', MacCatalyst='Menlo', WinUI='Segoe UI Symbol', Default='Courier New'}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid Padding="20" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header con icono y titulo -->
            <Border Grid.Row="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20,24"
                    StrokeThickness="0">


                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                            StrokeShape="RoundRectangle 12"
                            WidthRequest="56"
                            HeightRequest="56">
                        <Label Text="T"
                               Style="{StaticResource IconLabel}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                    </Border>

                    <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label Text="Gestion de Tanques"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Label Text="Asigne tanques a las estaciones de servicio"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               LineBreakMode="WordWrap"/>
                    </StackLayout>
                </Grid>
            </Border>

            <!-- Seccion EDS -->
            <Border Grid.Row="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    StrokeThickness="0">


                <StackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="8">
                            <Label Text="E"
                                   Style="{StaticResource IconLabel}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"/>
                        </Border>

                        <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Estacion de Servicio"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Label Text="Seleccione la EDS donde asignar el tanque"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                        </StackLayout>
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}">
                        <Picker x:Name="EdsPicker"
                                Title="? Seleccionar EDS"
                                ItemsSource="{Binding EdsList}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectEds, Mode=TwoWay}"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                TitleColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                BackgroundColor="Transparent"
                                Margin="16,12"/>
                    </Border>

                    <!-- Informacion de EDS seleccionada -->
                    <Border x:Name="EdsInfoCard"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                            Padding="12"
                            IsVisible="{Binding SelectEds, Converter={StaticResource IsNotNullConverter}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="?"
                                   Style="{StaticResource IconLabel}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding SelectEds.Name, StringFormat='EDS: {0}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                <Label Text="{Binding SelectEds.Address, StringFormat='Direccion: {0}'}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       IsVisible="{Binding SelectEds.Address, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                            </StackLayout>
                        </Grid>
                    </Border>
                </StackLayout>
            </Border>

            <!-- Seccion Tanque -->
            <Border Grid.Row="2"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    StrokeThickness="0">


                <StackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="8">
                            <Label Text="T"
                                   Style="{StaticResource IconLabel}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        </Border>

                        <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Tanque de Combustible"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                            <Label Text="Seleccione el tanque a asignar a la EDS"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                        </StackLayout>
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}">
                        <Picker x:Name="TankPicker"
                                Title="? Seleccionar Tanque"
                                ItemsSource="{Binding TankList}"
                                ItemDisplayBinding="{Binding DisplayText}"
                                SelectedItem="{Binding SelectTank, Mode=TwoWay}"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                TitleColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                BackgroundColor="Transparent"
                                Margin="16,12"/>
                    </Border>

                    <!-- Informacion de Tanque seleccionado -->
                    <Border x:Name="TankInfoCard"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                            Padding="12"
                            IsVisible="{Binding SelectTank, Converter={StaticResource IsNotNullConverter}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="T"
                                   Style="{StaticResource IconLabel}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                            <StackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding SelectTank.Number, StringFormat='Tanque #{0}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                    <Label Grid.Column="0"
                                           Text="{Binding SelectTank.Ability, StringFormat='Capacidad: {0:N0} L'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding SelectTank.Compartment, StringFormat='Compartimientos: {0}'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                </Grid>
                            </StackLayout>
                        </Grid>
                    </Border>
                </StackLayout>
            </Border>

            <!-- Resumen de Asignacion -->
            <Border Grid.Row="3"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    StrokeThickness="0"
                    IsVisible="{Binding ShowAssignmentSummary}">


                <StackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="8">
                            <Label Text="R"
                                   Style="{StaticResource IconLabel}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                        </Border>

                        <Label Grid.Column="1"
                               Text="Resumen de Asignacion"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               VerticalOptions="Center"/>
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                            Padding="16">
                        <StackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="E"
                                       Style="{StaticResource IconLabel}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"/>
                                <Label Grid.Column="1"
                                       Text="{Binding SelectEds.Name, StringFormat='EDS: {0}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"/>
                            </Grid>

                            <BoxView Height="1" BackgroundColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" Opacity="0.3"/>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="T"
                                       Style="{StaticResource IconLabel}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"/>
                                <Label Grid.Column="1"
                                       Text="{Binding SelectTank.Number, StringFormat='Tanque #{0}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"/>
                            </Grid>
                        </StackLayout>
                    </Border>
                </StackLayout>
            </Border>

            <!-- Botones de Accion -->
            <StackLayout Grid.Row="4"
                         Spacing="12"
                         VerticalOptions="End"
                         Margin="0,20,0,0">

                <!-- Boton Asignar -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        HeightRequest="54">


                    <Button x:Name="AssignButton"
                            BackgroundColor="Transparent"
                            Text="Asignar Tanque a EDS"
                            TextColor="{StaticResource OnBrand}"
                            FontSize="16"
                            FontAttributes="Bold"
                            Clicked="Button_Clicked"
                            IsEnabled="{Binding CanAssignTank}"/>
                </Border>

                <!-- Boton Limpiar -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                        MinimumHeightRequest="52">

                    <Button x:Name="ClearButton"
                            BackgroundColor="Transparent"
                            Text="Limpiar Seleccion"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            FontSize="14"
                            Clicked="OnClearClicked"/>
                </Border>

                <!-- Boton Ver Asignaciones -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        MinimumHeightRequest="52">

                    <Button x:Name="ViewAssignmentsButton"
                            BackgroundColor="Transparent"
                            Text="Ver Asignaciones Actuales"
                            TextColor="{StaticResource OnBrand}"
                            FontSize="14"
                            Clicked="OnViewAssignmentsClicked"/>
                </Border>
            </StackLayout>

            <!-- Loading Overlay -->
            <controls:LoadingView x:Name="LoadingOverlay"
                                  Grid.Row="0"
                                  Grid.RowSpan="5"
                                  IsVisible="False"/>
        </Grid>
    </ScrollView>
</ContentPage>
