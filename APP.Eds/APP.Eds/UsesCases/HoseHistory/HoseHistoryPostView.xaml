<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.HoseHistory.HoseHistoryPostView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             xmlns:button="clr-namespace:APP.Eds.Controls"
             xmlns:converters="clr-namespace:APP.Eds.Converters"
             Title="Gestión Historial De Mangueras">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DateFormatConverter x:Key="DateFormatConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <AbsoluteLayout>
        <VerticalStackLayout 
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            Padding="20" Spacing="15">
            <Label FontSize="16" Text="Fecha"/>
            <DatePicker
                Date="{Binding Date, Mode=TwoWay}"
                Format="dd/MM/yyyy"
                AutomationId="DatePickerDate"/>

            <Label FontSize="16" Text="Monto Acumulado"/>
            <Entry
                Keyboard="Text"
                Placeholder="Ingrese Monto Acumulado"
                Text="{Binding AccumulatedAmount, Mode=TwoWay}"
                AutomationId="EntryAccumulatedAmount"/>

            <Label FontSize="16" Text="Galones Acumulados"/>
            <Entry
                Keyboard="Text"
                Placeholder="Enter AccumulatedGallons"
                Text="{Binding AccumulatedGallons, Mode=TwoWay}"
                AutomationId="EntryAccumulatedGallons"/>

            <Picker Title="Seleccione un Dispensador"
                ItemsSource="{Binding DispensersList}"
                ItemDisplayBinding="{Binding DisplayName}"
                SelectedItem="{Binding SelectedDispensers, Mode=TwoWay}"
                AutomationId="PickerDispensers"/>

            <Picker Title="Seleccione una Manguera"
                ItemsSource="{Binding HoseList}"
                ItemDisplayBinding="{Binding Number}"
                SelectedItem="{Binding SelectHose, Mode=TwoWay}"
                AutomationId="PickerHose"/>

                <button:HoverButton
                    BackgroundColor="Green"
                    Clicked="Button_Clicked_1"
                    WidthRequest="200"
                    HeightRequest="60"
                    CornerRadius="10"
                    Text="Enviar Datos"
                    HoverColor="Gray"
                    PressedColor="AliceBlue"
                    TextColor="White"
                    AutomationId="ButtonSendData"/>

                <Label FontSize="18" Text="Historial de Mangueras" />

            <CollectionView ItemsSource="{Binding HoseHistoryList}" Margin="0,20"
                            HeightRequest="400">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Text="{Binding Id}" FontSize="14" Grid.Row="0" />
                            <Label Text="{Binding Date, Converter={StaticResource DateFormatConverter}}" FontSize="14" Grid.Row="1" />
                            <Label Text="{Binding IdDispensers}" FontSize="14" Grid.Row="2" />
                            <Label Text="{Binding AccumulatedAmount}" FontSize="14" Grid.Row="3" />
                            <Label Text="{Binding AccumulatedGallons}" FontSize="14" Grid.Row="4" />
                            <Label Text="{Binding IdHose}" FontSize="14" Grid.Row="5" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
            <controls:LoadingView x:Name="LoadingOverlay"
                                  AbsoluteLayout.LayoutBounds="0,0,1,1"
                                  AbsoluteLayout.LayoutFlags="All"
                                  AutomationId="LoadingOverlay"/>
        </AbsoluteLayout>
    </ScrollView>
</ContentPage>
