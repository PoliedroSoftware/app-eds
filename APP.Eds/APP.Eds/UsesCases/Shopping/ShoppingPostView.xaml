<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Shopping.ShoppingPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión de Compras"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="20">

                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="🛒 Gestión de Compras" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Registre las compras de combustible y productos" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Purchase Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">

                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="📋" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nueva Compra" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>
                                <Label Text="Registre los detalles de la compra" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">

                            <!-- Invoice Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Número de Factura" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>

                                <Border x:Name="InvoiceBorder"
                                        BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🧾" 
                                               FontSize="18" 
                                               TextColor="#6A1B9A" 
                                               VerticalOptions="Center"/>

                                        <Entry x:Name="FirstEntry"
                                               Keyboard="Text"
                                               Placeholder="Ingrese número de factura (mínimo 3 caracteres)"
                                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                               Text="{Binding Invoice, Mode=TwoWay}"
                                               TextChanged="InvoiceEntryTextChanged"
                                               Completed="InvoiceEntryCompleted"
                                               Unfocused="InvoiceEntryUnfocused"
                                               AutomationId="EntryInvoice"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                
                                <!-- Contextual Help and Validation Message -->
                                <StackLayout Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                    <Label x:Name="InvoiceHelpIcon"
                                           Text="ℹ️" 
                                           FontSize="12" 
                                           VerticalOptions="Center"
                                           IsVisible="True"/>
                                    <Label x:Name="InvoiceHelpText"
                                           Text="El número de factura debe tener al menos 3 caracteres"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#B8B8B8}"
                                           VerticalOptions="Center"
                                           IsVisible="True"/>
                                </StackLayout>
                            </VerticalStackLayout>

                            <!-- EDS Selection -->
                            <VerticalStackLayout Spacing="8">
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Label Text="Estación de Servicio (EDS)" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                           Margin="4,0,0,0"/>
                                    <Label Text="*" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#E74C3C"
                                           VerticalOptions="Start"/>
                                </StackLayout>

                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🏪" 
                                               FontSize="18" 
                                               TextColor="#E74C3C" 
                                               VerticalOptions="Center"/>

                                        <Picker x:Name="EdsPicker"
                                                Title="Seleccione una estación de servicio"
                                                ItemsSource="{Binding EdsList}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedEds, Mode=TwoWay}"
                                                AutomationId="PickerEds"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Date Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Fecha de Compra" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="#FFF3CD" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#F39C12"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="📅" 
                                               FontSize="18" 
                                               TextColor="#E67E22" 
                                               VerticalOptions="Center"/>

                                        <DatePicker Date="{Binding Date, Mode=TwoWay}"
                                                    Format="dd/MM/yyyy"
                                                    MinimumDate="2000-01-01"
                                                    MaximumDate="2100-12-31"
                                                    AutomationId="DatePickerDate"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#D68910"
                                                    FontSize="16"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Provider Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Proveedor" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🏭" 
                                               FontSize="18" 
                                               TextColor="#FF9800" 
                                               VerticalOptions="Center"/>

                                        <Picker x:Name="ProviderPicker"
                                                Title="Seleccione un proveedor"
                                                ItemsSource="{Binding ProviderList}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                                SelectedIndexChanged="ProviderSelected"
                                                AutomationId="PickerProvider"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Category Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Categoría de Combustible" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="⛽" 
                                               FontSize="18" 
                                               TextColor="#9C27B0" 
                                               VerticalOptions="Center"/>

                                        <Picker x:Name="CategoryPicker"
                                                Title="Seleccione categoría de combustible"
                                                ItemsSource="{Binding CategoryList}"
                                                ItemDisplayBinding="{Binding Description}"
                                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                SelectedIndexChanged="OpenShoppingPopUp"
                                                AutomationId="PickerCategory"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>



                <!-- Products Section -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- Products Header with Toggle -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackLayout Orientation="Horizontal" Spacing="12" Grid.Column="0">
                                <Border BackgroundColor="#FFF3E0" 
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="40" HeightRequest="40"
                                        VerticalOptions="Center">
                                    <Label Text="📦" 
                                           FontSize="20" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"/>
                                </Border>

                                <StackLayout VerticalOptions="Center">
                                    <Label Text="Productos Agregados" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                           AutomationId="LabelAddeProducts"/>
                                    <Label Text="Productos incluidos en esta compra" 
                                           FontSize="12" 
                                           TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"/>
                                </StackLayout>
                            </StackLayout>

                            <!-- Toggle Button -->
                            <Border BackgroundColor="#F3E5F5" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    Grid.Column="1"
                                    VerticalOptions="Center">
                                <Button Command="{Binding HideProducts}"
                                        BackgroundColor="Transparent"
                                        TextColor="#9C27B0"
                                        FontSize="16"
                                        WidthRequest="40" HeightRequest="40"
                                        CornerRadius="20"
                                        AutomationId="ButtonHideProducts">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding VisibleProducts}" Value="True">
                                            <Setter Property="Text" Value="👁️‍🗨️" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding VisibleProducts}" Value="False">
                                            <Setter Property="Text" Value="👁️" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Border>
                        </Grid>

                        <!-- Products List -->
                        <CollectionView ItemsSource="{Binding ShoppingProduct}" 
                                        IsVisible="{Binding VisibleProducts}" 
                                        AutomationId="CollectionViewShoppingProduct">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#FAFAFA" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                            Margin="0,4"
                                            Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1"/>
                                        </Border.Shadow>

                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                            <!-- Product Icon -->
                                            <Border BackgroundColor="#E8F5E8" 
                                                    StrokeShape="RoundRectangle 16"
                                                    WidthRequest="40" HeightRequest="40"
                                                    Grid.RowSpan="3" Grid.Column="0"
                                                    VerticalOptions="Start">
                                                <Label Text="🛢️" 
                                                       FontSize="18" 
                                                       HorizontalOptions="Center" 
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Product Info -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding Name}" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold" 
                                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                                       AutomationId="LabelProductNameValue"/>
                                            </StackLayout>

                                            <!-- Details Grid -->
                                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="16">
                                                <!-- Gallons -->
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label Text="Galones" FontSize="11" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" AutomationId="LabelProductQuantity"/>
                                                    <Label Text="{Binding Quantity, StringFormat='{0:N2}'}" 
                                                           FontSize="13" TextColor="#2196F3" FontAttributes="Bold" AutomationId="LabelProductQuantityValue"/>
                                                </StackLayout>

                                                <!-- Purchase Price -->
                                                <StackLayout Grid.Row="1" Grid.Column="0">
                                                    <Label Text="Precio Compra" FontSize="11" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" AutomationId="LabelProductPrice"/>
                                                    <Label Text="{Binding PurchasePrice, StringFormat='$ {0:N2}'}" 
                                                           FontSize="13" TextColor="#4CAF50" FontAttributes="Bold" AutomationId="LabelProductPriceValue"/>
                                                </StackLayout>

                                                <!-- Sell Price -->
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label Text="Precio Venta" FontSize="11" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                    <Label Text="{Binding SellPrice, StringFormat='$ {0:N2}'}" 
                                                           FontSize="13" TextColor="#FF9800" FontAttributes="Bold"/>
                                                </StackLayout>

                                                <!-- Total -->
                                                <StackLayout Grid.Row="1" Grid.Column="1">
                                                    <Label Text="Total" FontSize="11" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold"/>
                                                    <Label Text="{Binding TotalPrice, StringFormat='$ {0:N2}'}" 
                                                           FontSize="13" TextColor="#9C27B0" FontAttributes="Bold"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Delete Button -->
                                            <Border BackgroundColor="#FFEBEE" 
                                                    StrokeShape="RoundRectangle 20"
                                                    Stroke="#F44336"
                                                    WidthRequest="40" HeightRequest="40"
                                                    Grid.Column="2" Grid.RowSpan="3"
                                                    VerticalOptions="Center">
                                                <Button Text="✕" 
                                                        BackgroundColor="Transparent"
                                                        TextColor="#F44336"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        WidthRequest="40" HeightRequest="40"
                                                        CornerRadius="20"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProductCommand}"
                                                        CommandParameter="{Binding .}"
                                                        AutomationId="ButtonDeleteProduct"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>


                <!-- Purchase Summary Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- Summary Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E8F5E8" 
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40" HeightRequest="40"
                    VerticalOptions="Center">
                                <Label Text="📊" 
                       FontSize="20" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Total a pagar" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                       AutomationId="LabelTotalPurchases"/>
                                <Label Text="Resumen de la compra actual" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Summary Grid -->
                        <Grid ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                            <!-- Total Gallons -->
                            <Border BackgroundColor="#E3F2FD" 
                    StrokeShape="RoundRectangle 12"
                    Stroke="#2196F3"
                    Padding="16"
                    Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="Total Galones" 
                           FontAttributes="Bold" 
                           FontSize="12"
                           TextColor="#1976D2"
                           HorizontalOptions="Center"
                           AutomationId="LabelTotalQuantity"/>
                                    <Label Text="{Binding TotalAccumulatedQuantity, StringFormat='{0:N2}'}" 
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#0D47A1"
                           HorizontalOptions="Center"
                           AutomationId="LabelTotalAccumulatedQuantity"/>
                                </StackLayout>
                            </Border>

                            <!-- Total Amount -->
                            <Border BackgroundColor="#E8F5E8" 
                    StrokeShape="RoundRectangle 12"
                    Stroke="#4CAF50"
                    Padding="16"
                    Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="Monto Total" 
                           FontAttributes="Bold" 
                           FontSize="12"
                           TextColor="#2E7D32"
                           HorizontalOptions="Center"
                           AutomationId="LabelTotalAmount"/>
                                    <Label Text="{Binding TotalAccumulatedAmount, StringFormat='$ {0:N2}'}" 
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1B5E20"
                           HorizontalOptions="Center"
                           AutomationId="LabelTotalAccumulatedAmount"/>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons Section -->
                <VerticalStackLayout Spacing="16">

                    <!-- Info Card -->
                    <Border BackgroundColor="#E3F2FD" 
                            StrokeShape="RoundRectangle 12"
                            Stroke="#2196F3"
                            Padding="16"
                            Opacity="0.9">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Label Text="ℹ️" 
                                   FontSize="16" 
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0"/>
                            <Label Text="Las compras registran la adquisición de combustible de los proveedores, incluyendo cantidades, precios de compra y precios de venta para el control de inventario."
                                   FontSize="12"
                                   TextColor="#1565C0"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"/>
                        </StackLayout>
                    </Border>

                    <!-- Action Buttons Grid -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Add Product Button -->
                        <Border BackgroundColor="#6A1B9A" 
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0"
                                Grid.Column="0">
                            <Border.Shadow>
                                <Shadow Brush="#6A1B9A" 
                                        Offset="0,3" 
                                        Radius="8" 
                                        Opacity="0.3"/>
                            </Border.Shadow>
                            <Button Text="📦 Agregar producto" 
                                    TextColor="White" 
                                    BackgroundColor="Transparent"
                                    Clicked="OpenShoppingPopUp"
                                    AutomationId="ButtonNewProduct"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    CornerRadius="16"/>
                        </Border>

                        <!-- Register Purchase Button -->
                        <Border Style="{StaticResource PrimarySendButtonStyle}" Grid.Column="1">
                            <Button Text="✅ Finalizar compra"
                                    TextColor="White" 
                                    BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    AutomationId="ButtonSendData"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    CornerRadius="16"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>