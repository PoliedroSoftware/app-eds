<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Shopping.ShoppingPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión de Compras"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="Gestión de Compras"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Start"/>
                        <Label Text="Registre las compras de combustible y productos"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalOptions="Start"/>
                    </StackLayout>
                </Border>

                <!-- Purchase Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">

                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <brand:PoliedroIcon Text="📋"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nueva Compra"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Registre los detalles de la compra"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">

                            <!-- Invoice Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Número de Factura"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border x:Name="InvoiceBorder"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="🧾"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                               VerticalOptions="Center"/>

                                        <Entry x:Name="FirstEntry"
                                               Keyboard="Text"
                                               Placeholder="Ingrese número de factura (mínimo 3 caracteres)"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               Text="{Binding Invoice, Mode=TwoWay}"
                                               TextChanged="InvoiceEntryTextChanged"
                                               Completed="InvoiceEntryCompleted"
                                               Unfocused="InvoiceEntryUnfocused"
                                               AutomationId="EntryInvoice"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>

                                <!-- Contextual Help and Validation Message -->
                                <StackLayout Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                    <brand:PoliedroIcon x:Name="InvoiceHelpIcon"
                                           Text="ℹ️"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           IsVisible="True"/>
                                    <Label x:Name="InvoiceHelpText"
                                           Text="El número de factura debe tener al menos 3 caracteres"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           VerticalOptions="Center"
                                           IsVisible="True"/>
                                </StackLayout>
                            </VerticalStackLayout>

                            <!-- EDS Selection -->
                            <VerticalStackLayout Spacing="8">
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Label Text="Estación de Servicio (EDS)"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           Margin="4,0,0,0"/>
                                    <Label Text="*"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                           VerticalOptions="Start"/>
                                </StackLayout>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="🏪"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                               VerticalOptions="Center"/>

                                        <Picker x:Name="EdsPicker"
                                                Title="Seleccione una estación de servicio"
                                                ItemsSource="{Binding EdsList}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedEds, Mode=TwoWay}"
                                                AutomationId="PickerEds"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Date Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Fecha de Compra"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="📅"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                               VerticalOptions="Center"/>

                                        <DatePicker Date="{Binding Date, Mode=TwoWay}"
                                                    Format="dd/MM/yyyy"
                                                    MinimumDate="2000-01-01"
                                                    MaximumDate="2100-12-31"
                                                    AutomationId="DatePickerDate"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                    FontSize="16"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Provider Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Proveedor"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="🏭"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                               VerticalOptions="Center"/>

                                        <Picker x:Name="ProviderPicker"
                                                Title="Seleccione un proveedor"
                                                ItemsSource="{Binding ProviderList}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                                SelectedIndexChanged="ProviderSelected"
                                                AutomationId="PickerProvider"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Category Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Categoría de Combustible"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="⛽"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                               VerticalOptions="Center"/>

                                        <Picker x:Name="CategoryPicker"
                                                Title="Seleccione categoría de combustible"
                                                ItemsSource="{Binding CategoryList}"
                                                ItemDisplayBinding="{Binding Description}"
                                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                SelectedIndexChanged="OpenShoppingPopUp"
                                                AutomationId="PickerCategory"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>



                <!-- Products Section -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- Products Header with Toggle -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackLayout Orientation="Horizontal" Spacing="12" Grid.Column="0">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="40" HeightRequest="40"
                                        VerticalOptions="Center">
                                    <brand:PoliedroIcon Text="📦"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <StackLayout VerticalOptions="Center">
                                    <Label Text="Productos Agregados"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           AutomationId="LabelAddeProducts"/>
                                    <Label Text="Productos incluidos en esta compra"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </StackLayout>
                            </StackLayout>

                            <!-- Toggle Button -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" MinimumHeightRequest="52"
                                    Grid.Column="1"
                                    VerticalOptions="Center">
                                <Button Command="{Binding HideProducts}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                        FontSize="16"
                                        WidthRequest="40" MinimumHeightRequest="52"
                                        CornerRadius="20"
                                        AutomationId="ButtonHideProducts">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding VisibleProducts}" Value="True">
                                            <Setter Property="Text" Value="👁️‍🗨️" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding VisibleProducts}" Value="False">
                                            <Setter Property="Text" Value="👁️" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Border>
                        </Grid>

                        <!-- Products List -->
                        <CollectionView ItemsSource="{Binding ShoppingProduct}"
                                        IsVisible="{Binding VisibleProducts}"
                                        AutomationId="CollectionViewShoppingProduct">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            Margin="0,4"
                                            Padding="16">


                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                            <!-- Product Icon -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                    StrokeShape="RoundRectangle 16"
                                                    WidthRequest="40" HeightRequest="40"
                                                    Grid.RowSpan="3" Grid.Column="0"
                                                    VerticalOptions="Start">
                                                <brand:PoliedroIcon Text="🛢️"
                                                       FontSize="18"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Product Info -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                       AutomationId="LabelProductNameValue"/>
                                            </StackLayout>

                                            <!-- Details Grid -->
                                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="16">
                                                <!-- Gallons -->
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label Text="Galones" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" AutomationId="LabelProductQuantity"/>
                                                    <Label Text="{Binding Quantity, StringFormat='{0:N2}'}"
                                                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold" AutomationId="LabelProductQuantityValue"/>
                                                </StackLayout>

                                                <!-- Purchase Price -->
                                                <StackLayout Grid.Row="1" Grid.Column="0">
                                                    <Label Text="Precio Compra" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" AutomationId="LabelProductPrice"/>
                                                    <Label Text="{Binding PurchasePrice, StringFormat='$ {0:N2}'}"
                                                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" FontAttributes="Bold" AutomationId="LabelProductPriceValue"/>
                                                </StackLayout>

                                                <!-- Sell Price -->
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label Text="Precio Venta" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                    <Label Text="{Binding SellPrice, StringFormat='$ {0:N2}'}"
                                                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" FontAttributes="Bold"/>
                                                </StackLayout>

                                                <!-- Total -->
                                                <StackLayout Grid.Row="1" Grid.Column="1">
                                                    <Label Text="Total" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                    <Label Text="{Binding TotalPrice, StringFormat='$ {0:N2}'}"
                                                           FontSize="14" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Delete Button -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                    StrokeShape="RoundRectangle 20"
                                                    Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                    WidthRequest="40" MinimumHeightRequest="52"
                                                    Grid.Column="2" Grid.RowSpan="3"
                                                    VerticalOptions="Center">
                                                <Button Text="✕"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        WidthRequest="40" MinimumHeightRequest="52"
                                                        CornerRadius="20"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProductCommand}"
                                                        CommandParameter="{Binding .}"
                                                        AutomationId="ButtonDeleteProduct"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>


                <!-- Purchase Summary Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- Summary Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40" HeightRequest="40"
                    VerticalOptions="Center">
                                <brand:PoliedroIcon Text="📊"
                       FontSize="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Resumen de la Compra"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                       AutomationId="LabelTotalPurchases"/>
                                <Label Text="Resumen de la compra actual"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Summary Grid -->
                        <Grid ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                            <!-- Total Gallons -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                    Padding="16"
                    Grid.Column="0">
                                <StackLayout Spacing="8">
                                    <Label Text="Total Galones"
                           FontAttributes="Bold"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                           HorizontalOptions="Center"
                           AutomationId="LabelTotalQuantity"/>
                                    <Label Text="{Binding TotalAccumulatedQuantity, StringFormat='{0:N2}'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                           HorizontalOptions="Center"
                           AutomationId="LabelTotalAccumulatedQuantity"/>
                                </StackLayout>
                            </Border>

                            <!-- Total Amount -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                    Padding="16"
                    Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <Label Text="Monto Total"
                           FontAttributes="Bold"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                           HorizontalOptions="Center"
                           AutomationId="LabelTotalAmount"/>
                                    <Label Text="{Binding TotalAccumulatedAmount, StringFormat='$ {0:N2}'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                           HorizontalOptions="Center"
                           AutomationId="LabelTotalAccumulatedAmount"/>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons Section -->
                <VerticalStackLayout Spacing="16">

                    <!-- Info Card -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                            Padding="16"
                            Opacity="0.9">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <brand:PoliedroIcon Text="ℹ️"
                                   FontSize="16"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0"/>
                            <Label Text="Las compras registran la adquisición de combustible de los proveedores, incluyendo cantidades, precios de compra y precios de venta para el control de inventario."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"/>
                        </StackLayout>
                    </Border>

                    <!-- Action Buttons Grid -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <!-- Add Product Button -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0"
                                Grid.Column="0">

                            <Button Text="Agregar producto"
                                    TextColor="{StaticResource OnBrand}"
                                    BackgroundColor="Transparent"
                                    Clicked="OpenShoppingPopUp"
                                    AutomationId="ButtonNewProduct"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="52"
                                    CornerRadius="16"/>
                        </Border>

                        <!-- Register Purchase Button -->
                        <Border Style="{StaticResource PrimarySendButtonStyle}" Grid.Column="1">
                            <Button Text="Finalizar compra"
                                    TextColor="{StaticResource OnBrand}"
                                    BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    AutomationId="ButtonSendData"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="52"
                                    CornerRadius="16"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>