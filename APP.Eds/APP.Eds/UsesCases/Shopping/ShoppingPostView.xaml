<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.Shopping.ShoppingPostView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             Title="Gestion De Compras">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label FontSize="16" Text="Factura"/>
                <Entry x:Name="FirstEntry" Keyboard="Text" Placeholder="Ingrese Numero De Factura" Text="{Binding Invoice, Mode=TwoWay}" Completed="InvoiceEntryCompleted" AutomationId="EntryInvoice"/>

                <Label FontSize="16" Text="Fecha"/>
                <DatePicker Date="{Binding Date, Mode=TwoWay}" Format="dd/MM/yyyy" MinimumDate="2000-01-01" MaximumDate="2100-12-31" AutomationId="DatePickerDate"/>

                <Label FontSize="16" Text="Proveedor"/>
                <Picker x:Name="ProviderPicker" Title="Seleccione un Proveedor" ItemsSource="{Binding ProviderList}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" SelectedIndexChanged="ProviderSelected" AutomationId="PickerProvider"/>

                <Label FontSize="16" Text="Categoria"/>
                <Picker x:Name="CategoryPicker" Title="Seleccione una Categoria" ItemsSource="{Binding CategoryList}" ItemDisplayBinding="{Binding Description}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" AutomationId="PickerCategory"/>


                <Frame Padding="10" BorderColor="Gray" CornerRadius="10">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,10,*,*" RowSpacing="5">
                        <!-- Mostrar los totales acumulados -->
                        <Label FontAttributes="Bold" FontSize="18" Text="Compras Totales" Grid.Column="1" Grid.Row="0" HorizontalOptions="Center" AutomationId="LabelTotalPurchases"/>

                        <Label Text="Cantidad Total" FontAttributes="Bold" Grid.Column="0" Grid.Row="2" AutomationId="LabelTotalQuantity"/>
                        <Label Text="{Binding TotalAccumulatedQuantity, StringFormat='{0}'}" Grid.Column="0" Grid.Row="3" AutomationId="LabelTotalAccumulatedQuantity"/>

                        <Label Text="Precio Total" FontAttributes="Bold" Grid.Column="1" Grid.Row="2" AutomationId="LabelTotalPrice"/>
                        <Label Text="{Binding TotalAccumulatedPrice, StringFormat='$ {0}'}" Grid.Column="1" Grid.Row="3" AutomationId="LabelTotalAccumulatedPrice"/>

                        <Label Text="Monto Total" FontAttributes="Bold" Grid.Column="2" Grid.Row="2" AutomationId="LabelTotalAmount"/>
                        <Label Text="{Binding TotalAccumulatedAmount, StringFormat='$ {0}'}" Grid.Column="2" Grid.Row="3" AutomationId="LabelTotalAccumulatedAmount"/>
                    </Grid>
                </Frame>


                <!-- Products con botón de eliminar -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label  Text="Productos Comprados"  FontAttributes="Bold"  FontSize="18" Grid.ColumnSpan="2" VerticalOptions="Center" HorizontalOptions="Center" AutomationId="LabelAddeProducts"/>
                    <Button  Text="�️"  Command="{Binding HideProducts}"
                             WidthRequest="46"  HeightRequest="46"
                             BackgroundColor="Transparent"
                             HorizontalOptions="End" Grid.Column="1"
                             AutomationId="ButtonHideProducts">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding VisibleProducts}" Value="True">
                                <Setter Property="Text" Value="➖" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding VisibleProducts}" Value="False">
                                <Setter Property="Text" Value="👁️" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <CollectionView ItemsSource="{Binding ShoppingProduct}" IsVisible="{Binding VisibleProducts}" AutomationId="CollectionViewShoppingProduct" >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,5" Padding="10" BorderColor="LightGray" CornerRadius="8">
                                <Grid ColumnDefinitions="Auto,20,*,Auto" RowDefinitions="*,*,*,*" RowSpacing="5">

                                    <Label Text="Producto" FontAttributes="Bold" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" AutomationId="LabelProductName" />
                                    <Label Text="{Binding Name}" Grid.Row="0" Grid.Column="2" VerticalOptions="Center" AutomationId="LabelProductNameValue"/>

                                    <Label Text="Precio de compra" FontAttributes="Bold" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" AutomationId="LabelProductPrice"/>
                                    <Label Text="{Binding Price, StringFormat='$ {0}'}" Grid.Row="1" Grid.Column="2" VerticalOptions="Center" AutomationId="LabelProductPriceValue"/>

                                    <Label Text="Precio de venta" FontAttributes="Bold" Grid.Row="2" Grid.Column="0" VerticalOptions="Center" AutomationId="LabelProductPrice"/>
                                    <Label Text="{Binding SellPrice, StringFormat='$ {0}'}" Grid.Row="2" Grid.Column="2" VerticalOptions="Center" AutomationId="LabelProductPriceValue"/>

                                    <Label Text="Galones" FontAttributes="Bold" Grid.Row="3" Grid.Column="0" VerticalOptions="Center" AutomationId="LabelProductQuantity"/>
                                    <Label Text="{Binding Quantity}" Grid.Row="3" Grid.Column="2" VerticalOptions="Center" AutomationId="LabelProductQuantityValue"/>

                                    <!-- Botón eliminar -->
                                    <Button Text="X"  Grid.Column="3" Grid.RowSpan="3"
                                        WidthRequest="50" HeightRequest="50"
                                        BackgroundColor="Transparent" TextColor="#6A1B9A" CornerRadius="0"
                                        VerticalOptions="Center" HorizontalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProductCommand}" CommandParameter="{Binding .}" AutomationId="ButtonDeleteProduct"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <VerticalStackLayout Spacing="10">
                    <Button Clicked="OpenShoppingPopUp" Text="Producto Nuevo" AutomationId="ButtonNewProduct"/>
                </VerticalStackLayout>

                <Button BackgroundColor="Green"
                        Clicked="Button_Clicked_1"
                        CornerRadius="10"
                        Text="Registrar Compra"
                        TextColor="White"
                        AutomationId="ButtonSendData"/>

            </VerticalStackLayout>
        </ScrollView>
        <controls:LoadingView x:Name="LoadingOverlay"
                          AbsoluteLayout.LayoutBounds="0,0,1,1"
                          AbsoluteLayout.LayoutFlags="All"
                          AutomationId="LoadingOverlay"/>

    </AbsoluteLayout>

</ContentPage>