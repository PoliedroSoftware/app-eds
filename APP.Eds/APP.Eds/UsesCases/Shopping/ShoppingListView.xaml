<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Shopping.ShoppingListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Listado de Compras"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
            <VerticalStackLayout Padding="16" Spacing="20">

                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="Listado de Compras" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Historial de compras registradas" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="#E3F2FD" 
                                StrokeShape="RoundRectangle 12"
                                Stroke="#2196F3"
                                Padding="12"
                                Grid.Column="0">
                            <StackLayout Spacing="4">
                                <Label Text="Total Compras" 
                                       FontSize="11"
                                       TextColor="#1976D2"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="TotalCountLabel"
                                       Text="0" 
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#0D47A1"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </Border>

                        <Border BackgroundColor="#E8F5E8" 
                                StrokeShape="RoundRectangle 12"
                                Stroke="#4CAF50"
                                Padding="12"
                                Grid.Column="1">
                            <StackLayout Spacing="4">
                                <Label Text="Monto Total" 
                                       FontSize="11"
                                       TextColor="#2E7D32"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="TotalAmountLabel"
                                       Text="$ 0.00" 
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#1B5E20"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackLayout Spacing="12">
                        <Label Text="Buscar y Filtrar Compras" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>
                        
                        <!-- Search by Invoice -->
                        <Entry x:Name="SearchEntry"
                               Placeholder="Buscar por número de factura..."
                               TextChanged="OnSearchTextChanged"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"/>
                        
                        <!-- Filter by Provider -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="🏢"
                                   FontSize="20"
                                   VerticalOptions="Center"/>
                            <Picker x:Name="ProviderFilterPicker"
                                    Grid.Column="1"
                                    Title="Filtrar por Proveedor"
                                    ItemsSource="{Binding ProviderList}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedProviderFilter}"
                                    SelectedIndexChanged="OnProviderFilterChanged"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"/>
                        </Grid>
                        
                        <!-- Filter by Category -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="📦"
                                   FontSize="20"
                                   VerticalOptions="Center"/>
                            <Picker x:Name="CategoryFilterPicker"
                                    Grid.Column="1"
                                    Title="Filtrar por Categoría"
                                    ItemsSource="{Binding CategoryList}"
                                    ItemDisplayBinding="{Binding Description}"
                                    SelectedItem="{Binding SelectedCategoryFilter}"
                                    SelectedIndexChanged="OnCategoryFilterChanged"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"/>
                        </Grid>
                        
                        <!-- Clear Filters Button -->
                        <Button x:Name="ClearFiltersButton"
                                Text="🔄 Limpiar Filtros"
                                BackgroundColor="#FF9800"
                                TextColor="White"
                                FontSize="12"
                                HeightRequest="36"
                                CornerRadius="8"
                                Clicked="OnClearFiltersClicked"
                                IsVisible="False"/>
                    </StackLayout>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackLayout Spacing="16">
                        <Label Text="Compras Registradas" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>

                        <StackLayout x:Name="EmptyStateView" 
                                     IsVisible="False"
                                     Spacing="16" 
                                     Padding="32">
                            <Label Text="No hay compras registradas" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"
                                   HorizontalOptions="Center"/>
                        </StackLayout>

                        <CollectionView x:Name="ShoppingCollectionView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" 
                                            StrokeShape="RoundRectangle 16"
                                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                            StrokeThickness="1"
                                            Margin="0,8"
                                            Padding="0">
                                        <VerticalStackLayout Spacing="0">
                                            <!-- Header Section -->
                                            <Border BackgroundColor="#6A1B9A" 
                                                    StrokeShape="RoundRectangle 16,16,0,0"
                                                    Padding="16,12">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                                    <Label Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding Invoice, StringFormat='🧾 Compra: {0}'}" 
                                                           FontSize="18" 
                                                           FontAttributes="Bold" 
                                                           TextColor="White"/>
                                                    
                                                    <Label Grid.Row="1" Grid.Column="0"
                                                           Text="{Binding IdShopping, StringFormat='🔢 ID: {0}'}"
                                                           FontSize="12" 
                                                           TextColor="#E1BEE7"/>
                                                    
                                                    <Label Grid.Row="2" Grid.Column="0"
                                                           Text="{Binding Date, StringFormat='📅 {0:dd/MM/yyyy}'}"
                                                           FontSize="13" 
                                                           TextColor="#E1BEE7"/>
                                                
                                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                                            BackgroundColor="#4CAF50" 
                                                            StrokeShape="RoundRectangle 12"
                                                            Padding="12,8"
                                                            VerticalOptions="Center">
                                                        <StackLayout Spacing="2">
                                                            <Label Text="💰 Monto" 
                                                                   FontSize="10"
                                                                   FontAttributes="Bold"
                                                                   TextColor="White"
                                                                   HorizontalOptions="Center"/>
                                                            <Label Text="{Binding Amount, StringFormat='${0:N2}'}" 
                                                                   FontSize="15"
                                                                   FontAttributes="Bold"
                                                                   TextColor="White"
                                                                   HorizontalOptions="Center"/>
                                                        </StackLayout>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Info Section -->
                                            <StackLayout Padding="16,12" Spacing="10" BackgroundColor="#F5F5F5">
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                    <Label Grid.Row="0" Grid.Column="0"
                                                           Text="🏢 Proveedor:"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}"/>
                                                    <Label Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding Provider.Name}"
                                                           FontSize="13"
                                                           TextColor="#616161"/>
                                                
                                                    <Label Grid.Row="1" Grid.Column="0"
                                                           Text="📦 Categoría:"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}"/>
                                                    <Label Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding Category.Description}"
                                                           FontSize="13"
                                                           TextColor="#616161"/>
                                                </Grid>
                                            </StackLayout>

                                            <!-- Products Section -->
                                            <StackLayout Padding="16" Spacing="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" x:Name="ProductsSection" BindingContext="{Binding .}">
                                                <Label Text="{Binding ShoppingProducts.Count, StringFormat='📦 PRODUCTOS ({0}):'}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>
                                                
                                                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>

                                                <!-- Products List -->
                                                <CollectionView ItemsSource="{Binding ShoppingProducts}">
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BackgroundColor="#FAFAFA"
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                                                    Padding="12"
                                                                    Margin="0,4">
                                                                <VerticalStackLayout Spacing="8">
                                                                    <Label Text="{Binding Product.Name, StringFormat='▪️ {0}'}"
                                                                           FontSize="15"
                                                                           FontAttributes="Bold"
                                                                           TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>
                                                                
                                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                                                                          ColumnSpacing="8" RowSpacing="4">
                                                                        
                                                                        <Label Grid.Row="0" Grid.Column="0"
                                                                               Text="📊 Cantidad:"
                                                                               FontSize="12"
                                                                               TextColor="#616161"/>
                                                                        <Label Grid.Row="0" Grid.Column="1"
                                                                               Text="{Binding Quantity, StringFormat='{0:N2} gal'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}"/>
                                                                        
                                                                        <Label Grid.Row="1" Grid.Column="0"
                                                                               Text="💵 P. Compra:"
                                                                               FontSize="12"
                                                                               TextColor="#616161"/>
                                                                        <Label Grid.Row="1" Grid.Column="1"
                                                                               Text="{Binding PurchasePrice, StringFormat='$ {0:N2}'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}"/>
                                                                        
                                                                        <Label Grid.Row="2" Grid.Column="0"
                                                                               Text="💸 P. Venta:"
                                                                               FontSize="12"
                                                                               TextColor="#616161"/>
                                                                        <Label Grid.Row="2" Grid.Column="1"
                                                                               Text="{Binding SellPrice, StringFormat='$ {0:N2}'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}"/>
                                                                        
                                                                        <Label Grid.Row="3" Grid.Column="0"
                                                                               Text="📦 Stock:"
                                                                               FontSize="12"
                                                                               TextColor="#616161"/>
                                                                        <Label Grid.Row="3" Grid.Column="1"
                                                                               Text="{Binding Product.Stock, StringFormat='{0:N2} gal'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}"/>
                                                                        
                                                                        <Label Grid.Row="4" Grid.Column="0"
                                                                               Text="💰 Subtotal:"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="#1B5E20"/>
                                                                        <Label Grid.Row="4" Grid.Column="1"
                                                                               Text="{Binding TotalPrice, StringFormat='$ {0:N2}'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="#2E7D32"/>
                                                                    </Grid>
                                                                </VerticalStackLayout>
                                                            </Border>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>

                                                <!-- Summary Section -->
                                                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,8,0,0"/>
                                                
                                                <Border BackgroundColor="#E8F5E8"
                                                        StrokeShape="RoundRectangle 12"
                                                        Stroke="#4CAF50"
                                                        Padding="12">
                                                    <StackLayout Spacing="6">
                                                        <Label Text="📊 RESUMEN:"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               TextColor="#1B5E20"/>
                                                
                                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" 
                                                              ColumnSpacing="8" RowSpacing="4">
                                                            <Label Grid.Row="0" Grid.Column="0"
                                                                   Text="∑ Total Galones:"
                                                                   FontSize="12"
                                                                   TextColor="#2E7D32"/>
                                                            <Label Grid.Row="0" Grid.Column="1"
                                                                   Text="{Binding TotalGallonsText}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#1B5E20"/>
                                                            
                                                            <Label Grid.Row="1" Grid.Column="0"
                                                                   Text="∑ Total Compra:"
                                                                   FontSize="12"
                                                                   TextColor="#2E7D32"/>
                                                            <Label Grid.Row="1" Grid.Column="1"
                                                                   Text="{Binding Amount, StringFormat='$ {0:N2}'}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="#1B5E20"/>
                                                        </Grid>
                                                    </StackLayout>
                                                </Border>
                                            </StackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Pagination Controls -->
                        <Border BackgroundColor="#F5F5F5"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                Padding="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Button x:Name="PreviousPageButton"
                                        Grid.Column="0"
                                        Text="◀ Anterior"
                                        BackgroundColor="#6A1B9A"
                                        TextColor="White"
                                        FontSize="12"
                                        HeightRequest="40"
                                        CornerRadius="8"
                                        Clicked="OnPreviousPageClicked"/>
                                
                                <Label x:Name="PageInfoLabel"
                                       Grid.Column="1"
                                       Text="Página 1"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                
                                <Button x:Name="NextPageButton"
                                        Grid.Column="2"
                                        Text="Siguiente ▶"
                                        BackgroundColor="#6A1B9A"
                                        TextColor="White"
                                        FontSize="12"
                                        HeightRequest="40"
                                        CornerRadius="8"
                                        Clicked="OnNextPageClicked"/>
                            </Grid>
                        </Border>
                    </StackLayout>
                </Border>

                <Border BackgroundColor="#6A1B9A" 
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                    <Button Text="Actualizar Listado" 
                            TextColor="White" 
                            BackgroundColor="Transparent"
                            Clicked="OnRefreshClicked"
                            FontSize="14"
                            FontAttributes="Bold"
                            HeightRequest="50"/>
                </Border>

                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>
