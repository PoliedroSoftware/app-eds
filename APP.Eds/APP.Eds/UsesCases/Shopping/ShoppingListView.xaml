<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Shopping.ShoppingListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Listado de Compras"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="Listado de Compras"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnBrand}"
                               HorizontalOptions="Center"/>
                        <Label Text="Historial de compras registradas"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                Padding="12"
                                Grid.Column="0">
                            <StackLayout Spacing="4">
                                <Label Text="Total Compras"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="TotalCountLabel"
                                       Text="0"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                Padding="12"
                                Grid.Column="1">
                            <StackLayout Spacing="4">
                                <Label Text="Monto Total"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="TotalAmountLabel"
                                       Text="$ 0.00"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackLayout Spacing="12">
                        <Label Text="Buscar y Filtrar Compras"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                        <!-- Search by Invoice -->
                        <Entry x:Name="SearchEntry"
                               Placeholder="Buscar por número de factura..."
                               TextChanged="OnSearchTextChanged"
                               BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"/>

                        <!-- Filter by Provider -->
                        <brand:ResponsiveFormGrid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <brand:PoliedroIcon Grid.Column="0"
                                   Text="🏢"
                                   FontSize="20"
                                   VerticalOptions="Center"/>
                            <Picker x:Name="ProviderFilterPicker"
                                    Grid.Column="1"
                                    Title="Filtrar por Proveedor"
                                    ItemsSource="{Binding ProviderList}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedProviderFilter}"
                                    SelectedIndexChanged="OnProviderFilterChanged"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"/>
                        </brand:ResponsiveFormGrid>

                        <!-- Filter by Category -->
                        <brand:ResponsiveFormGrid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <brand:PoliedroIcon Grid.Column="0"
                                   Text="📦"
                                   FontSize="20"
                                   VerticalOptions="Center"/>
                            <Picker x:Name="CategoryFilterPicker"
                                    Grid.Column="1"
                                    Title="Filtrar por Categoría"
                                    ItemsSource="{Binding CategoryList}"
                                    ItemDisplayBinding="{Binding Description}"
                                    SelectedItem="{Binding SelectedCategoryFilter}"
                                    SelectedIndexChanged="OnCategoryFilterChanged"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"/>
                        </brand:ResponsiveFormGrid>

                        <!-- Clear Filters Button -->
                        <Button x:Name="ClearFiltersButton"
                                Text="Limpiar Filtros"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                TextColor="{StaticResource OnBrand}"
                                FontSize="12"
                                HeightRequest="36"
                                CornerRadius="8"
                                Clicked="OnClearFiltersClicked"
                                IsVisible="False"/>
                    </StackLayout>
                </Border>

                <Border Style="{StaticResource ModernCardStyle}">
                    <StackLayout Spacing="16">
                        <Label Text="Compras Registradas"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                        <StackLayout x:Name="EmptyStateView"
                                     IsVisible="False"
                                     Spacing="16"
                                     Padding="32">
                            <Label Text="No hay compras registradas"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   HorizontalOptions="Center"/>
                        </StackLayout>

                        <CollectionView x:Name="ShoppingCollectionView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                            StrokeShape="RoundRectangle 16"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            StrokeThickness="1"
                                            Margin="0,8"
                                            Padding="0">
                                        <VerticalStackLayout Spacing="0">
                                            <!-- Header Section -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                    StrokeShape="RoundRectangle 16,16,0,0"
                                                    Padding="16,12">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                                    <Label Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding Invoice, StringFormat='🧾 Compra: {0}'}"
                                                           FontSize="18"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource OnBrand}"/>

                                                    <Label Grid.Row="1" Grid.Column="0"
                                                           Text="{Binding IdShopping, StringFormat='🔢 ID: {0}'}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"/>

                                                    <Label Grid.Row="2" Grid.Column="0"
                                                           Text="{Binding Date, StringFormat='📅 {0:dd/MM/yyyy}'}"
                                                           FontSize="14"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"/>

                                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                                            BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                            StrokeShape="RoundRectangle 12"
                                                            Padding="12,8"
                                                            VerticalOptions="Center">
                                                        <StackLayout Spacing="2">
                                                            <Label Text="Monto"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource OnBrand}"
                                                                   HorizontalOptions="Center"/>
                                                            <Label Text="{Binding Amount, StringFormat='${0:N2}'}"
                                                                   FontSize="16"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{StaticResource OnBrand}"
                                                                   HorizontalOptions="Center"/>
                                                        </StackLayout>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Info Section -->
                                            <StackLayout Padding="16,12" Spacing="10" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                    <Label Grid.Row="0" Grid.Column="0"
                                                           Text="Proveedor:"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                                    <Label Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding Provider.Name}"
                                                           FontSize="14"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>

                                                    <Label Grid.Row="1" Grid.Column="0"
                                                           Text="Categoría:"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                                    <Label Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding Category.Description}"
                                                           FontSize="14"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                </Grid>
                                            </StackLayout>

                                            <!-- Products Section -->
                                            <StackLayout Padding="20" Spacing="12" BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}" x:Name="ProductsSection" BindingContext="{Binding .}">
                                                <Label Text="{Binding ShoppingProducts.Count, StringFormat='📦 PRODUCTOS ({0}):'}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"/>

                                                <!-- Products List -->
                                                <CollectionView ItemsSource="{Binding ShoppingProducts}">
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                                                    Padding="12"
                                                                    Margin="0,4">
                                                                <VerticalStackLayout Spacing="8">
                                                                    <Label Text="{Binding Product.Name, StringFormat='▪️ {0}'}"
                                                                           FontSize="16"
                                                                           FontAttributes="Bold"
                                                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                                          ColumnSpacing="8" RowSpacing="4">

                                                                        <Label Grid.Row="0" Grid.Column="0"
                                                                               Text="Cantidad:"
                                                                               FontSize="12"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                                        <Label Grid.Row="0" Grid.Column="1"
                                                                               Text="{Binding Quantity, StringFormat='{0:N2} gal'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                                                        <Label Grid.Row="1" Grid.Column="0"
                                                                               Text="P. Compra:"
                                                                               FontSize="12"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                                        <Label Grid.Row="1" Grid.Column="1"
                                                                               Text="{Binding PurchasePrice, StringFormat='$ {0:N2}'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                                                        <Label Grid.Row="2" Grid.Column="0"
                                                                               Text="P. Venta:"
                                                                               FontSize="12"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                                        <Label Grid.Row="2" Grid.Column="1"
                                                                               Text="{Binding SellPrice, StringFormat='$ {0:N2}'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                                                        <Label Grid.Row="3" Grid.Column="0"
                                                                               Text="Stock:"
                                                                               FontSize="12"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                                        <Label Grid.Row="3" Grid.Column="1"
                                                                               Text="{Binding Product.Stock, StringFormat='{0:N2} gal'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                                                        <Label Grid.Row="4" Grid.Column="0"
                                                                               Text="Subtotal:"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                                                        <Label Grid.Row="4" Grid.Column="1"
                                                                               Text="{Binding TotalPrice, StringFormat='$ {0:N2}'}"
                                                                               FontSize="12"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                                                    </Grid>
                                                                </VerticalStackLayout>
                                                            </Border>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>

                                                <!-- Summary Section -->
                                                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}" Margin="0,8,0,0"/>

                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 12"
                                                        Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                        Padding="12">
                                                    <StackLayout Spacing="6">
                                                        <Label Text="RESUMEN:"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>

                                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                                              ColumnSpacing="8" RowSpacing="4">
                                                            <Label Grid.Row="0" Grid.Column="0"
                                                                   Text="∑ Total Galones:"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                                            <Label Grid.Row="0" Grid.Column="1"
                                                                   Text="{Binding TotalGallonsText}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>

                                                            <Label Grid.Row="1" Grid.Column="0"
                                                                   Text="∑ Total Compra:"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                                            <Label Grid.Row="1" Grid.Column="1"
                                                                   Text="{Binding Amount, StringFormat='$ {0:N2}'}"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                                        </Grid>
                                                    </StackLayout>
                                                </Border>
                                            </StackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Pagination Controls -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                Padding="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Button x:Name="PreviousPageButton"
                                        Grid.Column="0"
                                        Text="Anterior"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                        TextColor="{StaticResource OnBrand}"
                                        FontSize="12"
                                        MinimumHeightRequest="52"
                                        CornerRadius="8"
                                        Clicked="OnPreviousPageClicked"/>

                                <Label x:Name="PageInfoLabel"
                                       Grid.Column="1"
                                       Text="Página 1"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>

                                <Button x:Name="NextPageButton"
                                        Grid.Column="2"
                                        Text="Siguiente ▶"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                        TextColor="{StaticResource OnBrand}"
                                        FontSize="12"
                                        MinimumHeightRequest="52"
                                        CornerRadius="8"
                                        Clicked="OnNextPageClicked"/>
                            </Grid>
                        </Border>
                    </StackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                    <Button Text="Actualizar Listado"
                            TextColor="{StaticResource OnBrand}"
                            BackgroundColor="Transparent"
                            Clicked="OnRefreshClicked"
                            FontSize="14"
                            FontAttributes="Bold"
                            MinimumHeightRequest="52"/>
                </Border>

                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>
