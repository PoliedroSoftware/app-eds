<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.Expenditures.ExpendituresPostView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             Title="Gestion De Gastos">
    <AbsoluteLayout>
        <VerticalStackLayout 
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            Padding="20" Spacing="15">
            <Label FontSize="16" Text="Gastos"/>
            <Entry
            Keyboard="Text"
            Placeholder="Ingrese Un Gasto"
            Text="{Binding Description, Mode=TwoWay}"
            AutomationId="EntryExpenditures"/>
            <Button
            BackgroundColor="Green"
            Clicked="Button_Clicked_1"
            CornerRadius="10"
            Text="Enviar Datos"
            TextColor="White"
            AutomationId="ButtonSendExpenditures"/>
        </VerticalStackLayout>
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>