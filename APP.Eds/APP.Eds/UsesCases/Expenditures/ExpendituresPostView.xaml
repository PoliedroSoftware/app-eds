<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Expenditures.ExpendituresPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión De Gastos"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header Card with Red Gradient -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">

                    <StackLayout>
                        <Label Text="Gestión De Gastos"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Start"/>
                        <Label Text="Registre y controle todos los gastos operativos"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                               HorizontalOptions="Start"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Expense Registration Form Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="20">

                        <!-- Form Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="📝" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Registrar Nuevo Gasto"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Expense Information Grid -->
                        <brand:ResponsiveFormGrid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="12">

                            <!-- Expense Category -->
                            <StackLayout Grid.Row="0" Grid.ColumnSpan="2">
                                <Label Text="Categoría de Gasto"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Picker Title="Seleccione una categoría"
                                            ItemsSource="{Binding ExpenseCategories}"
                                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerCategory"/>
                                </Border>
                            </StackLayout>

                            <!-- Amount -->
                            <StackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Monto (COP)"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Keyboard="Numeric"
                                           Placeholder="$ 0.00"
                                           Text="{Binding Amount, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryAmount"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- Date -->
                            <StackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Fecha"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <DatePicker Date="{Binding ExpenseDate, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                AutomationId="DatePickerExpense"/>
                                </Border>
                            </StackLayout>

                            <!-- Description -->
                            <StackLayout Grid.Row="2" Grid.ColumnSpan="2">
                                <Label Text="Descripción"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Editor Placeholder="Descripción detallada del gasto..."
                                            Text="{Binding Description, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="EditorDescription"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            HeightRequest="80"/>
                                </Border>
                            </StackLayout>
                        </brand:ResponsiveFormGrid>

                        <!-- Action Button -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorFill}, Dark={StaticResource ErrorFillDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Margin="0,10,0,0">

                            <Button BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    Text="Registrar Gasto"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="52"
                                    AutomationId="ButtonSendExpenditures"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Expense Statistics Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <!-- Stats Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="📊" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Resumen de Gastos"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Statistics Grid -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <!-- Today's Expenses -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                    Padding="12"
                                    Grid.Column="0">
                                <StackLayout Spacing="6">
                                    <Label Text="Hoy"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TodaysExpenses, StringFormat='$ {0:N0}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- This Week's Expenses -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                    Padding="12"
                                    Grid.Column="1">
                                <StackLayout Spacing="6">
                                    <Label Text="Semana"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding WeeksExpenses, StringFormat='$ {0:N0}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- This Month's Expenses -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                    Padding="12"
                                    Grid.Column="2">
                                <StackLayout Spacing="6">
                                    <Label Text="Mes"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding MonthsExpenses, StringFormat='$ {0:N0}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Expenses List Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="📋" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Gastos Recientes"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Filter Options -->
                        <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                            <Button Text="Hoy"
                                    BackgroundColor="{Binding FilterButtonColor1}"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterTodayCommand}"/>
                            <Button Text="Semana"
                                    BackgroundColor="{Binding FilterButtonColor2}"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterWeekCommand}"/>
                            <Button Text="Mes"
                                    BackgroundColor="{Binding FilterButtonColor3}"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterMonthCommand}"/>
                        </StackLayout>

                        <!-- Expenses Collection -->
                        <CollectionView ItemsSource="{Binding ExpensesList}"
                                        Margin="0,10,0,0"
                                        AutomationId="CollectionViewExpenses">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            Margin="0,4"
                                            Padding="16">


                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="8">

                                            <!-- Category Icon -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                    StrokeShape="RoundRectangle 25"
                                                    WidthRequest="50"
                                                    HeightRequest="50"
                                                    Grid.RowSpan="3"
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">
                                                <brand:PoliedroIcon Text="💸"
                                                       FontSize="24"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Expense Information -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="{Binding Category}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                                <Label Text="•" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center"/>
                                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="1" Grid.Column="1">
                                                <Label Text="{Binding Description}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" LineBreakMode="TailTruncation" MaxLines="2"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <brand:PoliedroIcon Text="💰" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Amount, StringFormat='$ {0:N0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" FontAttributes="Bold"/>
                                            </StackLayout>

                                            <!-- Delete Button -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                    StrokeShape="RoundRectangle 20"
                                                    Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                    WidthRequest="40" MinimumHeightRequest="52"
                                                    Grid.Column="2" Grid.RowSpan="3"
                                                    VerticalOptions="Center">
                                                <Button Text="✕"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        WidthRequest="40" MinimumHeightRequest="52"
                                                        CornerRadius="20"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteExpenseCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                                    <brand:PoliedroIcon Text="📊" FontSize="48" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label Text="No hay gastos registrados"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"
                                           FontAttributes="Bold"/>
                                    <Label Text="Agregue el primer gasto usando el formulario superior"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Margin for Better Scrolling -->
                <BoxView HeightRequest="20" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>