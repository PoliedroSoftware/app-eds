<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Expenditures.ExpendituresPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión De Gastos"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- Header Card with Red Gradient -->
                <Border BackgroundColor="#D32F2F" 
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#D32F2F" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="💸 Gestión De Gastos" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Registre y controle todos los gastos operativos" 
                               FontSize="14" 
                               TextColor="#FFCDD2" 
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Expense Registration Form Card -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Form Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="📝" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Registrar Nuevo Gasto" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Expense Information Grid -->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="12">
                
                            <!-- Expense Category -->
                            <StackLayout Grid.Row="0" Grid.ColumnSpan="2">
                                <Label Text="Categoría de Gasto" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#FFCDD2" 
                                        Padding="4">
                                    <Picker Title="Seleccione una categoría"
                                            ItemsSource="{Binding ExpenseCategories}"
                                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerCategory"/>
                                </Border>
                            </StackLayout>

                            <!-- Amount -->
                            <StackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Monto (COP)" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#FFCDD2" 
                                        Padding="4">
                                    <Entry Keyboard="Numeric"
                                           Placeholder="$ 0.00"
                                           Text="{Binding Amount, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryAmount"
                                           PlaceholderColor="#9CA3AF"/>
                                </Border>
                            </StackLayout>

                            <!-- Date -->
                            <StackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Fecha" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#FFCDD2" 
                                        Padding="4">
                                    <DatePicker Date="{Binding ExpenseDate, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                AutomationId="DatePickerExpense"/>
                                </Border>
                            </StackLayout>

                            <!-- Description -->
                            <StackLayout Grid.Row="2" Grid.ColumnSpan="2">
                                <Label Text="Descripción" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#FFCDD2" 
                                        Padding="4">
                                    <Editor Placeholder="Descripción detallada del gasto..."
                                            Text="{Binding Description, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="EditorDescription"
                                            PlaceholderColor="#9CA3AF"
                                            HeightRequest="80"/>
                                </Border>
                            </StackLayout>
                        </Grid>

                        <!-- Action Button -->
                        <Border BackgroundColor="#D32F2F" 
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Margin="0,10,0,0">
                            <Border.Shadow>
                                <Shadow Brush="#D32F2F" Offset="0,3" Radius="8" Opacity="0.3"/>
                            </Border.Shadow>
                            <Button BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    Text="💾 Registrar Gasto"
                                    TextColor="White"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    AutomationId="ButtonSendExpenditures"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Expense Statistics Card -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        
                        <!-- Stats Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="📊" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Resumen de Gastos" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Statistics Grid -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <!-- Today's Expenses -->
                            <Border BackgroundColor="#FFEBEE" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#F44336"
                                    Padding="12"
                                    Grid.Column="0">
                                <StackLayout Spacing="6">
                                    <Label Text="Hoy" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#D32F2F"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TodaysExpenses, StringFormat='$ {0:N0}'}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#B71C1C"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- This Week's Expenses -->
                            <Border BackgroundColor="#FFF3E0" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#FF9800"
                                    Padding="12"
                                    Grid.Column="1">
                                <StackLayout Spacing="6">
                                    <Label Text="Semana" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#F57C00"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding WeeksExpenses, StringFormat='$ {0:N0}'}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#E65100"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- This Month's Expenses -->
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#4CAF50"
                                    Padding="12"
                                    Grid.Column="2">
                                <StackLayout Spacing="6">
                                    <Label Text="Mes" 
                                           FontAttributes="Bold" 
                                           FontSize="12"
                                           TextColor="#388E3C"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding MonthsExpenses, StringFormat='$ {0:N0}'}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#2E7D32"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Expenses List Card -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        
                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="📋" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Gastos Recientes" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Filter Options -->
                        <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                            <Button Text="Hoy" 
                                    BackgroundColor="{Binding FilterButtonColor1}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterTodayCommand}"/>
                            <Button Text="Semana" 
                                    BackgroundColor="{Binding FilterButtonColor2}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterWeekCommand}"/>
                            <Button Text="Mes" 
                                    BackgroundColor="{Binding FilterButtonColor3}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterMonthCommand}"/>
                        </StackLayout>

                        <!-- Expenses Collection -->
                        <CollectionView ItemsSource="{Binding ExpensesList}" 
                                        Margin="0,10,0,0"
                                        AutomationId="CollectionViewExpenses">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#FEFEFE" 
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="#E5E7EB"
                                            Margin="0,4"
                                            Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.08"/>
                                        </Border.Shadow>
                                        
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="8">
                                            
                                            <!-- Category Icon -->
                                            <Border BackgroundColor="#D32F2F" 
                                                    StrokeShape="RoundRectangle 25"
                                                    WidthRequest="50" 
                                                    HeightRequest="50"
                                                    Grid.RowSpan="3" 
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">
                                                <Label Text="💸" 
                                                       FontSize="24" 
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Expense Information -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="{Binding Category}" FontSize="14" FontAttributes="Bold" TextColor="#111827"/>
                                                <Label Text="•" FontSize="12" TextColor="#6B7280" VerticalOptions="Center"/>
                                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" TextColor="#6B7280"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="1" Grid.Column="1">
                                                <Label Text="{Binding Description}" FontSize="13" TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}" LineBreakMode="TailTruncation" MaxLines="2"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <Label Text="💰" FontSize="11" VerticalOptions="Center"/>
                                                <Label Text="{Binding Amount, StringFormat='$ {0:N0}'}" FontSize="12" TextColor="#D32F2F" FontAttributes="Bold"/>
                                            </StackLayout>

                                            <!-- Delete Button -->
                                            <Border BackgroundColor="#FFEBEE" 
                                                    StrokeShape="RoundRectangle 20"
                                                    Stroke="#F44336"
                                                    WidthRequest="40" HeightRequest="40"
                                                    Grid.Column="2" Grid.RowSpan="3"
                                                    VerticalOptions="Center">
                                                <Button Text="✕" 
                                                        BackgroundColor="Transparent"
                                                        TextColor="#F44336"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        WidthRequest="40" HeightRequest="40"
                                                        CornerRadius="20"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteExpenseCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                                    <Label Text="📊" FontSize="48" HorizontalOptions="Center" TextColor="#9CA3AF"/>
                                    <Label Text="No hay gastos registrados" 
                                           FontSize="16" 
                                           TextColor="#6B7280" 
                                           HorizontalOptions="Center"
                                           FontAttributes="Bold"/>
                                    <Label Text="Agregue el primer gasto usando el formulario superior" 
                                           FontSize="14" 
                                           TextColor="#9CA3AF" 
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Margin for Better Scrolling -->
                <BoxView HeightRequest="20" Color="Transparent"/>
                
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>