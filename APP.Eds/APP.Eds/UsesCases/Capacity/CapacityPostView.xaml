<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Capacity.CapacityPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="{Binding GestionCapacityLabel}"
    BackgroundColor="#F8F9FA">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="20">
                
                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="📊 Gestión de Capacidad" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Configure las capacidades de los tanques" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Capacity Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="⚙️" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nueva Capacidad" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"/>
                                <Label Text="Registre las especificaciones de capacidad" 
                                       FontSize="12" 
                                       TextColor="#636E72"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Code Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding CodeLabel}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🔤" 
                                               FontSize="18" 
                                               TextColor="#6A1B9A" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Text"
                                               Placeholder="{Binding CodePlaceholder}"
                                               PlaceholderColor="#9CA3AF"
                                               Text="{Binding Code, Mode=TwoWay}"
                                               AutomationId="EntryCode"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="#374151"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Height Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding HeightLabel}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#E8F5E8" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#4CAF50"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="📏" 
                                               FontSize="18" 
                                               TextColor="#4CAF50" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Numeric"
                                               Placeholder="{Binding HeightPlaceholder}"
                                               PlaceholderColor="#9CA3AF"
                                               Text="{Binding Height, Mode=TwoWay}"
                                               AutomationId="EntryHeight"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="#2E7D32"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                        
                                        <Label Text="m" 
                                               FontSize="14" 
                                               TextColor="#4CAF50"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Volume Measurements Grid -->
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Medidas de Volumen" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       HorizontalOptions="Center"/>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    
                                    <!-- Gallons Field -->
                                    <VerticalStackLayout Spacing="8" Grid.Column="0">
                                        <Label Text="{Binding GallonLabel}" 
                                               FontSize="14" 
                                               FontAttributes="Bold" 
                                               TextColor="#2D3436"
                                               HorizontalOptions="Center"
                                               Margin="4,0,0,0"/>
                                               
                                        <Border BackgroundColor="#E3F2FD" 
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="#2196F3"
                                                StrokeThickness="2"
                                                Padding="0">
                                            <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                                <Label Text="⛽" 
                                                       FontSize="16" 
                                                       TextColor="#2196F3" 
                                                       VerticalOptions="Center"/>
                                                
                                                <Entry Keyboard="Numeric"
                                                       Placeholder="{Binding GallonPlaceholder}"
                                                       PlaceholderColor="#9CA3AF"
                                                       Text="{Binding Gallon, Mode=TwoWay}"
                                                       AutomationId="EntryGallon"
                                                       BackgroundColor="Transparent"
                                                       FontSize="14"
                                                       TextColor="#1976D2"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="FillAndExpand"/>
                                                
                                                <Label Text="gal" 
                                                       FontSize="12" 
                                                       TextColor="#2196F3"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Liters Field -->
                                    <VerticalStackLayout Spacing="8" Grid.Column="1">
                                        <Label Text="{Binding LitersLabel}" 
                                               FontSize="14" 
                                               FontAttributes="Bold" 
                                               TextColor="#2D3436"
                                               HorizontalOptions="Center"
                                               Margin="4,0,0,0"/>
                                               
                                        <Border BackgroundColor="#FFF3E0" 
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="#FF9800"
                                                StrokeThickness="2"
                                                Padding="0">
                                            <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                                <Label Text="🪣" 
                                                       FontSize="16" 
                                                       TextColor="#FF9800" 
                                                       VerticalOptions="Center"/>
                                                
                                                <Entry Keyboard="Numeric"
                                                       Placeholder="{Binding LitersPlaceholder}"
                                                       PlaceholderColor="#9CA3AF"
                                                       Text="{Binding Liters, Mode=TwoWay}"
                                                       AutomationId="EntryLiters"
                                                       BackgroundColor="Transparent"
                                                       FontSize="14"
                                                       TextColor="#F57C00"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="FillAndExpand"/>
                                                
                                                <Label Text="L" 
                                                       FontSize="12" 
                                                       TextColor="#FF9800"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Action Button Section -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                            
                            <!-- Info Card -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2196F3"
                                    Padding="16"
                                    Opacity="0.9">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="ℹ️" 
                                           FontSize="16" 
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="Las capacidades definen las especificaciones técnicas de los tanques, incluyendo dimensiones físicas y volúmenes de almacenamiento."
                                           FontSize="12"
                                           TextColor="#1565C0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Register Button -->
                            <Border Style="{StaticResource PrimarySendButtonStyle}">
                                <Button Text="{Binding SendData}"
                                        TextColor="White" 
                                        BackgroundColor="Transparent"
                                        Clicked="SendCapacityButton"
                                        AutomationId="ButtonSendCapacityData"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        HeightRequest="56"
                                        CornerRadius="16"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Measurement Conversion Guide Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- Guide Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#F3E5F5" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="🧮" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Guía de Conversiones" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"/>
                                <Label Text="Equivalencias entre unidades de medida" 
                                       FontSize="12" 
                                       TextColor="#636E72"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Conversion Information -->
                        <VerticalStackLayout Spacing="12">
                            
                            <!-- Gallon to Liter Conversion -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#2196F3"
                                    Padding="12"
                                    Opacity="0.8">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="⛽" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="1 Galón (US) = 3.78541 Litros"
                                           FontSize="13"
                                           TextColor="#1976D2"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"
                                           FontAttributes="Bold"/>
                                </StackLayout>
                            </Border>

                            <!-- Liter to Gallon Conversion -->
                            <Border BackgroundColor="#FFF3E0" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#FF9800"
                                    Padding="12"
                                    Opacity="0.8">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="🪣" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="1 Litro = 0.264172 Galones (US)"
                                           FontSize="13"
                                           TextColor="#F57C00"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"
                                           FontAttributes="Bold"/>
                                </StackLayout>
                            </Border>

                            <!-- Height Reference -->
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#4CAF50"
                                    Padding="12"
                                    Opacity="0.8">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="📏" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="La altura se mide en metros (m) desde la base del tanque"
                                           FontSize="13"
                                           TextColor="#2E7D32"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"
                                           FontAttributes="Bold"/>
                                </StackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Field Requirements Card -->
                <Border BackgroundColor="#FFF3CD" 
                        StrokeShape="RoundRectangle 12"
                        Stroke="#FFC107"
                        Padding="16">
                    <StackLayout Spacing="12">
                        <!-- Requirements Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="📋" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Campos Requeridos" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="#8A6914"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                        
                        <!-- Requirements List -->
                        <StackLayout Spacing="8">
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label Text="•" FontSize="14" TextColor="#8A6914" VerticalOptions="Start"/>
                                <Label Text="Código: Identificador único alfanumérico del tanque"
                                       FontSize="12" TextColor="#8A6914" 
                                       VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                            
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label Text="•" FontSize="14" TextColor="#8A6914" VerticalOptions="Start"/>
                                <Label Text="Altura: Dimensión vertical en metros (valor decimal permitido)"
                                       FontSize="12" TextColor="#8A6914" 
                                       VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                            
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label Text="•" FontSize="14" TextColor="#8A6914" VerticalOptions="Start"/>
                                <Label Text="Galones: Capacidad en galones estadounidenses (valor decimal)"
                                       FontSize="12" TextColor="#8A6914" 
                                       VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                            
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label Text="•" FontSize="14" TextColor="#8A6914" VerticalOptions="Start"/>
                                <Label Text="Litros: Capacidad en litros (valor entero)"
                                       FontSize="12" TextColor="#8A6914" 
                                       VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>
