<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Capacity.CapacityPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="{Binding GestionCapacityLabel}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="Gestión de Capacidad"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Start"/>
                        <Label Text="Configure las capacidades de los tanques"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalOptions="Start"/>
                    </StackLayout>
                </Border>

                <!-- Capacity Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">

                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <brand:PoliedroIcon Text="⚙️"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nueva Capacidad"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Registre las especificaciones de capacidad"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">

                            <!-- Code Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding CodeLabel}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="🔤"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                               VerticalOptions="Center"/>

                                        <Entry Keyboard="Text"
                                               Placeholder="{Binding CodePlaceholder}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               Text="{Binding Code, Mode=TwoWay}"
                                               AutomationId="EntryCode"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Height Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding HeightLabel}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="📏"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                               VerticalOptions="Center"/>

                                        <Entry Keyboard="Numeric"
                                               Placeholder="{Binding HeightPlaceholder}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               Text="{Binding Height, Mode=TwoWay}"
                                               AutomationId="EntryHeight"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>

                                        <Label Text="m"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Volume Measurements Grid -->
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Medidas de Volumen"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       HorizontalOptions="Center"/>

                                <brand:ResponsiveFormGrid ColumnDefinitions="*,*" ColumnSpacing="12">

                                    <!-- Gallons Field -->
                                    <VerticalStackLayout Spacing="8" Grid.Column="0">
                                        <Label Text="{Binding GallonLabel}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               HorizontalOptions="Center"
                                               Margin="4,0,0,0"/>

                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                                StrokeThickness="2"
                                                Padding="12,0">
                                            <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                                <brand:PoliedroIcon Text="⛽"
                                                       FontSize="16"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                       VerticalOptions="Center"/>

                                                <Entry Keyboard="Numeric"
                                                       Placeholder="{Binding GallonPlaceholder}"
                                                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       Text="{Binding Gallon, Mode=TwoWay, UpdateSourceEventName=TextChanged}"
                                                       TextChanged="EntryGallon_TextChanged"
                                                       AutomationId="EntryGallon"
                                                       BackgroundColor="Transparent"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="FillAndExpand"/>

                                                <Label Text="gal"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Liters Field -->
                                    <VerticalStackLayout Spacing="8" Grid.Column="1">
                                        <Label Text="{Binding LitersLabel}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               HorizontalOptions="Center"
                                               Margin="4,0,0,0"/>

                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                                StrokeThickness="2"
                                                Padding="12,0">
                                            <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                                <brand:PoliedroIcon Text="🪣"
                                                       FontSize="16"
                                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                       VerticalOptions="Center"/>

                                                <Entry Keyboard="Numeric"
                                                       Placeholder="{Binding LitersPlaceholder}"
                                                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       Text="{Binding Liters, Mode=TwoWay, UpdateSourceEventName=TextChanged}"
                                                       TextChanged="EntryGallon_TextChanged"
                                                       AutomationId="EntryLiters"
                                                       BackgroundColor="Transparent"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="FillAndExpand"/>

                                                <Label Text="L"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </StackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </brand:ResponsiveFormGrid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Action Button Section -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">

                            <!-- Info Card -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="16"
                                    Opacity="0.9">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <brand:PoliedroIcon Text="ℹ️"
                                           FontSize="16"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="Las capacidades definen las especificaciones técnicas de los tanques, incluyendo dimensiones físicas y volúmenes de almacenamiento."
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Register Button -->
                            <Border Style="{StaticResource PrimarySendButtonStyle}">
                                <Button Text="{Binding SendData}"
                                        TextColor="{StaticResource OnBrand}"
                                        BackgroundColor="Transparent"
                                        Clicked="SendCapacityButton"
                                        AutomationId="ButtonSendCapacityData"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        MinimumHeightRequest="52"
                                        CornerRadius="16"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Measurement Conversion Guide Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- Guide Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <brand:PoliedroIcon Text="🧮"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Guía de Conversiones"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Equivalencias entre unidades de medida"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Conversion Information -->
                        <VerticalStackLayout Spacing="12">

                            <!-- Gallon to Liter Conversion -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="12"
                                    Opacity="0.8">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <brand:PoliedroIcon Text="⛽" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="1 Galón (US) = 3.78541 Litros"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"
                                           FontAttributes="Bold"/>
                                </StackLayout>
                            </Border>

                            <!-- Liter to Gallon Conversion -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                    Padding="12"
                                    Opacity="0.8">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <brand:PoliedroIcon Text="🪣" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="1 Litro = 0.264172 Galones (US)"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"
                                           FontAttributes="Bold"/>
                                </StackLayout>
                            </Border>

                            <!-- Height Reference -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                    Padding="12"
                                    Opacity="0.8">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <brand:PoliedroIcon Text="📏" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="La altura se mide en metros (m) desde la base del tanque"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"
                                           FontAttributes="Bold"/>
                                </StackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Field Requirements Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                        Padding="16">
                    <StackLayout Spacing="12">
                        <!-- Requirements Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="📋" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Campos Requeridos"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Requirements List -->
                        <StackLayout Spacing="8">
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label Text="•" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" VerticalOptions="Start"/>
                                <Label Text="Código: Identificador único alfanumérico del tanque"
                                       FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                       VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label Text="•" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" VerticalOptions="Start"/>
                                <Label Text="Altura: Dimensión vertical en metros (valor decimal permitido)"
                                       FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                       VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label Text="•" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" VerticalOptions="Start"/>
                                <Label Text="Galones: Capacidad en galones estadounidenses (valor decimal)"
                                       FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                       VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                            </StackLayout>

                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label Text="•" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" VerticalOptions="Start"/>
                                <Label Text="Litros: Capacidad en litros (valor entero)"
                                       FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                       VerticalOptions="Center" HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>
