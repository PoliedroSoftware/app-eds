<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.ProductType.ProductTypePostView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             Title="Gestión de Tipos de Producto"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">

                    <StackLayout>
                        <Label Text="Gestión de Tipos de Producto"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Start"/>
                        <Label Text="Configure categorías y clasificaciones de productos"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                               HorizontalOptions="Start"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Product Type Registration Form Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="20">

                        <!-- Form Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="📝" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Nuevo Tipo de Producto"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Description Field -->
                        <StackLayout Spacing="8">
                            <Label Text="Descripción del Tipo de Producto"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   FontSize="14"/>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    Padding="4">
                                <brand:ResponsiveFormGrid ColumnDefinitions="Auto,*" Padding="12">
                                    <brand:PoliedroIcon Grid.Column="0"
                                           Text="🏷️"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           VerticalOptions="Center"
                                           Margin="0,0,12,0"/>
                                    <Entry Grid.Column="1"
                                           Keyboard="Text"
                                           Placeholder="Ej: Combustibles, Lubricantes, Aditivos"
                                           Text="{Binding Description, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryProductType"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </brand:ResponsiveFormGrid>
                            </Border>
                        </StackLayout>

                        <!-- Action Button -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Margin="0,10,0,0">

                            <Button BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    Text="Crear Tipo de Producto"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="52"
                                    AutomationId="ButtonSendData"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Margin for Better Scrolling -->
                <BoxView HeightRequest="20" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>