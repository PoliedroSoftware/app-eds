<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.ProductType.ProductTypePostView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             Title="Gestion Tipo De Producto">
    <AbsoluteLayout>
    <VerticalStackLayout 
        AbsoluteLayout.LayoutBounds="0,0,1,1"
        AbsoluteLayout.LayoutFlags="All"
        Padding="20" Spacing="15">
        
        <Label FontSize="16" Text="Tipo De Producto"/>
        
        <!-- Picker for existing product types -->
        <StackLayout IsVisible="{Binding IsNotAddingNew}">
            <Picker 
                ItemsSource="{Binding ProductTypeList}"
                ItemDisplayBinding="{Binding Description}"
                SelectedItem="{Binding SelectedProductType, Mode=TwoWay}"
                Title="Seleccione un tipo de producto"
                AutomationId="PickerProductType"/>
            <Button 
                Text="Agregar Nuevo Tipo"
                Command="{Binding AddNewProductTypeCommand}"
                BackgroundColor="LightBlue"
                TextColor="Black"
                CornerRadius="5"
                Margin="0,10,0,0"
                AutomationId="ButtonAddNew"/>
        </StackLayout>
        
        <!-- Entry for new product type -->
        <StackLayout IsVisible="{Binding IsAddingNew}">
            <Entry
                Keyboard="Text"
                Placeholder="Ingresar El Nuevo Tipo De Producto"
                Text="{Binding Description, Mode=TwoWay}"
                AutomationId="EntryProductType"/>
            <Button 
                Text="Cancelar"
                Command="{Binding CancelAddNewCommand}"
                BackgroundColor="LightCoral"
                TextColor="White"
                CornerRadius="5"
                Margin="0,5,0,0"
                AutomationId="ButtonCancel"/>
        </StackLayout>
        
        <Button
            BackgroundColor="Green"
            Clicked="Button_Clicked_1"
            CornerRadius="10"
            Text="Enviar Datos"
            TextColor="White"
            AutomationId="ButtonSendData"/>
    </VerticalStackLayout>
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>