<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.DispenserType.DispenserTypePostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión de Tipos de Dispensador"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- Header Card -->
                <Border BackgroundColor="#2196F3" 
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#2196F3" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="⛽ Gestión de Tipos de Dispensador" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Configure categorías y especificaciones de dispensadores" 
                               FontSize="14" 
                               TextColor="#BBDEFB" 
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Dispenser Type Registration Form Card -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Form Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="⛽" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Nuevo Tipo de Dispensador" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Description Field -->
                        <StackLayout Spacing="8">
                            <Label Text="Descripción del Tipo de Dispensador" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}" 
                                   FontSize="14"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#BBDEFB" 
                                    Padding="4">
                                <Grid ColumnDefinitions="Auto,*" Padding="12">
                                    <Label Grid.Column="0" 
                                           Text="⛽" 
                                           FontSize="18" 
                                           TextColor="#2196F3" 
                                           VerticalOptions="Center"
                                           Margin="0,0,12,0"/>
                                    <Entry Grid.Column="1"
                                           Keyboard="Text"
                                           Placeholder="Ej: Multisurtidor, Surtidor Simple, Auto-Servicio"
                                           Text="{Binding Description, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryDispenserType"
                                           PlaceholderColor="#9CA3AF"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"/>
                                </Grid>
                            </Border>
                        </StackLayout>

                        <!-- Info Card -->
                        <Border BackgroundColor="#E3F2FD" 
                                StrokeShape="RoundRectangle 8"
                                Stroke="#2196F3"
                                Padding="16"
                                Opacity="0.9">
                            <StackLayout Orientation="Horizontal" Spacing="12">
                                <Label Text="💡" 
                                       FontSize="16" 
                                       VerticalOptions="Start"
                                       Margin="0,2,0,0"/>
                                <Label Text="Los tipos de dispensador ayudan a categorizar y organizar los equipos de dispensado en su sistema. Ejemplos: Multisurtidor, Surtidor Simple, Auto-Servicio, Premium."
                                       FontSize="12"
                                       TextColor="#1565C0"
                                       VerticalOptions="Center"
                                       HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                        </Border>

                        <!-- Action Button -->
                        <Border BackgroundColor="#2196F3" 
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Margin="0,10,0,0">
                            <Border.Shadow>
                                <Shadow Brush="#2196F3" Offset="0,3" Radius="8" Opacity="0.3"/>
                            </Border.Shadow>
                            <Button BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    Text="🚀 Crear Tipo de Dispensador"
                                    TextColor="White"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    AutomationId="ButtonSendDispenserType"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Example Types Card -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        
                        <!-- Examples Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="💡" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Ejemplos de Tipos de Dispensador" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Examples Grid -->
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                            
                            <!-- Multisurtidor -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    BackgroundColor="#E3F2FD"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#2196F3"
                                    Padding="12">
                                <StackLayout Spacing="4">
                                    <Label Text="⛽" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="Multisurtidor" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#1976D2"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Múltiples productos, 4-8 mangueras" 
                                           FontSize="11" 
                                           TextColor="#2196F3"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Surtidor Simple -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    BackgroundColor="#E8F5E8"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#4CAF50"
                                    Padding="12">
                                <StackLayout Spacing="4">
                                    <Label Text="⛽" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="Surtidor Simple" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#2E7D32"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Un producto, 1-2 mangueras" 
                                           FontSize="11" 
                                           TextColor="#4CAF50"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Auto-Servicio -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    BackgroundColor="#F3E5F5"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#9C27B0"
                                    Padding="12">
                                <StackLayout Spacing="4">
                                    <Label Text="🤖" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="Auto-Servicio" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#7B1FA2"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Dispensado automático" 
                                           FontSize="11" 
                                           TextColor="#9C27B0"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Premium -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    BackgroundColor="#FFF3E0"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#FF9800"
                                    Padding="12">
                                <StackLayout Spacing="4">
                                    <Label Text="⭐" FontSize="20" HorizontalOptions="Center"/>
                                    <Label Text="Premium" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#F57C00"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Características avanzadas" 
                                           FontSize="11" 
                                           TextColor="#FF9800"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Margin for Better Scrolling -->
                <BoxView HeightRequest="20" Color="Transparent"/>
                
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>