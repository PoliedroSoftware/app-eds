<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.DispenserType.DispenserTypePostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión de Tipos de Dispensador"
    BackgroundColor="#F8F9FA">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- Header Card with Blue Gradient -->
                <Border BackgroundColor="#2196F3" 
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#2196F3" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="🔧 Gestión de Tipos de Dispensador" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Administre los diferentes tipos de dispensadores de combustible" 
                               FontSize="14" 
                               TextColor="#BBDEFB" 
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Dispenser Type Registration Form Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Form Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="⚙️" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Nuevo Tipo de Dispensador" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#2D3436"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Description Input -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Descripción del Tipo de Dispensador" 
                                   FontAttributes="Bold" 
                                   TextColor="#636E72" 
                                   FontSize="14"/>
                            <Border BackgroundColor="#F8F9FA" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#BBDEFB" 
                                    Padding="4">
                                <Entry Keyboard="Text"
                                       Placeholder="Ej: Dispensador de 2 mangueras, Dispensador de alto flujo"
                                       Text="{Binding Description, Mode=TwoWay}"
                                       BackgroundColor="Transparent"
                                       AutomationId="EntryDispenserTypeDescription"
                                       PlaceholderColor="#9CA3AF"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Action Button -->
                        <Border BackgroundColor="#2196F3" 
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Margin="0,10,0,0">
                            <Border.Shadow>
                                <Shadow Brush="#2196F3" Offset="0,3" Radius="8" Opacity="0.3"/>
                            </Border.Shadow>
                            <Button BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    Text="➕ Registrar Tipo de Dispensador"
                                    TextColor="White"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    AutomationId="ButtonSendData"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Dispenser Types List Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        
                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="📋" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Tipos de Dispensador Registrados" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#2D3436"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Dispenser Types Collection -->
                        <CollectionView ItemsSource="{Binding DispenserTypeList}" 
                                        Margin="0,10,0,0"
                                        AutomationId="CollectionViewDispenserTypes">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#FEFEFE" 
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="#E5E7EB"
                                            Margin="0,4"
                                            Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.08"/>
                                        </Border.Shadow>
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                            <!-- Dispenser Type Info -->
                                            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <Label Text="🔧" FontSize="16" VerticalOptions="Center"/>
                                                <Label Text="{Binding Description}" FontSize="14" FontAttributes="Bold" TextColor="#111827"/>
                                            </StackLayout>

                                            <!-- Action Buttons -->
                                            <StackLayout Grid.RowSpan="2" Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                                <Button Text="✏️" 
                                                        Style="{StaticResource IconActionButtonStyle}"
                                                        BackgroundColor="#2196F3"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.EditDispenserTypeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        AutomationId="EditDispenserTypeButton"/>
                                                <Button Text="🗑️" 
                                                        Style="{StaticResource IconActionButtonStyle}"
                                                        BackgroundColor="#F44336"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.DeleteDispenserTypeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        AutomationId="DeleteDispenserTypeButton"/>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                                    <Label Text="🔧" FontSize="48" HorizontalOptions="Center" TextColor="#9CA3AF"/>
                                    <Label Text="No hay tipos de dispensador configurados" 
                                           FontSize="16" 
                                           TextColor="#6B7280" 
                                           HorizontalOptions="Center"
                                           FontAttributes="Bold"/>
                                    <Label Text="Configure el primer tipo de dispensador usando el formulario superior" 
                                           FontSize="14" 
                                           TextColor="#9CA3AF" 
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Margin for Better Scrolling -->
                <BoxView HeightRequest="20" Color="Transparent"/>
                
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>
