<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.RegisterShift.RegisterShiftView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             xmlns:converters="clr-namespace:APP.Eds.Converters"
             Title="Registrar Turno">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DecimalFormatConverter x:Key="DecimalFormat" />
            <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />
            <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
            <converters:NumberToWordsConverter x:Key="NumberToWordsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="RegisterShift">
    <VerticalStackLayout Padding="16" Spacing="16">
                <Border BackgroundColor="#6A1B9A" 
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#6A1B9A" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="🏪 Registro De Turno" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Todos los campos son obligatorios" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <Border x:Name="Business"
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="🏢" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="EDS" 
                   FontAttributes="Bold" 
                   FontSize="18" 
                   TextColor="#2D3436"
                   VerticalOptions="Center"/>
                        </StackLayout>

                        <Grid ColumnDefinitions="100, *" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <!-- EDS -->
                            <Label Text="EDS" 
                   FontAttributes="Bold" 
                   TextColor="#636E72" 
                   VerticalOptions="Center" 
                   Grid.Row="1" Grid.Column="0"/>
                            <Border BackgroundColor="#F8F9FA" 
                    StrokeShape="RoundRectangle 8"
                    Stroke="#DDD6FE" 
                    Grid.Row="1" Grid.Column="1">
                                <Picker Title="Seleccione su EDS"
                        AutomationId="EdsPicker"
                        ItemDisplayBinding="{Binding Name}" 
                        ItemsSource="{Binding EdsList}"
                        SelectedItem="{Binding SelectedEds, Mode=TwoWay}" 
                        SelectedIndexChanged="OnEdsSelected"
                        BackgroundColor="Transparent"
                        Margin="12,8"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="Time" 
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <StackLayout Orientation="Vertical" Spacing="5">
                            <Label Text="⏰" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Horario" 
                     FontAttributes="Bold" 
                     FontSize="18" 
                     TextColor="#2D3436"
                     VerticalOptions="Center"/>
                        </StackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                            <!-- Start Date -->
                            <StackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                <Label Text="Fecha Inicio" 
                         FontAttributes="Bold" 
                         TextColor="#636E72" 
                         HorizontalOptions="Center"/>
                                <Border BackgroundColor="#FFF3CD" 
                          StrokeShape="RoundRectangle 8"
                          Stroke="#F39C12" 
                          Padding="8">
                                    <DatePicker x:Name="datePicker" 
                                  AutomationId="DatePickerStart" 
                                  Date="{Binding DateStart, Mode=TwoWay}" 
                                  MinimumDate="1900-01-01"
                                  BackgroundColor="Transparent"
                                  HorizontalOptions="Center"
                                  TextColor="#E67E22"/>
                                </Border>
                            </StackLayout>

                            <!-- Start Time -->
                            <StackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                <Label Text="Hora Inicio" 
                         FontAttributes="Bold" 
                         TextColor="#636E72" 
                         HorizontalOptions="Center"/>
                                <Border BackgroundColor="#D4EDDA" 
                          StrokeShape="RoundRectangle 8"
                          Stroke="#27AE60" 
                          Padding="8">
                                    <TimePicker AutomationId="StartTimePicker" 
                                  Time="{Binding StartTime, Mode=TwoWay}"
                                  Format="HH:mm"
                                  BackgroundColor="Transparent"
                                  HorizontalOptions="Center"
                                  TextColor="#27AE60"/>
                                </Border>
                            </StackLayout>

                            <!-- End Time -->
                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                                <Label Text="Hora Fin" 
                         FontAttributes="Bold" 
                         TextColor="#636E72" 
                         HorizontalOptions="Center"/>
                                <Border BackgroundColor="#F8D7DA" 
                          StrokeShape="RoundRectangle 8"
                          Stroke="#E74C3C" 
                          Padding="8">
                                    <TimePicker AutomationId="EndTimePicker" 
                                  Time="{Binding EndTime, Mode=TwoWay}"
                                  Format="HH:mm"
                                  BackgroundColor="Transparent"
                                  HorizontalOptions="Center"
                                  TextColor="#E74C3C"/>
                                </Border>
                            </StackLayout>

                            <!-- End Date -->
                            <StackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                <Label Text="Fecha Fin" 
                         FontAttributes="Bold" 
                         TextColor="#636E72" 
                         HorizontalOptions="Center"/>
                                <Border BackgroundColor="#FFF3CD" 
                          StrokeShape="RoundRectangle 8"
                          Stroke="#F39C12" 
                          Padding="8">
                                    <DatePicker 
                                  AutomationId="DatePickerEnd" 
                                  Date="{Binding DateEnd, Mode=TwoWay}" 
                                  MinimumDate="1900-01-01"
                                  BackgroundColor="Transparent"
                                  HorizontalOptions="Center"
                                  TextColor="#E67E22"/>
                                </Border>
                            </StackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Send Button -->
                <Border BackgroundColor="#6A1B9A" 
                        StrokeShape="RoundRectangle 12"
                        Padding="4"
                        Margin="0,10,0,0">
                    <Border.Shadow>
                        <Shadow Brush="#6A1B9A" Offset="0,3" Radius="8" Opacity="0.3"/>
                    </Border.Shadow>
                    <Button BackgroundColor="Transparent"
                            Text="🚀 Registrar Turno"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Command="{Binding SaveRegisterShiftCommand}"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>

    </AbsoluteLayout>
</ContentPage>