<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.Dispensers.DispensersPostView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             xmlns:button="clr-namespace:APP.Eds.Controls"
             Title="Gestión de Dispensadores">
    <ScrollView>
        <VerticalStackLayout 
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            Padding="20" Spacing="15">
                <Label FontSize="16" Text="Código"/>
                <Entry
            Keyboard="Text"
            Placeholder="Ingresar Dispensador"
            Text="{Binding Code, Mode=TwoWay}" 
            AutomationId="EntryDispenserCode"/>

                <Label FontSize="16" Text="Numero"/>
                <Entry
            Keyboard="Numeric"
            Placeholder="Digite Numero"
            Text="{Binding Number, Mode=TwoWay}" 
            AutomationId="EntryDispenserNumber"/>

                <Picker Title="Seleccione un Dispensador"
            ItemsSource="{Binding DispenserTypeList}"
            ItemDisplayBinding="{Binding Description}"
            SelectedItem="{Binding SelectedDispenserType, Mode=TwoWay}" 
            AutomationId="PickerDispenserType"/>

                <Picker Title="Seleccione un EDS"
            ItemsSource="{Binding EdsList}"
            ItemDisplayBinding="{Binding Name}"
            SelectedItem="{Binding SelectedEds, Mode=TwoWay}"
            AutomationId="PickerEds"/>

                <Picker Title="Seleccione una Isla"
            ItemsSource="{Binding IslandList}"
            ItemDisplayBinding="{Binding Description}"
            SelectedItem="{Binding SelectedIsland, Mode=TwoWay}"
            AutomationId="PickerIsland"/>

                <Label FontSize="16" Text="Numero de Manguera"/>
                <Entry
            Keyboard="Numeric"
            Placeholder="Enter Hose Number"
            Text="{Binding HoseNumber, Mode=TwoWay}"
            AutomationId="EntryHoseNumber"/>

                <button:HoverButton
                    BackgroundColor="Green"
                    Clicked="Button_Clicked_1"
                    WidthRequest="200"
                    HeightRequest="60"
                    CornerRadius="10"
                    Text="Enviar Datos"
                    HoverColor="Gray"
                    PressedColor="AliceBlue"
                    TextColor="White" 
                    AutomationId="ButtonSendData"/>
                
                <Label FontSize="18" Text="Lista de Dispensadores"/>

                <CollectionView ItemsSource="{Binding EdsList}" Margin="0,20,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout>
                                <Label Text="{Binding Number,StringFormat='Compartimiento {0:N0}'}" FontSize="16" Grid.Row="1" Grid.Column="3" HorizontalOptions="Center" Margin="0,20,0,5"/>
                                <Frame Padding="0">
                                    <Grid ColumnDefinitions="20,*,20,*,10" RowDefinitions="10,*,*,*,*,*,*,*,*,10">
                                        <!--<Label Text="{Binding Number, StringFormat='Compartimiento {0:N0}'}" FontSize="16" Grid.Row="1" Grid.ColumnSpan="5" HorizontalOptions="Center"/>-->

                                        <Label Text="Capacidad nominal"  Grid.Row="3" Grid.Column="1"/>
                                        <Label Text=""  Grid.Row="3" Grid.Column="3"/>

                                        <Label Text="Capacidad operativa"  Grid.Row="4" Grid.Column="1"/>
                                        <Label Text=""  Grid.Row="4" Grid.Column="3"/>
                                        <BoxView Grid.Row="4" Grid.ColumnSpan="5" ZIndex="-1"/>

                                        <Label Text="Stock"  Grid.Row="5" Grid.Column="1"/>
                                        <Label Text=""  Grid.Row="5" Grid.Column="3"/>

                                        <Label Text="Altura"  Grid.Row="6" Grid.Column="1"/>
                                        <Label Text="{Binding Height}"  Grid.Row="6" Grid.Column="3"/>
                                        <BoxView Grid.Row="6" Grid.ColumnSpan="5" ZIndex="-1"/>

                                        <Label Text="Tanque"  Grid.Row="7" Grid.Column="1"/>
                                        <Label Text="{Binding IdTank}"  Grid.Row="7" Grid.Column="3"/>

                                    </Grid>
                                </Frame>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            <controls:LoadingView x:Name="LoadingOverlay"
                                  AbsoluteLayout.LayoutBounds="0,0,1,1"
                                  AbsoluteLayout.LayoutFlags="All"
                                  AutomationId="LoadingOverlay"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
