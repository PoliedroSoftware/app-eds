<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Tank.TankPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="{Binding GestionTankTitle}"
    BackgroundColor="#F8F9FA">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="20">
                
                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="🛢️ Gestión de Tanques" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Administre los tanques de almacenamiento" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Tank Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="⚙️" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nuevo Tanque" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"/>
                                <Label Text="Registre un nuevo tanque de almacenamiento" 
                                       FontSize="12" 
                                       TextColor="#636E72"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Tank Number Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding TankNumberLabel}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🔢" 
                                               FontSize="18" 
                                               TextColor="#6A1B9A" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Text"
                                               Placeholder="{Binding TankNumberPlaceholder}"
                                               PlaceholderColor="#9CA3AF"
                                               Text="{Binding Number, Mode=TwoWay}"
                                               AutomationId="EntryTankNumber"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="#374151"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Grid for Compartment and Capacity -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                
                                <!-- Compartment Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="0">
                                    <Label Text="{Binding TankCompartmentLabel}" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#2D3436"
                                           Margin="4,0,0,0"/>
                                           
                                    <Border BackgroundColor="#F8F9FA" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="#DDD6FE"
                                            StrokeThickness="2"
                                            Padding="0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <Label Text="📦" 
                                                   FontSize="16" 
                                                   TextColor="#2196F3" 
                                                   VerticalOptions="Center"/>
                                            
                                            <Entry Keyboard="Numeric"
                                                   Placeholder="{Binding CompartmentPlacheholder}"
                                                   PlaceholderColor="#9CA3AF"
                                                   Text="{Binding Compartment, Mode=TwoWay}"
                                                   AutomationId="EntryCompartment"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="#374151"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Capacity Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="1">
                                    <Label Text="{Binding Capacity}" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#2D3436"
                                           Margin="4,0,0,0"/>
                                           
                                    <Border BackgroundColor="#F8F9FA" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="#DDD6FE"
                                            StrokeThickness="2"
                                            Padding="0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <Label Text="📏" 
                                                   FontSize="16" 
                                                   TextColor="#FF9800" 
                                                   VerticalOptions="Center"/>
                                            
                                            <Entry Keyboard="Numeric"
                                                   Placeholder="Ingrese la capacidad"
                                                   PlaceholderColor="#9CA3AF"
                                                   Text="{Binding Ability, Mode=TwoWay}"
                                                   AutomationId="EntryCapacity"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="#374151"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Action Button -->
                            <Border Style="{StaticResource PrimarySendButtonStyle}">
                                <Button Text="{Binding SendData}"
                                        TextColor="White" 
                                        BackgroundColor="Transparent"
                                        Clicked="SendData"
                                        AutomationId="ButtonSendData"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        HeightRequest="56"
                                        CornerRadius="16"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Tank List Section -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#FFF3E0" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="📋" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Lista de Tanques" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"/>
                                <Label Text="Tanques registrados en el sistema" 
                                       FontSize="12" 
                                       TextColor="#636E72"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Tank List -->
                        <CollectionView ItemsSource="{Binding TankList}" 
                                      Margin="0,20"
                                      AutomationId="CollectionViewTankList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#FAFAFA" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="#E0E0E0"
                                            Margin="0,4"
                                            Padding="16">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding Number, StringFormat='Tanque {0}'}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#2D3436"/>
                                                <Label Text="{Binding Compartment, StringFormat='Compartimientos: {0}'}"
                                                       FontSize="14"
                                                       TextColor="#636E72"/>
                                                <Label Text="{Binding Ability, StringFormat='Capacidad: {0}'}"
                                                       FontSize="14"
                                                       TextColor="#636E72"/>
                                                <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"
                                                       FontSize="14"
                                                       TextColor="#636E72"/>
                                            </StackLayout>
                                            <Button Grid.Column="1"
                                                   Text="✏️"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditTankCommand}"
                                                   CommandParameter="{Binding .}"
                                                   BackgroundColor="Transparent"
                                                   FontSize="18"
                                                   WidthRequest="40"
                                                   HeightRequest="40"
                                                   Padding="0"
                                                   VerticalOptions="Center"/>
                                            <Button Grid.Column="2"
                                                   Text="❌"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteTankCommand}"
                                                   CommandParameter="{Binding .}"
                                                   BackgroundColor="Transparent"
                                                   FontSize="18"
                                                   WidthRequest="40"
                                                   HeightRequest="40"
                                                   Padding="0"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>