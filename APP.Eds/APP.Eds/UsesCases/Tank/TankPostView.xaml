<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.Tank.TankPostView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             Title="{Binding GestionTankTitle}">
    <ScrollView>
        <AbsoluteLayout>
            <VerticalStackLayout
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All"
                Padding="20" Spacing="15">
                <Label FontSize="16" Text="{Binding TankNumberLabel}"/>
                <Entry
                Keyboard="Text"
                Placeholder="{Binding TankNumberPlaceholder}"
                Text="{Binding Number, Mode=TwoWay}"
                AutomationId="EntryTankNumber"/>

                <Label FontSize="16" Text="{Binding TankCompartmentLabel}"/>
                <Entry
	            Keyboard="Text"
	            Placeholder="{Binding CompartmentPlacheholder}"
	            Text="{Binding Compartment, Mode=TwoWay}"
                AutomationId="EntryCompartment"/>

                <Label FontSize="16" Text="{Binding Capacity}"/>
                <Entry
                Keyboard="Text"
                Placeholder="Ingresa La Capacidad"
                Text="{Binding Ability, Mode=TwoWay}"
                AutomationId="EntryCapacity"/>

                <Label FontSize="16" Text="{Binding StockLabel}"/>
                <Entry
                Keyboard="Text"
                Placeholder="{Binding StockPlaceholder}"
                Text="{Binding Stock, Mode=TwoWay}"
                AutomationId="EntryStock"/>

                <Button
                BackgroundColor="Green"
                Clicked="SendData"
                CornerRadius="10"
                Text="{Binding SendData}"
                TextColor="White"
                AutomationId="ButtonSendData"/>

                <Label FontSize="18" Text="Lista De Tanques" />
                <CollectionView ItemsSource="{Binding TankList}" Margin="0,20"
                                AutomationId="CollectionViewTankList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Grid Padding="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Text="{Binding Id}" FontSize="14" Grid.Row="0" />
                                <Label Text="{Binding Nmber}" FontSize="14" Grid.Row="1" />
                                <Label Text="{Binding Compartment}" FontSize="14" Grid.Row="2" />
                                <Label Text="{Binding Ability}" FontSize="14" Grid.Row="3" />
                                <Label Text="{Binding Stock}" FontSize="14" Grid.Row="4" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            <controls:LoadingView x:Name="LoadingOverlay"
                                  AbsoluteLayout.LayoutBounds="0,0,1,1"
                                  AbsoluteLayout.LayoutFlags="All"
                                  AutomationId="LoadingOverlay"/>
        </AbsoluteLayout>
    </ScrollView>
</ContentPage>