<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Tank.TankPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="{Binding GestionTankTitle}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="Gestión de Tanques"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Start"/>
                        <Label Text="Administre los tanques de almacenamiento"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalOptions="Start"/>
                    </StackLayout>
                </Border>

                <!-- Tank Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">

                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <brand:PoliedroIcon Text="⚙️"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nuevo Tanque"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Registre un nuevo tanque de almacenamiento"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">

                            <!-- Tank Number Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding TankNumberLabel}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="🔢"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                               VerticalOptions="Center"/>

                                        <Entry Keyboard="Text"
                                               Placeholder="{Binding TankNumberPlaceholder}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               Text="{Binding Number, Mode=TwoWay}"
                                               AutomationId="EntryTankNumber"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Grid for Compartment and Capacity -->
                            <brand:ResponsiveFormGrid ColumnDefinitions="*,*" ColumnSpacing="12">

                                <!-- Compartment Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="0">
                                    <Label Text="{Binding TankCompartmentLabel}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           Margin="4,0,0,0"/>

                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                            StrokeThickness="2"
                                            Padding="12,0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <brand:PoliedroIcon Text="📦"
                                                   FontSize="16"
                                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                   VerticalOptions="Center"/>

                                            <Entry Keyboard="Numeric"
                                                   Placeholder="{Binding CompartmentPlacheholder}"
                                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   Text="{Binding Compartment, Mode=TwoWay}"
                                                   AutomationId="EntryCompartment"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Capacity Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="1">
                                    <Label Text="{Binding Capacity}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           Margin="4,0,0,0"/>

                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                            StrokeThickness="2"
                                            Padding="12,0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <brand:PoliedroIcon Text="📏"
                                                   FontSize="16"
                                                   TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                   VerticalOptions="Center"/>

                                            <Entry Keyboard="Numeric"
                                                   Placeholder="Ingresa La Capacidad"
                                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   Text="{Binding Ability, Mode=TwoWay}"
                                                   AutomationId="EntryCapacity"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </brand:ResponsiveFormGrid>
                        </VerticalStackLayout>

                        <!-- Action Button Section -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">

                            <!-- Info Card -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="16"
                                    Opacity="0.9">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <brand:PoliedroIcon Text="ℹ️"
                                           FontSize="16"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="Los tanques almacenan el combustible antes de ser dispensado. Cada tanque tiene compartimientos que pueden contener diferentes tipos de combustible."
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Register Button -->
                            <Border Style="{StaticResource PrimarySendButtonStyle}">
                                <Button Text="{Binding SendData}"
                                        TextColor="{StaticResource OnBrand}"
                                        BackgroundColor="Transparent"
                                        Clicked="SendData"
                                        AutomationId="ButtonSendData"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        MinimumHeightRequest="52"
                                        CornerRadius="16"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Tanks List Section -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <brand:PoliedroIcon Text="📋"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Lista de Tanques"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Tanques registrados en el sistema"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Tanks List -->
                        <CollectionView ItemsSource="{Binding TankList}"
                                        AutomationId="CollectionViewTankList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            Margin="0,4"
                                            Padding="16">


                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                                            <!-- Tank Icon -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                    StrokeShape="RoundRectangle 16"
                                                    WidthRequest="40" HeightRequest="40"
                                                    Grid.RowSpan="5" Grid.Column="0"
                                                    VerticalOptions="Start">
                                                <brand:PoliedroIcon Text="🛢️"
                                                       FontSize="18"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Tank Info -->
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="0" Grid.Column="1">
                                                <Label Text="ID:" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Id}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="1" Grid.Column="1">
                                                <Label Text="Número:" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Nmber}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="2" Grid.Column="1">
                                                <Label Text="Compartimientos:" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Compartment}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="3" Grid.Column="1">
                                                <Label Text="Capacidad:" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Ability, StringFormat='{0:N2} L'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="4" Grid.Column="1">
                                                <Label Text="Stock:" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Stock, StringFormat='{0:N2} L'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>