<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Island.IslandPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestion De Islas"
    BackgroundColor="#F8F9FA">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- Header Card with Blue Gradient -->
                <Border BackgroundColor="#1976D2" 
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#1976D2" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="🏝️ Gestion De Islas" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Configure las islas de combustible y sus dispensadores" 
                               FontSize="14" 
                               TextColor="#BBDEFB" 
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Island Registration Form Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Form Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="⚙️" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Configuracion de Nueva Isla" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#2D3436"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Island Information Grid -->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="12">
                            
                            <!-- Name/Identifier -->
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Nombre/Identificador" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       FontSize="14"/>
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#BBDEFB" 
                                        Padding="4">
                                    <Entry Keyboard="Text"
                                           Placeholder="Ej: Isla A, Isla 1"
                                           Text="{Binding IslandName, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryIslandName"
                                           PlaceholderColor="#9CA3AF"/>
                                </Border>
                            </StackLayout>

                            <!-- Location -->
                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Ubicacion" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       FontSize="14"/>
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#BBDEFB" 
                                        Padding="4">
                                    <Picker Title="Seleccione ubicacion"
                                            ItemsSource="{Binding LocationOptions}"
                                            SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerLocation"/>
                                </Border>
                            </StackLayout>

                            <!-- Type -->
                            <StackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Tipo de Isla" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       FontSize="14"/>
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#BBDEFB" 
                                        Padding="4">
                                    <Picker Title="Seleccione tipo"
                                            ItemsSource="{Binding IslandTypes}"
                                            SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerType"/>
                                </Border>
                            </StackLayout>

                            <!-- Capacity -->
                            <StackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Capacidad (Dispensadores)" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       FontSize="14"/>
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#BBDEFB" 
                                        Padding="4">
                                    <Picker Title="Max dispensadores"
                                            ItemsSource="{Binding CapacityOptions}"
                                            SelectedItem="{Binding SelectedCapacity, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerCapacity"/>
                                </Border>
                            </StackLayout>

                            <!-- Status -->
                            <StackLayout Grid.Row="2" Grid.Column="0">
                                <Label Text="Estado Operativo" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       FontSize="14"/>
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#BBDEFB" 
                                        Padding="4">
                                    <Picker Title="Seleccione estado"
                                            ItemsSource="{Binding StatusOptions}"
                                            SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerStatus"/>
                                </Border>
                            </StackLayout>

                            <!-- Installation Date -->
                            <StackLayout Grid.Row="2" Grid.Column="1">
                                <Label Text="Fecha de Instalacion" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       FontSize="14"/>
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#BBDEFB" 
                                        Padding="4">
                                    <DatePicker Date="{Binding InstallationDate, Mode=TwoWay}"
                                                BackgroundColor="Transparent"
                                                AutomationId="DatePickerInstallation"/>
                                </Border>
                            </StackLayout>

                            <!-- Description -->
                            <StackLayout Grid.Row="3" Grid.ColumnSpan="2">
                                <Label Text="Descripcion/Observaciones" 
                                       FontAttributes="Bold" 
                                       TextColor="#636E72" 
                                       FontSize="14"/>
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#BBDEFB" 
                                        Padding="4">
                                    <Editor Placeholder="Descripcion detallada, caracteristicas especiales, etc."
                                            Text="{Binding Description, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="EditorDescription"
                                            PlaceholderColor="#9CA3AF"
                                            HeightRequest="80"/>
                                </Border>
                            </StackLayout>
                        </Grid>

                        <!-- Action Button -->
                        <Border BackgroundColor="#1976D2" 
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Margin="0,10,0,0">
                            <Border.Shadow>
                                <Shadow Brush="#1976D2" Offset="0,3" Radius="8" Opacity="0.3"/>
                            </Border.Shadow>
                            <Button BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    Text="🏗️ Registrar Isla"
                                    TextColor="White"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    HeightRequest="50"
                                    AutomationId="ButtonSaveData"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Island Statistics Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        
                        <!-- Stats Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="📊" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Estado de las Islas" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#2D3436"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Statistics Grid -->
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <!-- Total Islands -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#2196F3"
                                    Padding="12"
                                    Grid.Column="0">
                                <StackLayout Spacing="6">
                                    <Label Text="Total" 
                                           FontAttributes="Bold" 
                                           FontSize="11"
                                           TextColor="#1976D2"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalIslands}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#0D47A1"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Active Islands -->
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#4CAF50"
                                    Padding="12"
                                    Grid.Column="1">
                                <StackLayout Spacing="6">
                                    <Label Text="Activas" 
                                           FontAttributes="Bold" 
                                           FontSize="11"
                                           TextColor="#388E3C"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding ActiveIslands}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#2E7D32"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Maintenance Islands -->
                            <Border BackgroundColor="#FFF3E0" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#FF9800"
                                    Padding="12"
                                    Grid.Column="2">
                                <StackLayout Spacing="6">
                                    <Label Text="Mant." 
                                           FontAttributes="Bold" 
                                           FontSize="11"
                                           TextColor="#F57C00"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding MaintenanceIslands}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#E65100"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Inactive Islands -->
                            <Border BackgroundColor="#FFEBEE" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#F44336"
                                    Padding="12"
                                    Grid.Column="3">
                                <StackLayout Spacing="6">
                                    <Label Text="Inact." 
                                           FontAttributes="Bold" 
                                           FontSize="11"
                                           TextColor="#D32F2F"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding InactiveIslands}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#B71C1C"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Islands List Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        
                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="🏝️" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Lista de Islas Configuradas" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   TextColor="#2D3436"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Filter Options -->
                        <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                            <Button Text="Todas" 
                                    BackgroundColor="{Binding FilterAllColor}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterAllCommand}"/>
                            <Button Text="Activas" 
                                    BackgroundColor="{Binding FilterActiveColor}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterActiveCommand}"/>
                            <Button Text="Mantenimiento" 
                                    BackgroundColor="{Binding FilterMaintenanceColor}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterMaintenanceCommand}"/>
                        </StackLayout>

                        <!-- Islands Collection -->
                        <CollectionView ItemsSource="{Binding IslandList}" 
                                        Margin="0,10,0,0"
                                        AutomationId="CollectionViewIslandList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#FEFEFE" 
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="#E5E7EB"
                                            Margin="0,4"
                                            Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.08"/>
                                        </Border.Shadow>
                                        
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="8">
                                            
                                            <!-- Island Icon -->
                                            <Border BackgroundColor="#1976D2" 
                                                    StrokeShape="RoundRectangle 25"
                                                    WidthRequest="50" 
                                                    HeightRequest="50"
                                                    Grid.RowSpan="4" 
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">
                                                <Label Text="⛽" 
                                                       FontSize="24" 
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Island Information -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="ID:" FontAttributes="Bold" FontSize="12" TextColor="#6B7280"/>
                                                <Label Text="{Binding Idisland}" FontSize="12" TextColor="#374151"/>
                                                <Border BackgroundColor="#E3F2FD"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="6,2"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Status, FallbackValue='Activa'}" 
                                                           FontSize="10" 
                                                           FontAttributes="Bold"
                                                           TextColor="#1976D2"/>
                                                </Border>
                                            </StackLayout>

                                            <StackLayout Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="🏷️" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Name, FallbackValue='Isla sin nombre'}" FontSize="14" FontAttributes="Bold" TextColor="#111827"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="📋" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Description}" FontSize="13" TextColor="#374151" LineBreakMode="TailTruncation" MaxLines="1"/>
                                            </StackLayout>

                                            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                                    <Label Text="📍" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding Location, FallbackValue='No especificada'}" FontSize="12" TextColor="#6B7280"/>
                                                </StackLayout>
                                                
                                                <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalOptions="End">
                                                    <Label Text="🔧" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding Capacity, FallbackValue='0'}" FontSize="12" TextColor="#1976D2" FontAttributes="Bold"/>
                                                    <Label Text="disp." FontSize="11" TextColor="#6B7280" VerticalOptions="Center"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <StackLayout Grid.Column="2" Grid.RowSpan="4" VerticalOptions="Center" Spacing="8">
                                                <!-- Edit Button -->
                                                <Border BackgroundColor="#E8F5E8" 
                                                        StrokeShape="RoundRectangle 15"
                                                        Stroke="#4CAF50"
                                                        WidthRequest="30" HeightRequest="30">
                                                    <Button Text="✏️" 
                                                            BackgroundColor="Transparent"
                                                            TextColor="#4CAF50"
                                                            FontSize="12"
                                                            WidthRequest="30" HeightRequest="30"
                                                            CornerRadius="15"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditIslandCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Border>
                                                
                                                <!-- Delete Button -->
                                                <Border BackgroundColor="#FFEBEE" 
                                                        StrokeShape="RoundRectangle 15"
                                                        Stroke="#F44336"
                                                        WidthRequest="30" HeightRequest="30">
                                                    <Button Text="🗑️" 
                                                            BackgroundColor="Transparent"
                                                            TextColor="#F44336"
                                                            FontSize="12"
                                                            WidthRequest="30" HeightRequest="30"
                                                            CornerRadius="15"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteIslandCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Border>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                                    <Label Text="🏝️" FontSize="48" HorizontalOptions="Center" TextColor="#9CA3AF"/>
                                    <Label Text="No hay islas configuradas" 
                                           FontSize="16" 
                                           TextColor="#6B7280" 
                                           HorizontalOptions="Center"
                                           FontAttributes="Bold"/>
                                    <Label Text="Configure la primera isla usando el formulario superior" 
                                           FontSize="14" 
                                           TextColor="#9CA3AF" 
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Margin for Better Scrolling -->
                <BoxView HeightRequest="20" Color="Transparent"/>
                
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>