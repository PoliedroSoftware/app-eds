<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.TypeOfCollection.TypeOfCollectionPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:button="clr-namespace:APP.Eds.Controls"
    Title="Gestion de Formas de Pago"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header Card with Green Gradient -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">

                    <StackLayout>
                        <Label Text="Gestion de Formas de Pago"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Start"/>
                        <Label Text="Configure metodos de pago y procesamiento de transacciones"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                               HorizontalOptions="Start"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Payment Method Registration Form Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="20">

                        <!-- Form Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="🏦" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Configurar Nueva Forma de Pago"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Payment Method Information Grid -->
                        <brand:ResponsiveFormGrid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="12">

                            <!-- Payment Type -->
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Tipo de Pago"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Picker Title="Seleccione tipo"
                                            ItemsSource="{Binding PaymentTypes}"
                                            SelectedItem="{Binding SelectedPaymentType, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerPaymentType"/>
                                </Border>
                            </StackLayout>

                            <!-- Payment Method -->
                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Metodo de Pago"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Picker Title="Seleccione metodo"
                                            ItemsSource="{Binding PaymentMethods}"
                                            SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerPaymentMethod"/>
                                </Border>
                            </StackLayout>

                            <!-- Name -->
                            <StackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Nombre/Descripcion"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Keyboard="Text"
                                           Placeholder="Ej: Efectivo, Tarjeta Debito"
                                           Text="{Binding PaymentName, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryPaymentName"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- Provider -->
                            <StackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Proveedor/Procesador"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Keyboard="Text"
                                           Placeholder="Ej: Visa, MasterCard, PSE"
                                           Text="{Binding PaymentProvider, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryPaymentProvider"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- Processing Fee -->
                            <StackLayout Grid.Row="2" Grid.Column="0">
                                <Label Text="Comision (%)"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Keyboard="Numeric"
                                           Placeholder="0.00"
                                           Text="{Binding ProcessingFee, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryProcessingFee"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- Status -->
                            <StackLayout Grid.Row="2" Grid.Column="1">
                                <Label Text="Estado"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Picker Title="Estado del metodo"
                                            ItemsSource="{Binding StatusOptions}"
                                            SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerStatus"/>
                                </Border>
                            </StackLayout>

                            <!-- Configuration Settings -->
                            <StackLayout Grid.Row="3" Grid.ColumnSpan="2">
                                <Label Text="Configuraciones Especiales"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <StackLayout Orientation="Horizontal" Spacing="16">
                                    <StackLayout Orientation="Horizontal" Spacing="6">
                                        <CheckBox IsChecked="{Binding RequiresAuth, Mode=TwoWay}"
                                                  Color="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                  AutomationId="CheckBoxRequiresAuth"/>
                                        <Label Text="Requiere Autorizacion"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="6">
                                        <CheckBox IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                                  Color="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                  AutomationId="CheckBoxIsDefault"/>
                                        <Label Text="Metodo por Defecto"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center"/>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>

                            <!-- Description -->
                            <StackLayout Grid.Row="4" Grid.ColumnSpan="2">
                                <Label Text="Observaciones/Notas"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Editor Placeholder="Configuraciones adicionales, limitaciones, etc."
                                            Text="{Binding Description, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="EditorDescription"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                            HeightRequest="80"/>
                                </Border>
                            </StackLayout>
                        </brand:ResponsiveFormGrid>

                        <!-- Action Button -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Margin="0,10,0,0">

                            <Button BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    Text="Registrar Forma de Pago"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="52"
                                    AutomationId="ButtonSendData"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Payment Methods Statistics Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <!-- Stats Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="📊" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Resumen de Formas de Pago"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Statistics Grid -->
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <!-- Total Methods -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                    Padding="12"
                                    Grid.Column="0">
                                <StackLayout Spacing="6">
                                    <Label Text="Total"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalPaymentMethods}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Active Methods -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="12"
                                    Grid.Column="1">
                                <StackLayout Spacing="6">
                                    <Label Text="Activos"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding ActivePaymentMethods}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Digital Methods -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="12"
                                    Grid.Column="2">
                                <StackLayout Spacing="6">
                                    <Label Text="Digital"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding DigitalPaymentMethods}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Cash Methods -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                    Padding="12"
                                    Grid.Column="3">
                                <StackLayout Spacing="6">
                                    <Label Text="Efectivo"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding CashPaymentMethods}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Payment Methods List Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="💳" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Formas de Pago Configuradas"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Filter Options -->
                        <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                            <Button Text="Todas"
                                    BackgroundColor="{Binding FilterAllColor}"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterAllCommand}"/>
                            <Button Text="Activas"
                                    BackgroundColor="{Binding FilterActiveColor}"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterActiveCommand}"/>
                            <Button Text="Digitales"
                                    BackgroundColor="{Binding FilterDigitalColor}"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterDigitalCommand}"/>
                        </StackLayout>

                        <!-- Payment Methods Collection -->
                        <CollectionView ItemsSource="{Binding PaymentMethodsList}"
                                        Margin="0,10,0,0"
                                        AutomationId="CollectionViewPaymentMethods">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            Margin="0,4"
                                            Padding="16">


                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="8">

                                            <!-- Payment Icon -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                                    StrokeShape="RoundRectangle 25"
                                                    WidthRequest="50"
                                                    HeightRequest="50"
                                                    Grid.RowSpan="4"
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Icon, FallbackValue='💳'}"
                                                       FontSize="24"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                       HorizontalOptions="Start"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Payment Method Information -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="6,2"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Status}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                                </Border>
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="6,2"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding IsDefault}">
                                                    <Label Text="DEFECTO"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"/>
                                                </Border>
                                            </StackLayout>

                                            <StackLayout Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <brand:PoliedroIcon Text="🏦" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Type}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                <Label Text="•" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center"/>
                                                <Label Text="{Binding Provider}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <brand:PoliedroIcon Text="📄" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Description}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" LineBreakMode="TailTruncation" MaxLines="1"/>
                                            </StackLayout>

                                            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                                    <brand:PoliedroIcon Text="💰" FontSize="12" VerticalOptions="Center"/>
                                                    <Label Text="Comision:" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center"/>
                                                    <Label Text="{Binding ProcessingFee, StringFormat='{0}%'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" FontAttributes="Bold"/>
                                                </StackLayout>

                                                <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalOptions="End">
                                                    <brand:PoliedroIcon Text="🔐" FontSize="12" VerticalOptions="Center" IsVisible="{Binding RequiresAuth}"/>
                                                    <Label Text="Auth Req." FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" VerticalOptions="Center" IsVisible="{Binding RequiresAuth}"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <StackLayout Grid.Column="2" Grid.RowSpan="4" VerticalOptions="Center" Spacing="8">
                                                <!-- Edit Button -->
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 15"
                                                        Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                        WidthRequest="30" HeightRequest="30">
                                                    <Button Text="✏️"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                            FontSize="12"
                                                            WidthRequest="30" HeightRequest="30"
                                                            CornerRadius="15"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditPaymentMethodCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Border>

                                                <!-- Delete Button -->
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 15"
                                                        Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                        WidthRequest="30" HeightRequest="30">
                                                    <Button Text="🗑️"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                            FontSize="12"
                                                            WidthRequest="30" HeightRequest="30"
                                                            CornerRadius="15"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeletePaymentMethodCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Border>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                                    <brand:PoliedroIcon Text="💳" FontSize="48" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label Text="No hay formas de pago configuradas"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"
                                           FontAttributes="Bold"/>
                                    <Label Text="Configure la primera forma de pago usando el formulario superior"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Margin for Better Scrolling -->
                <BoxView HeightRequest="20" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>