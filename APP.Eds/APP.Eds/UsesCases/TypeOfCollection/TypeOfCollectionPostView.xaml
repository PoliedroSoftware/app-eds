<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP.Eds.UsesCases.TypeOfCollection.TypeOfCollectionPostView"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             xmlns:button="clr-namespace:APP.Eds.Controls"
             Title="{Binding DescriptionTitle}">
    <AbsoluteLayout>
        <VerticalStackLayout
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            Padding="20" Spacing="15">
        <Label FontSize="16" Text="{Binding DescriptionLabel}"/>
        <Entry
            Keyboard="Text"
            Placeholder="{Binding DescriptionPlaceHolder}"
            Text="{Binding Description, Mode=TwoWay}"
            AutomationId="EntryDescription"/>
        <button:HoverButton
            BackgroundColor="Green"
            Clicked="Button_Clicked_1"
            WidthRequest="200"
            HeightRequest="60"
            CornerRadius="10"
            HoverColor="Gray"
            PressedColor="AliceBlue"
            Text="{Binding SendData}"
            TextColor="White"
            AutomationId="ButtonSendData"/>
    </VerticalStackLayout>
        <controls:LoadingView x:Name="LoadingOverlay"
                          AbsoluteLayout.LayoutBounds="0,0,1,1"
                          AbsoluteLayout.LayoutFlags="All"
                          AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>