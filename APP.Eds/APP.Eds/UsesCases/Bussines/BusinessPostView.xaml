<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Business.BusinessPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:behaviors="clr-namespace:APP.Eds.UsesCases.Behaviors"
    Title="Gestion de Negocios"
    BackgroundColor="#F8F9FA">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="24">
                
                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="🏢 Gestion de Negocios" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Administre sus unidades de negocio" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Quick Actions Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Acciones rapidas" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#2D3436"
                               HorizontalOptions="Center"/>
                        
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <!-- View List Button -->
                            <Border Grid.Column="0" 
                                    BackgroundColor="#E3F2FD"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2196F3"
                                    Padding="0">
                                <Button Text="📋 Ver Lista"
                                        BackgroundColor="Transparent"
                                        TextColor="#1976D2"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        HeightRequest="48"
                                        Clicked="OnViewListClicked"
                                        AutomationId="ButtonViewBusinessList"/>
                            </Border>
                            
                            <!-- New Business Button -->
                            <Border Grid.Column="1" 
                                    BackgroundColor="#E8F5E8"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#4CAF50"
                                    Padding="0">
                                <Button Text="➕ Nuevo"
                                        BackgroundColor="Transparent"
                                        TextColor="#388E3C"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        HeightRequest="48"
                                        Clicked="OnClearFormClicked"
                                        AutomationId="ButtonNewBusiness"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Business Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="🏪" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nuevo Negocio" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"/>
                                <Label Text="Registre una nueva unidad de negocio" 
                                       FontSize="12" 
                                       TextColor="#636E72"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Business Name Input Section -->
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Nombre del Negocio" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="#2D3436"
                                   Margin="4,0,0,0"/>
                                   
                            <Border BackgroundColor="#F8F9FA" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#DDD6FE"
                                    StrokeThickness="2"
                                    Padding="0">
                                <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                    <Label Text="🏢" 
                                           FontSize="18" 
                                           TextColor="#6A1B9A" 
                                           VerticalOptions="Center"/>
                                    
                                    <Entry Keyboard="Text"
                                           Placeholder="Ingrese el nombre del negocio"
                                           PlaceholderColor="#9CA3AF"
                                           Text="{Binding Name, Mode=TwoWay}"
                                           AutomationId="EntryBusinessName"
                                           BackgroundColor="Transparent"
                                           FontSize="16"
                                           TextColor="#374151"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand">
                                        <Entry.Behaviors>
                                            <behaviors:LettersOnlyBehavior />
                                        </Entry.Behaviors>
                                    </Entry>
                                </StackLayout>
                                
                                <!-- Border animation triggers -->
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding ShowNameError}" Value="True">
                                        <Setter Property="Stroke" Value="#F44336"/>
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <!-- Error Message -->
                            <Border BackgroundColor="#FFEBEE" 
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#F44336"
                                    Padding="12,8"
                                    IsVisible="{Binding ShowNameError}">
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Label Text="⚠️" 
                                           FontSize="14" 
                                           VerticalOptions="Center"/>
                                    <Label Text="Por favor, ingrese un nombre valido. Solo se permiten letras."
                                           TextColor="#D32F2F"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Register Button -->
                        <Border Style="{StaticResource PrimarySendButtonStyle}">
                            <Button Text="🚀 Registrar Negocio"
                                    TextColor="White" 
                                    BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    AutomationId="ButtonSendBusinessData"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    HeightRequest="56"
                                    CornerRadius="16"/>
                        </Border>

                        <!-- Info Card -->
                        <Border BackgroundColor="#E3F2FD" 
                                StrokeShape="RoundRectangle 12"
                                Stroke="#2196F3"
                                Padding="16"
                                Opacity="0.9">
                            <StackLayout Orientation="Horizontal" Spacing="12">
                                <Label Text="ℹ️" 
                                       FontSize="16" 
                                       VerticalOptions="Start"
                                       Margin="0,2,0,0"/>
                                <Label Text="El negocio es la unidad principal que agrupa todas las estaciones de servicio (EDS) bajo una misma administracion."
                                       FontSize="12"
                                       TextColor="#1565C0"
                                       VerticalOptions="Center"
                                       HorizontalOptions="FillAndExpand"/>
                            </StackLayout>
                        </Border>

                        <!-- Help Section -->
                        <Border BackgroundColor="#FFF3E0" 
                                StrokeShape="RoundRectangle 12"
                                Stroke="#FF9800"
                                Padding="16"
                                Opacity="0.9">
                            <StackLayout Spacing="8">
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Label Text="💡" FontSize="16" VerticalOptions="Center"/>
                                    <Label Text="Proximos pasos despues del registro:"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#E65100"
                                           VerticalOptions="Center"/>
                                </StackLayout>
                                
                                <StackLayout Spacing="4" Margin="24,0,0,0">
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label Text="1." FontSize="12" TextColor="#F57C00" FontAttributes="Bold"/>
                                        <Label Text="Agregar estaciones de servicio (EDS)"
                                               FontSize="12" TextColor="#F57C00"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label Text="2." FontSize="12" TextColor="#F57C00" FontAttributes="Bold"/>
                                        <Label Text="Configurar tanques e islas"
                                               FontSize="12" TextColor="#F57C00"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label Text="3." FontSize="12" TextColor="#F57C00" FontAttributes="Bold"/>
                                        <Label Text="Asignar isleros y productos"
                                               FontSize="12" TextColor="#F57C00"/>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>