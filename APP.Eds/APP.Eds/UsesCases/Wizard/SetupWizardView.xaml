<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="APP.Eds.UsesCases.Wizard.SetupWizardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:APP.Eds.Converters.Wizard"
    xmlns:controls="clr-namespace:APP.Eds.Controls"
    xmlns:behaviors="clr-namespace:APP.Eds.UsesCases.Behaviors"
             Title="Configuración del Sistema">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <Frame BackgroundColor="{AppThemeBinding Light=#F3E8FF, Dark=#2A263B}"
                        BorderColor="{AppThemeBinding Light=#E9D5FF, Dark=#3B3757}"
                        HasShadow="False"
                        CornerRadius="12">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Complete todos los pasos para configurar su sistema EDS"
                                FontSize="16"
                                TextColor="{AppThemeBinding Light=#5B21B6, Dark=#C4B5FD}"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>

                <ScrollView>
                    <VerticalStackLayout Padding="20" Spacing="20">

                        <!-- Business Section -->
                        <Label Text="🏢 Negocio"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#1565C0"/>
                        <Label Text="Nombre del Negocio" 
                                        FontAttributes="Bold" 
                                        TextColor="#636E72" 
                                        FontSize="14"/>
                        <Border BackgroundColor="#F8F9FA" 
                                         StrokeShape="RoundRectangle 8"
                                         Stroke="#BFDBFE" 
                                         Padding="4">
                            <Entry Keyboard="Text"
                                            Placeholder="Ingrese el nombre completo del negocio"
                                            Text="{Binding Name}"
                                            BackgroundColor="Transparent"
                                            AutomationId="EntryBusinessName"
                                            PlaceholderColor="#9CA3AF">
                                <Entry.Behaviors>
                                    <behaviors:LettersOnlyBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </Border>
                        <!-- Error Message -->
                        <Border BackgroundColor="#FEF2F2" 
                                StrokeShape="RoundRectangle 8"
                                Stroke="#F87171" 
                                Padding="8"
                                IsVisible="{Binding ShowNameError}">
                            <Label Text="El nombre debe tener al menos 3 caracteres" 
                                   FontSize="12" 
                                   TextColor="#DC2626"/>
                        </Border>

                        <!-- EDS -->
                        <toolkit:Expander IsExpanded="True">
                            <toolkit:Expander.Header>
                                <Label Text="⛽ EDS"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="Black"
                                       Padding="10,5" />
                            </toolkit:Expander.Header>
                            <VerticalStackLayout>
                                <CollectionView ItemsSource="{Binding EdsList}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame BorderColor="#E0E0E0" Padding="10" Margin="0,5">
                                                <VerticalStackLayout>
                                                    <!-- Nombre de la EDS -->
                                                    <StackLayout Spacing="8">
                                                        <Label Text="Nombre de la EDS" 
                                                               FontSize="15" 
                                                               FontAttributes="Bold" 
                                                               TextColor="{StaticResource Gray900}"
                                                               Margin="4,0,0,0"/>

                                                        <Border BackgroundColor="{StaticResource Gray50}" 
                                                                StrokeShape="RoundRectangle 15"
                                                                StrokeThickness="2"
                                                                Stroke="#E8F5E8">
                                                            <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                                                <Border Grid.Column="0"
                                                                        BackgroundColor="#E8F5E8"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        WidthRequest="32"
                                                                        HeightRequest="32">
                                                                    <Label Text="N" 
                                                                           FontSize="16" 
                                                                           FontAttributes="Bold"
                                                                           TextColor="#2E7D32"
                                                                           FontFamily="{OnPlatform Android='monospace', iOS='Menlo', Default='Courier New'}"
                                                                           HorizontalOptions="Center" 
                                                                           VerticalOptions="Center"/>
                                                                </Border>

                                                                <Entry Grid.Column="1"
                                                                       Keyboard="Text"
                                                                       Placeholder="Ingrese el nombre"
                                                                       PlaceholderColor="{StaticResource Gray400}"
                                                                       Text="{Binding Name, Mode=TwoWay}"
                                                                       AutomationId="EntryName"
                                                                       BackgroundColor="Transparent"
                                                                       FontSize="16"
                                                                       TextColor="{StaticResource Gray900}"
                                                                       VerticalOptions="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackLayout>

                                                    <!-- NIT -->
                                                    <StackLayout Spacing="8">
                                                        <Label Text="NIT" 
                                                               FontSize="15" 
                                                               FontAttributes="Bold" 
                                                               TextColor="{StaticResource Gray900}"
                                                               Margin="4,0,0,0"/>

                                                        <Border BackgroundColor="{StaticResource Gray50}" 
                                                                StrokeShape="RoundRectangle 15"
                                                                StrokeThickness="2"
                                                                Stroke="#E3F2FD">
                                                            <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                                                <Border Grid.Column="0"
                                                                        BackgroundColor="#E3F2FD"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        WidthRequest="32"
                                                                        HeightRequest="32">
                                                                    <Label Text="ID" 
                                                                           FontSize="12" 
                                                                           FontAttributes="Bold"
                                                                           TextColor="#1565C0"
                                                                           FontFamily="{OnPlatform Android='monospace', iOS='Menlo', Default='Courier New'}"
                                                                           HorizontalOptions="Center" 
                                                                           VerticalOptions="Center"/>
                                                                </Border>

                                                                <Entry Grid.Column="1"
                                                                       Keyboard="Text"
                                                                       Placeholder="Ingrese el NIT"
                                                                       PlaceholderColor="{StaticResource Gray400}"
                                                                       Text="{Binding Nit, Mode=TwoWay}"
                                                                       AutomationId="EntryNit"
                                                                       BackgroundColor="Transparent"
                                                                       FontSize="16"
                                                                       TextColor="{StaticResource Gray900}"
                                                                       VerticalOptions="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackLayout>

                                                    <!-- Dirección -->
                                                    <StackLayout Spacing="8">
                                                        <Label Text="Dirección" 
                                                               FontSize="15" 
                                                               FontAttributes="Bold" 
                                                               TextColor="{StaticResource Gray900}"
                                                               Margin="4,0,0,0"/>

                                                        <Border BackgroundColor="{StaticResource Gray50}" 
                                                                StrokeShape="RoundRectangle 15"
                                                                StrokeThickness="2"
                                                                Stroke="#FFF3E0">
                                                            <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                                                <Border Grid.Column="0"
                                                                        BackgroundColor="#FFF3E0"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        WidthRequest="32"
                                                                        HeightRequest="32">
                                                                    <Label Text="📍" 
                                                                           FontSize="16"
                                                                           HorizontalOptions="Center" 
                                                                           VerticalOptions="Center"/>
                                                                </Border>

                                                                <Entry Grid.Column="1"
                                                                       Keyboard="Text"
                                                                       Placeholder="Ingrese la dirección"
                                                                       PlaceholderColor="{StaticResource Gray400}"
                                                                       Text="{Binding Address, Mode=TwoWay}"
                                                                       AutomationId="EntryAddress"
                                                                       BackgroundColor="Transparent"
                                                                       FontSize="16"
                                                                       TextColor="{StaticResource Gray900}"
                                                                       VerticalOptions="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackLayout>

                                                    <!-- SICOM -->
                                                    <StackLayout Spacing="8">
                                                        <Label Text="SICOM" 
                                                               FontSize="15" 
                                                               FontAttributes="Bold" 
                                                               TextColor="{StaticResource Gray900}"
                                                               Margin="4,0,0,0"/>

                                                        <Border BackgroundColor="{StaticResource Gray50}" 
                                                                StrokeShape="RoundRectangle 15"
                                                                StrokeThickness="2"
                                                                Stroke="#F3E5F5">
                                                            <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                                                <Border Grid.Column="0"
                                                                        BackgroundColor="#F3E5F5"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        WidthRequest="32"
                                                                        HeightRequest="32">
                                                                    <Label Text="🔢" 
                                                                           FontSize="16"
                                                                           HorizontalOptions="Center" 
                                                                           VerticalOptions="Center"/>
                                                                </Border>

                                                                <Entry Grid.Column="1"
                                                                       Keyboard="Text"
                                                                       Placeholder="Ingrese SITCOM"
                                                                       PlaceholderColor="{StaticResource Gray400}"
                                                                       Text="{Binding Sicom, Mode=TwoWay}"
                                                                       AutomationId="EntrySicom"
                                                                       BackgroundColor="Transparent"
                                                                       FontSize="16"
                                                                       TextColor="{StaticResource Gray900}"
                                                                       VerticalOptions="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackLayout>
                                                    <Button Text="Eliminar"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveEdsCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="IndianRed"
                                                            TextColor="White" />
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Button Text="Agregar EDS" Command="{Binding AddEdsCommand}" BackgroundColor="#2196F3" TextColor="White" />
                            </VerticalStackLayout>
                        </toolkit:Expander>

                        <!-- Islands -->
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Label 
                                    Text="🏝️ Islas"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    TextColor="Black"
                                    Padding="10,5" />
                            </toolkit:Expander.Header>
                            <VerticalStackLayout>
                                <CollectionView ItemsSource="{Binding Islands}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid BackgroundColor="#E3F2FD" Padding="15,10" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Label Grid.Column="0" 
                                                       Text="🏝️" 
                                                       FontSize="16" 
                                                       VerticalOptions="Center"
                                                       Margin="0,0,10,0" />

                                                <Frame Grid.Column="1" 
                                                       BackgroundColor="White" 
                                                       CornerRadius="5"
                                                       Padding="5"
                                                       HasShadow="False">
                                                    <Entry Text="{Binding Number, Mode=TwoWay}"
                                                           Keyboard="Numeric"
                                                           FontSize="14"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Center"
                                                           BackgroundColor="Transparent"
                                                           Placeholder="Núm"
                                                           AutomationId="EntryIslandNumber" />
                                                </Frame>

                                                <Label Grid.Column="2" 
                                                       Text="{Binding Name}" 
                                                       FontSize="16" 
                                                       TextColor="#1976D2"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"
                                                       Margin="10,0,0,0" />

                                                <Button Grid.Column="3"
                                                        Text="✕"
                                                        BackgroundColor="#FF5722"
                                                        TextColor="White"
                                                        FontSize="12"
                                                        CornerRadius="15"
                                                        HeightRequest="37"
                                                        WidthRequest="40"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveIslandCommand}"
                                                        CommandParameter="{Binding .}"
                                                        AutomationId="ButtonRemoveIsland" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Button Text="Agregar Isla" Command="{Binding AddIslandCommand}" BackgroundColor="#2196F3" TextColor="White"/>
                            </VerticalStackLayout>
                        </toolkit:Expander>

                        <!-- Tanks -->
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Label 
                                    Text="🛢️ Tanques"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    TextColor="Black"
                                    Padding="10,5" />
                            </toolkit:Expander.Header>
                            <VerticalStackLayout>
                                <CollectionView ItemsSource="{Binding Tanks}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame Padding="10" BorderColor="#E0E0E0" Margin="0,5">
                                                <VerticalStackLayout Spacing="16">

                                                    <!-- Tank Number Field -->
                                                    <VerticalStackLayout Spacing="8">
                                                        <Label Text="Número" 
                                                               FontSize="14" 
                                                               FontAttributes="Bold" 
                                                               TextColor="#2D3436"
                                                               Margin="4,0,0,0"/>

                                                        <Border BackgroundColor="#F8F9FA" 
                                                                StrokeShape="RoundRectangle 12"
                                                                Stroke="#DDD6FE"
                                                                StrokeThickness="2"
                                                                Padding="0">
                                                            <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                <Label Text="🔢" 
                                                                       FontSize="18" 
                                                                       TextColor="#6A1B9A" 
                                                                       VerticalOptions="Center"/>

                                                                <Entry Keyboard="Text"
                                                                       Placeholder="Ingrese el número de tanque"
                                                                       PlaceholderColor="#9CA3AF"
                                                                       Text="{Binding Number, Mode=TwoWay}"
                                                                       AutomationId="EntryTankNumber"
                                                                       BackgroundColor="Transparent"
                                                                       FontSize="16"
                                                                       TextColor="#374151"
                                                                       VerticalOptions="Center"
                                                                       HorizontalOptions="FillAndExpand"/>
                                                            </StackLayout>
                                                        </Border>
                                                    </VerticalStackLayout>

                                                    <!-- Grid for Compartment and Capacity -->
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                                                        <!-- Compartment Field -->
                                                        <VerticalStackLayout Spacing="8" Grid.Column="0">
                                                            <Label Text="Compartimiento" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold" 
                                                                   TextColor="#2D3436"
                                                                   Margin="4,0,0,0"/>

                                                            <Border BackgroundColor="#F8F9FA" 
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="#DDD6FE"
                                                                    StrokeThickness="2"
                                                                    Padding="0">
                                                                <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                                                    <Label Text="📦" 
                                                                           FontSize="16" 
                                                                           TextColor="#2196F3" 
                                                                           VerticalOptions="Center"/>

                                                                    <Entry Keyboard="Numeric"
                                                                           Placeholder="Ingresa Cantidad"
                                                                           PlaceholderColor="#9CA3AF"
                                                                           Text="{Binding Compartment, Mode=TwoWay}"
                                                                           AutomationId="EntryCompartment"
                                                                           BackgroundColor="Transparent"
                                                                           FontSize="14"
                                                                           TextColor="#374151"
                                                                           VerticalOptions="Center"
                                                                           HorizontalOptions="FillAndExpand"/>
                                                                </StackLayout>
                                                            </Border>
                                                        </VerticalStackLayout>

                                                        <!-- Capacity Field -->
                                                        <VerticalStackLayout Spacing="8" Grid.Column="1">
                                                            <Label Text="Capacidad" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold" 
                                                                   TextColor="#2D3436"
                                                                   Margin="4,0,0,0"/>

                                                            <Border BackgroundColor="#F8F9FA" 
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="#DDD6FE"
                                                                    StrokeThickness="2"
                                                                    Padding="0">
                                                                <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                                                    <Label Text="📏" 
                                                                           FontSize="16" 
                                                                           TextColor="#FF9800" 
                                                                           VerticalOptions="Center"/>

                                                                    <Entry Keyboard="Numeric"
                                                                           Placeholder="Ingresa La Capacidad"
                                                                           PlaceholderColor="#9CA3AF"
                                                                           Text="{Binding Ability, Mode=TwoWay}"
                                                                           AutomationId="EntryCapacity"
                                                                           BackgroundColor="Transparent"
                                                                           FontSize="14"
                                                                           TextColor="#374151"
                                                                           VerticalOptions="Center"
                                                                           HorizontalOptions="FillAndExpand"/>
                                                                </StackLayout>
                                                            </Border>
                                                        </VerticalStackLayout>
                                                    </Grid>

                                                    <!-- EDS Selection (NUEVO) -->
                                                    <VerticalStackLayout Spacing="8">
                                                        <StackLayout Orientation="Horizontal" Spacing="4">
                                                            <Label Text="Estación de Servicio (EDS)" 
                                                                    FontSize="14" 
                                                                    FontAttributes="Bold" 
                                                                    TextColor="#2D3436"
                                                                    Margin="4,0,0,0"/>
                                                            <Label Text="*" 
                                                                    FontSize="14" 
                                                                    FontAttributes="Bold" 
                                                                    TextColor="#E74C3C"
                                                                    VerticalOptions="Start"/>
                                                        </StackLayout>

                                                        <Border BackgroundColor="#F8F9FA" 
                                                                 StrokeShape="RoundRectangle 12"
                                                                 Stroke="#DDD6FE"
                                                                 StrokeThickness="2"
                                                                 Padding="0">
                                                            <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                <Label Text="🏪" 
                                                                        FontSize="18" 
                                                                        TextColor="#8B5CF6" 
                                                                        VerticalOptions="Center"/>

                                                                <Picker x:Name="EdsPicker"
                                                                         Title="Seleccione una estación de servicio"
                                                                         ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EdsList}"
                                                                         ItemDisplayBinding="{Binding Name}"
                                                                         SelectedItem="{Binding SelectedEds, Mode=TwoWay}"
                                                                         AutomationId="PickerEds"
                                                                         BackgroundColor="Transparent"
                                                                         FontSize="16"
                                                                         TextColor="#374151"
                                                                         VerticalOptions="Center"
                                                                         HorizontalOptions="FillAndExpand"/>
                                                            </StackLayout>
                                                        </Border>

                                                        <Label Text="Campo obligatorio. Seleccione la estación de servicio a la que pertenece este producto."
                                                                FontSize="12"
                                                                TextColor="#636E72"
                                                                Margin="4,0,0,0"/>
                                                    </VerticalStackLayout>

                                                    <Button Text="Eliminar" 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveTankCommand}"
                                                            CommandParameter="{Binding .}" 
                                                            BackgroundColor="IndianRed"
                                                            TextColor="White"/>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Button Text="Agregar Tanque" Command="{Binding AddTankCommand}" BackgroundColor="#2196F3" TextColor="White"/>
                            </VerticalStackLayout>
                        </toolkit:Expander>

                        <!-- Products -->
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Label 
                                      Text="📦 Productos"
                                      FontAttributes="Bold"
                                      FontSize="18"
                                      TextColor="Black"
                                      Padding="10,5" />
                            </toolkit:Expander.Header>
                            <VerticalStackLayout>
                                <CollectionView ItemsSource="{Binding Products}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame Padding="10" BorderColor="#E0E0E0" Margin="0,5">
                                                <VerticalStackLayout Spacing="20">

                                                    <!-- Form Fields -->
                                                    <VerticalStackLayout Spacing="16">

                                                        <!-- Product Category Selection -->
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Text="Tipo de Producto" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold" 
                                                                   TextColor="#2D3436"
                                                                   Margin="4,0,0,0"/>

                                                            <Border BackgroundColor="#F8F9FA" 
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="#DDD6FE"
                                                                    StrokeThickness="2"
                                                                    Padding="0">
                                                                <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                    <Label Text="⛽" 
                                                                           FontSize="18" 
                                                                           TextColor="#6A1B9A" 
                                                                           VerticalOptions="Center"/>

                                                                    <Picker Title="Seleccione el tipo de producto"
                                                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ProductOptions}"
                                                                            ItemDisplayBinding="{Binding Name}"
                                                                            SelectedItem="{Binding SelectedProductOption, Mode=TwoWay}"
                                                                            AutomationId="PickerProductCategory"
                                                                            BackgroundColor="Transparent"
                                                                            FontSize="16"
                                                                            TextColor="#374151"
                                                                            VerticalOptions="Center"
                                                                            HorizontalOptions="FillAndExpand"/>
                                                                </StackLayout>
                                                            </Border>
                                                            <Label Text="Seleccione el tipo principal de combustible que desea registrar" 
                                                                   FontSize="12" 
                                                                   TextColor="#636E72"
                                                                   Margin="4,0,0,0"/>
                                                        </VerticalStackLayout>

                                                        <!-- Product Subtype Selection (Only for Gasolina) -->
                                                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsProductTypeSelectionVisible}">
                                                            <Label Text="Tipo de Gasolina" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold" 
                                                                   TextColor="#2D3436"
                                                                   Margin="4,0,0,0"/>

                                                            <Border BackgroundColor="#F8F9FA" 
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="#DDD6FE"
                                                                    StrokeThickness="2"
                                                                    Padding="0">
                                                                <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                    <Label Text="✨" 
                                                                           FontSize="18" 
                                                                           TextColor="#4CAF50" 
                                                                           VerticalOptions="Center"/>

                                                                    <Picker Title="Seleccione el tipo de gasolina"
                                                                            ItemsSource="{Binding FilteredProductTypes}"
                                                                            ItemDisplayBinding="{Binding Description}"
                                                                            SelectedItem="{Binding SelectedSpecificProductType, Mode=TwoWay}"
                                                                            AutomationId="PickerProductSubtype"
                                                                            BackgroundColor="Transparent"
                                                                            FontSize="16"
                                                                            TextColor="#374151"
                                                                            VerticalOptions="Center"
                                                                            HorizontalOptions="FillAndExpand"/>
                                                                </StackLayout>
                                                            </Border>
                                                            <Label Text="Seleccione si es gasolina corriente o extra" 
                                                                   FontSize="12" 
                                                                   TextColor="#636E72"
                                                                   Margin="4,0,0,0"/>
                                                        </VerticalStackLayout>

                                                        <!-- ACPM Automatic Selection Message -->
                                                        <Border BackgroundColor="#E8F5E8" 
                                                                StrokeShape="RoundRectangle 12"
                                                                Stroke="#4CAF50"
                                                                Padding="16"
                                                                IsVisible="{Binding IsAcpmSelected}">
                                                            <StackLayout Orientation="Horizontal" Spacing="12">
                                                                <Label Text="🚛" 
                                                                       FontSize="16" 
                                                                       VerticalOptions="Start"
                                                                       Margin="0,2,0,0"/>
                                                                <Label Text="ACPM seleccionado automáticamente. El tipo de producto se asignará como ACPM."
                                                                       FontSize="12"
                                                                       TextColor="#2E7D32"
                                                                       VerticalOptions="Center"
                                                                       HorizontalOptions="FillAndExpand"/>
                                                            </StackLayout>
                                                        </Border>

                                                        <!-- Product Name Display (Read-only) -->
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Text="Nombre del Producto" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold" 
                                                                   TextColor="#2D3436"
                                                                   Margin="4,0,0,0"/>

                                                            <Border BackgroundColor="#F0F0F0" 
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="#E0E0E0"
                                                                    StrokeThickness="1"
                                                                    Padding="0">
                                                                <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                    <Label Text="🏷️" 
                                                                           FontSize="18" 
                                                                           TextColor="#757575" 
                                                                           VerticalOptions="Center"/>

                                                                    <Label Text="{Binding Name}"
                                                                           AutomationId="LabelProductName"
                                                                           FontSize="16"
                                                                           TextColor="#424242"
                                                                           VerticalOptions="Center"
                                                                           HorizontalOptions="FillAndExpand"
                                                                           BackgroundColor="Transparent"/>
                                                                </StackLayout>
                                                            </Border>
                                                            <Label Text="El nombre se genera automáticamente basado en su selección" 
                                                                   FontSize="12" 
                                                                   TextColor="#636E72"
                                                                   Margin="4,0,0,0"/>
                                                        </VerticalStackLayout>

                                                        <!-- Purchase Price Field -->
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Text="Precio de Compra" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold" 
                                                                   TextColor="#2D3436"
                                                                   Margin="4,0,0,0"/>

                                                            <Border BackgroundColor="#F8F9FA" 
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="#DDD6FE"
                                                                    StrokeThickness="2"
                                                                    Padding="0">
                                                                <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                    <Label Text="🛒" 
                                                                           FontSize="18" 
                                                                           TextColor="#FF6B35" 
                                                                           VerticalOptions="Center"/>

                                                                    <Entry Keyboard="Numeric"
                                                                           Placeholder="0.00 (opcional)"
                                                                           PlaceholderColor="#9CA3AF"
                                                                           Text="{Binding PurchasePrice, Mode=TwoWay}"
                                                                           AutomationId="EntryPurchasePrice"
                                                                           BackgroundColor="Transparent"
                                                                           FontSize="16"
                                                                           TextColor="#374151"
                                                                           VerticalOptions="Center"
                                                                           HorizontalOptions="FillAndExpand"/>
                                                                </StackLayout>
                                                            </Border>
