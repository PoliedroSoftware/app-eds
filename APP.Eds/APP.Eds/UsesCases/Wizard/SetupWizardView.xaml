                                                                               HorizontalOptions="FillAndExpand"/>
                                                                    </StackLayout>
                                                                </Border>
                                                            </VerticalStackLayout>
                                                        </Grid>

                                                        <!-- Dispenser Selection -->
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Text="Dispensador" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold" 
                                                                   TextColor="#2D3436"
                                                                   Margin="4,0,0,0"/>

                                                            <Border BackgroundColor="#F8F9FA" 
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="#DDD6FE"
                                                                    StrokeThickness="2"
                                                                    Padding="0">
                                                                <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                    <Label Text="🔧" 
                                                                           FontSize="18" 
                                                                           TextColor="#FF9800" 
                                                                           VerticalOptions="Center"/>

                                                                    <Picker Title="Seleccione un Dispensador"
                                                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Dispensers}"
                                                                            ItemDisplayBinding="{Binding DisplayName}"
                                                                            SelectedItem="{Binding SelectedDispenser, Mode=TwoWay}"
                                                                            AutomationId="PickerDispensers"
                                                                            BackgroundColor="Transparent"
                                                                            FontSize="16"
                                                                            TextColor="#374151"
                                                                            VerticalOptions="Center"
                                                                            HorizontalOptions="FillAndExpand"/>
                                                                </StackLayout>
                                                            </Border>
                                                        </VerticalStackLayout>

                                                        <!-- Product Type Selection -->
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Text="Tipo de Producto" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold" 
                                                                   TextColor="#2D3436"
                                                                   Margin="4,0,0,0"/>

                                                            <Border BackgroundColor="#F8F9FA" 
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="#DDD6FE"
                                                                    StrokeThickness="2"
                                                                    Padding="0">
                                                                <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                    <Label Text="🛢️" 
                                                                           FontSize="18" 
                                                                           TextColor="#9C27B0" 
                                                                           VerticalOptions="Center"/>

                                                                    <Picker Title="Seleccione un Tipo de Producto"
                                                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ProductTypeList}"
                                                                            ItemDisplayBinding="{Binding Description}"
                                                                            SelectedItem="{Binding SelectProductType, Mode=TwoWay}"
                                                                            AutomationId="PickerProductType"
                                                                            BackgroundColor="Transparent"
                                                                            FontSize="16"
                                                                            TextColor="#374151"
                                                                            VerticalOptions="Center"
                                                                            HorizontalOptions="FillAndExpand"/>
                                                                </StackLayout>
                                                            </Border>
                                                        </VerticalStackLayout>
                                                        <!-- Compartiment Selection -->
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Text="Compartimiento" 
                                                                   FontSize="14" 
                                                                   FontAttributes="Bold" 
                                                                   TextColor="#2D3436"
                                                                   Margin="4,0,0,0"/>

                                                            <Border BackgroundColor="#F8F9FA" 
                                                                    StrokeShape="RoundRectangle 12"
                                                                    Stroke="#DDD6FE"
                                                                    StrokeThickness="2"
                                                                    Padding="0">
                                                                <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                    <Label Text="🔧" 
                                                                           FontSize="18" 
                                                                           TextColor="#FF9800" 
                                                                           VerticalOptions="Center"/>

                                                                    <Picker Title="Seleccione un Compartimiento"
                                                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Compartiments}"
                                                                            ItemDisplayBinding="{Binding DisplayCompartiment}"
                                                                            SelectedItem="{Binding SelectedCompartiment, Mode=TwoWay}"
                                                                            AutomationId="PickerCompartiments"
                                                                            BackgroundColor="Transparent"
                                                                            FontSize="16"
                                                                            TextColor="#374151"
                                                                            VerticalOptions="Center"
                                                                            HorizontalOptions="FillAndExpand"/>
                                                                </StackLayout>
                                                            </Border>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>

                                                    <Button Text="Eliminar" 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveHoseCommand}"
                                                            CommandParameter="{Binding .}" 
                                                            BackgroundColor="IndianRed"
                                                            TextColor="White"/>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Button Text="Agregar Manguera" Command="{Binding AddHoseCommand}" BackgroundColor="#2196F3" TextColor="White"/>
                            </VerticalStackLayout>
                        </toolkit:Expander>


                        <!-- Islanders -->
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Label 
                                 Text="👷 Isleros"
                                 FontAttributes="Bold"
                                 FontSize="18"
                                 TextColor="Black"
                                 Padding="10,5" />
                            </toolkit:Expander.Header>
                            <VerticalStackLayout>
                                <CollectionView ItemsSource="{Binding Islanders}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame Padding="10" BorderColor="#E0E0E0" Margin="0,5">
                                                <VerticalStackLayout Spacing="20">
                                                    <!-- Personal Information Grid -->
                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="12">

                                                        <!-- Name -->
                                                        <StackLayout Grid.Row="0" Grid.Column="0">
                                                            <Label Text="Usuario" 
                                                                    FontAttributes="Bold" 
                                                                    TextColor="#636E72" 
                                                                    FontSize="14"/>
                                                            <Border BackgroundColor="#F8F9FA" 
                                                                     StrokeShape="RoundRectangle 8"
                                                                     Stroke="#DDD6FE" 
                                                                     Padding="4">
                                                                <Entry Keyboard="Text"
                                                                        Placeholder="Usuario del islero"
                                                                        Text="{Binding Name, Mode=TwoWay}"
                                                                        BackgroundColor="Transparent"
                                                                        AutomationId="EntryName"
                                                                        PlaceholderColor="#9CA3AF"/>
                                                            </Border>
                                                        </StackLayout>

                                                        <!-- First Name -->
                                                        <StackLayout Grid.Row="0" Grid.Column="1">
                                                            <Label Text="Nombre completo" 
                                                                    FontAttributes="Bold" 
                                                                    TextColor="#636E72" 
                                                                    FontSize="14"/>
                                                            <Border BackgroundColor="#F8F9FA" 
                                                                     StrokeShape="RoundRectangle 8"
                                                                     Stroke="#DDD6FE" 
                                                                     Padding="4">
                                                                <Entry Keyboard="Text"
                                                                        Placeholder="Nombre completo"
                                                                        Text="{Binding FirstName, Mode=TwoWay}"
                                                                        BackgroundColor="Transparent"
                                                                        AutomationId="EntryFirstName"
                                                                        PlaceholderColor="#9CA3AF"/>
                                                            </Border>
                                                        </StackLayout>

                                                        <!-- Last Name -->
                                                        <StackLayout Grid.Row="1" Grid.Column="0">
                                                            <Label Text="Apellidos completos" 
                                                                    FontAttributes="Bold" 
                                                                    TextColor="#636E72" 
                                                                    FontSize="14"/>
                                                            <Border BackgroundColor="#F8F9FA" 
                                                                     StrokeShape="RoundRectangle 8"
                                                                     Stroke="#DDD6FE" 
                                                                     Padding="4">
                                                                <Entry Keyboard="Text"
                                                                        Placeholder="Apellidos completos"
                                                                        Text="{Binding LastName, Mode=TwoWay}"
                                                                        BackgroundColor="Transparent"
                                                                        AutomationId="EntryLastName"
                                                                        PlaceholderColor="#9CA3AF"/>
                                                            </Border>
                                                        </StackLayout>

                                                        <!-- Email -->
                                                        <StackLayout Grid.Row="1" Grid.Column="1">
                                                            <Label Text="Correo Electronico" 
                                                                    FontAttributes="Bold" 
                                                                    TextColor="#636E72" 
                                                                    FontSize="14"/>
                                                            <Border BackgroundColor="#F8F9FA" 
                                                                     StrokeShape="RoundRectangle 8"
                                                                     Stroke="#DDD6FE" 
                                                                     Padding="4">
                                                                <Entry Keyboard="Text"
                                                                        Placeholder="correo@ejemplo.com"
                                                                        Text="{Binding Email, Mode=TwoWay}"
                                                                        BackgroundColor="Transparent"
                                                                        AutomationId="EntryEmail"
                                                                        PlaceholderColor="#9CA3AF"/>
                                                            </Border>
                                                        </StackLayout>

                                                        <!-- Password -->
                                                        <StackLayout Grid.Row="2" Grid.Column="0">
                                                            <Label Text="Contraseña" 
                                                                    FontAttributes="Bold" 
                                                                    TextColor="#636E72" 
                                                                    FontSize="14"/>
                                                            <Border BackgroundColor="#F8F9FA" 
                                                                     StrokeShape="RoundRectangle 8"
                                                                     Stroke="#DDD6FE" 
                                                                     Padding="4">
                                                                <Entry Placeholder="Contraseña de acceso (min. 6 caracteres)"
                                                                        Text="{Binding Password, Mode=TwoWay}"
                                                                        IsPassword="True"
                                                                        BackgroundColor="Transparent"
                                                                        AutomationId="EntryPassword"
                                                                        PlaceholderColor="#9CA3AF"/>
                                                            </Border>
                                                        </StackLayout>

                                                        <!-- Phone -->
                                                        <StackLayout Grid.Row="2" Grid.Column="1">
                                                            <Label Text="Telefono de Contacto" 
                                                                    FontAttributes="Bold" 
                                                                    TextColor="#636E72" 
                                                                    FontSize="14"/>
                                                            <Border BackgroundColor="#F8F9FA" 
                                                                     StrokeShape="RoundRectangle 8"
                                                                     Stroke="#DDD6FE" 
                                                                     Padding="4">
                                                                <Entry Keyboard="Telephone"
                                                                        Placeholder="Numero de contacto"
                                                                        Text="{Binding PhoneNumber, Mode=TwoWay}"
                                                                        BackgroundColor="Transparent"
                                                                        AutomationId="EntryPhone"
                                                                        PlaceholderColor="#9CA3AF"/>
                                                            </Border>
                                                        </StackLayout>
                                                        <!-- EDS Selection (NUEVO) -->
                                                        <StackLayout Grid.Row="3" Grid.Column="0">
                                                            <Label Text="EDS 🏪" 
                                                                     FontAttributes="Bold" 
                                                                     TextColor="#636E72" 
                                                                     FontSize="14"/>
                                                            <Border BackgroundColor="#F8F9FA" 
                                                                      StrokeShape="RoundRectangle 8"
                                                                      Stroke="#DDD6FE" 
                                                                      Padding="4">

                                                                <Picker x:Name="EdsPicker"
                                                                        Title="Seleccione una estación de servicio"
                                                                        ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EdsList}"
                                                                        ItemDisplayBinding="{Binding Name}"
                                                                        SelectedItem="{Binding SelectedEds, Mode=TwoWay}"
                                                                        AutomationId="PickerEds"
                                                                        BackgroundColor="Transparent"
                                                                        FontSize="16"
                                                                        TextColor="#374151"
                                                                        VerticalOptions="Center"
                                                                        HorizontalOptions="FillAndExpand"/>
                                                            </Border>
                                                            <Label Text="Campo obligatorio. Seleccione la estación de servicio a la que pertenece este producto."
                                                                    FontSize="12"
                                                                    TextColor="#636E72"
                                                                    Margin="4,0,0,0"/>
                                                        </StackLayout>

                                                        <!-- Additional Options -->
                                                        <StackLayout Grid.Row="4" Grid.ColumnSpan="2">
                                                            <Label Text="Configuraciones de Acceso" 
                                                                    FontAttributes="Bold" 
                                                                    TextColor="#636E72" 
                                                                    FontSize="14"/>
                                                            <StackLayout Orientation="Horizontal" Spacing="20">
                                                                <StackLayout Orientation="Horizontal" Spacing="6">
                                                                    <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                                               Color="#6A1B9A"
                                                                               AutomationId="CheckBoxIsActive"/>
                                                                    <Label Text="Usuario Activo" 
                                                                            FontSize="13" 
                                                                            TextColor="#636E72"
                                                                            VerticalOptions="Center"/>
                                                                </StackLayout>

                                                                <StackLayout Orientation="Horizontal" Spacing="6">
                                                                    <CheckBox IsChecked="{Binding CanManageDispensers, Mode=TwoWay}"
                                                                               Color="#6A1B9A"
                                                                               AutomationId="CheckBoxCanManageDispensers"
                                                                               VerticalOptions="Start"
                                                                               Margin="0,2,0,0"/>
                                                                    <Label Text="¿Puede gestionar dispensadores?" 
                                                                            FontSize="13" 
                                                                            TextColor="#636E72"
                                                                            VerticalOptions="Center"
                                                                            LineBreakMode="WordWrap"
                                                                            MaxLines="2"
                                                                            HorizontalOptions="FillAndExpand"/>
                                                                </StackLayout>
                                                            </StackLayout>
                                                        </StackLayout>


                                                    </Grid>
                                                    <Button Text="Eliminar" 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveIslanderCommand}"
                                                            CommandParameter="{Binding .}" 
                                                            BackgroundColor="IndianRed"
                                                            TextColor="White"/>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Button Text="Agragar Islero" Command="{Binding AddIslanderCommand}" BackgroundColor="#2196F3" TextColor="White"/>
                            </VerticalStackLayout>
                        </toolkit:Expander>

                        <!-- Providers -->
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Label 
                                     Text="🚚 Proveedores"
                                     FontAttributes="Bold"
                                     FontSize="18"
                                     TextColor="Black"
                                     Padding="10,5" />
                            </toolkit:Expander.Header>
                            <VerticalStackLayout>
                                <CollectionView ItemsSource="{Binding Providers}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame Padding="10" BorderColor="#E0E0E0" Margin="0,5">
                                                <VerticalStackLayout Spacing="16">

                                                    <!-- Provider Name Field -->
                                                    <VerticalStackLayout Spacing="8">
                                                        <Label Text="Nombre del Proveedor" 
                                                               FontSize="14" 
                                                               FontAttributes="Bold" 
                                                               TextColor="#2D3436"
                                                               Margin="4,0,0,0"/>

                                                        <Border BackgroundColor="#F8F9FA" 
                                                                StrokeShape="RoundRectangle 12"
                                                                Stroke="#DDD6FE"
                                                                StrokeThickness="2"
                                                                Padding="0">
                                                            <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                                                <Label Text="🏷️" 
                                                                       FontSize="18" 
                                                                       TextColor="#FF9800" 
                                                                       VerticalOptions="Center"/>

                                                                <Entry Keyboard="Text"
                                                                       Placeholder="Ingrese el nombre del proveedor"
                                                                       PlaceholderColor="#9CA3AF"
                                                                       Text="{Binding Name, Mode=TwoWay}"
                                                                       AutomationId="EntryProvider"
                                                                       BackgroundColor="Transparent"
                                                                       FontSize="16"
                                                                       TextColor="#374151"
                                                                       VerticalOptions="Center"
                                                                       HorizontalOptions="FillAndExpand"/>
                                                            </StackLayout>
                                                        </Border>
                                                    </VerticalStackLayout>
                                                    <Button Text="Eliminar" 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveProviderCommand}"
                                                            CommandParameter="{Binding .}" 
                                                            BackgroundColor="IndianRed"
                                                            TextColor="White"/>
                                                </VerticalStackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Label Text="Proveedor otros, incluido por defecto." 
                                       FontSize="14" 
                                       TextColor="#636E72"
                                       Margin="4,0,0,0"/>
                                <Button Text="Agregar proveedor" Command="{Binding AddProviderCommand}" BackgroundColor="#2196F3" TextColor="White"/>
                            </VerticalStackLayout>
                        </toolkit:Expander>

                        <!-- Submit -->
                        <Button Text="Crear configuración inicial"
                                Command="{Binding SaveDataCommand}"
                                BackgroundColor="#2E7D32"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                Margin="0,30,0,0"/>

                    </VerticalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </ScrollView>
        <!--<Grid x:Name="LoadingOverlay"
                BackgroundColor="#80000000"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                ZIndex="1">
            <ActivityIndicator IsRunning="True"
                    Color="Purple"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    WidthRequest="50"
                    HeightRequest="50" />
        </Grid>-->
    </Grid>
</ContentPage>