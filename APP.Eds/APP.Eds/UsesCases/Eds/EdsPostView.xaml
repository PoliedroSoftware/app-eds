<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Eds.EdsPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:button="clr-namespace:APP.Eds.Controls"
    Title="{Binding EdsTitle}"
    BackgroundColor="{StaticResource Gray50}">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
            <GradientStop Color="{StaticResource Secondary}" Offset="0.4" />
            <GradientStop Color="{StaticResource Gray50}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <StackLayout Padding="25,40,25,25" Spacing="25">
                
                <!-- Header Section Moderno -->
                <Border BackgroundColor="{StaticResource White}" 
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0" 
                        Padding="25,20">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" 
                                Offset="0,6" 
                                Radius="20" 
                                Opacity="0.2"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                WidthRequest="70"
                                HeightRequest="70">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4CAF50" Offset="0.0" />
                                    <GradientStop Color="#2E7D32" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#4CAF50" 
                                        Offset="0,4" 
                                        Radius="12" 
                                        Opacity="0.3"/>
                            </Border.Shadow>
                            <Label Text="EDS"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   FontFamily="{OnPlatform Android='monospace', iOS='Menlo', Default='Courier New'}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                            <Label Text="Gestión EDS" 
                                   FontSize="26" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource Primary}"/>
                            <Label Text="Registre sus Estaciones de Servicio" 
                                   FontSize="14" 
                                   TextColor="{StaticResource Gray600}"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                    </Grid>
                </Border>

                <!-- Formulario Principal Card -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray300}" 
                                Offset="0,4" 
                                Radius="15" 
                                Opacity="0.15"/>
                    </Border.Shadow>

                    <StackLayout Spacing="24">
                        
                        <!-- Section Header con gradiente -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                Padding="20,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E3F2FD" Offset="0.0" />
                                    <GradientStop Color="#BBDEFB" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" 
                                        BackgroundColor="White" 
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0">
                                    <Label Text="+"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Nueva Estación de Servicio" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource Primary}"/>
                                    <Label Text="Complete todos los campos requeridos" 
                                           FontSize="13" 
                                           TextColor="{StaticResource Gray700}"/>
                                </StackLayout>
                            </Grid>
                        </Border>

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- Header Card with Green Gradient -->
                <Border BackgroundColor="#4CAF50"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#4CAF50" Offset="0,4" Radius="12" Opacity="0.3"/>
                    </Border.Shadow>
                    <StackLayout>
                        <Label Text="⛽ Gestión de EDS"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Label Text="Administre sus estaciones de servicio"
                               FontSize="14"
                               TextColor="#C8E6C9"
                               HorizontalOptions="Center"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- EDS Registration Form Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Form Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="📝" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Nueva Estación de Servicio"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#2D3436"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Business Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Negocio Asociado"
                                       FontAttributes="Bold"
                                       TextColor="#636E72"
                                       FontSize="14"/>
                                <Border BackgroundColor="#F8F9FA"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#C8E6C9"
                                        Padding="4">
                                    <Picker Title="Seleccione un negocio"
                                            ItemsSource="{Binding BusinessList}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerBusiness"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Name and NIT -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Label Text="Nombre de la EDS"
                                           FontAttributes="Bold"
                                           TextColor="#636E72"
                                           FontSize="14"/>
                                    <Border BackgroundColor="#F8F9FA"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="#C8E6C9"
                                            Padding="4">
                                        <Entry Keyboard="Text"
                                               Placeholder="Ej: EDS Principal, Estación Norte"
                                               Text="{Binding Name, Mode=TwoWay}"
                                               BackgroundColor="Transparent"
                                               AutomationId="EntryName"
                                               PlaceholderColor="#9CA3AF"/>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="NIT"
                                           FontAttributes="Bold"
                                           TextColor="#636E72"
                                           FontSize="14"/>
                                    <Border BackgroundColor="#F8F9FA"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="#C8E6C9"
                                            Padding="4">
                                        <Entry Keyboard="Text"
                                               Placeholder="Ej: 900123456-7"
                                               Text="{Binding Nit, Mode=TwoWay}"
                                               BackgroundColor="Transparent"
                                               AutomationId="EntryNit"
                                               PlaceholderColor="#9CA3AF"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Address and SICOM -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Label Text="Dirección"
                                           FontAttributes="Bold"
                                           TextColor="#636E72"
                                           FontSize="14"/>
                                    <Border BackgroundColor="#F8F9FA"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="#C8E6C9"
                                            Padding="4">
                                        <Entry Keyboard="Text"
                                               Placeholder="Ej: Calle 10 # 20-30"
                                               Text="{Binding Address, Mode=TwoWay}"
                                               BackgroundColor="Transparent"
                                               AutomationId="EntryAddress"
                                               PlaceholderColor="#9CA3AF"/>
                                    </Border>
                                </VerticalStackLayout>

                            <!-- Dirección -->
                            <StackLayout Spacing="8">
                                <Label Text="Dirección" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Gray900}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{StaticResource Gray50}" 
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="#FFF3E0">
                                    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#FFF3E0"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="📍" 
                                                   FontSize="16"
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        
                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding AdreessPlaceHolder}"
                                               PlaceholderColor="{StaticResource Gray400}"
                                               Text="{Binding Address, Mode=TwoWay}"
                                               AutomationId="EntryAddress"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{StaticResource Gray900}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </StackLayout>

                            <!-- SICOM -->
                            <StackLayout Spacing="8">
                                <Label Text="SICOM" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Gray900}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{StaticResource Gray50}" 
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="#F3E5F5">
                                    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#F3E5F5"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="🔢" 
                                                   FontSize="16"
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        
                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding SicomPlaceHolder}"
                                               PlaceholderColor="{StaticResource Gray400}"
                                               Text="{Binding Sicom, Mode=TwoWay}"
                                               AutomationId="EntrySicom"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{StaticResource Gray900}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </StackLayout>

                            <!-- Selección de Negocio -->
                            <StackLayout Spacing="8">
                                <Label Text="{Binding SelectBusiness}" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Gray900}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{StaticResource Gray50}" 
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="#E8F5E8">
                                    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#E8F5E8"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="🏢" 
                                                   FontSize="16"
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        
                                        <Picker Grid.Column="1"
                                                Title="{Binding BusinessPicker}"
                                                ItemsSource="{Binding BusinessList}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}"
                                                AutomationId="PickerBusiness"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{StaticResource Gray900}"
                                                TitleColor="{StaticResource Gray400}"
                                                VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Info Card y Botón de Acción -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray300}" 
                                Offset="0,4" 
                                Radius="15" 
                                Opacity="0.15"/>
                    </Border.Shadow>

                    <StackLayout Spacing="20">
                        
                        <!-- Info Card Mejorado -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="1"
                                Stroke="#2196F3"
                                Padding="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E3F2FD" Offset="0.0" />
                                    <GradientStop Color="#F3E5F5" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        BackgroundColor="White"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="32"
                                        HeightRequest="32">
                                    <Label Text="i" 
                                           FontSize="18" 
                                           FontAttributes="Bold"
                                           TextColor="#2196F3"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Una EDS (Estación de Servicio) agrupa islas, tanques y operaciones de venta de combustible bajo una ubicación específica."
                                       FontSize="13"
                                       TextColor="#1565C0"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"/>
                            </Grid>
                        </Border>

                        <!-- Botón Registrar con gradiente -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                HeightRequest="56">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4CAF50" Offset="0.0" />
                                    <GradientStop Color="#2E7D32" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#4CAF50" 
                                        Offset="0,6" 
                                        Radius="15" 
                                        Opacity="0.3"/>
                            </Border.Shadow>
                            
                            <button:HoverButton
                                Text="{Binding SendData}"
                                TextColor="White" 
                                BackgroundColor="Transparent"
                                Clicked="Button_Clicked_1"
                                AutomationId="ButtonSendData"
                                FontSize="18"
                                FontAttributes="Bold"
                                HoverColor="#45A049"
                                PressedColor="#388E3C"/>
                        </Border>
                    </StackLayout>
                </Border>

                <!-- Lista de EDS Rediseñada -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray300}" 
                                Offset="0,4" 
                                Radius="15" 
                                Opacity="0.15"/>
                    </Border.Shadow>

                    <StackLayout Spacing="20">
                        
                        <!-- Header de Lista Mejorado -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 15"
                                    StrokeThickness="0"
                                    WidthRequest="50"
                                    HeightRequest="50">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF9800" Offset="0.0" />
                                        <GradientStop Color="#F57C00" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="📋"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding EdsListTranslation}" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Primary}"/>
                                <Label Text="Estaciones registradas en el sistema" 
                                       FontSize="13" 
                                       TextColor="{StaticResource Gray600}"/>
                            </StackLayout>
                        </Grid>


                        <!-- EDS Collection -->
                        <CollectionView ItemsSource="{Binding EdsList}"
                                        Margin="0,10,0,0"
                                        AutomationId="CollectionViewEds">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#FEFEFE"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="#E5E7EB"
                                            Margin="0,4"
                                            Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,1" Radius="3" Opacity="0.08"/>
                                        </Border.Shadow>
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                            <!-- EDS Icon -->
                                            <Border BackgroundColor="#4CAF50"
                                                    StrokeShape="RoundRectangle 25"
                                                    WidthRequest="50"
                                                    HeightRequest="50"
                                                    Grid.RowSpan="5"
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">
                                                <Label Text="⛽"
                                                       FontSize="24"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- EDS Information -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#111827"/>
                                                <Border BackgroundColor="#C8E6C9"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="6,2"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Nit, StringFormat='NIT: {0}'}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="#2E7D32"/>
                                                </Border>
                                            </StackLayout>

                                            <StackLayout Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="🏢" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding BusinessName}" FontSize="13" TextColor="#6B7280"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="📍" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Address}" FontSize="13" TextColor="#374151" LineBreakMode="TailTruncation" MaxLines="1"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="🆔" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Sicom, StringFormat='SICOM: {0}'}" FontSize="13" TextColor="#6B7280"/>
                                            </StackLayout>

                                            <!-- Action Buttons -->
                                            <StackLayout Grid.RowSpan="4" Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                                <Button Text="✏️"
                                                        Style="{StaticResource IconActionButtonStyle}"
                                                        BackgroundColor="#2196F3"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.EditEdsCommand}"
                                                        CommandParameter="{Binding .}"
                                                        AutomationId="EditEdsButton"/>
                                                <Button Text="🗑️"
                                                        Style="{StaticResource IconActionButtonStyle}"
                                                        BackgroundColor="#F44336"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.DeleteEdsCommand}"
                                                        CommandParameter="{Binding .}"
                                                        AutomationId="DeleteEdsButton"/>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                                    <Label Text="⛽" FontSize="48" HorizontalOptions="Center" TextColor="#9CA3AF"/>
                                    <Label Text="No hay estaciones de servicio configuradas"
                                           FontSize="16"
                                           TextColor="#6B7280"
                                           HorizontalOptions="Center"
                                           FontAttributes="Bold"/>
                                    <Label Text="Configure la primera EDS usando el formulario superior"
                                           FontSize="14"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Margin for Better Scrolling -->
                <BoxView HeightRequest="20" Color="Transparent"/>
                
            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>