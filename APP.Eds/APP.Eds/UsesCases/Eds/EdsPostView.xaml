<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Eds.EdsPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:button="clr-namespace:APP.Eds.Controls"
    Title="{Binding EdsTitle}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Background>
        <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <StackLayout Padding="25,40,25,25" Spacing="25">

                <!-- Header Section Moderno -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25,20">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                WidthRequest="70"
                                HeightRequest="70">
                            <Border.Background>
                                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                            </Border.Background>

                            <Label Text="EDS"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource OnBrand}"
                                   FontFamily="{OnPlatform Android='monospace', iOS='Menlo', Default='Courier New'}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                            <Label Text="Gestión EDS"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                            <Label Text="Registre sus Estaciones de Servicio"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                    </Grid>
                </Border>

                <!-- Formulario Principal Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25">


                    <StackLayout Spacing="24">

                        <!-- Section Header con gradiente -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                Padding="20,16">
                            <Border.Background>
                                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0">
                                    <Label Text="+"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Nueva Estación de Servicio"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                    <Label Text="Complete todos los campos requeridos"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                </StackLayout>
                            </Grid>
                        </Border>

                        <!-- Campos del Formulario con diseño mejorado -->
                        <StackLayout Spacing="20">

                            <!-- Nombre de la EDS -->
                            <StackLayout Spacing="8">
                                <Label Text="Nombre de la EDS"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}">
                                    <brand:ResponsiveFormGrid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="N"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                   FontFamily="{OnPlatform Android='monospace', iOS='Menlo', Default='Courier New'}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding NamePlaceHolder}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               Text="{Binding Name, Mode=TwoWay}"
                                               AutomationId="EntryName"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               VerticalOptions="Center"/>
                                    </brand:ResponsiveFormGrid>
                                </Border>
                            </StackLayout>

                            <!-- NIT -->
                            <StackLayout Spacing="8">
                                <Label Text="NIT"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}">
                                    <brand:ResponsiveFormGrid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="ID"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                   FontFamily="{OnPlatform Android='monospace', iOS='Menlo', Default='Courier New'}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding NitPlaceHolder}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               Text="{Binding Nit, Mode=TwoWay}"
                                               AutomationId="EntryNit"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               VerticalOptions="Center"/>
                                    </brand:ResponsiveFormGrid>
                                </Border>
                            </StackLayout>

                            <!-- Dirección -->
                            <StackLayout Spacing="8">
                                <Label Text="Dirección"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}">
                                    <brand:ResponsiveFormGrid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <brand:PoliedroIcon Text="📍"
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding AdreessPlaceHolder}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               Text="{Binding Address, Mode=TwoWay}"
                                               AutomationId="EntryAddress"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               VerticalOptions="Center"/>
                                    </brand:ResponsiveFormGrid>
                                </Border>
                            </StackLayout>

                            <!-- SICOM -->
                            <StackLayout Spacing="8">
                                <Label Text="SICOM"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}">
                                    <brand:ResponsiveFormGrid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <brand:PoliedroIcon Text="🔢"
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding SicomPlaceHolder}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               Text="{Binding Sicom, Mode=TwoWay}"
                                               AutomationId="EntrySicom"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               VerticalOptions="Center"/>
                                    </brand:ResponsiveFormGrid>
                                </Border>
                            </StackLayout>

                            <!-- Selección de Negocio -->
                            <StackLayout Spacing="8">
                                <Label Text="{Binding SelectBusiness}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}">
                                    <brand:ResponsiveFormGrid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <brand:PoliedroIcon Text="🏢"
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <Picker Grid.Column="1"
                                                Title="{Binding BusinessPicker}"
                                                ItemsSource="{Binding BusinessList}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}"
                                                AutomationId="PickerBusiness"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                TitleColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center"/>
                                    </brand:ResponsiveFormGrid>
                                </Border>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Info Card y Botón de Acción -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25">


                    <StackLayout Spacing="20">

                        <!-- Info Card Mejorado -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                Padding="18">
                            <Border.Background>
                                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="32"
                                        HeightRequest="32">
                                    <Label Text="i"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Una EDS (Estación de Servicio) agrupa islas, tanques y operaciones de venta de combustible bajo una ubicación específica."
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"/>
                            </Grid>
                        </Border>

                        <!-- Botón Registrar con gradiente -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                HeightRequest="56">
                            <Border.Background>
                                <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                            </Border.Background>


                            <button:HoverButton
                                Text="{Binding SendData}"
                                TextColor="{StaticResource OnBrand}"
                                BackgroundColor="Transparent"
                                Clicked="Button_Clicked_1"
                                AutomationId="ButtonSendData"
                                FontSize="18"
                                FontAttributes="Bold"
                                HoverColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                PressedColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                        </Border>
                    </StackLayout>
                </Border>

                <!-- Lista de EDS Rediseñada -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25">


                    <StackLayout Spacing="20">

                        <!-- Header de Lista Mejorado -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 15"
                                    StrokeThickness="0"
                                    WidthRequest="50"
                                    HeightRequest="50">
                                <Border.Background>
                                    <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                                </Border.Background>
                                <brand:PoliedroIcon Text="📋"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding EdsListTranslation}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                <Label Text="Estaciones registradas en el sistema"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </Grid>

                        <!-- Lista de EDS -->
                        <CollectionView ItemsSource="{Binding EdsList}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 15"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            Margin="0,6"
                                            Padding="18">


                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                              RowSpacing="8" ColumnSpacing="15">

                                            <!-- Icono EDS Mejorado -->
                                            <Border Grid.RowSpan="5" Grid.Column="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="0"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    VerticalOptions="Start">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                                                </Border.Background>
                                                <brand:PoliedroIcon Text="⛽"
                                                       FontSize="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Información de la EDS -->
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="0" Grid.Column="1">
                                                <Label Text="ID:" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding IdEds}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="1" Grid.Column="1">
                                                <Label Text="Nombre:" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Name}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="2" Grid.Column="1">
                                                <Label Text="NIT:" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Nit}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="3" Grid.Column="1">
                                                <Label Text="Dirección:" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Address}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" Grid.Column="1" Margin="8,0,0,0" LineBreakMode="TailTruncation"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="4" Grid.Column="1">
                                                <Label Text="SICOM:" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Sicom}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Border>
            </StackLayout>
        </ScrollView>

        <!-- Loading Overlay Mejorado -->
        <Grid x:Name="LoadingOverlay"
              BackgroundColor="#90000000"
              IsVisible="False"
              VerticalOptions="Fill"
              HorizontalOptions="Fill"
              AutomationId="GridLoadingOverlay">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 20"
                    Padding="35,30"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <StackLayout Spacing="18">
                    <ActivityIndicator IsRunning="True"
                                       Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                       WidthRequest="45"
                                       HeightRequest="45"
                                       HorizontalOptions="Center"
                                       AutomationId="ActivityIndicatorLoading"/>
                    <Label Text="Registrando EDS..."
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>