<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Eds.EdsPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:button="clr-namespace:APP.Eds.Controls"
    Title="{Binding EdsTitle}"
    BackgroundColor="{StaticResource Gray50}">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
            <GradientStop Color="{StaticResource Secondary}" Offset="0.4" />
            <GradientStop Color="{StaticResource Gray50}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <StackLayout Padding="25,40,25,25" Spacing="25">
                
                <!-- Header Section Moderno -->
                <Border BackgroundColor="{StaticResource White}" 
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0" 
                        Padding="25,20">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" 
                                Offset="0,6" 
                                Radius="20" 
                                Opacity="0.2"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                WidthRequest="70"
                                HeightRequest="70">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4CAF50" Offset="0.0" />
                                    <GradientStop Color="#2E7D32" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#4CAF50" 
                                        Offset="0,4" 
                                        Radius="12" 
                                        Opacity="0.3"/>
                            </Border.Shadow>
                            <Label Text="EDS"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   FontFamily="{OnPlatform Android='monospace', iOS='Menlo', Default='Courier New'}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                            <Label Text="Gestión EDS" 
                                   FontSize="26" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource Primary}"/>
                            <Label Text="Registre sus Estaciones de Servicio" 
                                   FontSize="14" 
                                   TextColor="{StaticResource Gray600}"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>
                    </Grid>
                </Border>

                <!-- Formulario Principal Card -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray300}" 
                                Offset="0,4" 
                                Radius="15" 
                                Opacity="0.15"/>
                    </Border.Shadow>

                    <StackLayout Spacing="24">
                        
                        <!-- Section Header con gradiente -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                Padding="20,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E3F2FD" Offset="0.0" />
                                    <GradientStop Color="#BBDEFB" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0" 
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" 
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0">
                                    <Label Text="+"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Nueva Estación de Servicio" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="{StaticResource Primary}"/>
                                    <Label Text="Complete todos los campos requeridos" 
                                           FontSize="13" 
                                           TextColor="{StaticResource Gray700}"/>
                                </StackLayout>
                            </Grid>
                        </Border>

                        <!-- Campos del Formulario con diseño mejorado -->
                        <StackLayout Spacing="20">
                            
                            <!-- Nombre de la EDS -->
                            <StackLayout Spacing="8">
                                <Label Text="Nombre de la EDS" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Gray900}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{StaticResource Gray50}" 
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="#E8F5E8">
                                    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#E8F5E8"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="N" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold"
                                                   TextColor="#2E7D32"
                                                   FontFamily="{OnPlatform Android='monospace', iOS='Menlo', Default='Courier New'}"
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        
                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding NamePlaceHolder}"
                                               PlaceholderColor="{StaticResource Gray400}"
                                               Text="{Binding Name, Mode=TwoWay}"
                                               AutomationId="EntryName"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{StaticResource Gray900}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </StackLayout>

                            <!-- NIT -->
                            <StackLayout Spacing="8">
                                <Label Text="NIT" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Gray900}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{StaticResource Gray50}" 
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="#E3F2FD">
                                    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#E3F2FD"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="ID" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold"
                                                   TextColor="#1565C0"
                                                   FontFamily="{OnPlatform Android='monospace', iOS='Menlo', Default='Courier New'}"
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        
                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding NitPlaceHolder}"
                                               PlaceholderColor="{StaticResource Gray400}"
                                               Text="{Binding Nit, Mode=TwoWay}"
                                               AutomationId="EntryNit"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{StaticResource Gray900}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </StackLayout>

                            <!-- Dirección -->
                            <StackLayout Spacing="8">
                                <Label Text="Dirección" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Gray900}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{StaticResource Gray50}" 
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="#FFF3E0">
                                    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#FFF3E0"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="📍" 
                                                   FontSize="16"
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        
                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding AdreessPlaceHolder}"
                                               PlaceholderColor="{StaticResource Gray400}"
                                               Text="{Binding Address, Mode=TwoWay}"
                                               AutomationId="EntryAddress"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{StaticResource Gray900}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </StackLayout>

                            <!-- SICOM -->
                            <StackLayout Spacing="8">
                                <Label Text="SICOM" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Gray900}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{StaticResource Gray50}" 
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="#F3E5F5">
                                    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#F3E5F5"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="🔢" 
                                                   FontSize="16"
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        
                                        <Entry Grid.Column="1"
                                               Keyboard="Text"
                                               Placeholder="{Binding SicomPlaceHolder}"
                                               PlaceholderColor="{StaticResource Gray400}"
                                               Text="{Binding Sicom, Mode=TwoWay}"
                                               AutomationId="EntrySicom"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{StaticResource Gray900}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </StackLayout>

                            <!-- Selección de Negocio -->
                            <StackLayout Spacing="8">
                                <Label Text="{Binding SelectBusiness}" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Gray900}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{StaticResource Gray50}" 
                                        StrokeShape="RoundRectangle 15"
                                        StrokeThickness="2"
                                        Stroke="#E8F5E8">
                                    <Grid ColumnDefinitions="Auto,*" Padding="18,14" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                BackgroundColor="#E8F5E8"
                                                StrokeShape="RoundRectangle 8"
                                                WidthRequest="32"
                                                HeightRequest="32">
                                            <Label Text="🏢" 
                                                   FontSize="16"
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        
                                        <Picker Grid.Column="1"
                                                Title="{Binding BusinessPicker}"
                                                ItemsSource="{Binding BusinessList}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}"
                                                AutomationId="PickerBusiness"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{StaticResource Gray900}"
                                                TitleColor="{StaticResource Gray400}"
                                                VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!-- Info Card y Botón de Acción -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray300}" 
                                Offset="0,4" 
                                Radius="15" 
                                Opacity="0.15"/>
                    </Border.Shadow>

                    <StackLayout Spacing="20">
                        
                        <!-- Info Card Mejorado -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="1"
                                Stroke="#2196F3"
                                Padding="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E3F2FD" Offset="0.0" />
                                    <GradientStop Color="#F3E5F5" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="32"
                                        HeightRequest="32">
                                    <Label Text="i" 
                                           FontSize="18" 
                                           FontAttributes="Bold"
                                           TextColor="#2196F3"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Una EDS (Estación de Servicio) agrupa islas, tanques y operaciones de venta de combustible bajo una ubicación específica."
                                       FontSize="13"
                                       TextColor="#1565C0"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"/>
                            </Grid>
                        </Border>

                        <!-- Botón Registrar con gradiente -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                HeightRequest="56">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4CAF50" Offset="0.0" />
                                    <GradientStop Color="#2E7D32" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#4CAF50" 
                                        Offset="0,6" 
                                        Radius="15" 
                                        Opacity="0.3"/>
                            </Border.Shadow>
                            
                            <button:HoverButton
                                Text="{Binding SendData}"
                                TextColor="White" 
                                BackgroundColor="Transparent"
                                Clicked="Button_Clicked_1"
                                AutomationId="ButtonSendData"
                                FontSize="18"
                                FontAttributes="Bold"
                                HoverColor="#45A049"
                                PressedColor="#388E3C"/>
                        </Border>
                    </StackLayout>
                </Border>

                <!-- Lista de EDS Rediseñada -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="25">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Gray300}" 
                                Offset="0,4" 
                                Radius="15" 
                                Opacity="0.15"/>
                    </Border.Shadow>

                    <StackLayout Spacing="20">
                        
                        <!-- Header de Lista Mejorado -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 15"
                                    StrokeThickness="0"
                                    WidthRequest="50"
                                    HeightRequest="50">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF9800" Offset="0.0" />
                                        <GradientStop Color="#F57C00" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="📋"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding EdsListTranslation}" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource Primary}"/>
                                <Label Text="Estaciones registradas en el sistema" 
                                       FontSize="13" 
                                       TextColor="{StaticResource Gray600}"/>
                            </StackLayout>
                        </Grid>

                        <!-- Lista de EDS -->
                        <CollectionView ItemsSource="{Binding EdsList}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource Gray50}" 
                                            StrokeShape="RoundRectangle 15"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource Gray200}"
                                            Margin="0,6"
                                            Padding="18">
                                        <Border.Shadow>
                                            <Shadow Brush="{StaticResource Gray400}" 
                                                    Offset="0,2" 
                                                    Radius="6" 
                                                    Opacity="0.08"/>
                                        </Border.Shadow>
                                        
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                                              RowSpacing="8" ColumnSpacing="15">
                                            
                                            <!-- Icono EDS Mejorado -->
                                            <Border Grid.RowSpan="5" Grid.Column="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="0"
                                                    WidthRequest="40" 
                                                    HeightRequest="40"
                                                    VerticalOptions="Start">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#4CAF50" Offset="0.0" />
                                                        <GradientStop Color="#2E7D32" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Label Text="⛽" 
                                                       FontSize="20"
                                                       HorizontalOptions="Center" 
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Información de la EDS -->
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="0" Grid.Column="1">
                                                <Label Text="ID:" FontSize="13" TextColor="{StaticResource Gray600}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding IdEds}" FontSize="13" TextColor="{StaticResource Gray900}" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                            
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="1" Grid.Column="1">
                                                <Label Text="Nombre:" FontSize="13" TextColor="{StaticResource Gray600}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Name}" FontSize="13" TextColor="{StaticResource Primary}" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                            
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="2" Grid.Column="1">
                                                <Label Text="NIT:" FontSize="13" TextColor="{StaticResource Gray600}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Nit}" FontSize="13" TextColor="{StaticResource Gray900}" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                            
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="3" Grid.Column="1">
                                                <Label Text="Dirección:" FontSize="13" TextColor="{StaticResource Gray600}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Address}" FontSize="12" TextColor="{StaticResource Gray900}" Grid.Column="1" Margin="8,0,0,0" LineBreakMode="TailTruncation"/>
                                            </Grid>
                                            
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="4" Grid.Column="1">
                                                <Label Text="SICOM:" FontSize="13" TextColor="{StaticResource Gray600}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Sicom}" FontSize="13" TextColor="{StaticResource Gray900}" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Border>
            </StackLayout>
        </ScrollView>

        <!-- Loading Overlay Mejorado -->
        <Grid x:Name="LoadingOverlay"
              BackgroundColor="#90000000"
              IsVisible="False"
              VerticalOptions="Fill"
              HorizontalOptions="Fill"
              AutomationId="GridLoadingOverlay">
            <Border BackgroundColor="{StaticResource White}"
                    StrokeShape="RoundRectangle 20"
                    Padding="35,30"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" 
                            Offset="0,8" 
                            Radius="25" 
                            Opacity="0.3"/>
                </Border.Shadow>
                <StackLayout Spacing="18">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="45"
                                       HeightRequest="45"
                                       HorizontalOptions="Center"
                                       AutomationId="ActivityIndicatorLoading"/>
                    <Label Text="Registrando EDS..."
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray700}"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>