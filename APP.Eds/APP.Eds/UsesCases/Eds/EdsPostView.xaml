<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             x:Class="APP.Eds.UsesCases.Eds.EdsPostView"
             xmlns:button="clr-namespace:APP.Eds.Controls"
             Title="{Binding EdsTitle}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
            <VerticalStackLayout Padding="20" Spacing="15">
                <Entry
                Keyboard="Text"
                Placeholder="{Binding NamePlaceHolder}"
                Text="{Binding Name, Mode=TwoWay}" 
                AutomationId="EntryName"/>
                <Entry
	            Keyboard="Text"
	            Placeholder="{Binding NitPlaceHolder}"
	            Text="{Binding Nit, Mode=TwoWay}"
                AutomationId="EntryNit"/>
                <Entry
                Keyboard="Text"
                Placeholder="{Binding AdreessPlaceHolder}"
                Text="{Binding Address, Mode=TwoWay}"
                AutomationId="EntryAddress"/>
                <Entry
                Keyboard="Text"
                Placeholder="{Binding SicomPlaceHolder}"
                Text="{Binding Sicom, Mode=TwoWay}"
                AutomationId="EntrySicom"/>

                <Label FontSize="16" Text="{Binding SelectBusiness}" />
                <Picker Title="{Binding BusinessPicker}"
                ItemsSource="{Binding BusinessList}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedBusiness, Mode=TwoWay}"
                AutomationId="PickerBusiness"/>

                <button:HoverButton
                BackgroundColor="Green"
                Clicked="Button_Clicked_1"
                WidthRequest="200"
                HeightRequest="60"
                CornerRadius="10"
                HoverColor="Gray"
                PressedColor="AliceBlue"
                Text="{Binding SendData}"
                TextColor="White"
                AutomationId="ButtonSendData"/>

                <Label FontSize="18" Text="{Binding EdsListTranslation}" />
                <CollectionView ItemsSource="{Binding EdsList}" Margin="0,20">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Grid Padding="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Text="{Binding IdEds}" FontSize="14" Grid.Row="0" />
                                <Label Text="{Binding Name}" FontSize="14" Grid.Row="1" />
                                <Label Text="{Binding Nit}" FontSize="14" Grid.Row="2" />
                                <Label Text="{Binding Address}" FontSize="14" Grid.Row="3" />
                                <Label Text="{Binding Sicom}" FontSize="14" Grid.Row="4" />
                                <Label Text="{Binding IdBusiness}" FontSize="14" Grid.Row="5" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </ScrollView>
        <controls:LoadingView x:Name="LoadingOverlay"
                                  AbsoluteLayout.LayoutBounds="0,0,1,1"
                                  AbsoluteLayout.LayoutFlags="All"
                                  AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>

</ContentPage>