<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Islander.IslanderPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestion de Isleros"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header Card with Purple Gradient -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        StrokeThickness="0">

                    <StackLayout>
                        <Label Text="Gestion de Isleros"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Start"/>
                        <Label Text="Administre operarios y personal de estaciones de servicio"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalOptions="Start"
                               Margin="0,5,0,0"/>
                    </StackLayout>
                </Border>

                <!-- Islander Registration Form Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="20">

                        <!-- Form Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="📝" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Registro de Nuevo Islero"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Personal Information Grid -->
                        <brand:ResponsiveFormGrid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="12">

                            <!-- Name -->
                            <StackLayout Grid.Row="0" Grid.Column="0">
                                <Label Text="Usuario"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Keyboard="Text"
                                           Placeholder="Usuario del islero"
                                           Text="{Binding Name, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryName"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- First Name -->
                            <StackLayout Grid.Row="0" Grid.Column="1">
                                <Label Text="Nombre completo"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Keyboard="Text"
                                           Placeholder="Nombre completo"
                                           Text="{Binding FirstName, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryFirstName"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- Last Name -->
                            <StackLayout Grid.Row="1" Grid.Column="0">
                                <Label Text="Apellidos completos"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Keyboard="Text"
                                           Placeholder="Apellidos completos"
                                           Text="{Binding LastName, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryLastName"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- Email -->
                            <StackLayout Grid.Row="1" Grid.Column="1">
                                <Label Text="Correo Electronico"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Keyboard="Text"
                                           Placeholder="correo@ejemplo.com"
                                           Text="{Binding Email, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryEmail"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- EDS Selection -->
                            <StackLayout Grid.Row="2" Grid.Column="0">
                                <Label Text="Estacion de Servicio (EDS)"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Picker Title="Seleccione EDS asignada"
                                            ItemsSource="{Binding EdsList}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding SelectedEds, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerEds"/>
                                </Border>
                            </StackLayout>

                            <!-- Role/Position -->
                            <StackLayout Grid.Row="2" Grid.Column="1">
                                <Label Text="Posicion/Rol"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Picker Title="Seleccione rol"
                                            ItemsSource="{Binding RoleOptions}"
                                            SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                            BackgroundColor="Transparent"
                                            AutomationId="PickerRole"/>
                                </Border>
                            </StackLayout>

                            <!-- Password -->
                            <StackLayout Grid.Row="3" Grid.Column="0">
                                <Label Text="Contraseña"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Placeholder="Contraseña de acceso (min. 6 caracteres)"
                                           Text="{Binding Password, Mode=TwoWay}"
                                           IsPassword="True"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryPassword"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- Phone -->
                            <StackLayout Grid.Row="3" Grid.Column="1">
                                <Label Text="Telefono de Contacto"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        Padding="12,0">
                                    <Entry Keyboard="Telephone"
                                           Placeholder="Numero de contacto"
                                           Text="{Binding PhoneNumber, Mode=TwoWay}"
                                           BackgroundColor="Transparent"
                                           AutomationId="EntryPhone"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                </Border>
                            </StackLayout>

                            <!-- Additional Options -->
                            <StackLayout Grid.Row="4" Grid.ColumnSpan="2">
                                <Label Text="Configuraciones de Acceso"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="14"/>
                                <StackLayout Orientation="Horizontal" Spacing="20">
                                    <StackLayout Orientation="Horizontal" Spacing="6">
                                        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                  Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                  AutomationId="CheckBoxIsActive"/>
                                        <Label Text="Usuario Activo"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center"/>
                                    </StackLayout>

                                    <StackLayout Orientation="Horizontal" Spacing="6">
                                        <CheckBox IsChecked="{Binding CanManageDispensers, Mode=TwoWay}"
                                                  Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                  AutomationId="CheckBoxCanManageDispensers"
                                                  VerticalOptions="Start"
                                                  Margin="0,2,0,0"/>
                                        <Label Text="¿Puede gestionar dispensadores?"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               VerticalOptions="Center"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </StackLayout>
                            </StackLayout>
                        </brand:ResponsiveFormGrid>

                        <!-- Action Button -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Margin="0,10,0,0">

                            <Button BackgroundColor="Transparent"
                                    Clicked="Button_Clicked_1"
                                    Text="Registrar Islero"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="52"
                                    AutomationId="ButtonSendData"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Islanders Statistics Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <!-- Stats Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="📊" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Estadisticas de Personal"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Statistics Grid -->
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <!-- Total Islanders -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="12"
                                    Grid.Column="0">
                                <StackLayout Spacing="6">
                                    <Label Text="Total"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding TotalIslanders}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Active Islanders -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                    Padding="12"
                                    Grid.Column="1">
                                <StackLayout Spacing="6">
                                    <Label Text="Activos"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding ActiveIslanders}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- Supervisors -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                    Padding="12"
                                    Grid.Column="2">
                                <StackLayout Spacing="6">
                                    <Label Text="Superv."
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding SupervisorIslanders}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>

                            <!-- EDS Count -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="12"
                                    Grid.Column="3">
                                <StackLayout Spacing="6">
                                    <Label Text="EDS"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"/>
                                    <Label Text="{Binding CoveredEDS}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"/>
                                </StackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Islanders List Card -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="20">

                    <VerticalStackLayout Spacing="16">

                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <brand:PoliedroIcon Text="👥" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Personal Registrado"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>

                        <!-- Filter Options -->
                        <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                            <Button Text="Todos"
                                    BackgroundColor="{Binding FilterAllColor}"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterAllCommand}"/>
                            <Button Text="Activos"
                                    BackgroundColor="{Binding FilterActiveColor}"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterActiveCommand}"/>
                            <Button Text="Supervisores"
                                    BackgroundColor="{Binding FilterSupervisorColor}"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    Padding="12,6"
                                    CornerRadius="15"
                                    Command="{Binding FilterSupervisorCommand}"/>
                        </StackLayout>

                        <!-- Islanders Collection -->
                        <CollectionView ItemsSource="{Binding EnhancedIslanderList}"
                                        Margin="0,10,0,0"
                                        AutomationId="CollectionViewIslanderList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            Margin="0,4"
                                            Padding="16">


                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="8">

                                            <!-- Avatar Icon -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                                    StrokeShape="RoundRectangle 25"
                                                    WidthRequest="50"
                                                    HeightRequest="50"
                                                    Grid.RowSpan="4"
                                                    Grid.Column="0"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding RoleIcon, FallbackValue='👷'}"
                                                       FontSize="24"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                                       HorizontalOptions="Start"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Islander Information -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="6,2"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Id, StringFormat='ID: {0}'}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>
                                                </Border>
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="6,2"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding IsActive, FallbackValue=true}">
                                                    <Label Text="ACTIVO"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>
                                                </Border>
                                            </StackLayout>

                                            <StackLayout Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <brand:PoliedroIcon Text="📧" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Email}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            </StackLayout>

                                            <StackLayout Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <brand:PoliedroIcon Text="👤" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Firstname}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                                <Label Text="{Binding Lastname}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                            </StackLayout>

                                            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                                    <brand:PoliedroIcon Text="🏪" FontSize="12" VerticalOptions="Center"/>
                                                    <Label Text="{Binding EdsName, FallbackValue='Sin asignar'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold"/>
                                                </StackLayout>

                                                <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalOptions="End">
                                                    <brand:PoliedroIcon Text="📞" FontSize="12" VerticalOptions="Center"/>
                                                    <Label Text="{Binding PhoneNumber, FallbackValue='N/D'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" VerticalOptions="Center"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <StackLayout Grid.Column="2" Grid.RowSpan="4" VerticalOptions="Center" Spacing="8">
                                                <!-- Edit Button -->
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                        StrokeShape="RoundRectangle 15"
                                                        Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                        WidthRequest="30" HeightRequest="30">
                                                    <Button Text="✏️"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                            FontSize="12"
                                                            WidthRequest="30" HeightRequest="30"
                                                            CornerRadius="15"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditIslanderCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Border>

                                                <!-- Delete Button -->
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 15"
                                                        Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                        WidthRequest="30" HeightRequest="30">
                                                    <Button Text="🗑️"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                            FontSize="12"
                                                            WidthRequest="30" HeightRequest="30"
                                                            CornerRadius="15"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteIslanderCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Border>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                                    <brand:PoliedroIcon Text="👷" FontSize="48" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label Text="No hay isleros registrados"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"
                                           FontAttributes="Bold"/>
                                    <Label Text="Registre el primer islero usando el formulario superior"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Margin for Better Scrolling -->
                <BoxView HeightRequest="20" Color="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>
