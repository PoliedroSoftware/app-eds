<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="APP.Eds.UsesCases.Inventory.InventoryPostView"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    x:Name="ThisPage"
    Title="Inventario">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Add any needed resources here -->
        </ResourceDictionary>
    </ContentPage.Resources>
  <AbsoluteLayout>
    <ScrollView Margin="15">
      <StackLayout Spacing="15">
        <!-- Business Header -->
        <CollectionView ItemsSource="{Binding Businesses}" 
                        AutomationId="CollectionViewBusinesses">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <StackLayout Spacing="10" Margin="0,0,0,20">
                
                <!-- Business Name Header -->
                <Frame BackgroundColor="#f0f7ff" Padding="15" CornerRadius="12" HasShadow="False">
                  <Label Text="{Binding BusinessName}" 
                         FontAttributes="Bold" 
                         FontSize="18" 
                         TextColor="#2c5aa0"
                         HorizontalOptions="Center"
                         AutomationId="LabelBusinessName"/>
                </Frame>

                <!-- EDS Collection -->
                <CollectionView ItemsSource="{Binding Eds}" AutomationId="CollectionViewEds">
                  <CollectionView.ItemTemplate>
                    <DataTemplate>
                      <StackLayout Spacing="8" Margin="0,0,0,15">
                        
                        <!-- EDS Header -->
                        <Frame BackgroundColor="#e8f4fd" Padding="12" CornerRadius="10" HasShadow="False">
                          <Label Text="{Binding EdsName}" 
                                 FontAttributes="Bold" 
                                 FontSize="16" 
                                 TextColor="#1e40af"
                                 AutomationId="LabelEdsName"/>
                        </Frame>

                        <!-- Tanks Collection - Simplified -->
                        <CollectionView ItemsSource="{Binding Tanks}" AutomationId="CollectionViewTanks">
                          <CollectionView.ItemTemplate>
                            <DataTemplate>
                              <Frame BackgroundColor="White" 
                                     Padding="15" 
                                     CornerRadius="8" 
                                     HasShadow="True" 
                                     Margin="0,3,0,3">
                                <StackLayout Spacing="12">
                                  
                                  <!-- Tank Header -->
                                  <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" 
                                           Text="{Binding TankNumber, StringFormat='Tanque {0}'}" 
                                           FontAttributes="Bold" 
                                           FontSize="14" 
                                           TextColor="#374151"
                                           VerticalOptions="Center"
                                           AutomationId="LabelTankNumber"/>
                                    
                                    <Label Grid.Column="2" 
                                           Text="{Binding TankCapacity, StringFormat='Cap: {0:N0} L'}" 
                                           FontSize="12" 
                                           TextColor="#6b7280"
                                           VerticalOptions="Center"/>
                                  </Grid>

                                  <!-- Products in this tank -->
                                  <CollectionView ItemsSource="{Binding Compartments}" 
                                                  AutomationId="CollectionViewCompartments">
                                    <CollectionView.ItemTemplate>
                                      <DataTemplate>
                                        <Frame BackgroundColor="#f9fafb" 
                                               Padding="12" 
                                               CornerRadius="6" 
                                               HasShadow="False" 
                                               Margin="0,2,0,2">
                                          <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                            
                                            <!-- Product Name -->
                                            <Label Grid.Column="0" 
                                                   Grid.Row="0" 
                                                   Text="{Binding Product}" 
                                                   FontAttributes="Bold" 
                                                   FontSize="14"
                                                   TextColor="#111827"
                                                   VerticalOptions="Center"
                                                   AutomationId="LabelProduct"/>
                                            
                                            <!-- Stock Amount -->
                                            <Label Grid.Column="1" 
                                                   Grid.Row="0" 
                                                   Text="{Binding Stock, StringFormat='{0:N0}'}" 
                                                   FontAttributes="Bold" 
                                                   FontSize="16"
                                                   TextColor="#059669"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End"
                                                   AutomationId="LabelCompartmentStock"/>
                                            
                                            <!-- Unit Label -->
                                            <Label Grid.Column="2" 
                                                   Grid.Row="0" 
                                                   Text="L" 
                                                   FontSize="12"
                                                   TextColor="#6b7280"
                                                   VerticalOptions="Center"
                                                   Margin="3,0,0,0"/>
                                            
                                            <!-- Compartment Number -->
                                            <Label Grid.Column="0" 
                                                   Grid.Row="1" 
                                                   Text="{Binding CompartmentNumber, StringFormat='Compartimento {0}'}" 
                                                   FontSize="11"
                                                   TextColor="#9ca3af"
                                                   Margin="0,2,0,0"
                                                   AutomationId="LabelCompartmentNumber"/>
                                          </Grid>
                                        </Frame>
                                      </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                  </CollectionView>
                                  
                                </StackLayout>
                              </Frame>
                            </DataTemplate>
                          </CollectionView.ItemTemplate>
                        </CollectionView>
                        
                      </StackLayout>
                    </DataTemplate>
                  </CollectionView.ItemTemplate>
                </CollectionView>
                
              </StackLayout>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
      </StackLayout>
    </ScrollView>
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>
