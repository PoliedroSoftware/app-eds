<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             x:Class="APP.Eds.UsesCases.Product.ProductPostView"
             Title="Gestion De Productos">

    <Frame BorderColor="Transparent" HasShadow="False" Padding="10" Margin="10">
        <AbsoluteLayout>
        <VerticalStackLayout
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">
            <Label FontSize="16" Text="Ingrese El Producto" />

            <Entry
                Keyboard="Text"
                Placeholder="Ingrese EL Producto"
                Text="{Binding Name, Mode=TwoWay}"
                AutomationId="EntryProductName"/>

            <Picker 
                Title="Seleccione Un Tipo De Producto"
                ItemsSource="{Binding ProductTypeList}"
                ItemDisplayBinding="{Binding Description}"
                SelectedItem="{Binding SelectProductType, Mode=TwoWay}"
                AutomationId="PickerProductType"/>
            <Button Text="Agregar tipo de producto" Clicked="OnAddProductTypeClicked" AutomationId="ButtonAddProductType"/>

                <Label Text="Ingrese EL Precio Del Producto" />
            <Entry
                Keyboard="Numeric"
                Placeholder="Enter Price"
                Text="{Binding Price, Mode=TwoWay}"
                AutomationId="EntryPrice"/>

            <Button
                BackgroundColor="Green"
                Clicked="Button_Clicked"
                CornerRadius="10"
                Text="Enviar Datos"
                TextColor="White"
                AutomationId="ButtonSendData"/>

            <!-- Listado de productos -->
    <Label Text="Lista de Productos" FontSize="18"/>
    <CollectionView ItemsSource="{Binding ProductList}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <VerticalStackLayout>
                    <Label Text="{Binding Name, StringFormat='Producto: {0}'}" FontSize="16" HorizontalOptions="Center" Margin="0,20,0,5"/>
                    <Frame Padding="0">
                        <Grid ColumnDefinitions="20,*,20,*,10" RowDefinitions="10,*,*,*,*,*,*,*,*,10">

                            <Label Text="Precio" Grid.Row="3" Grid.Column="1"/>
                            <Label Text="{Binding Price, StringFormat='{0:C}'}" Grid.Row="3" Grid.Column="3"/>

                            <StackLayout Orientation="Horizontal" Grid.Row="8" Grid.Column="3" HorizontalOptions="EndAndExpand" VerticalOptions="CenterAndExpand">
                                <ImageButton Source="edit.png" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditProductCommand}" CommandParameter="{Binding .}" HeightRequest="20" WidthRequest="20"/>
                                <ImageButton Source="delete.png" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProductCommand}" CommandParameter="{Binding .}" HeightRequest="20" WidthRequest="20"/>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
        </VerticalStackLayout>
            <controls:LoadingView x:Name="LoadingOverlay"
                                  AbsoluteLayout.LayoutBounds="0,0,1,1"
                                  AbsoluteLayout.LayoutFlags="All"
                                  AutomationId="LoadingOverlay"/>
        </AbsoluteLayout>
    </Frame>
</ContentPage>
