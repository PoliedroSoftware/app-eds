<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Product.ProductPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión de Productos"
    BackgroundColor="#F8F9FA">


                            <!-- Add Product Type Button -->
                            <Border BackgroundColor="#6A1B9A" 
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Padding="4">
                                <Border.Shadow>
                                    <Shadow Brush="#6A1B9A" 
                                            Offset="0,3" 
                                            Radius="8" 
                                            Opacity="0.3"/>
                                </Border.Shadow>
                                <Button Text="➕ Agregar Tipo de Producto"
                                        TextColor="White" 
                                        BackgroundColor="Transparent"
                                        Clicked="OnAddProductTypeClicked"
                                        AutomationId="ButtonAddProductType"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        HeightRequest="44"
                                        CornerRadius="12"/>
                            </Border>


</ContentPage>
