<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
             x:Class="APP.Eds.UsesCases.Product.ProductPostView"
             Title="Gestion De Productos">

    <Frame BorderColor="Transparent" HasShadow="False" Padding="10" Margin="10">
        <AbsoluteLayout>
        <VerticalStackLayout
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">
            <Label FontSize="16" Text="Ingrese El Producto" />

            <Entry
                Keyboard="Text"
                Placeholder="Ingrese EL Producto"
                Text="{Binding Name, Mode=TwoWay}"
                AutomationId="EntryProductName"/>

            <Picker 
                Title="Seleccione Un Tipo De Producto"
                ItemsSource="{Binding ProductTypeList}"
                ItemDisplayBinding="{Binding Description}"
                SelectedItem="{Binding SelectProductType, Mode=TwoWay}"
                AutomationId="PickerProductType"/>
            <Button Text="Agregar tipo de producto" Clicked="OnAddProductTypeClicked" AutomationId="ButtonAddProductType"/>

                <Label Text="Ingrese EL Precio Del Producto" />
            <Entry
                Keyboard="Numeric"
                Placeholder="Enter Price"
                Text="{Binding Price, Mode=TwoWay}"
                AutomationId="EntryPrice"/>

            <Button
                BackgroundColor="Green"
                Clicked="Button_Clicked"
                CornerRadius="10"
                Text="Enviar Datos"
                TextColor="White"
                AutomationId="ButtonSendData"/>

            <!-- Listado de productos -->
    <Label Text="Lista de Productos" FontSize="18"/>
    <CollectionView ItemsSource="{Binding ProductList}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Text="{Binding Name}" FontSize="14" Grid.Row="0" />
                    <Label Text="{Binding Price}" FontSize="14" Grid.Row="1" />
                    <StackLayout Orientation="Horizontal" Grid.Row="2">
                        <Button Text="Editar" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditProductCommand}" CommandParameter="{Binding .}" />
                        <Button Text="Eliminar" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProductCommand}" CommandParameter="{Binding .}" />
                    </StackLayout>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
        </VerticalStackLayout>
            <controls:LoadingView x:Name="LoadingOverlay"
                                  AbsoluteLayout.LayoutBounds="0,0,1,1"
                                  AbsoluteLayout.LayoutFlags="All"
                                  AutomationId="LoadingOverlay"/>
        </AbsoluteLayout>
    </Frame>
</ContentPage>
