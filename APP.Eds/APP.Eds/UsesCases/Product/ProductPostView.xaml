<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Product.ProductPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión de Productos"
    BackgroundColor="#F8F9FA">


    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="20">
                
                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="📦 Gestión de Productos" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Administre los productos y sus precios" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Product Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="📦" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nuevo Producto" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"/>
                                <Label Text="Registre un nuevo producto con su precio" 
                                       FontSize="12" 
                                       TextColor="#636E72"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Product Name Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Nombre del Producto" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🏷️" 
                                               FontSize="18" 
                                               TextColor="#6A1B9A" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Text"
                                               Placeholder="Ingrese el nombre del producto"
                                               PlaceholderColor="#9CA3AF"
                                               Text="{Binding Name, Mode=TwoWay}"
                                               AutomationId="EntryProductName"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="#374151"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Product Type Selection -->
                            <VerticalStackLayout Spacing="8">
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Label Text="Tipo de Producto" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#2D3436"
                                           VerticalOptions="Center"
                                           Margin="4,0,0,0"/>
                                    <Label Text="*" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="#F44336"
                                           VerticalOptions="Center"/>
                                </StackLayout>

                                <!-- Simplified Product Type Selection -->
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="1"
                                        Padding="16">
                                    <VerticalStackLayout Spacing="12">
                                        
                                        <!-- Header -->
                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                            <Label Text="📋" 
                                                   FontSize="16" 
                                                   TextColor="#2196F3" 
                                                   VerticalOptions="Center"/>
                                            <Label Text="Seleccione el tipo de producto:" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold"
                                                   TextColor="#374151"
                                                   VerticalOptions="Center"/>
                                        </StackLayout>

                                        <!-- Simple Picker for Product Types -->
                                        <Border BackgroundColor="White"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="#DDD6FE"
                                                Padding="12">
                                            <Picker Title="Seleccionar tipo de producto"
                                                    ItemsSource="{Binding EnhancedProductTypeList}"
                                                    ItemDisplayBinding="{Binding Description}"
                                                    SelectedItem="{Binding SelectProductType, Mode=TwoWay}"
                                                    AutomationId="PickerProductType"
                                                    FontSize="16"/>
                                        </Border>

                                        <!-- Add Product Type Button -->
                                        <Border BackgroundColor="#FF6B35" 
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                Padding="2"
                                                Margin="0,8,0,0">
                                            <Border.Shadow>
                                                <Shadow Brush="#FF6B35" 
                                                        Offset="0,2" 
                                                        Radius="6" 
                                                        Opacity="0.25"/>
                                            </Border.Shadow>
                                            <Button Text="➕ Agregar Nuevo Tipo"
                                                    TextColor="White" 
                                                    BackgroundColor="Transparent"
                                                    Clicked="OnAddProductTypeClicked"
                                                    AutomationId="ButtonAddProductType"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    HeightRequest="40"
                                                    CornerRadius="8"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Price Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Precio del Producto" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="💰" 
                                               FontSize="18" 
                                               TextColor="#4CAF50" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Numeric"
                                               Placeholder="0.00"
                                               PlaceholderColor="#9CA3AF"
                                               Text="{Binding Price, Mode=TwoWay}"
                                               AutomationId="EntryPrice"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="#374151"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Action Button Section -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                            
                            <!-- Info Card -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2196F3"
                                    Padding="16"
                                    Opacity="0.9">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="ℹ️" 
                                           FontSize="16" 
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="Los productos son los combustibles y lubricantes que se venden en las estaciones de servicio. Cada producto debe tener un tipo y precio definido."
                                           FontSize="12"
                                           TextColor="#1565C0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Register Button -->
                            <Border Style="{StaticResource PrimarySendButtonStyle}">
                                <Button Text="🚀 Registrar Producto"
                                        TextColor="White" 
                                        BackgroundColor="Transparent"
                                        Clicked="Button_Clicked"
                                        AutomationId="ButtonSendData"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        HeightRequest="56"
                                        CornerRadius="16"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>

</ContentPage>
