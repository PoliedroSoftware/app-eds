<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Product.ProductPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión de Productos"
    BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="20">
                
                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="📦 Gestión de Productos" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Administre los productos y sus precios" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Product Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#1E4D2B}" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="📦" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nuevo Producto" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>
                                <Label Text="Registre un nuevo producto con su precio" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Product Category Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Tipo de Producto" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="⛽" 
                                               FontSize="18" 
                                               TextColor="#6A1B9A" 
                                               VerticalOptions="Center"/>

                                        <Picker Title="Seleccione el tipo de producto"
                                                ItemsSource="{Binding ProductOptions}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedProductOption, Mode=TwoWay}"
                                                AutomationId="PickerProductCategory"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="Seleccione el tipo principal de combustible que desea registrar" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- Product Subtype Selection (Only for Gasolina) -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsProductTypeSelectionVisible}">
                                <Label Text="Tipo de Gasolina" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="✨" 
                                               FontSize="18" 
                                               TextColor="#4CAF50" 
                                               VerticalOptions="Center"/>
                                        
                                        <Picker Title="Seleccione el tipo de gasolina"
                                                ItemsSource="{Binding FilteredProductTypes}"
                                                ItemDisplayBinding="{Binding Description}"
                                                SelectedItem="{Binding SelectedSpecificProductType, Mode=TwoWay}"
                                                AutomationId="PickerProductSubtype"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="Seleccione si es gasolina corriente o extra" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- ACPM Automatic Selection Message -->
                            <Border BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#1E4D2B}" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#4CAF50"
                                    Padding="16"
                                    IsVisible="{Binding IsAcpmSelected}">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="🚛" 
                                           FontSize="16" 
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="ACPM seleccionado automáticamente. El tipo de producto se asignará como ACPM."
                                           FontSize="12"
                                           TextColor="#2E7D32"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Product Name Display (Read-only) -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Nombre del Producto" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F0F0F0" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                                        StrokeThickness="1"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🏷️" 
                                               FontSize="18" 
                                               TextColor="{AppThemeBinding Light=#757575, Dark=#B8B8B8}" 
                                               VerticalOptions="Center"/>
                                        
                                        <Label Text="{Binding Name}"
                                               AutomationId="LabelProductName"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light=#424242, Dark=#B8B8B8}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"
                                               BackgroundColor="Transparent"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="El nombre se genera automáticamente basado en su selección" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- Purchase Price Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Precio de Compra" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🛒" 
                                               FontSize="18" 
                                               TextColor="#FF6B35" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Numeric"
                                               Placeholder="0.00 (opcional)"
                                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                               Text="{Binding PurchasePrice, Mode=TwoWay}"
                                               AutomationId="EntryPurchasePrice"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="Precio al cual compra el producto a su proveedor (opcional, se guardará como 0 si está vacío)" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- Sell Price Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Precio de Venta" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="💰" 
                                               FontSize="18" 
                                               TextColor="#4CAF50" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Numeric"
                                               Placeholder="0.00 (opcional)"
                                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                               Text="{Binding SellPrice, Mode=TwoWay}"
                                               AutomationId="EntrySellPrice"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="Precio al cual venderá el producto a sus clientes (opcional, se guardará como 0 si está vacío)" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- Stock Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding StockLabel}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="📦" 
                                               FontSize="18" 
                                               TextColor="#9C27B0" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Numeric"
                                               Placeholder="{Binding StockPlaceholder}"
                                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                               Text="{Binding Stock, Mode=TwoWay}"
                                               AutomationId="EntryStock"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="{Binding StockHint}" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- EDS Selection (NUEVO) -->
                            <VerticalStackLayout Spacing="8">
                                <StackLayout Orientation="Horizontal" Spacing="4">
                                    <Label Text="Estación de Servicio (EDS)" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                           Margin="4,0,0,0"/>
                                    <Label Text="*" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#E74C3C"
                                           VerticalOptions="Start"/>
                                </StackLayout>

                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🏪" 
                                               FontSize="18" 
                                               TextColor="#8B5CF6" 
                                               VerticalOptions="Center"/>

                                        <Picker x:Name="EdsPicker"
                                                Title="Seleccione una estación de servicio"
                                                ItemsSource="{Binding EdsList}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedEds, Mode=TwoWay}"
                                                AutomationId="PickerEds"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>

                                <Label Text="Campo obligatorio. Seleccione la estación de servicio a la que pertenece este producto."
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Action Button Section -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">

                            <!-- Info Card -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2196F3"
                                    Padding="16"
                                    Opacity="0.9">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="ℹ️" 
                                           FontSize="16" 
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="Seleccione el tipo de producto para generar automáticamente el nombre del producto. Los precios y stock son opcionales y pueden configurarse posteriormente."
                                           FontSize="12"
                                           TextColor="#1565C0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Register Button -->
                            <Border Style="{StaticResource PrimarySendButtonStyle}">
                                <Button Text="✅ Registrar Producto"
                                        TextColor="White" 
                                        BackgroundColor="Transparent"
                                        Clicked="Button_Clicked"
                                        AutomationId="ButtonSendData"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        HeightRequest="56"
                                        CornerRadius="16"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <!-- Hoses List Section -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light=#E8F5E8, Dark=#1E4D2B}" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="📋" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>   
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Lista de Productos" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>
                                        <Label Text="Productos registrados en el sistema" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"/>
                            </StackLayout>
                        </StackLayout>
                        <!-- Product List -->
                        <CollectionView ItemsSource="{Binding ProductList}" HeightRequest="400">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#FAFAFA" 
                             StrokeShape="RoundRectangle 12"
                             Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}"
                             Margin="0,4"
                             Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1"/>
                                        </Border.Shadow>

                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                                            <!-- Product Icon -->
                                            <Border BackgroundColor="#E3F2FD" 
                                                     StrokeShape="RoundRectangle 16"
                                                     WidthRequest="40" HeightRequest="40"
                                                     Grid.RowSpan="6" Grid.Column="0"
                                                     VerticalOptions="Start">
                                                <Label Text="📦" 
                                                        FontSize="18" 
                                                        HorizontalOptions="Center" 
                                                        VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Product Info -->
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="0" Grid.Column="1">
                                                <Label Text="Tipo de Producto:" FontSize="13" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding ProductTypeName}" FontSize="13" TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="1" Grid.Column="1">
                                                <Label Text="Nombre:" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Name}" FontSize="12" TextColor="#FF9800" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <!-- ✅ NUEVA FILA: EDS -->
                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="2" Grid.Column="1">
                                                <Label Text="🏪 EDS:" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding EdsName}" FontSize="12" TextColor="#8B5CF6" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="3" Grid.Column="1">
                                                <Label Text="Precio de Compra:" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding PurchasePrice, StringFormat='$ {0:N2}'}" FontSize="12" TextColor="#9C27B0" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="4" Grid.Column="1">
                                                <Label Text="Precio de Venta:" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding SellPrice, StringFormat='$ {0:N2}'}" FontSize="12" TextColor="#4CAF50" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="Auto,*" Grid.Row="5" Grid.Column="1">
                                                <Label Text="Stock Inicial:" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#B8B8B8}" FontAttributes="Bold" Grid.Column="0"/>
                                                <Label Text="{Binding Stock, StringFormat='{0:N3}'}" FontSize="12" TextColor="#2196F3" FontAttributes="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <StackLayout Grid.Column="2" Grid.RowSpan="6" VerticalOptions="Center" Spacing="8">
                                                <!-- Edit Button -->
                                                <Border BackgroundColor="#FFF3E0" 
                                                         StrokeShape="RoundRectangle 15"
                                                         Stroke="#FF9800"
                                                         WidthRequest="30" HeightRequest="30">
                                                    <Button Text="✏️" 
                                                             BackgroundColor="Transparent"
                                                             TextColor="#FF9800"
                                                             FontSize="12"
                                                             WidthRequest="30" HeightRequest="30"
                                                             CornerRadius="15"
                                                             Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditProductDataCommand}"
                                                             CommandParameter="{Binding .}"/>
                                                </Border>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>


                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>
