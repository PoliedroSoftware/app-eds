<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Product.ProductPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="Gestión de Productos"
    BackgroundColor="#F8F9FA">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="20">
                
                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="📦 Gestión de Productos" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Administre los productos y sus precios" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Product Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="📦" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nuevo Producto" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"/>
                                <Label Text="Registre un nuevo producto con su precio" 
                                       FontSize="12" 
                                       TextColor="#636E72"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Product Category Selection -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Tipo de Combustible" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="⛽" 
                                               FontSize="18" 
                                               TextColor="#6A1B9A" 
                                               VerticalOptions="Center"/>
                                        
                                        <Picker Title="Seleccione el tipo de combustible"
                                                ItemsSource="{Binding ProductOptions}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedProductOption, Mode=TwoWay}"
                                                AutomationId="PickerProductCategory"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="#374151"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="Seleccione el tipo principal de combustible que desea registrar" 
                                       FontSize="12" 
                                       TextColor="#636E72"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- Product Subtype Selection (Only for Gasolina) -->
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsProductTypeSelectionVisible}">
                                <Label Text="Tipo de Gasolina" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="✨" 
                                               FontSize="18" 
                                               TextColor="#4CAF50" 
                                               VerticalOptions="Center"/>
                                        
                                        <Picker Title="Seleccione el tipo de gasolina"
                                                ItemsSource="{Binding FilteredProductTypes}"
                                                ItemDisplayBinding="{Binding Description}"
                                                SelectedItem="{Binding SelectedSpecificProductType, Mode=TwoWay}"
                                                AutomationId="PickerProductSubtype"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="#374151"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="Seleccione si es gasolina corriente o extra" 
                                       FontSize="12" 
                                       TextColor="#636E72"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- ACPM Automatic Selection Message -->
                            <Border BackgroundColor="#E8F5E8" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#4CAF50"
                                    Padding="16"
                                    IsVisible="{Binding IsAcpmSelected}">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="🚛" 
                                           FontSize="16" 
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="ACPM seleccionado automáticamente. El tipo de producto se asignará como ACPM."
                                           FontSize="12"
                                           TextColor="#2E7D32"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Product Name Display (Read-only) -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Nombre del Producto" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F0F0F0" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#E0E0E0"
                                        StrokeThickness="1"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🏷️" 
                                               FontSize="18" 
                                               TextColor="#757575" 
                                               VerticalOptions="Center"/>
                                        
                                        <Label Text="{Binding Name}"
                                               AutomationId="LabelProductName"
                                               FontSize="16"
                                               TextColor="#424242"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"
                                               BackgroundColor="Transparent"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="El nombre se genera automáticamente basado en su selección" 
                                       FontSize="12" 
                                       TextColor="#636E72"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- Purchase Price Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Precio de Compra" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🛒" 
                                               FontSize="18" 
                                               TextColor="#FF6B35" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Numeric"
                                               Placeholder="0.00 (opcional)"
                                               PlaceholderColor="#9CA3AF"
                                               Text="{Binding PurchasePrice, Mode=TwoWay}"
                                               AutomationId="EntryPurchasePrice"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="#374151"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="Precio al cual compra el producto a su proveedor (opcional, se guardará como 0 si está vacío)" 
                                       FontSize="12" 
                                       TextColor="#636E72"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- Sell Price Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Precio de Venta" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="💰" 
                                               FontSize="18" 
                                               TextColor="#4CAF50" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Numeric"
                                               Placeholder="0.00 (opcional)"
                                               PlaceholderColor="#9CA3AF"
                                               Text="{Binding SellPrice, Mode=TwoWay}"
                                               AutomationId="EntrySellPrice"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="#374151"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="Precio al cual venderá el producto a sus clientes (opcional, se guardará como 0 si está vacío)" 
                                       FontSize="12" 
                                       TextColor="#636E72"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>

                            <!-- Stock Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding StockLabel}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="📦" 
                                               FontSize="18" 
                                               TextColor="#9C27B0" 
                                               VerticalOptions="Center"/>
                                        
                                        <Entry Keyboard="Numeric"
                                               Placeholder="{Binding StockPlaceholder}"
                                               PlaceholderColor="#9CA3AF"
                                               Text="{Binding Stock, Mode=TwoWay}"
                                               AutomationId="EntryStock"
                                               BackgroundColor="Transparent"
                                               FontSize="16"
                                               TextColor="#374151"
                                               VerticalOptions="Center"
                                               HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                                <Label Text="{Binding StockHint}" 
                                       FontSize="12" 
                                       TextColor="#636E72"
                                       Margin="4,0,0,0"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Action Button Section -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                            
                            <!-- Info Card -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2196F3"
                                    Padding="16"
                                    Opacity="0.9">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="ℹ️" 
                                           FontSize="16" 
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="Seleccione el tipo de combustible para generar automáticamente el nombre del producto. Los precios y stock son opcionales y pueden configurarse posteriormente."
                                           FontSize="12"
                                           TextColor="#1565C0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Register Button -->
                            <Border Style="{StaticResource PrimarySendButtonStyle}">
                                <Button Text="🚀 Registrar Producto"
                                        TextColor="White" 
                                        BackgroundColor="Transparent"
                                        Clicked="Button_Clicked"
                                        AutomationId="ButtonSendData"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        HeightRequest="56"
                                        CornerRadius="16"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              AutomationId="LoadingOverlay"/>
    </AbsoluteLayout>
</ContentPage>
