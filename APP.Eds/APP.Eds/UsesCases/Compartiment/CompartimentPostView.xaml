<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="APP.Eds.UsesCases.Compartiment.CompartimentPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="{Binding CompartimentManagement}"
    BackgroundColor="#F8F9FA">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="16" Spacing="20">
                
                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="📦 Gestión de Compartimentos" 
                               FontSize="28" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                        <Label Text="Administre los compartimentos de los tanques" 
                               FontSize="14" 
                               TextColor="#E1BEE7" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Border>

                <!-- Compartment Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="⚙️" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nuevo Compartimento" 
                                       FontSize="20" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"/>
                                <Label Text="Configure un nuevo compartimento del tanque" 
                                       FontSize="12" 
                                       TextColor="#636E72"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">
                            
                            <!-- Tank Selection Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding SelectTank}" 
                                       FontSize="14" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       Margin="4,0,0,0"/>
                                       
                                <Border BackgroundColor="#F8F9FA" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="2"
                                        Padding="0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <Label Text="🛢️" 
                                               FontSize="18" 
                                               TextColor="#6A1B9A" 
                                               VerticalOptions="Center"/>
                                        
                                        <Picker Title="{Binding SelectTank}"
                                                ItemsSource="{Binding TankList}" 
                                                ItemDisplayBinding="{Binding Number}" 
                                                SelectedItem="{Binding SelectedTank, Mode=TwoWay}"
                                                AutomationId="PickerTank"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="#374151"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Grid for Number and Height -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                
                                <!-- Number Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="0">
                                    <Label Text="Número" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#2D3436"
                                           Margin="4,0,0,0"/>
                                           
                                    <Border BackgroundColor="#F8F9FA" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="#DDD6FE"
                                            StrokeThickness="2"
                                            Padding="0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <Label Text="🔢" 
                                                   FontSize="16" 
                                                   TextColor="#2196F3" 
                                                   VerticalOptions="Center"/>
                                            
                                            <Entry Keyboard="Numeric"
                                                   Placeholder="{Binding EnterNumber}"
                                                   PlaceholderColor="#9CA3AF"
                                                   Text="{Binding Number, Mode=TwoWay}"
                                                   TextChanged="NumericEntry_TextChanged"
                                                   AutomationId="EntryCompartimentNumber"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="#374151"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Height Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="1">
                                    <Label Text="Altura (m)" 
                                           FontSize="14" 
                                           FontAttributes="Bold" 
                                           TextColor="#2D3436"
                                           Margin="4,0,0,0"/>
                                           
                                    <Border BackgroundColor="#F8F9FA" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="#DDD6FE"
                                            StrokeThickness="2"
                                            Padding="0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <Label Text="📏" 
                                                   FontSize="16" 
                                                   TextColor="#FF9800" 
                                                   VerticalOptions="Center"/>
                                            
                                            <Entry Keyboard="Numeric"
                                                   Placeholder="{Binding EnterHeight}"
                                                   PlaceholderColor="#9CA3AF"
                                                   Text="{Binding Height, Mode=TwoWay}"
                                                   TextChanged="NumericEntry_TextChanged"
                                                   AutomationId="EntryCompartimentHeight"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="#374151"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Capacities Section -->
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Capacidades" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"
                                       HorizontalOptions="Center"/>

                                <!-- Grid for Capacities -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                                    
                                    <!-- Nominal Capacity -->
                                    <VerticalStackLayout Spacing="8" Grid.Column="0" Grid.Row="0">
                                        <Label Text="Capacidad Nominal" 
                                               FontSize="13" 
                                               FontAttributes="Bold" 
                                               TextColor="#2D3436"
                                               HorizontalOptions="Center"/>
                                               
                                        <Border BackgroundColor="#E8F5E8" 
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="#4CAF50"
                                                StrokeThickness="2"
                                                Padding="0">
                                            <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,10">
                                                <Label Text="🟢" 
                                                       FontSize="14" 
                                                       VerticalOptions="Center"/>
                                                
                                                <Entry Keyboard="Numeric"
                                                       Placeholder="{Binding EnterNominal}"
                                                       PlaceholderColor="#9CA3AF"
                                                       Text="{Binding Nominal, Mode=TwoWay}"
                                                       TextChanged="NumericEntry_TextChanged"
                                                       AutomationId="EntryCompartimentNominal"
                                                       BackgroundColor="Transparent"
                                                       FontSize="13"
                                                       TextColor="#2E7D32"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="FillAndExpand"/>
                                            </StackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Operative Capacity -->
                                    <VerticalStackLayout Spacing="8" Grid.Column="1" Grid.Row="0">
                                        <Label Text="Capacidad Operativa" 
                                               FontSize="13" 
                                               FontAttributes="Bold" 
                                               TextColor="#2D3436"
                                               HorizontalOptions="Center"/>
                                               
                                        <Border BackgroundColor="#E3F2FD" 
                                                StrokeShape="RoundRectangle 12"
                                                Stroke="#2196F3"
                                                StrokeThickness="2"
                                                Padding="0">
                                            <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,10">
                                                <Label Text="🔵" 
                                                       FontSize="14" 
                                                       VerticalOptions="Center"/>
                                                
                                                <Entry Keyboard="Numeric"
                                                       Placeholder="{Binding EnterOperative}"
                                                       PlaceholderColor="#9CA3AF"
                                                       Text="{Binding Operative, Mode=TwoWay}"
                                                       TextChanged="NumericEntry_TextChanged"
                                                       AutomationId="EntryCompartimentOperative"
                                                       BackgroundColor="Transparent"
                                                       FontSize="13"
                                                       TextColor="#1976D2"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="FillAndExpand"/>
                                            </StackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Action Button Section -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                            
                            <!-- Info Card -->
                            <Border BackgroundColor="#E3F2FD" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2196F3"
                                    Padding="16"
                                    Opacity="0.9">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Label Text="ℹ️" 
                                           FontSize="16" 
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="Los compartimentos dividen los tanques para almacenar diferentes tipos de combustible. Cada compartimento debe tener capacidades nominal y operativa definidas."
                                           FontSize="12"
                                           TextColor="#1565C0"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Register Button -->
                            <Border Style="{StaticResource PrimarySendButtonStyle}">
                                <Button Text="{Binding SendData}"
                                        TextColor="White" 
                                        BackgroundColor="Transparent"
                                        Clicked="Button_Clicked_1"
                                        AutomationId="ButtonSendCompartimentData"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        HeightRequest="56"
                                        CornerRadius="16"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Compartments List Section -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="#FFF3E0" 
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="📋" 
                                       FontSize="20" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                            
                            <StackLayout VerticalOptions="Center">
                                <Label Text="Lista de Compartimentos" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#2D3436"/>
                                <Label Text="Compartimentos registrados en el sistema" 
                                       FontSize="12" 
                                       TextColor="#636E72"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Compartments List -->
                        <CollectionView ItemsSource="{Binding CompartimentList}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#FAFAFA" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="#E0E0E0"
                                            Margin="0,4"
                                            Padding="16">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1"/>
                                        </Border.Shadow>
                                        


        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              IsVisible="{Binding IsLoading}"/>
    </AbsoluteLayout>
</ContentPage>