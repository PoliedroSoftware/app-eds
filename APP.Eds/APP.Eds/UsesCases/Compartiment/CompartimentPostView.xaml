<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Compartiment.CompartimentPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    Title="{Binding CompartimentManagement}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <AbsoluteLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" x:Name="MainContent">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Header Card with Purple Gradient -->
                <Border Style="{StaticResource HeaderCardStyle}" Margin="0,8,0,0">
                    <StackLayout Spacing="8">
                        <Label Text="Gestión de Compartimentos"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Start"/>
                        <Label Text="Administre los compartimentos de los tanques"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalOptions="Start"/>
                    </StackLayout>
                </Border>

                <!-- Compartment Registration Form Card -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="20">

                        <!-- Section Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <brand:PoliedroIcon Text="⚙️"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Nuevo Compartimento"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Configure un nuevo compartimento del tanque"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="16">

                            <!-- Tank Selection Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding SelectTank}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="🛢️"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                               VerticalOptions="Center"/>

                                        <Picker Title="{Binding SelectTank}"
                                                ItemsSource="{Binding TankList}"
                                                ItemDisplayBinding="{Binding DisplayText}"
                                                SelectedItem="{Binding SelectedTank, Mode=TwoWay}"
                                                AutomationId="PickerTank"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Product Selection Field -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Seleccionar producto"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,0"/>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <StackLayout Orientation="Horizontal" Spacing="12" Padding="16,12">
                                        <brand:PoliedroIcon Text="⛽"
                                               FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                               VerticalOptions="Center"/>

                                        <Picker Title="Selecciona un producto"
                                                ItemsSource="{Binding ProductList}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                                AutomationId="PickerProduct"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="FillAndExpand"/>
                                    </StackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Grid for Number and Height -->
                            <brand:ResponsiveFormGrid ColumnDefinitions="*,*" ColumnSpacing="12">

                                <!-- Number Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="0">
                                    <Label Text="Número"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           Margin="4,0,0,0"/>

                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                            StrokeThickness="2"
                                            Padding="12,0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <brand:PoliedroIcon Text="🔢"
                                                   FontSize="16"
                                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                   VerticalOptions="Center"/>

                                            <Entry Keyboard="Numeric"
                                                   Placeholder="{Binding EnterNumber}"
                                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   Text="{Binding Number, Mode=TwoWay}"
                                                   TextChanged="NumericEntry_TextChanged"
                                                   AutomationId="EntryCompartimentNumber"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Height Field -->
                                <VerticalStackLayout Spacing="8" Grid.Column="1">
                                    <Label Text="Altura (cm)"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           Margin="4,0,0,0"/>

                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                            StrokeThickness="2"
                                            Padding="12,0">
                                        <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,12">
                                            <brand:PoliedroIcon Text="📏"
                                                   FontSize="16"
                                                   TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                   VerticalOptions="Center"/>

                                            <Entry Keyboard="Numeric"
                                                   Placeholder="{Binding EnterHeight}"
                                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   Text="{Binding Height, Mode=TwoWay}"
                                                   TextChanged="NumericEntry_TextChanged"
                                                   AutomationId="EntryCompartimentHeight"
                                                   BackgroundColor="Transparent"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </StackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </brand:ResponsiveFormGrid>

                            <!-- Capacities Section -->
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Capacidades"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       HorizontalOptions="Center"/>

                                <!-- Grid for Capacities -->
                                <brand:ResponsiveFormGrid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto" RowSpacing="12">

                                    <!-- Nominal Capacity -->
                                    <VerticalStackLayout Spacing="8" Grid.Column="0" Grid.Row="0">
                                        <Label Text="Capacidad Nominal"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               HorizontalOptions="Center"/>

                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                                StrokeThickness="2"
                                                Padding="12,0">
                                            <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,10">
                                                <brand:PoliedroIcon Text="🟢"
                                                       FontSize="14"
                                                       VerticalOptions="Center"/>

                                                <Entry Keyboard="Numeric"
                                                       Placeholder="{Binding EnterNominal}"
                                                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       Text="{Binding Nominal, Mode=TwoWay}"
                                                       TextChanged="NumericEntry_TextChanged"
                                                       AutomationId="EntryCompartimentNominal"
                                                       BackgroundColor="Transparent"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="FillAndExpand"/>
                                            </StackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Operative Capacity -->
                                    <VerticalStackLayout Spacing="8" Grid.Column="1" Grid.Row="0">
                                        <Label Text="Capacidad Operativa"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               HorizontalOptions="Center"/>

                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                                StrokeThickness="2"
                                                Padding="12,0">
                                            <StackLayout Orientation="Horizontal" Spacing="8" Padding="12,10">
                                                <brand:PoliedroIcon Text="🔵"
                                                       FontSize="14"
                                                       VerticalOptions="Center"/>

                                                <Entry Keyboard="Numeric"
                                                       Placeholder="{Binding EnterOperative}"
                                                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       Text="{Binding Operative, Mode=TwoWay}"
                                                       TextChanged="NumericEntry_TextChanged"
                                                       AutomationId="EntryCompartimentOperative"
                                                       BackgroundColor="Transparent"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="FillAndExpand"/>
                                            </StackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </brand:ResponsiveFormGrid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Action Button Section -->
                        <VerticalStackLayout Spacing="16" Margin="0,12,0,0">

                            <!-- Info Card -->
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                    Padding="16"
                                    Opacity="0.9">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <brand:PoliedroIcon Text="ℹ️"
                                           FontSize="16"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"/>
                                    <Label Text="Los compartimentos dividen los tanques para almacenar diferentes tipos de combustible. Cada compartimento debe tener capacidades nominal y operativa definidas, así como una altura específica en centímetros."
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"/>
                                </StackLayout>
                            </Border>

                            <!-- Register Button -->
                            <Border Style="{StaticResource PrimarySendButtonStyle}">
                                <Button Text="{Binding SendData}"
                                        TextColor="{StaticResource OnBrand}"
                                        BackgroundColor="Transparent"
                                        Clicked="Button_Clicked_1"
                                        AutomationId="ButtonSendCompartimentData"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        MinimumHeightRequest="52"
                                        CornerRadius="16"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Compartments List Section -->
                <Border Style="{StaticResource ModernCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <!-- List Header -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                    StrokeShape="RoundRectangle 20"
                                    WidthRequest="40" HeightRequest="40"
                                    VerticalOptions="Center">
                                <brand:PoliedroIcon Text="📋"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <StackLayout VerticalOptions="Center">
                                <Label Text="Lista de Compartimentos"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                <Label Text="Compartimentos registrados en el sistema"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Compartments List -->
                        <CollectionView ItemsSource="{Binding CompartimentList}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                            Margin="0,4"
                                            Padding="16">


                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                                            <!-- Compartment Icon -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                    StrokeShape="RoundRectangle 16"
                                                    WidthRequest="40" HeightRequest="40"
                                                    Grid.RowSpan="3" Grid.Column="0"
                                                    VerticalOptions="Start">
                                                <brand:PoliedroIcon Text="📦"
                                                       FontSize="18"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Compartment Info Header -->
                                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding Number, StringFormat='Compartimento #{0}'}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                                <StackLayout Orientation="Horizontal" Spacing="8">
                                                    <Label Text="{Binding Number, StringFormat='Tanque #: {0}'}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                           FontAttributes="Bold"/>
                                                    <Label Text="{Binding IdProduct, StringFormat='| Producto ID: {0}'}"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                                           FontAttributes="Bold"/>
                                                </StackLayout>
                                            </StackLayout>

                                            <!-- Details Grid -->
                                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="16">
                                                <!-- Nominal Capacity -->
                                                <StackLayout Grid.Row="0" Grid.Column="0">
                                                    <Label Text="Cap. Nominal" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                    <Label Text="{Binding Nominal, StringFormat='{0:N2} L'}"
                                                           FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" FontAttributes="Bold"/>
                                                </StackLayout>

                                                <!-- Operative Capacity -->
                                                <StackLayout Grid.Row="0" Grid.Column="1">
                                                    <Label Text="Cap. Operativa" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                    <Label Text="{Binding Operative, StringFormat='{0:N2} L'}"
                                                           FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold"/>
                                                </StackLayout>

                                                <!-- Height -->
                                                <StackLayout Grid.Row="1" Grid.Column="1">
                                                    <Label Text="Altura" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                                    <Label Text="{Binding Height, StringFormat='{0:N0} cm'}"
                                                           FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}" FontAttributes="Bold"/>
                                                </StackLayout>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <StackLayout Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                        StrokeShape="RoundRectangle 16"
                                                        Padding="8,4">
                                                    <Button Text="Editar"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                                            FontSize="12"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCompartimentCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Border>

                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 16"
                                                        Padding="8,4">
                                                    <Button Text="Eliminar"
                                                            BackgroundColor="Transparent"
                                                            TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                            FontSize="12"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCompartimentCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                </Border>
                                            </StackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Spacer -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <controls:LoadingView x:Name="LoadingOverlay"
                              AbsoluteLayout.LayoutBounds="0,0,1,1"
                              AbsoluteLayout.LayoutFlags="All"
                              IsVisible="{Binding IsLoading}"/>
    </AbsoluteLayout>
</ContentPage>