<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.UsesCases.Phone.PhoneRegistrationView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:APP.Eds.UsesCases.LoadingView"
    xmlns:converters="clr-namespace:APP.Eds.Converters.Wizard"
    Title="Registrar Telefonos"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Header -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    StrokeThickness="0">
                <StackLayout>
                    <Label Text="Registro de Telefonos"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           HorizontalOptions="Start"/>
                    <Label Text="Registra numeros telefonicos con propietario e indicativo +57 automaticamente"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           HorizontalOptions="Start"
                           Margin="0,5,0,0"/>
                </StackLayout>
            </Border>

            <!-- Statistics -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Estadisticas de Registro"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                Padding="12"
                                Grid.Column="0">
                            <StackLayout Spacing="6">
                                <Label Text="Total Registrados"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding TotalPhones}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                Padding="12"
                                Grid.Column="1">
                            <StackLayout Spacing="6">
                                <Label Text="Registrados Hoy"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding PhonesToday}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                       HorizontalOptions="Center"/>
                            </StackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Registration Form -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="24">
                <VerticalStackLayout Spacing="24">

                    <Label Text="Registrar Nuevo Telefono"
                           FontAttributes="Bold"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                    <!-- Owner Name Input -->
                    <StackLayout Spacing="12">
                        <Label Text="Nombre del Propietario"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="16"/>

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                Padding="12,0">
                            <Entry Keyboard="Text"
                                   Placeholder="Ej: Juan Pérez"
                                   Text="{Binding OwnerName, Mode=TwoWay}"
                                   BackgroundColor="Transparent"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                   FontSize="16"
                                   MaxLength="50"/>
                        </Border>

                        <!-- Name Error message -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                Padding="8"
                                IsVisible="{Binding ShowNameError}">
                            <Label Text="El nombre es obligatorio"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"/>
                        </Border>
                    </StackLayout>

                    <!-- Phone Number Input -->
                    <StackLayout Spacing="12">
                        <Label Text="Numero de Telefono"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="16"/>

                        <!-- Preview of full number -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                Padding="12">
                            <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                                <Label Text="Vista previa:"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding FullPhoneNumber}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                       VerticalOptions="Center"/>
                            </StackLayout>
                        </Border>

                        <!-- Phone input with +57 prefix -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                Padding="4">
                            <brand:ResponsiveFormGrid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="12,8"
                                        Grid.Column="0">
                                    <Label Text="+57"
                                           TextColor="{StaticResource OnBrand}"
                                           FontAttributes="Bold"
                                           FontSize="16"/>
                                </Border>
                                <Entry Keyboard="Telephone"
                                       Placeholder="Ej: 3001234567"
                                       Text="{Binding PhoneNumber, Mode=TwoWay}"
                                       BackgroundColor="Transparent"
                                       PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="16"
                                       Grid.Column="1"
                                       MaxLength="12"/>
                            </brand:ResponsiveFormGrid>
                        </Border>

                        <!-- Phone Error message -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                Padding="8"
                                IsVisible="{Binding ShowPhoneError}">
                            <Label Text="El numero de telefono es obligatorio"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"/>
                        </Border>
                    </StackLayout>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                        <!-- Add to List Button -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Grid.Column="0">
                            <Button BackgroundColor="Transparent"
                                    Command="{Binding SavePhoneCommand}"
                                    Text="Agregar a Lista"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="52"/>
                        </Border>

                        <!-- Clear Button -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Grid.Column="1">
                            <Button BackgroundColor="Transparent"
                                    Command="{Binding ClearFormCommand}"
                                    Text="Limpiar"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    WidthRequest="80"
                                    MinimumHeightRequest="52"/>
                        </Border>

                        <!-- Send to Server Button -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="4"
                                Grid.Column="2">
                            <Button BackgroundColor="Transparent"
                                    Command="{Binding SendPhonesCommand}"
                                    Text="Guardar"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="52"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Phone List -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="20">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Lista de Telefonos a Enviar"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                    <CollectionView ItemsSource="{Binding PhonesList}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                        Margin="0,4"
                                        Padding="16">

                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="6">

                                        <!-- Phone Icon -->
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                                StrokeShape="RoundRectangle 25"
                                                WidthRequest="50"
                                                HeightRequest="50"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                VerticalOptions="Center">
                                            <Label Text="TEL"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource OnBrand}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Owner Name -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                        <!-- Phone Number -->
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Number}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"/>

                                        <!-- Delete Button -->
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                                                StrokeShape="RoundRectangle 15"
                                                Stroke="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                WidthRequest="35"
                                                HeightRequest="35"
                                                Grid.Column="2"
                                                Grid.RowSpan="2"
                                                VerticalOptions="Center">
                                            <Button Text="X"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    WidthRequest="35"
                                                    HeightRequest="35"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeletePhoneCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16" Margin="0,40">
                                <Label Text="TEL" FontSize="48" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                <Label Text="No hay telefonos en la lista"
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalOptions="Center"
                                       FontAttributes="Bold"/>
                                <Label Text="Agrega numeros con propietarios usando el formulario superior"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Database Phones List -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    Padding="20">
                <VerticalStackLayout Spacing="16">

                    <!-- Header with refresh button -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="Telefonos Guardados"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               VerticalOptions="Center"/>

                        <Border Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="4">
                            <Button BackgroundColor="Transparent"
                                    Command="{Binding RefreshDatabasePhonesCommand}"
                                    Text="Actualizar"
                                    TextColor="{StaticResource OnBrand}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    WidthRequest="80"
                                    HeightRequest="35"
                                    IsEnabled="{Binding IsLoadingDatabasePhones, Converter={StaticResource InvertedBoolConverter}}"/>
                        </Border>
                    </Grid>

                    <!-- Statistics -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                            Padding="12">
                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="8">
                            <Label Text="Total Guardados:"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding DatabasePhonesCount}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <!-- Loading Indicator -->
                    <StackLayout IsVisible="{Binding IsLoadingDatabasePhones}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16"
                                 Margin="0,20">
                        <ActivityIndicator IsRunning="{Binding IsLoadingDatabasePhones}"
                                           Color="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                                           WidthRequest="40"
                                           HeightRequest="40"/>
                        <Label Text="Cargando telefonos guardados..."
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalOptions="Center"/>
                    </StackLayout>

                    <!-- Database Phones Collection -->
                    <CollectionView ItemsSource="{Binding DatabasePhonesList}"
                                    IsVisible="{Binding IsLoadingDatabasePhones, Converter={StaticResource InvertedBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                        Margin="0,4"
                                        Padding="16">

                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="6">

                                        <!-- Phone Icon -->
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                StrokeShape="RoundRectangle 25"
                                                WidthRequest="50"
                                                HeightRequest="50"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                VerticalOptions="Center">
                                            <Label Text="TEL"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource OnBrand}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Owner Name -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>

                                        <!-- Phone Number -->
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Number}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"/>

                                        <!-- Status Indicator -->
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                StrokeShape="RoundRectangle 15"
                                                Stroke="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                WidthRequest="35"
                                                HeightRequest="35"
                                                Grid.Column="2"
                                                Grid.RowSpan="2"
                                                VerticalOptions="Center">
                                            <brand:PoliedroIcon Text="✓"
                                                   BackgroundColor="Transparent"
                                                   TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16" Margin="0,40"
                                         IsVisible="{Binding IsLoadingDatabasePhones, Converter={StaticResource InvertedBoolConverter}}">
                                <Label Text="TEL" FontSize="48" HorizontalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" FontAttributes="Bold"/>
                                <Label Text="No hay telefonos guardados"
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalOptions="Center"
                                       FontAttributes="Bold"/>
                                <Label Text="Los telefonos aparecerán aquí una vez que los guardes usando el boton 'Guardar'"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="20" Color="Transparent"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>