<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup
	x:Class="APP.Eds.Components.PopUp.AddInfo"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
	CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent">
    
    <Frame
		Padding="20"
		BorderColor="#6200E8"
		CornerRadius="15"
		HasShadow="True"
		WidthRequest="390"
        AutomationId="FrameAddInfo">

        <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">

            <!--  Encabezado  -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, *" Padding="0,0,0,10">
                <Button Grid.Column="2" Margin="10,0,0,0"
                        BackgroundColor="Transparent"
                        Clicked="OnCloseTapped"
                        FontSize="18" Text="✖" TextColor="#6200E8"
                        WidthRequest="30" HeightRequest="30"
                        Padding="0"
                        HorizontalOptions="End" VerticalOptions="Center"
                        AutomationId="ButtonClosePopup"/>
            </Grid>
            
            <!--  Campos de Entrada  -->
            <Frame Grid.Row="1"
                   Padding="10"
                CornerRadius="10"
                   AutomationId="FrameDescriptionInput">
            <VerticalStackLayout Spacing="10">
                    <Editor
                        HeightRequest="300"
                        AutoSize="Disabled"
                        Placeholder="{Binding EnterADescription}"
                        Text="{Binding AditionalInfoDescription, Mode=TwoWay}"
                        AutomationId="EditorDescription"/>
                </VerticalStackLayout>
            </Frame>
            
            <!-- Botones de Acción -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="Cancelar" Clicked="OnCloseTapped" BackgroundColor="#E0E0E0" TextColor="#6200E8" CornerRadius="10" AutomationId="ButtonCancelAddInfo"/>
                <Button Grid.Column="1" Text="Guardar" Clicked="OnSaveTapped" BackgroundColor="#6200E8" TextColor="White" CornerRadius="10" AutomationId="ButtonSaveAddInfo"/>
            </Grid>
        </Grid>
    </Frame>
</mct:Popup>
