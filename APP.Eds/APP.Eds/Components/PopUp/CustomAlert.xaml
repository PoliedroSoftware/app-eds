<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup
    x:Class="APP.Eds.Components.PopUp.CustomAlert"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Color="Transparent">

    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
            StrokeShape="RoundRectangle 20"
            WidthRequest="340"
            HeightRequest="450"
            VerticalOptions="Center"
            HorizontalOptions="Center">


        <Grid RowDefinitions="Auto,*,Auto" Padding="0">

            <!-- Header -->
            <Border Grid.Row="0"
                    x:Name="HeaderBorder"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                    StrokeShape="RoundRectangle 20,20,0,0"
                    Padding="20,24,20,20">

                <StackLayout HorizontalOptions="Center" Spacing="12">
                    <!-- Icon with better styling -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 25"
                            WidthRequest="50"
                            HeightRequest="50"
                            HorizontalOptions="Center"
                            Opacity="0.9">
                        <Label x:Name="IconLabel"
                               Text="i"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>

                    <Label x:Name="TitleLabel"
                           Text="Error"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnBrand}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Border>

            <!-- Message Content with ScrollView -->
            <ScrollView Grid.Row="1"
                        Padding="24,20"
                        Orientation="Vertical"
                        VerticalScrollBarVisibility="Default">
                <StackLayout Spacing="16">
                    <Label x:Name="MessageLabel"
                           Text="Mensaje de alerta"
                           FontSize="16"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           HorizontalOptions="FillAndExpand"
                           HorizontalTextAlignment="Start"
                           VerticalTextAlignment="Start"/>

                    <Label x:Name="DetailLabel"
                           Text=""
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                           HorizontalOptions="FillAndExpand"
                           HorizontalTextAlignment="Start"
                           VerticalTextAlignment="Start"
                           IsVisible="False"
                           Margin="0,8,0,0"/>
                </StackLayout>
            </ScrollView>

            <!-- Buttons -->
            <StackLayout Grid.Row="2"
                         Orientation="Horizontal"
                         Spacing="12"
                         Padding="24,16,24,24"
                         HorizontalOptions="Center">

                <Border x:Name="CancelButtonBorder"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                        StrokeThickness="1"
                        IsVisible="False"
                        Padding="2">
                    <Button x:Name="CancelButton"
                            BackgroundColor="Transparent"
                            Text="Cancelar"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                            FontSize="14"
                            FontAttributes="Bold"
                            WidthRequest="110"
                            MinimumHeightRequest="52"
                            Clicked="OnCancelClicked"/>
                </Border>

                <Border x:Name="ConfirmButtonBorder"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ErrorSurface}, Dark={StaticResource ErrorSurfaceDark}}"
                        StrokeShape="RoundRectangle 12"
                        Padding="2">

                    <Button x:Name="ConfirmButton"
                            BackgroundColor="Transparent"
                            Text="OK"
                            TextColor="{StaticResource OnBrand}"
                            FontSize="14"
                            FontAttributes="Bold"
                            WidthRequest="110"
                            MinimumHeightRequest="52"
                            Clicked="OnConfirmClicked"/>
                </Border>
            </StackLayout>
        </Grid>
    </Border>
</mct:Popup>