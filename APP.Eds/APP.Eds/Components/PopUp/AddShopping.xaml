<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup
    x:Class="APP.Eds.Components.PopUp.AddShopping"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent"
    AutomationId="PopupAddShopping">

    <!-- Main Container with Modern Design -->
    <Border x:Name="PopupBorder"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
            StrokeShape="RoundRectangle 24"
            StrokeThickness="0"
            WidthRequest="400"
            HeightRequest="700"
            AutomationId="FrameAddShopping">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,8" Radius="24" Opacity="0.15"/>
        </Border.Shadow>

        <Grid RowDefinitions="Auto,*,Auto" Padding="0">
            
            <!-- Modern Header -->
            <Border Grid.Row="0"
                    BackgroundColor="#6A1B9A"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    Padding="24,20,24,20">
                <Border.Shadow>
                    <Shadow Brush="#6A1B9A" Offset="0,2" Radius="8" Opacity="0.3"/>
                </Border.Shadow>
                
                <Grid ColumnDefinitions="*,Auto,*">
                    <!-- Header Content -->
                    <StackLayout Grid.Column="1" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center"
                                 Spacing="4">
                        <Label Text="🛒 Nuevo Producto" 
                               FontSize="22" 
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               AutomationId="LabelAddShopping"/>
                        <Label Text="Agregue un producto a la compra" 
                               FontSize="13" 
                               TextColor="#E1BEE7"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                    
                    <!-- Close Button -->
                    <Border Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                            StrokeShape="RoundRectangle 16"
                            WidthRequest="32" HeightRequest="32"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Opacity="0.9">
                        <Button BackgroundColor="Transparent"
                                Clicked="OnCloseTapped"
                                FontSize="16" 
                                Text="✖" 
                                TextColor="#6A1B9A"
                                FontAttributes="Bold"
                                WidthRequest="32" HeightRequest="32"
                                CornerRadius="16"
                                Padding="0"
                                AutomationId="ButtonClosePopup"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollView Grid.Row="1" 
                        Padding="20" 
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="20">
                    
                    <!-- Product Selection Card -->
                    <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}"
                            StrokeShape="RoundRectangle 16"
                            Stroke="#E3F2FD"
                            StrokeThickness="2"
                            Padding="20"
                            AutomationId="FrameProductCompartimentPicker">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05"/>
                        </Border.Shadow>
                        
                        <VerticalStackLayout Spacing="12">
                            <!-- Section Header -->
                            <StackLayout Orientation="Horizontal" Spacing="12">
                                <Border BackgroundColor="#E3F2FD" 
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="32" HeightRequest="32"
                                        VerticalOptions="Center">
                                    <Label Text="📦" 
                                           FontSize="16" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"/>
                                </Border>
                                
                                <Label Text="Producto y Compartimento" 
                                       FontSize="16" 
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       VerticalOptions="Center"/>
                            </StackLayout>
                            
                            <!-- Product List Container - Visible cuando hay productos -->
                            <VerticalStackLayout x:Name="PickerContainer" Spacing="8">
                                <!-- Header -->
                                <Label Text="Seleccione producto y compartimento"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                       Margin="4,0,0,4"/>
                                
                                <!-- Scrollable Product List -->
                                <Border BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        HeightRequest="320">
                                    <CollectionView x:Name="ProductCompartimentList"
                                                    ItemsSource="{Binding FilteredProductCompartimentPairs}"
                                                    SelectionMode="Single"
                                                    SelectedItem="{Binding SelectedProductCompartimentPair, Mode=TwoWay}"
                                                    SelectionChanged="ProductCompartimentListSelectionChanged"
                                                    AutomationId="CollectionViewProductCompartimentPair">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
                                                        StrokeShape="RoundRectangle 8"
                                                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#3D3D3D}"
                                                        StrokeThickness="1"
                                                        Padding="12,10"
                                                        Margin="8,4">
                                                    <Border.Shadow>
                                                        <Shadow Brush="Black" Offset="0,1" Radius="2" Opacity="0.05"/>
                                                    </Border.Shadow>
                                                    
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <!-- Product Icon -->
                                                        <Border Grid.Column="0"
                                                                BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1E3A5F}"
                                                                StrokeShape="RoundRectangle 12"
                                                                WidthRequest="32" HeightRequest="32"
                                                                VerticalOptions="Center">
                                                            <Label Text="📦"
                                                                   FontSize="16"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>
                                                        
                                                        <!-- Product Info -->
                                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                            <Label Text="{Binding ProductName}"
                                                                   FontSize="15"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"/>
                                                            <Label FontSize="13"
                                                                   TextColor="{AppThemeBinding Light=#636E72, Dark=#B8B8B8}"
                                                                   LineBreakMode="WordWrap">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="Compartimento " FontAttributes="Bold"/>
                                                                        <Span Text="{Binding Number}"/>
                                                                        <Span Text=" | Capacidad: "/>
                                                                        <Span Text="{Binding Operative, StringFormat='{0:N0}'}"/>
                                                                        <Span Text=" | Stock: "/>
                                                                        <Span Text="{Binding Stock, StringFormat='{0:N0}'}"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                    
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup Name="CommonStates">
                                                            <VisualState Name="Normal">
                                                                <VisualState.Setters>
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#252525}"/>
                                                                    <Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#3D3D3D}"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState Name="Selected">
                                                                <VisualState.Setters>
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EBF5FF, Dark=#1A2F4A}"/>
                                                                    <Setter Property="Stroke" Value="#2196F3"/>
                                                                    <Setter Property="StrokeThickness" Value="2"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                        
                                        <!-- Empty View -->
                                        <CollectionView.EmptyView>
                                            <VerticalStackLayout Padding="20" Spacing="12" VerticalOptions="Center">
                                                <Label Text="🔍"
                                                       FontSize="32"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="No hay productos disponibles"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#B8B8B8}"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </CollectionView.EmptyView>
                                    </CollectionView>
                                </Border>
                            </VerticalStackLayout>
                            
                            <!-- Empty State Message - Visible cuando NO hay productos -->
                            <Border x:Name="EmptyStateContainer"
                                    BackgroundColor="#FFF3CD" 
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#F59E0B"
                                    StrokeThickness="2"
                                    Padding="16"
                                    IsVisible="False">
                                <StackLayout Spacing="12">
                                    <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                                        <Label Text="⚠️" 
                                               FontSize="24" 
                                               VerticalOptions="Center"/>
                                        <Label Text="Sin Productos Disponibles" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               TextColor="#92400E"
                                               VerticalOptions="Center"/>
                                    </StackLayout>
                                    <Label x:Name="EmptyStateMessage"
                                           Text="Cargando información..."
                                           FontSize="13"
                                           TextColor="#92400E"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>
                                </StackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Price Fields Grid -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="16">
                        
                        <!-- Purchase Price -->
                        <Border Grid.Column="0" Grid.Row="0"
                                BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="#E8F5E8"
                                StrokeThickness="2"
                                Padding="16"
                                AutomationId="FramePriceEntry">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05"/>
                            </Border.Shadow>
                            
                            <VerticalStackLayout Spacing="12">
                                <!-- Field Header -->
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Label Text="💰" 
                                           FontSize="16" 
                                           TextColor="#4CAF50" 
                                           VerticalOptions="Center"/>
                                    <StackLayout VerticalOptions="Center">
                                        <Label Text="Precio Compra" 
                                               FontSize="14" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                               AutomationId="LabelPrice"/>
                                        <Label Text="Incluye transporte" 
                                               FontSize="11" 
                                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#B8B8B8}"
                                               Margin="0,-2,0,0"/>
                                    </StackLayout>
                                </StackLayout>
                                
                                <!-- Entry Container -->
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" 
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="1"
                                        Padding="12,10">
                                    <Entry x:Name="FirstEntry" 
                                           Keyboard="Numeric"
                                           Placeholder="0.00" 
                                           PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                           Text="{Binding PurchasePrice, Mode=TwoWay}"
                                           Completed="EntryPurchasePriceCompleted"
                                           IsEnabled="{Binding SelectedProductCompartimentPair, Converter={StaticResource IsNotNullConverter}}"
                                           BackgroundColor="Transparent"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                           HorizontalTextAlignment="Center"
                                           AutomationId="EntryPrice"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Sell Price -->
                        <Border Grid.Column="1" Grid.Row="0"
                                BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="#FFF3E0"
                                StrokeThickness="2"
                                Padding="16"
                                AutomationId="FrameSellPriceEntry">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05"/>
                            </Border.Shadow>
                            
                            <VerticalStackLayout Spacing="12">
                                <!-- Field Header -->
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Label Text="🏷️" 
                                           FontSize="16" 
                                           TextColor="#FF9800" 
                                           VerticalOptions="Center"/>
                                    <Label Text="Precio Venta" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                           VerticalOptions="Center"
                                           AutomationId="LabelSellPrice"/>
                                </StackLayout>
                                
                                <!-- Entry Container -->
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" 
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="1"
                                        Padding="12,10">
                                    <Entry x:Name="SecondEntry" 
                                           Keyboard="Numeric"
                                           Placeholder="0.00" 
                                           PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                           Text="{Binding SellPrice, Mode=TwoWay}"
                                           IsEnabled="{Binding SelectedProductCompartimentPair, Converter={StaticResource IsNotNullConverter}}"
                                           Completed="EntrySellPriceCompleted"
                                           BackgroundColor="Transparent"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                           HorizontalTextAlignment="Center"
                                           AutomationId="EntrySellPrice"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Quantity Field (Full Width) -->
                        <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2C2C2C}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="#E3F2FD"
                                StrokeThickness="2"
                                Padding="20"
                                AutomationId="FrameQuantityEntry">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.05"/>
                            </Border.Shadow>
                            
                            <VerticalStackLayout Spacing="12">
                                <!-- Field Header -->
                                <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                                    <Label Text="⛽" 
                                           FontSize="18" 
                                           TextColor="#2196F3" 
                                           VerticalOptions="Center"/>
                                    <Label Text="Cantidad de Galones" 
                                           FontSize="16" 
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#2D3436, Dark=#E8E8E8}"
                                           VerticalOptions="Center"
                                           AutomationId="LabelQuantity"/>
                                </StackLayout>
                                
                                <!-- Entry Container -->
                                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" 
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#3D3D3D}"
                                        StrokeThickness="2"
                                        Padding="16,12">
                                    <Entry x:Name="ThirdEntry" 
                                           Keyboard="Numeric"
                                           Placeholder="0.000" 
                                           PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                                           Text="{Binding Quantity, Mode=TwoWay}"
                                           IsEnabled="{Binding SelectedProductCompartimentPair, Converter={StaticResource IsNotNullConverter}}"
                                           Completed="Add_Product"
                                           BackgroundColor="Transparent"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light=#374151, Dark=#E8E8E8}"
                                           HorizontalTextAlignment="Center"
                                           AutomationId="EntryQuantity"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Info Card -->
                    <Border BackgroundColor="#E3F2FD" 
                            StrokeShape="RoundRectangle 12"
                            Stroke="#2196F3"
                            Padding="16"
                            Opacity="0.9">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Label Text="ℹ️" 
                                   FontSize="16" 
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0"/>
                            <Label Text="Complete todos los campos para agregar el producto a la compra. El sistema calculará automáticamente el total."
                                   FontSize="12"
                                   TextColor="#1565C0"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"/>
                        </StackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Action Button -->
            <Border Grid.Row="2" 
                    Margin="20,0,20,20">
                <Border BackgroundColor="#6A1B9A"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="4">
                    <Border.Shadow>
                        <Shadow Brush="#6A1B9A" 
                                Offset="0,4" 
                                Radius="12" 
                                Opacity="0.3"/>
                    </Border.Shadow>
                    
                    <Button x:Name="AddButton" 
                            BackgroundColor="Transparent"
                            Clicked="Add_Product"
                            FontSize="18" 
                            FontAttributes="Bold"
                            Text="🚀 Agregar a la Compra" 
                            TextColor="White"
                            HeightRequest="56"
                            CornerRadius="16"
                            AutomationId="ButtonAddProduct"/>
                </Border>
            </Border>
        </Grid>
    </Border>
</mct:Popup>