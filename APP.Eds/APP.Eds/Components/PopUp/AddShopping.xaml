<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup
    x:Class="APP.Eds.Components.PopUp.AddShopping"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent"
    AutomationId="PopupAddShopping">

    <Frame Padding="20"
           BorderColor="#6200E8"
           CornerRadius="15"
           HasShadow="True"
           HeightRequest="600" WidthRequest="380"
           AutomationId="FrameAddShopping">

        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">

            <!--  Encabezado  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Padding="0,0,0,10">
                <Label Text="Nuevo Producto" FontAttributes="Bold" FontSize="22" Grid.Row="0" Grid.Column="1"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center"
                       AutomationId="LabelAddShopping"/>
                <Button Grid.Column="2"
                        BackgroundColor="Transparent"
                        Clicked="OnCloseTapped"
                        FontSize="18" Text="✖" TextColor="#6200E8"
                        WidthRequest="30" HeightRequest="30" Padding="0"
                        HorizontalOptions="End" VerticalOptions="Center"
                        AutomationId="ButtonClosePopup"/>
            </Grid>

            <ScrollView Grid.Row="1" MaximumHeightRequest="500">
                <VerticalStackLayout>
                    <Frame Padding="10" CornerRadius="10" HasShadow="True" Margin="0,0,0,10" AutomationId="FrameProductCompartimentPicker">
                        <Grid RowDefinitions="*,*" ColumnDefinitions="*">
                            <Label Text="Producto y Compartimento" HorizontalOptions="Center" Grid.Row="0"/>
                            <Picker x:Name="ProductCompartimentPicker" Title="Seleccione producto y compartimento" Grid.Row="1"
                                    ItemsSource="{Binding ProductCompartimentPairs}" ItemDisplayBinding="{Binding Display}" SelectedItem="{Binding SelectedProductCompartimentPair, Mode=TwoWay}" SelectedIndexChanged="ProductCompartimentPickerSelected"
                                    HorizontalTextAlignment="Center"
                                    AutomationId="PickerProductCompartimentPair"/>
                        </Grid>
                    </Frame>

                    <Frame Padding="10" CornerRadius="10" HasShadow="True" Margin="0,0,0,10" AutomationId="FramePriceEntry">
                        <Grid RowDefinitions="*,*" ColumnDefinitions="*">
                            <Label Text="Precio De Compra Por Galon" HorizontalOptions="Center" Grid.Row="0" AutomationId="LabelPrice"/>
                            <Entry x:Name="FirstEntry" Keyboard="Numeric" Grid.Row="1"
                                   Placeholder="Ingrese el precio de compra por galon" HorizontalTextAlignment="Center"
                                   Text="{Binding Price, Mode=TwoWay}"
                                   Completed="EntryPriceCompleted"
                                   IsEnabled="{Binding SelectedProductCompartimentPair, Converter={StaticResource NullToBoolConverter}}"
                                   AutomationId="EntryPrice"/>
                        </Grid>
                    </Frame>

                    <Frame Padding="10" CornerRadius="10" HasShadow="True" Margin="0,0,0,10" AutomationId="FrameQuantityEntry">
                        <Grid RowDefinitions="*,*" ColumnDefinitions="*">
                            <Label Text="Cantidad De Galones" HorizontalOptions="Center" Grid.Row="0" AutomationId="LabelQuantity"/>
                            <Entry x:Name="SecondEntry" Keyboard="Numeric" Grid.Row="1"
                                   Placeholder="Ingrese la cantidad de galones" HorizontalTextAlignment="Center"
                                   Text="{Binding Quantity, Mode=TwoWay}"
                                   IsEnabled="{Binding SelectedProductCompartimentPair, Converter={StaticResource NullToBoolConverter}}"
                                   Completed="EntryQuantityCompleted"
                                   AutomationId="EntryQuantity"/>
                        </Grid>
                    </Frame>

                    <Frame Padding="10" CornerRadius="10" HasShadow="True" Margin="0,0,0,10" AutomationId="FrameSellPriceEntry">
                        <Grid RowDefinitions="*,*" ColumnDefinitions="*">
                            <Label Text="Precio De Venta Por Galon" HorizontalOptions="Center" Grid.Row="0" AutomationId="LabelSellPrice"/>
                            <Entry x:Name="ThirdEntry" Keyboard="Numeric" Grid.Row="1"
                                   Placeholder="Ingrese el precio de venta por galon" HorizontalTextAlignment="Center"
                                   Text="{Binding SellPrice, Mode=TwoWay}"
                                   IsEnabled="{Binding SelectedProductCompartimentPair, Converter={StaticResource NullToBoolConverter}}"
                                   Completed="Add_Product"
                                   AutomationId="EntrySellPrice"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Botón de agregar -->
            <Button Grid.Row="2" x:Name="AddButton" 
                    BackgroundColor="#6200E8"
                    Clicked="Add_Product"
                    CornerRadius="10"
                    FontSize="18" Text="Agregar Compra De Producto" TextColor="White"
                    AutomationId="ButtonAddProduct"/>
        </Grid>
    </Frame>
</mct:Popup>