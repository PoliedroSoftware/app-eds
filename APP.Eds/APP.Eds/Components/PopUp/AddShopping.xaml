<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns:brand="clr-namespace:APP.Eds.Controls"
    x:Class="APP.Eds.Components.PopUp.AddShopping"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent"
    AutomationId="PopupAddShopping">

    <!-- Main Container with Modern Design -->
    <Border x:Name="PopupBorder"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
            StrokeShape="RoundRectangle 24"
            StrokeThickness="0"
            WidthRequest="400"
            HeightRequest="700"
            AutomationId="FrameAddShopping">


        <Grid RowDefinitions="Auto,*,Auto" Padding="0">

            <!-- Modern Header -->
            <Border Grid.Row="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    Padding="24,20,24,20">


                <Grid ColumnDefinitions="*,Auto,*">
                    <!-- Header Content -->
                    <StackLayout Grid.Column="1"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="4">
                        <Label Text="Nuevo Producto"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                               HorizontalOptions="Center"
                               AutomationId="LabelAddShopping"/>
                        <Label Text="Agregue un producto a la compra"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               HorizontalOptions="Center"/>
                    </StackLayout>

                    <!-- Close Button -->
                    <Border Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 16"
                            WidthRequest="32" HeightRequest="32"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Opacity="0.9">
                        <Button BackgroundColor="Transparent"
                                Clicked="OnCloseTapped"
                                FontSize="16"
                                Text="✖"
                                TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                FontAttributes="Bold"
                                WidthRequest="32" HeightRequest="32"
                                CornerRadius="16"
                                Padding="0"
                                AutomationId="ButtonClosePopup"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollView Grid.Row="1"
                        Padding="20"
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="20">

                    <!-- Product Selection Card -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                            StrokeThickness="2"
                            Padding="20"
                            AutomationId="FrameProductCompartimentPicker">


                        <VerticalStackLayout Spacing="12">
                            <!-- Section Header -->
                            <StackLayout Orientation="Horizontal" Spacing="12">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                        StrokeShape="RoundRectangle 16"
                                        WidthRequest="32" HeightRequest="32"
                                        VerticalOptions="Center">
                                    <brand:PoliedroIcon Text="📦"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <Label Text="Producto y Compartimento"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       VerticalOptions="Center"/>
                            </StackLayout>

                            <!-- Product List Container - Visible cuando hay productos -->
                            <VerticalStackLayout x:Name="PickerContainer" Spacing="8">
                                <!-- Header -->
                                <Label Text="Seleccione producto y compartimento"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       Margin="4,0,0,4"/>

                                <!-- Scrollable Product List -->
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                        StrokeThickness="2"
                                        HeightRequest="320">
                                    <CollectionView x:Name="ProductCompartimentList"
                                                    ItemsSource="{Binding FilteredProductCompartimentPairs}"
                                                    SelectionMode="Single"
                                                    SelectedItem="{Binding SelectedProductCompartimentPair, Mode=TwoWay}"
                                                    SelectionChanged="ProductCompartimentListSelectionChanged"
                                                    AutomationId="CollectionViewProductCompartimentPair">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                                        StrokeShape="RoundRectangle 8"
                                                        Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                                        StrokeThickness="1"
                                                        Padding="12,10"
                                                        Margin="8,4">


                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <!-- Product Icon -->
                                                        <Border Grid.Column="0"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                                                StrokeShape="RoundRectangle 12"
                                                                WidthRequest="32" HeightRequest="32"
                                                                VerticalOptions="Center">
                                                            <brand:PoliedroIcon Text="📦"
                                                                   FontSize="16"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"/>
                                                        </Border>

                                                        <!-- Product Info -->
                                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                            <Label Text="{Binding ProductName}"
                                                                   FontSize="16"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                                            <Label FontSize="14"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                                   LineBreakMode="WordWrap">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="Compartimento" FontAttributes="Bold"/>
                                                                        <Span Text="{Binding Number}"/>
                                                                        <Span Text="| Capacidad:"/>
                                                                        <Span Text="{Binding Operative, StringFormat='{0:N0}'}"/>
                                                                        <Span Text="| Stock:"/>
                                                                        <Span Text="{Binding Stock, StringFormat='{0:N0}'}"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </VerticalStackLayout>
                                                    </Grid>

                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup Name="CommonStates">
                                                            <VisualState Name="Normal">
                                                                <VisualState.Setters>
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"/>
                                                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState Name="Selected">
                                                                <VisualState.Setters>
                                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"/>
                                                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"/>
                                                                    <Setter Property="StrokeThickness" Value="2"/>
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>

                                        <!-- Empty View -->
                                        <CollectionView.EmptyView>
                                            <VerticalStackLayout Padding="20" Spacing="12" VerticalOptions="Center">
                                                <brand:PoliedroIcon Text="🔍"
                                                       FontSize="32"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="No hay productos disponibles"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </CollectionView.EmptyView>
                                    </CollectionView>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Empty State Message - Visible cuando NO hay productos -->
                            <Border x:Name="EmptyStateContainer"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                    StrokeThickness="2"
                                    Padding="16"
                                    IsVisible="False">
                                <StackLayout Spacing="12">
                                    <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                                        <brand:PoliedroIcon Text="⚠️"
                                               FontSize="24"
                                               VerticalOptions="Center"/>
                                        <Label Text="Sin Productos Disponibles"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                               VerticalOptions="Center"/>
                                    </StackLayout>
                                    <Label x:Name="EmptyStateMessage"
                                           Text="Cargando información..."
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>
                                </StackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Price Fields Grid -->
                    <brand:ResponsiveFormGrid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="16">

                        <!-- Purchase Price -->
                        <Border Grid.Column="0" Grid.Row="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{AppThemeBinding Light={StaticResource SuccessSurface}, Dark={StaticResource SuccessSurfaceDark}}"
                                StrokeThickness="2"
                                Padding="16"
                                AutomationId="FramePriceEntry">


                            <VerticalStackLayout Spacing="12">
                                <!-- Field Header -->
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <brand:PoliedroIcon Text="💰"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}"
                                           VerticalOptions="Center"/>
                                    <StackLayout VerticalOptions="Center">
                                        <Label Text="Precio Compra"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               AutomationId="LabelPrice"/>
                                        <Label Text="Incluye transporte"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               Margin="0,-2,0,0"/>
                                    </StackLayout>
                                </StackLayout>

                                <!-- Entry Container -->
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="1"
                                        Padding="12,0">
                                    <Entry x:Name="FirstEntry"
                                           Keyboard="Numeric"
                                           Placeholder="0.00"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           Text="{Binding PurchasePrice, Mode=TwoWay}"
                                           Completed="EntryPurchasePriceCompleted"
                                           IsEnabled="{Binding SelectedProductCompartimentPair, Converter={StaticResource IsNotNullConverter}}"
                                           BackgroundColor="Transparent"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalTextAlignment="Center"
                                           AutomationId="EntryPrice"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Sell Price -->
                        <Border Grid.Column="1" Grid.Row="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{AppThemeBinding Light={StaticResource WarningSurface}, Dark={StaticResource WarningSurfaceDark}}"
                                StrokeThickness="2"
                                Padding="16"
                                AutomationId="FrameSellPriceEntry">


                            <VerticalStackLayout Spacing="12">
                                <!-- Field Header -->
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <brand:PoliedroIcon Text="🏷️"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                                           VerticalOptions="Center"/>
                                    <Label Text="Precio Venta"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           VerticalOptions="Center"
                                           AutomationId="LabelSellPrice"/>
                                </StackLayout>

                                <!-- Entry Container -->
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="1"
                                        Padding="12,0">
                                    <Entry x:Name="SecondEntry"
                                           Keyboard="Numeric"
                                           Placeholder="0.00"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           Text="{Binding SellPrice, Mode=TwoWay}"
                                           IsEnabled="{Binding SelectedProductCompartimentPair, Converter={StaticResource IsNotNullConverter}}"
                                           Completed="EntrySellPriceCompleted"
                                           BackgroundColor="Transparent"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalTextAlignment="Center"
                                           AutomationId="EntrySellPrice"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Quantity Field (Full Width) -->
                        <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                                StrokeThickness="2"
                                Padding="20"
                                AutomationId="FrameQuantityEntry">


                            <VerticalStackLayout Spacing="12">
                                <!-- Field Header -->
                                <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                                    <brand:PoliedroIcon Text="⛽"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                           VerticalOptions="Center"/>
                                    <Label Text="Cantidad de Galones"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           VerticalOptions="Center"
                                           AutomationId="LabelQuantity"/>
                                </StackLayout>

                                <!-- Entry Container -->
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource InputBorder}, Dark={StaticResource InputBorderDark}}"
                                        StrokeThickness="2"
                                        Padding="12,0">
                                    <Entry x:Name="ThirdEntry"
                                           Keyboard="Numeric"
                                           Placeholder="0.000"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           Text="{Binding Quantity, Mode=TwoWay}"
                                           IsEnabled="{Binding SelectedProductCompartimentPair, Converter={StaticResource IsNotNullConverter}}"
                                           Completed="Add_Product"
                                           BackgroundColor="Transparent"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalTextAlignment="Center"
                                           AutomationId="EntryQuantity"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </brand:ResponsiveFormGrid>

                    <!-- Info Card -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                            Padding="16"
                            Opacity="0.9">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <brand:PoliedroIcon Text="ℹ️"
                                   FontSize="16"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0"/>
                            <Label Text="Complete todos los campos para agregar el producto a la compra. El sistema calculará automáticamente el total."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"/>
                        </StackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Action Button -->
            <Border Grid.Row="2"
                    Margin="20,0,20,20">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandPrimary}, Dark={StaticResource BrandPrimaryDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        Padding="4">


                    <Button x:Name="AddButton"
                            BackgroundColor="Transparent"
                            Clicked="Add_Product"
                            FontSize="18"
                            FontAttributes="Bold"
                            Text="Agregar a la Compra"
                            TextColor="{StaticResource OnBrand}"
                            MinimumHeightRequest="52"
                            CornerRadius="16"
                            AutomationId="ButtonAddProduct"/>
                </Border>
            </Border>
        </Grid>
    </Border>
</mct:Popup>