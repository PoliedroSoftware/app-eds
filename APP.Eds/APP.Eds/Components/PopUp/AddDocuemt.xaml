<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="APP.Eds.Components.PopUp.AddDocuemt"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Grid RowDefinitions="Auto,* ,Auto" Padding="0">
        <!-- Header -->
        <Grid BackgroundColor="#1E88E5" Padding="12" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Text="Agregar comprobante"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="18"
                   VerticalOptions="Center" />

            <!-- Botón X arriba a la derecha -->
            <Button Grid.Column="1"
                    Text="✖"
                    Clicked="OnCloseTapped"
                    BackgroundColor="#00000000"
                    TextColor="White"
                    FontAttributes="Bold"
                    WidthRequest="32"
                    HeightRequest="32"
                    Padding="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Padding="16" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*">
            <Label Text="Seleccionar documento"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="{DynamicResource PrimaryTextColor}" />

            <!-- Selector -->
            <Frame Grid.Row="1"
                   Margin="0,8,0,12"
                   Padding="16"
                   BorderColor="#CED4DA"
                   BackgroundColor="#EDF2FA"
                   CornerRadius="12">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSelectFileClicked" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="folder.png" HeightRequest="28" WidthRequest="28" />
                    <Label Grid.Column="1" Text="Toca para seleccionar uno o más archivos"
                           VerticalOptions="Center" TextColor="#6C757D" />
                    <Button Grid.Column="2" Text="Buscar" Clicked="OnSelectFileClicked" />
                </Grid>
            </Frame>

            <!-- Lista de archivos -->
            <CollectionView Grid.Row="2"
                            x:Name="FilesList"
                            ItemsSource="{Binding SelectedFiles}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay archivos seleccionados"
                           HorizontalOptions="Center"
                           TextColor="#6C757D" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="8" RowDefinitions="Auto" ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" Text="{Binding Name}" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="1" Text="{Binding SizeDisplay}" TextColor="#6C757D" Margin="8,0" />
                            <Button Grid.Column="2"
                                    Text="Quitar"
                                    BackgroundColor="#E53935"
                                    TextColor="White"
                                    Clicked="OnRemoveFileClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Resumen + Eliminar todo -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Padding="0,8,0,0">
                <Label Grid.Column="0" Text="{Binding SummaryText}" TextColor="#6C757D" />
                <Label Grid.Column="1" Text="{Binding TotalSizeDisplay}" FontAttributes="Bold" Margin="8,0,12,0" />
                <Button Grid.Column="2"
                        Text="Eliminar todo"
                        Clicked="OnClearAllFilesClicked"
                        IsVisible="{Binding HasFiles}"
                        BackgroundColor="#E53935"
                        TextColor="White"
                        Padding="10,6"
                        CornerRadius="8" />
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="16">
            <Button x:Name="AddButton"
                    Text="Agregar"
                    Clicked="Add_Dispenser"
                    IsEnabled="{Binding HasFiles}"
                    BackgroundColor="#1E88E5"
                    TextColor="White"
                    HeightRequest="44"
                    CornerRadius="10" />
        </Grid>
    </Grid>
</toolkit:Popup>