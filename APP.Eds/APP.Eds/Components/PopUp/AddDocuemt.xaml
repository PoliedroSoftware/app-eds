<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup
	x:Class="APP.Eds.Components.PopUp.AddDocuemt"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
	CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent">
    
	<Frame
		Padding="16"
		BorderColor="#6200E8"
		CornerRadius="15"
		HasShadow="True"
		HeightRequest="300"
		WidthRequest="380">

        <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="*">

            <!--  Encabezado  -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, *" Padding="0,0,0,10">
                <Label Grid.Column="1" FontAttributes="Bold" FontSize="22" Text="AddDocumentTranslation(traducir)" HorizontalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Button Grid.Column="2"
                        BackgroundColor="Transparent"
                        Clicked="OnCloseTapped"
                        FontSize="18"  Text="✖"  TextColor="#6200E8"
                        WidthRequest="30" HeightRequest="30" Padding="0"
                        HorizontalOptions="End" VerticalOptions="Center"/>
            </Grid>

            <!--  Campos de Entrada  -->
            <Frame Grid.Row="1"
				Margin="15"
				Padding="10"
				CornerRadius="10">
				<VerticalStackLayout Spacing="10">
					<Button
						BackgroundColor="#6200E8"
                        TextColor="White"
						Clicked="OnSelectFileClicked"
						CornerRadius="10"
						Text="Select File(traducit)"/>
					<Label
						FontAttributes="Bold"
						IsVisible="{Binding IsFileSelected}"
						Text="Selected File:(traducir)" />
					<Label
						FontAttributes="Italic"
						Text="{Binding SelectedFileName}"
						TextColor="Gray" />
				</VerticalStackLayout>
			</Frame>

            <!--  Botón Agregar  -->
            <Button Grid.Row="2"
                    BackgroundColor="#6200E8"
                    Clicked="Add_Dispenser"
                    CornerRadius="10"
                    FontSize="18"
                    Text="Add(traducir)"
                    TextColor="White"
                    VerticalOptions="Center"
                    HeightRequest="40"/>
		</Grid>
	</Frame>
</mct:Popup>