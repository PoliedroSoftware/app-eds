<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup
    x:Class="APP.Eds.Components.PopUp.AddDocuemt"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent">

    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0"
            WidthRequest="420" 
            HeightRequest="520">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.12"/>
        </Border.Shadow>

        <Grid RowDefinitions="75,*,80" Padding="0">

            <!-- Header -->
            <Border Grid.Row="0"
                    BackgroundColor="#2196F3"
                    StrokeShape="RoundRectangle 20,20,0,0"
                    StrokeThickness="0"
                    Padding="20,20">
                <Grid ColumnDefinitions="*,40">
                    <StackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                        <Label Text="Agregar comprobantes" 
                               FontAttributes="Bold" 
                               FontSize="22" 
                               TextColor="White"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Seleccione uno o varios archivos" 
                               FontSize="13" 
                               TextColor="#F5F5F5"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>

                    <Border Grid.Column="1"
                            BackgroundColor="#FFFFFF20"
                            StrokeShape="RoundRectangle 20"
                            WidthRequest="40" HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="✕" 
                               FontSize="16" 
                               TextColor="White"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <Border Grid.Row="1" BackgroundColor="#FAFCFF" Padding="18,14">
                <VerticalStackLayout Spacing="14">

                    <!-- Selector -->
                    <Border BackgroundColor="#F0F7FF"
                            StrokeShape="RoundRectangle 12"
                            Stroke="#90CAF9"
                            StrokeThickness="2"
                            Padding="18,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectFileClicked"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="48,*" ColumnSpacing="10">
                            <Border BackgroundColor="#2196F3" StrokeShape="RoundRectangle 12" WidthRequest="44" HeightRequest="44">
                                <Label Text="📁" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <StackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Toque para seleccionar archivos" 
                                       FontSize="14" FontAttributes="Bold" TextColor="#1976D2"/>
                                <Label Text="PDF, JPG, PNG, DOC, TXT (máx. 5MB c/u)" 
                                       FontSize="11" TextColor="#616161"/>
                            </StackLayout>
                        </Grid>
                    </Border>

                    <!-- Lista previa de selección -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}" StrokeShape="RoundRectangle 12" Stroke="#E8F2FF" Padding="8,6">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" Padding="6,2">
                                <Label Text="Archivos seleccionados" FontAttributes="Bold" TextColor="#1976D2"/>
                                <Button Text="Eliminar todos"
                                        Grid.Column="1"
                                        IsVisible="{Binding HasSelectedFiles}"
                                        Padding="10,6"
                                        CornerRadius="12"
                                        BackgroundColor="#FFEBEE"
                                        TextColor="#C62828"
                                        FontSize="12"
                                        Clicked="OnClearSelectedClicked"/>
                            </Grid>

                            <CollectionView ItemsSource="{Binding SelectedFiles}" HeightRequest="280">
                                <CollectionView.EmptyView>
                                    <Label Text="No hay archivos seleccionados" 
                                           HorizontalOptions="Center" 
                                           TextColor="#9E9E9E" 
                                           Margin="0,10"/>
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#FAFAFA" 
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="#EEEEEE"
                                                Padding="10"
                                                Margin="0,4">
                                            <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="10">
                                                <Label Text="{Binding Icon}" FontSize="16" VerticalOptions="Center"/>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" TextColor="#424242"/>
                                                    <Label Text="{Binding SizeText}" FontSize="11" TextColor="#757575"/>
                                                </VerticalStackLayout>
                                                <Button Text="✕" 
                                                        Grid.Column="2"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#F44336"
                                                        FontAttributes="Bold"
                                                        Clicked="OnRemoveItemClicked"
                                                        CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <Grid Grid.Row="2" Padding="16,10" ColumnDefinitions="*,*" ColumnSpacing="12"
                  BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}">
                <Border BackgroundColor="#E3F2FD" StrokeShape="RoundRectangle 12">
                    <Button BackgroundColor="Transparent"
                            Text="Seleccionar más"
                            TextColor="#1976D2"
                            Clicked="OnSelectFileClicked"/>
                </Border>

                <Border Grid.Column="1" BackgroundColor="#2196F3" StrokeShape="RoundRectangle 12">
                    <Button BackgroundColor="Transparent"
                            AutomationId="AddButton"
                            Text="{Binding AddButtonText}"
                            TextColor="White"
                            FontAttributes="Bold"
                            IsEnabled="{Binding HasSelectedFiles}"
                            Clicked="Add_Dispenser"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</mct:Popup>