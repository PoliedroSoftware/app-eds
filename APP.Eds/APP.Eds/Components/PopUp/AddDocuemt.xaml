<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="APP.Eds.Components.PopUp.AddDocuemt"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Color="#80000000"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border
        StrokeThickness="0"
        BackgroundColor="White"
        Padding="20"
        WidthRequest="520"
        MaximumWidthRequest="700"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        StrokeShape="RoundRectangle 16">
        <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">
            <!-- Header -->
            <Label Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Agregar comprobante"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#1F5EFF"
                   Margin="0,0,0,12"/>
            <ImageButton Grid.Row="0" Grid.Column="1"
                         Source="close.png"
                         BackgroundColor="Transparent"
                         HorizontalOptions="End"
                         Clicked="OnCloseTapped"/>

            <!-- Selector múltiple -->
            <Border Grid.Row="1" Grid.ColumnSpan="2"
                    BackgroundColor="#F2F6FF"
                    Stroke="#DDE6FF"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,0,0,10"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Button Text="📁 Seleccionar documentos (múltiples)"
                            Clicked="OnPickMultipleFiles"
                            BackgroundColor="#EAF1FF"
                            TextColor="#1F5EFF"
                            CornerRadius="10"/>
                    <Label Text="Formatos sugeridos: .jpg, .png, .pdf"
                           FontSize="12"
                           TextColor="#666"/>
                </VerticalStackLayout>
            </Border>

            <!-- Lista de seleccionados -->
            <Border Grid.Row="2" Grid.ColumnSpan="2"
                    BackgroundColor="#FAFFFA"
                    Stroke="#E1F3E1"
                    StrokeThickness="1"
                    Padding="12"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Archivos seleccionados:" FontAttributes="Bold"/>
                        <Label Text="{Binding SelectedCount, StringFormat='({0})'}" TextColor="#0A7F2E"/>
                        <Label Text="{Binding TotalSizeText}" TextColor="#0A7F2E"/>
                    </HorizontalStackLayout>

                    <CollectionView ItemsSource="{Binding SelectedFiles}" HeightRequest="220">
                        <CollectionView.EmptyView>
                            <Label Text="No hay archivos seleccionados" TextColor="#999" HorizontalTextAlignment="Center" Margin="0,20,0,0"/>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="6,4">
                                    <Label Text="✔" TextColor="#0A7F2E" Margin="0,0,6,0"/>
                                    <Label Grid.Column="1" Text="{Binding Name}" LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="2" Text="{Binding SizeText}" TextColor="#666" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Botonera -->
            <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                <Label Grid.Column="0" Text="{Binding SummaryText}" TextColor="#666" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="Cancelar" Clicked="OnCloseTapped"
                        BackgroundColor="#EEE" TextColor="#333" CornerRadius="10" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Text="Subir"
                        Clicked="OnUpload"
                        BackgroundColor="#1F5EFF" TextColor="White" CornerRadius="10"/>
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>