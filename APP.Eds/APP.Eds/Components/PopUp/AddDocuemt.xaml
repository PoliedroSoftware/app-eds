<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="APP.Eds.Components.PopUp.AddDocuemt"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Size="600,Auto">

    <!-- Layout con filas fijas + lista scrollable -->
    <Grid Padding="16"
          RowSpacing="12"
          RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Botón seleccionar -->
        <Border Grid.Row="0" Padding="12" BackgroundColor="{AppThemeBinding Light=#EEF3FF, Dark=#1F2A44}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="6">
                <Button Text="Seleccionar documentos (múltiples)" Clicked="OnPickMultipleFiles" />
                <Label Text="Formatos sugeridos: .jpg, .png, .pdf" FontSize="12" TextColor="{AppThemeBinding Light=#586174, Dark=#AAB2C0}" Margin="0,6,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Cabecera + Quitar todo -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="4,0">
            <Label Text="{Binding Source={x:Reference Root}, Path=BindingContext.SelectedCount, StringFormat='Archivos seleccionados: ({0})'}" />
            <Button Grid.Column="1" Text="Quitar todo" Clicked="OnClearAll" IsEnabled="{Binding SelectedCount, Converter={toolkit:IntToBoolConverter}}" />
        </Grid>

        <!-- Lista scrollable: ocupa el espacio disponible -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding SelectedFiles}"
                        VerticalOptions="FillAndExpand"
                        Margin="0,4,0,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" Spacing="4">
                    <Label Text="No hay archivos seleccionados." HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#586174, Dark=#AAB2C0}"/>
                    <Label Text="Pulsa “Seleccionar documentos (múltiples)” para agregarlos." FontSize="12" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#7A8497, Dark=#8F98A8}"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="24,*,Auto" Padding="8,6">
                        <Label Grid.Column="0" Text="✔" TextColor="ForestGreen" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="{Binding Name}" LineBreakMode="TailTruncation" MaxLines="1"/>
                            <Label Text="{Binding SizeText}" FontSize="12" TextColor="{AppThemeBinding Light=#586174, Dark=#AAB2C0}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Quitar" Padding="10,6" Clicked="OnRemoveFile"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Resumen -->
        <VerticalStackLayout Grid.Row="3" Spacing="0">
            <Label Text="{Binding TotalSizeText}" FontAttributes="Bold" Margin="0,6,0,0"/>
            <Label Text="{Binding SummaryText}" FontSize="12" TextColor="{AppThemeBinding Light=#586174, Dark=#AAB2C0}"/>
        </VerticalStackLayout>

        <!-- Acciones: siempre visibles -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0" Padding="0,0,0,8">
            <Button Text="Cancelar" Grid.Column="0" Clicked="OnCloseTapped" />
            <Label Grid.Column="1"/>
            <Button Text="Subir"
                    Grid.Column="2"
                    Clicked="OnUpload"
                    IsEnabled="{Binding SelectedCount, Converter={toolkit:IntToBoolConverter}}"/>
        </Grid>
    </Grid>
</toolkit:Popup>