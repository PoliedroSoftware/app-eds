<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup x:Class="APP.Eds.Components.PopUp.AddCourtExpenditure" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui" CanBeDismissedByTappingOutsideOfPopup="False" Color="Transparent">
    <Border Style="{StaticResource PoliedroCard}" WidthRequest="420" HeightRequest="560" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding AddExpense}" Style="{StaticResource PoliedroSectionTitle}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Cerrar" Clicked="OnCloseTapped" Style="{StaticResource PoliedroSecondaryButton}" SemanticProperties.Description="Cerrar registro de gasto" />
            </Grid>
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Expenditures}" Style="{StaticResource InputLabelStyle}" />
                        <Border Style="{StaticResource PoliedroField}">
                            <Picker x:Name="ExpenditurePicker" Title="{Binding Select}" ItemDisplayBinding="{Binding Description}" ItemsSource="{Binding ExpenditureList}" SelectedItem="{Binding SelectedExpenditure, Mode=TwoWay}" SelectedIndexChanged="ExpenditureSelected" AutomationId="ExpenditurePicker" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding AmountTranslation}" Style="{StaticResource InputLabelStyle}" />
                            <Label Grid.Column="1" Text="COP" Style="{StaticResource PoliedroBodySecondary}" />
                        </Grid>
                        <Border Style="{StaticResource PoliedroField}">
                            <Entry x:Name="FirstEntry" Placeholder="0" Text="{Binding CourtExpenditureAmount, Mode=TwoWay}" Completed="EntryAmountCompleted" TextChanged="FirstEntry_TextChanged" IsEnabled="False" Keyboard="Numeric" HorizontalTextAlignment="End" AutomationId="AmountEntry" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Descripción" Style="{StaticResource InputLabelStyle}" />
                        <Border Style="{StaticResource PoliedroField}">
                            <Entry x:Name="SecondEntry" Placeholder="{Binding Description}" Text="{Binding ExpenditureDescription, Mode=TwoWay}" Completed="Add_Expenditure" IsEnabled="False" MaxLength="200" AutomationId="DescriptionEntry" />
                        </Border>
                        <Label Text="{Binding Source={x:Reference SecondEntry}, Path=Text.Length, StringFormat='{0}/200 caracteres'}" Style="{StaticResource PoliedroBodySecondary}" HorizontalOptions="End" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
            <Button x:Name="AddButton" Grid.Row="2" Text="{Binding Add}" Clicked="Add_Expenditure" Style="{StaticResource PoliedroPrimaryButton}" AutomationId="AddButton">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding Source={x:Reference ExpenditurePicker}, Path=SelectedIndex}" Value="-1"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
    </Border>
</mct:Popup>
