<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup
    x:Class="APP.Eds.Components.PopUp.AddDispenser"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:converters="clr-namespace:APP.Eds.Converters"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent">

    <mct:Popup.Resources>
        <ResourceDictionary>
            <converters:DecimalFormatConverter x:Key="DecimalFormat" />
            <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />
        </ResourceDictionary>
    </mct:Popup.Resources>

    <Frame x:Name="Frame"
           Padding="16"
           BorderColor="#FF9800"
           CornerRadius="18"
           HasShadow="True"
           BackgroundColor="White"
           WidthRequest="360" 
           MaximumWidthRequest="400"
           MaximumHeightRequest="650"
           VerticalOptions="Center" 
           HorizontalOptions="Center"
           Margin="20,40">

        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">

            <!-- Header -->
            <Frame Grid.Row="0" BackgroundColor="#FF9800" CornerRadius="12"
                   HasShadow="True" Padding="16,12" Margin="0,0,0,15">
                <Grid ColumnDefinitions="*, Auto, *">
                    <StackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                        <Label Text="Agregar Dispensador" FontAttributes="Bold" FontSize="20"
                               TextColor="White" HorizontalTextAlignment="Center" />
                        <Label Text="Registro de venta del dispensador" FontSize="12"
                               TextColor="#FFE0B2" HorizontalTextAlignment="Center" />
                    </StackLayout>

                    <Frame Grid.Column="2" BackgroundColor="White" CornerRadius="15"
                           HasShadow="False" Padding="0" WidthRequest="30" HeightRequest="30"
                           HorizontalOptions="End" VerticalOptions="Center">
                        <Button BackgroundColor="Transparent" Clicked="OnCloseTapped"
                                AutomationId="CloseButton" FontSize="16" Text="X"
                                TextColor="#FF9800" FontAttributes="Bold"
                                WidthRequest="30" HeightRequest="30" Padding="0" CornerRadius="15"/>
                    </Frame>
                </Grid>
            </Frame>

            <!-- Content -->
            <ScrollView Grid.Row="1" MaximumHeightRequest="480" Margin="0,0,0,10">
                <VerticalStackLayout Spacing="15">

                    <!-- Manguera -->
                    <Frame BackgroundColor="#F8F9FA" CornerRadius="12" HasShadow="True"
                           BorderColor="#FFE0B2" Padding="14">
                        <StackLayout Spacing="10">
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Frame BackgroundColor="#FFE0B2" CornerRadius="10" HasShadow="False"
                                       Padding="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                    <Label Text="H" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="Manguera" FontSize="14" FontAttributes="Bold"
                                       TextColor="#2D3436" VerticalOptions="Center"/>
                            </StackLayout>

                            <Frame BackgroundColor="White" CornerRadius="8" HasShadow="False"
                                   BorderColor="#DDD6FE" Padding="8,4">
                                <Picker x:Name="HosePicker" AutomationId="HosePicker"
                                        Title="Seleccione una manguera"
                                        ItemDisplayBinding="{Binding DisplayText}"
                                        ItemsSource="{Binding CourtService.HoseList}"
                                        SelectedItem="{Binding SelectedHose, Mode=TwoWay}"
                                        SelectedIndexChanged="HoseSelected"
                                        BackgroundColor="Transparent" FontSize="13"
                                        HorizontalTextAlignment="Center"/>
                            </Frame>
                        </StackLayout>
                    </Frame>

                    <!-- Dinero -->
                    <Frame BackgroundColor="#F8F9FA" CornerRadius="12" HasShadow="True"
                           BorderColor="#E8F5E8" Padding="14">
                        <StackLayout Spacing="12">

                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Frame BackgroundColor="#E8F5E8" CornerRadius="10" HasShadow="False"
                                       Padding="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                    <Label Text="$" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="Información de Dinero" FontSize="14" FontAttributes="Bold"
                                       TextColor="#2D3436" VerticalOptions="Center"/>
                            </StackLayout>

                            <!-- Precio por galón -->
                            <Grid RowDefinitions="*" ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="Precio por galón" FontAttributes="Bold"
                                       FontSize="13" VerticalOptions="Center" HorizontalOptions="End"/>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <!-- Label solo lectura -->
                                    <Label x:Name="PricePerGallonLabel"
                                           FontAttributes="Bold" FontSize="13"
                                           VerticalOptions="Center" HorizontalOptions="Start"/>

                                    <!-- Entry editable con validación -->
                                    <Entry x:Name="PriceEditEntry"
                                           Keyboard="Numeric"
                                           Placeholder="Editar precio"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand"
                                           WidthRequest="90"
                                           IsVisible="False"
                                           Completed="PriceEditEntry_Completed"
                                           TextChanged="PriceEditEntry_TextChanged"
                                           AutomationId="EntryPricePerGallon">
                                        <Entry.Behaviors>
                                            <!-- Debe ser > 0 -->
                                            <toolkit:NumericValidationBehavior x:Name="PriceValidator"
                                                MinimumValue="0.01"
                                                MaximumValue="999999999"
                                                Flags="ValidateOnValueChanged" />
                                        </Entry.Behaviors>
                                        <Entry.Triggers>
                                            <!-- Pinta rojo si inválido -->
                                            <DataTrigger TargetType="Entry"
                                                         Binding="{Binding Source={x:Reference PriceValidator}, Path=IsValid}"
                                                         Value="False">
                                                <Setter Property="TextColor" Value="Red"/>
                                            </DataTrigger>
                                        </Entry.Triggers>
                                    </Entry>

                                    <!-- Botón para activar edición -->
                                    <Button x:Name="PriceEditButton"
                                            Text="E"
                                            Clicked="PriceEditButton_Clicked"
                                            BackgroundColor="Transparent"
                                            FontSize="12"
                                            VerticalOptions="Center"
                                            HorizontalOptions="End"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            Padding="0"
                                            IsVisible="False"/>

                                    <!-- Mensaje de error -->
                                    <Label x:Name="PriceErrorLabel"
                                           FontSize="12"
                                           TextColor="Red"
                                           Text="El precio por galón debe ser mayor a 0."
                                           IsVisible="False">
                                        <Label.Triggers>
                                            <!-- Editando y valor inválido -->
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Source={x:Reference PriceValidator}, Path=IsValid}"
                                                         Value="False">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                            <!-- No editando y label vacío/0 -->
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Source={x:Reference PricePerGallonLabel}, Path=Text}"
                                                         Value="">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Source={x:Reference PricePerGallonLabel}, Path=Text}"
                                                         Value="0">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,20,*" RowSpacing="8">
                                <Label Text="Último monto acumulado" VerticalOptions="Center"
                                       HorizontalOptions="End" FontSize="13" Grid.Row="0" Grid.Column="0"/>
                                <Label Text="{Binding LastAccumulatedAmount, Converter={StaticResource CurrencyFormat}}"
                                       VerticalOptions="Center" FontSize="13" FontAttributes="Bold"
                                       Grid.Row="0" Grid.Column="2"/>

                                <Label Text="Monto acumulado" VerticalOptions="Center"
                                       HorizontalOptions="End" FontAttributes="Bold" FontSize="13"
                                       Grid.Row="1" Grid.Column="0"/>

                                <Frame BackgroundColor="White" CornerRadius="8" HasShadow="False"
                                       BorderColor="#DDD6FE" Padding="6,2" Grid.Row="1" Grid.Column="2">
                                    <Entry x:Name="FirstEntry" AutomationId="AccumulatedAmountEntry"
                                           Keyboard="Numeric" Placeholder="Ingrese el monto"
                                           Text="{Binding AccumulatedAmount, Mode=TwoWay}"
                                           BackgroundColor="Transparent" FontSize="13"
                                           Unfocused="OnEntryUnfocused" Completed="EntryAccumulatedCompleted"
                                           IsEnabled="False" HorizontalTextAlignment="Center"/>
                                </Frame>

                                <Label Text="Venta en dinero" HorizontalOptions="End" VerticalOptions="Center"
                                       FontSize="13" Grid.Row="2" Grid.Column="0"/>
                                <Label Text="{Binding AmountDifferenceResult, Converter={StaticResource CurrencyFormat}}"
                                       VerticalOptions="Center" HorizontalOptions="Start"
                                       FontAttributes="Bold" FontSize="13" TextColor="#FF9800"
                                       Grid.Row="2" Grid.Column="2"/>
                            </Grid>
                        </StackLayout>
                    </Frame>

                    <!-- Galones -->
                    <Frame BackgroundColor="#F8F9FA" CornerRadius="12" HasShadow="True"
                           BorderColor="#E3F2FD" Padding="14">
                        <StackLayout Spacing="12">
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Frame BackgroundColor="#E3F2FD" CornerRadius="10" HasShadow="False"
                                       Padding="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                    <Label Text="G" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>
                                <Label Text="Información de Galones" FontSize="14" FontAttributes="Bold"
                                       TextColor="#2D3436" VerticalOptions="Center"/>
                            </StackLayout>

                            <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,20,*" RowSpacing="8">
                                <Label Text="Últimos galones acumulados" VerticalOptions="Center"
                                       HorizontalOptions="End" FontSize="13" Grid.Row="0" Grid.Column="0"/>
                                <Label Text="{Binding LastAccumulatedGallons, Converter={StaticResource DecimalFormat}}"
                                       VerticalOptions="Center" FontSize="13" FontAttributes="Bold"
                                       Grid.Row="0" Grid.Column="2"/>

                                <Label Text="Galones acumulados" VerticalOptions="Center"
                                       HorizontalOptions="End" FontAttributes="Bold" FontSize="13"
                                       Grid.Row="1" Grid.Column="0"/>

                                <StackLayout Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                    <Frame BackgroundColor="White" CornerRadius="8" HasShadow="False"
                                           BorderColor="#DDD6FE" Padding="6,2" HorizontalOptions="FillAndExpand">
                                        <Entry x:Name="SecondEntry" AutomationId="AccumulatedGallonsEntry"
                                               Keyboard="Numeric" Placeholder="Ingrese los galones"
                                               Text="{Binding AccumulatedGallons, Converter={StaticResource DecimalFormat}}"
                                               BackgroundColor="Transparent" FontSize="13"
                                               Completed="EntryGallonsCompleted" IsEnabled="False"
                                               HorizontalTextAlignment="Center"/>
                                    </Frame>

                                    <Frame BackgroundColor="#E3F2FD" CornerRadius="12" HasShadow="False"
                                           Padding="0" WidthRequest="26" HeightRequest="26" VerticalOptions="Center">
                                        <Button Text="E" Clicked="EditGallonsButton_Clicked"
                                                AutomationId="EditGallonsButton" BackgroundColor="Transparent"
                                                TextColor="#2196F3" FontSize="12" WidthRequest="26" HeightRequest="26"
                                                Padding="0"/>
                                    </Frame>
                                </StackLayout>

                                <Label Text="Venta en galones" VerticalOptions="Center" HorizontalOptions="End"
                                       FontSize="13" Grid.Row="2" Grid.Column="0"/>
                                <Label Text="{Binding GallonsDifferenceResult, Converter={StaticResource DecimalFormat}}"
                                       VerticalOptions="Center" HorizontalOptions="Start" FontAttributes="Bold"
                                       FontSize="13" TextColor="#2196F3" Grid.Row="2" Grid.Column="2"/>
                            </Grid>
                        </StackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Botón Agregar -->
            <Frame Grid.Row="2" BackgroundColor="#FF9800" CornerRadius="14"
                   HasShadow="True" Padding="4" Margin="0,15,0,0">
                <Button x:Name="AddButton" AutomationId="AddButton" BackgroundColor="Transparent"
                        Clicked="Add_Dispenser" CornerRadius="14" FontSize="17" FontAttributes="Bold"
                        Text="Agregar" TextColor="White" VerticalOptions="Center" HeightRequest="44">
                    <Button.Triggers>
                        <!-- Deshabilitar si estoy editando y el precio es inválido -->
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Source={x:Reference PriceValidator}, Path=IsValid}"
                                     Value="False">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                        <!-- Deshabilitar si NO estoy editando y el label está vacío/0 -->
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Source={x:Reference PricePerGallonLabel}, Path=Text}"
                                     Value="">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Source={x:Reference PricePerGallonLabel}, Path=Text}"
                                     Value="0">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Frame>
        </Grid>
    </Frame>
</mct:Popup>
