<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns:brand="clr-namespace:APP.Eds.Controls"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="APP.Eds.Views.Popups.CategoryPopup"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Color="Transparent"
    AutomationId="PopupCategory">

    <Border x:Name="Frame"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0"
            WidthRequest="340"
            Padding="0"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            AutomationId="FrameCategory">

        <!-- Sombra moderna -->


        <VerticalStackLayout Spacing="0">

            <!-- Header moderno con gradiente purpura -->
            <Border StrokeShape="RoundRectangle 20,20,0,0"
                    StrokeThickness="0"
                    Padding="20,16">
                <Border.Background>
                    <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                </Border.Background>

                <Grid ColumnDefinitions="*, Auto">
                    <StackLayout Grid.Column="0" Spacing="4">
                        <Label x:Name="CategoryTitle"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="{StaticResource OnBrand}"
                               AutomationId="LabelCategoryTitle"/>
                        <Label Text="Seleccione una opcion"
                               FontSize="12"
                               TextColor="{StaticResource OnBrand}"
                               Opacity="0.85"/>
                    </StackLayout>

                    <!-- Boton cerrar mejorado -->
                    <Border Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeThickness="1"
                            WidthRequest="24"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Opacity="0.8"
                            AutomationId="ButtonClosePopup">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseTapped"/>
                        </Border.GestureRecognizers>
                        <brand:PoliedroIcon Text="✕"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Contenido principal -->
            <StackLayout Padding="16,12,16,16" Spacing="8">
                <CollectionView x:Name="MenuItemsList"
                                ItemSizingStrategy="MeasureAllItems"
                                AutomationId="CollectionViewMenuItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"
                                    Padding="0"
                                    MinimumHeightRequest="56"
                                    AutomationId="ButtonMenuItem">

                                <!-- Sombra sutil -->


                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding .}" Value="{x:Null}">
                                        <Setter Property="IsVisible" Value="False"/>
                                    </DataTrigger>
                                </Border.Triggers>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateCommand}"
                                                          Tapped="OnMenuItemClicked"/>
                                </Border.GestureRecognizers>

                                <!-- Estados visuales para interacciones -->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"/>
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SubtleBorder}, Dark={StaticResource SubtleBorderDark}}"/>
                                                <Setter Property="Scale" Value="1"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.98"/>
                                                <Setter Property="Opacity" Value="0.7"/>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12">
                                    <!-- Icono mejorado -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Margin="0,0,12,0"
                                            VerticalOptions="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{AppThemeBinding Light={StaticResource BrandSoft}, Dark={StaticResource BrandSoftDark}}" />
                                        </Border.Background>
                                        <brand:PoliedroIcon Text="{Binding Icon}"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Contenido texto -->
                                    <StackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                               IsVisible="{Binding HasDescription}"/>
                                    </StackLayout>

                                    <!-- Indicador de accion -->
                                    <Border Grid.Column="2"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            VerticalOptions="Center">
                                        <Label Text="›"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource BrandText}, Dark={StaticResource BrandTextDark}}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
