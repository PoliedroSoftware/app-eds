<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="APP.Eds.Views.Popups.CategoryPopup"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Color="Transparent"
    AutomationId="PopupCategory">

    <Border x:Name="Frame"
            BackgroundColor="{StaticResource White}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0"
            WidthRequest="340"
            Padding="0"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            AutomationId="FrameCategory">
        
        <!-- Sombra moderna -->
        <Border.Shadow>
            <Shadow Brush="{StaticResource Black}" 
                    Offset="0,8" 
                    Radius="32" 
                    Opacity="0.12"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="0">

            <!-- Header moderno con gradiente purpura -->
            <Border StrokeShape="RoundRectangle 20,20,0,0"
                    StrokeThickness="0"
                    Padding="20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6A1B9A" Offset="0.0" />
                        <GradientStop Color="#8E24AA" Offset="0.5" />
                        <GradientStop Color="#9C27B0" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid ColumnDefinitions="*, Auto">
                    <StackLayout Grid.Column="0" Spacing="4">
                        <Label x:Name="CategoryTitle"
                               FontAttributes="Bold" 
                               FontSize="18"
                               TextColor="{StaticResource White}"
                               AutomationId="LabelCategoryTitle"/>
                        <Label Text="Seleccione una opcion"
                               FontSize="12"
                               TextColor="{StaticResource White}"
                               Opacity="0.85"/>
                    </StackLayout>

                    <!-- Boton cerrar mejorado -->
                    <Border Grid.Column="1"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource White}"
                            StrokeThickness="1"
                            WidthRequest="24" 
                            HeightRequest="24"
                            HorizontalOptions="End" 
                            VerticalOptions="Center"
                            Opacity="0.8"
                            AutomationId="ButtonClosePopup">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="✕"
                               FontSize="12" 
                               TextColor="{StaticResource White}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Contenido principal -->
            <StackLayout Padding="16,12,16,16" Spacing="8">
                <CollectionView x:Name="MenuItemsList"
                                ItemSizingStrategy="MeasureAllItems"
                                AutomationId="CollectionViewMenuItems">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    BackgroundColor="{StaticResource White}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Gray200}"
                                    Padding="0"
                                    MinimumHeightRequest="56"
                                    AutomationId="ButtonMenuItem">
                                
                                <!-- Sombra sutil -->
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray400}" 
                                            Offset="0,2" 
                                            Radius="4" 
                                            Opacity="0.06"/>
                                </Border.Shadow>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding .}" Value="{x:Null}">
                                        <Setter Property="IsVisible" Value="False"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateCommand}" 
                                                          Tapped="OnMenuItemClicked"/>
                                </Border.GestureRecognizers>
                                
                                <!-- Estados visuales para interacciones -->
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
                                                <Setter Property="Stroke" Value="{StaticResource Gray200}"/>
                                                <Setter Property="Scale" Value="1"/>
                                                <Setter Property="Opacity" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.98"/>
                                                <Setter Property="Opacity" Value="0.7"/>
                                                <Setter Property="BackgroundColor" Value="{StaticResource Gray50}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12">
                                    <!-- Icono mejorado -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Margin="0,0,12,0"
                                            VerticalOptions="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F8F9FA" Offset="0.0" />
                                                <GradientStop Color="#E9ECEF" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="{Binding Icon}"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    
                                    <!-- Contenido texto -->
                                    <StackLayout Grid.Column="1" 
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Gray900}"/>
                                        <Label Text="{Binding Description}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray600}"
                                               IsVisible="{Binding HasDescription}"/>
                                    </StackLayout>
                                    
                                    <!-- Indicador de accion -->
                                    <Border Grid.Column="2"
                                            BackgroundColor="{StaticResource Gray100}"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            VerticalOptions="Center">
                                        <Label Text="›"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
