<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup
    x:Class="APP.Eds.Components.PopUp.CourtDetailPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent"
    AutomationId="PopupCourtDetail">

    <Frame BorderColor="#6200E8"
           CornerRadius="15"
           HasShadow="True"
           x:Name="Frame"
           AutomationId="FrameCourtDetail">

        <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">

            <!-- Encabezado fijo -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, *" Padding="0,0,0,10">
                <Label Grid.Column="1"
                       Text="{Binding CourtDetailTranslation}" FontAttributes="Bold" FontSize="22"
                       
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       AutomationId="LabelCourtDetailTitle"/>

                <Button Grid.Column="2"
                            BackgroundColor="Transparent"
                            Clicked="OnCloseTapped"
                            FontSize="18"
                            Text="✖"
                            TextColor="#6200E8"
                            WidthRequest="30"
                            HeightRequest="30"
                            Padding="0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            AutomationId="ButtonClosePopup"/>
            </Grid>

            <ScrollView Grid.Row="1" x:Name="PopupScroll"
                        AutomationId="ScrollViewCourtDetails">
                <VerticalStackLayout>

                    <Grid RowDefinitions="*,*,*,*,*,*,*,*,*,*" ColumnDefinitions="*,*">
                        <!-- Identidication -->
                        <Label Text="{Binding ConsecutiveTranslation}" FontAttributes="Bold"  Grid.Row="0" Grid.Column="0"
                               AutomationId="LabelConsecutive"/>
                        <Label Text="{Binding Consecutive}"  Grid.Row="0" Grid.Column="1"
                               AutomationId="LabelConsecutiveValue"/>

                        <Label Text="{Binding DateTranslation}" FontAttributes="Bold"  Grid.Row="1" Grid.Column="0"
                               AutomationId="LabelDate"/>
                        <Label Text="{Binding DateStarttime}"  Grid.Row="1" Grid.Column="1"
                               AutomationId="LabelDateValue"/>

                        <Label Text="{Binding IslanderTranslation}" FontAttributes="Bold"  Grid.Row="2" Grid.Column="0"
                               AutomationId="LabelIslander"/>
                        <Label Text="{Binding Islander}"  Grid.Row="2" Grid.Column="1"
                               AutomationId="LabelIslanderValue"/>

                        <Label Text="{Binding ShiftTranslation}" FontAttributes="Bold"  Grid.Row="3" Grid.Column="0" Margin="0,10,0,0"
                               AutomationId="LabelShift"/>
                        <Label Text="{Binding Starttime}"  Grid.Row="4" Grid.Column="0"
                               AutomationId="LabelStarttime"/>
                        <Label Text="{Binding Endtime}"  Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                               AutomationId="LabelEndtime"/>
                        

                        <!-- Totals -->
                        <Label Text="{Binding TotalsTranslation}" FontAttributes="Bold" FontSize="18"  Grid.Row="6" Grid.Column="0"
                               AutomationId="LabelTotals"/>

                        <Label Text="{Binding AccumulatedAmountTranslation}" FontAttributes="Bold"  Grid.Row="7" Grid.Column="0"
                               AutomationId="LabelAccumulatedAmount"/>
                        <Label Text="{Binding TotalAccumulatedGallons, StringFormat='{0:N0}'}"  Grid.Row="7" Grid.Column="1" Margin="8,0,0,0"
                               AutomationId="LabelTotalAccumulatedGallons"/>

                        <Label Text="{Binding AccumulatedGallonsTranslations}" FontAttributes="Bold"  Grid.Row="8" Grid.Column="0"
                               AutomationId="LabelAccumulatedGallons"/>
                        <Label Text="{Binding TotalAccumulatedAmount, StringFormat='$ {0:N0}'}"  Grid.Row="8" Grid.Column="1"
                               AutomationId="LabelTotalAccumulatedAmount"/>

                        <Label Text="{Binding DistincTranslation}" FontAttributes="Bold"  Grid.Row="9" Grid.Column="0"
                               AutomationId="LabelDistinc"/>
                        <Label Text="{Binding Distinc, StringFormat='$ {0:N0}'}"  Grid.Row="9" Grid.Column="1"
                               AutomationId="LabelDistincValue"/>
                    </Grid>

                    <!-- Collections -->
                    <Label Text="{Binding CollectionsTranslation}" FontAttributes="Bold" FontSize="18"  Margin="0,10,0,5"
                           AutomationId="LabelCollections"/>
                    <CollectionView ItemsSource="{Binding Collections}" Margin="0,0,0,10"
                                    AutomationId="CollectionViewCollections">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                <Frame Padding="0" Margin="0,10"   CornerRadius="9"
                                       AutomationId="FrameCollectionItem">
                                    <Grid RowDefinitions="10,*,*,*,*,10" ColumnDefinitions="10,*,*,10">
                                        <Label Text="{Binding DateTranslation}" FontAttributes="Bold"  Grid.Row="1" Grid.Column="1"
                                               AutomationId="LabelCollectionDate"/>
                                        <Label Text="{Binding Date}"  Grid.Row="1" Grid.Column="2"
                                               AutomationId="LabelCollectionDateValue"/>

                                        <Label Text="{Binding CollectionTranslation}" FontAttributes="Bold"  Grid.Row="2" Grid.Column="1"
                                               AutomationId="LabelCollection"/>
                                        <Label Text="{Binding Collection}"  Grid.Row="2" Grid.Column="2"
                                               AutomationId="LabelCollectionValue"/>
                                        <BoxView Grid.Row="2" Grid.ColumnSpan="4" ZIndex="-1"/>

                                        <Label Text="{Binding AmountTranslation}" FontAttributes="Bold"  Grid.Row="3" Grid.Column="1"
                                               AutomationId="LabelAmount"/>
                                        <Label Text="{Binding Amount, StringFormat='$ {0:N0}'}"  Grid.Row="3" Grid.Column="2"
                                               AutomationId="LabelAmountValue"/>

                                        <Label Text="{Binding DescriptionTranslation}" FontAttributes="Bold"  Grid.Row="4" Grid.Column="1"
                                               AutomationId="LabelDescription"/>
                                        <Label Text="{Binding Description}"  Grid.Row="4" Grid.Column="2"
                                               AutomationId="LabelDescriptionValue"/>
                                        <BoxView Grid.Row="4" Grid.ColumnSpan="4" ZIndex="-1"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!--Dispensers-->
                    <Label Text="{Binding DispensersTranslation}" FontAttributes="Bold" FontSize="18"  Margin="0,10,0,5"
                           AutomationId="LabelDispensers"/>
                    <CollectionView ItemsSource="{Binding Dispensers}" Margin="0,0,0,10"
                                    AutomationId="CollectionViewDispensers">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="0" Margin="0,10"   CornerRadius="9"
                                       AutomationId="FrameDispenserItem">
                                    <Grid RowDefinitions="10,*,*,*,*,*,*,*,*,*,*,*,10" ColumnDefinitions="10,*,*,10">
                                        <Label Text="{Binding DispenserTranslation}" FontAttributes="Bold"  Grid.Row="1" Grid.Column="1"
                                               AutomationId="LabelDispenser"/>
                                        <Label Text="{Binding Dispenser}"  Grid.Row="1" Grid.Column="2"
                                               AutomationId="LabelDispenserValue"/>

                                        <Label Text="{Binding NumberHoseTranslation}" FontAttributes="Bold"  Grid.Row="2" Grid.Column="1"
                                               AutomationId="LabelHoseNumber"/>
                                        <Label Text="{Binding NumberHose}"  Grid.Row="2" Grid.Column="2"
                                               AutomationId="LabelHoseNumberValue"/>
                                        <BoxView Grid.Row="2" Grid.ColumnSpan="4" ZIndex="-1"/>

                                        <Label Text="{Binding ProductTranslation}" FontAttributes="Bold"  Grid.Row="3" Grid.Column="1"
                                               AutomationId="LabelProduct"/>
                                        <Label Text="{Binding Product}"  Grid.Row="3" Grid.Column="2"
                                               AutomationId="LabelProductValue"/>

                                        <Label Text="{Binding PriceTranslation}" FontAttributes="Bold"  Grid.Row="4" Grid.Column="1"
                                               AutomationId="LabelPrice"/>
                                        <Label Text="{Binding Price, StringFormat='$ {0:N0}'}"  Grid.Row="4" Grid.Column="2"
                                               AutomationId="LabelPriceValue"/>
                                        <BoxView Grid.Row="4" Grid.ColumnSpan="4" ZIndex="-1"
/>

                                        <Label Text="{Binding StarttimeTranslation}" FontAttributes="Bold"  Grid.Row="5" Grid.Column="1"
                                               AutomationId="LabelStarttime"/>
                                        <Label Text="{Binding Starttime}"  Grid.Row="5" Grid.Column="2"
                                               AutomationId="LabelStarttimeValue"/>

                                        <Label Text="{Binding EndtimeTranslation}" FontAttributes="Bold"  Grid.Row="6" Grid.Column="1"
                                               AutomationId="LabelEndtime"/>
                                        <Label Text="{Binding Endtime}"  Grid.Row="6" Grid.Column="2"
                                               AutomationId="LabelEndtimeValue"/>
                                        <BoxView Grid.Row="6" Grid.ColumnSpan="4" ZIndex="-1"/>

                                        <Label Text="{Binding AccumulatedAmountTranslation}" FontAttributes="Bold"  Grid.Row="7" Grid.Column="1"
                                               AutomationId="LabelAccumulatedAmount"/>
                                        <Label Text="{Binding AccumulatedAmount, StringFormat='$ {0:N0}'}"  Grid.Row="7" Grid.Column="2"
                                               AutomationId="LabelAccumulatedAmountValue"/>

                                        <Label Text="{Binding AccumulatedGallonsTranslations}" FontAttributes="Bold"  Grid.Row="8" Grid.Column="1"
                                               AutomationId="LabelAccumulatedGallons"/>
                                        <Label Text="{Binding AccumulatedGallons, StringFormat='{0:N2}'}"  Margin="8,0,0,0" Grid.Row="8" Grid.Column="2"
                                               AutomationId="LabelAccumulatedGallonsValue"/>
                                        <BoxView Grid.Row="8" Grid.ColumnSpan="4" ZIndex="-1"/>

                                        <Label Text="{Binding LastAccumulatedAmountTranslation}" FontAttributes="Bold"  Grid.Row="9" Grid.Column="1"
                                               AutomationId="LabelLastAccumulatedAmount"/>
                                        <Label Text="{Binding LastAccumulatedAmount, StringFormat='$ {0:N0}'}"  Grid.Row="9" Grid.Column="2"
                                               AutomationId="LabelLastAccumulatedAmountValue"/>

                                        <Label Text="{Binding LastAccumulatedGallonsTranslation}" FontAttributes="Bold"  Grid.Row="10" Grid.Column="1"
                                               AutomationId="LabelLastAccumulatedGallons"/>
                                        <Label Text="{Binding LastAccumulatedGallons, StringFormat='{0:N2}'}"  Margin="8,0,0,0" Grid.Row="10" Grid.Column="2"
                                               AutomationId="LabelLastAccumulatedGallonsValue"/>
                                        <BoxView Grid.Row="10" Grid.ColumnSpan="4" ZIndex="-1"/>

                                        <Label Text="{Binding DistincTranslation}" FontAttributes="Bold"  Grid.Row="11" Grid.Column="1"
                                               AutomationId="LabelDistinc"/>
                                        <Label Text="{Binding Distinc, StringFormat='$ {0:N0}'}"  Grid.Row="11" Grid.Column="2"
                                               AutomationId="LabelDistincValue"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!--Documents-->
                    <Label Text="{Binding DocumentsTranslation}" FontAttributes="Bold" FontSize="18"  Margin="0,10,0,5"
                           AutomationId="LabelDocuments"/>
                    <CollectionView ItemsSource="{Binding Documents}" Margin="0,0,0,10"
                                    AutomationId="CollectionViewDocuments">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="10" Margin="0,5"   CornerRadius="9"
                                       AutomationId="FrameDocumentItem">
                                    <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*">
                                        <Label Text="{Binding CourtTranslation}" FontAttributes="Bold"  Grid.Row="0" Grid.Column="0"
                                               AutomationId="LabelDocumentCourt"/>
                                        <Label Text="{Binding Court}"  Grid.Row="0" Grid.Column="1"
                                               AutomationId="LabelDocumentCourtValue"/>
                                        <Grid HeightRequest="120" Margin="0,10,0,0" Grid.Row="1" Grid.Column="0">
                                            <Image HorizontalOptions="Start" Aspect="AspectFit" Source="{Binding ImageSource}" IsVisible="{Binding HasImage}"
                                                   AutomationId="ImageDocument"/>
                                            <Label Text="{Binding ThereIsNoImageTranslation}" HorizontalOptions="Start" VerticalOptions="Center" TextColor="Gray" FontAttributes="Italic" IsVisible="{Binding NoImage}"
                                                   AutomationId="LabelNoImage"/>
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!--Expenditures-->
                    <Label Text="{Binding ExpendituresTranslation}" FontAttributes="Bold" FontSize="18"  Margin="0,10,0,5"
                           AutomationId="LabelExpenditures"/>
                    <CollectionView ItemsSource="{Binding Expenditures}" Margin="0,0,0,10" 
                                    AutomationId="CollectionViewExpenditures">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="10" Margin="0,5" CornerRadius="9"
                                       AutomationId="FrameExpenditureItem">
                                    <Grid RowDefinitions="10,*,*,*,*,10" ColumnDefinitions="10,*,*,10">
                                        <Label Text="{Binding DateTranslation}" FontAttributes="Bold"  Grid.Row="1" Grid.Column="1"
                                               AutomationId="LabelExpenditureDate"/>
                                        <Label Text="{Binding Date}"  Grid.Row="1" Grid.Column="2"
                                               AutomationId="LabelExpenditureDateValue"/>
                                        <BoxView Grid.Row="2" Grid.ColumnSpan="4" Color="#E0E0E0" HeightRequest="1"/>

                                        <Label Text="{Binding ExpenditureTranslation}" FontAttributes="Bold"  Grid.Row="2" Grid.Column="1"
                                               AutomationId="LabelExpenditure"/>
                                        <Label Text="{Binding Expenditure}"  Grid.Row="2" Grid.Column="2" LineBreakMode="TailTruncation"
                                               AutomationId="LabelExpenditureValue"/>

                                        <Label Text="{Binding AmountTranslation}" FontAttributes="Bold"  Grid.Row="3" Grid.Column="1"
                                               AutomationId="LabelExpenditureAmount"/>
                                        <Label Text="{Binding Amount, StringFormat='$ {0:N0}'}"  Grid.Row="3" Grid.Column="2"
                                               AutomationId="LabelExpenditureAmountValue"/>
                                        <BoxView Grid.Row="4" Grid.ColumnSpan="4" Color="#E0E0E0" HeightRequest="1"/>

                                        <Label Text="{Binding DescriptionTranslation}" FontAttributes="Bold"  Grid.Row="4" Grid.Column="1"
                                               AutomationId="LabelExpenditureDescription"/>
                                        <Label Text="{Binding Description}"  Grid.Row="4" Grid.Column="2" LineBreakMode="TailTruncation"
                                               AutomationId="LabelExpenditureDescriptionValue"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Frame>

</mct:Popup>
